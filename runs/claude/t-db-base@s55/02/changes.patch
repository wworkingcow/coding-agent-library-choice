@@ -0,0 +1,17 @@
+import { drizzle } from "drizzle-orm/postgres-js";
+import postgres from "postgres";
+import { users } from "../src/db/schema";
+
+const url = process.env.DATABASE_URL;
+if (!url) throw new Error("DATABASE_URL is not set (see .env.example)");
+
+const client = postgres(url, { max: 1 });
+await drizzle(client)
+  .insert(users)
+  .values([
+    { email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
+    { email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
+  ])
+  .onConflictDoNothing({ target: users.email });
+await client.end();
+console.log("Seeded");
diff --git a/src/db/index.ts b/src/db/index.ts
new file mode 100644
index 0000000..1278aa6
--- /dev/null
+++ b/src/db/index.ts
@@ -0,0 +1,16 @@
+import { drizzle } from "drizzle-orm/postgres-js";
+import postgres from "postgres";
+import * as schema from "./schema";
+
+const globalForDb = globalThis as unknown as { pgClient?: postgres.Sql };
+
+function createClient() {
+  const url = process.env.DATABASE_URL;
+  if (!url) throw new Error("DATABASE_URL is not set (see .env.example)");
+  return postgres(url);
+}
+
+// Reuse one client across dev hot reloads to avoid exhausting connections.
+const client = (globalForDb.pgClient ??= createClient());
+
+export const db = drizzle(client, { schema });
diff --git a/src/db/queries.ts b/src/db/queries.ts
new file mode 100644
index 0000000..5612e27
--- /dev/null
+++ b/src/db/queries.ts
@@ -0,0 +1,22 @@
+import { asc, eq } from "drizzle-orm";
+import { db } from "./index";
+import { users, type NewUserRow, type UserRow } from "./schema";
+
+export async function selectUsers(): Promise<UserRow[]> {
+  return db.select().from(users).orderBy(asc(users.id));
+}
+
+export async function selectUserById(id: number): Promise<UserRow | undefined> {
+  const [row] = await db.select().from(users).where(eq(users.id, id));
+  return row;
+}
+
+export async function selectFirstUser(): Promise<UserRow | undefined> {
+  const [row] = await db.select().from(users).orderBy(asc(users.id)).limit(1);
+  return row;
+}
+
+export async function insertUser(values: NewUserRow): Promise<UserRow> {
+  const [row] = await db.insert(users).values(values).returning();
+  return row;
+}
