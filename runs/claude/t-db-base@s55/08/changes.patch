@@ -0,0 +1,23 @@
+import { drizzle } from "drizzle-orm/node-postgres";
+import { Pool } from "pg";
+import { users } from "./schema";
+
+async function main() {
+  const url = process.env.DATABASE_URL;
+  if (!url) throw new Error("DATABASE_URL is not set (see .env.example)");
+  const pool = new Pool({ connectionString: url });
+  await drizzle(pool)
+    .insert(users)
+    .values([
+      { email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
+      { email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
+    ])
+    .onConflictDoNothing();
+  await pool.end();
+  console.log("seeded");
+}
+
+main().catch((e) => {
+  console.error(e);
+  process.exit(1);
+});
