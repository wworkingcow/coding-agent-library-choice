diff --git a/src/db/index.ts b/src/db/index.ts
new file mode 100644
index 0000000..7c865e2
--- /dev/null
+++ b/src/db/index.ts
@@ -0,0 +1,35 @@
+import Database from "better-sqlite3";
+import { drizzle } from "drizzle-orm/better-sqlite3";
+import { migrate } from "drizzle-orm/better-sqlite3/migrator";
+import fs from "node:fs";
+import path from "node:path";
+import * as schema from "./schema";
+
+export const MIGRATIONS_FOLDER = path.join(process.cwd(), "drizzle");
+
+export function createDb(url = process.env.DATABASE_URL ?? "./data/app.db") {
+  if (url !== ":memory:") {
+    fs.mkdirSync(path.dirname(path.resolve(url)), { recursive: true });
+  }
+  const sqlite = new Database(url);
+  sqlite.pragma("journal_mode = WAL");
+  sqlite.pragma("foreign_keys = ON");
+  return drizzle(sqlite, { schema });
+}
+
+export type Db = ReturnType<typeof createDb>;
+
+const globalForDb = globalThis as unknown as { __db?: Db };
+
+// Cached on globalThis so Next dev hot reloads don't open a new handle each time.
+// Migrations are applied on first open, so a fresh checkout works without a manual step.
+export function getDb(): Db {
+  if (!globalForDb.__db) {
+    const db = createDb();
+    migrate(db, { migrationsFolder: MIGRATIONS_FOLDER });
+    globalForDb.__db = db;
+  }
+  return globalForDb.__db;
+}
+
+export { schema };
diff --git a/src/db/queries.ts b/src/db/queries.ts
new file mode 100644
index 0000000..c3df930
--- /dev/null
+++ b/src/db/queries.ts
@@ -0,0 +1,19 @@
+import { asc, eq } from "drizzle-orm";
+import { getDb } from "./index";
+import { users, type NewUserRow, type UserRow } from "./schema";
+
+export function selectUsers(): UserRow[] {
+  return getDb().select().from(users).orderBy(asc(users.createdAt), asc(users.id)).all();
+}
+
+export function selectUserById(id: string): UserRow | undefined {
+  return getDb().select().from(users).where(eq(users.id, id)).get();
+}
+
+export function selectFirstUser(): UserRow | undefined {
+  return getDb().select().from(users).orderBy(asc(users.createdAt), asc(users.id)).limit(1).get();
+}
+
+export function insertUser(user: NewUserRow): UserRow {
+  return getDb().insert(users).values(user).returning().get();
+}
diff --git a/src/db/schema.ts b/src/db/schema.ts
new file mode 100644
index 0000000..88056a3
--- /dev/null
+++ b/src/db/schema.ts
@@ -0,0 +1,15 @@
+import { sql } from "drizzle-orm";
+import { sqliteTable, text } from "drizzle-orm/sqlite-core";
+
+export const users = sqliteTable("users", {
+  id: text("id").primaryKey(),
+  email: text("email").notNull().unique(),
+  name: text("name").notNull(),
+  // ISO date (YYYY-MM-DD), same shape the in-memory users used.
+  createdAt: text("created_at")
+    .notNull()
+    .default(sql`(date('now'))`),
+});
+
+export type UserRow = typeof users.$inferSelect;
+export type NewUserRow = typeof users.$inferInsert;
