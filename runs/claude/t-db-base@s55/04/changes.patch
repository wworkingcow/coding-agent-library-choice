@@ -0,0 +1,16 @@
+import { drizzle } from "drizzle-orm/postgres-js";
+import postgres from "postgres";
+import { users } from "../src/db/schema";
+
+const url = process.env.DATABASE_URL;
+if (!url) throw new Error("DATABASE_URL is not set");
+const sql = postgres(url, { max: 1 });
+await drizzle(sql)
+  .insert(users)
+  .values([
+    { email: "ada@example.com", name: "Ada", createdAt: new Date("2026-01-04") },
+    { email: "grace@example.com", name: "Grace", createdAt: new Date("2026-02-11") },
+  ])
+  .onConflictDoNothing();
+await sql.end();
+console.log("seeded");
diff --git a/src/db/index.ts b/src/db/index.ts
new file mode 100644
index 0000000..d503c7e
--- /dev/null
+++ b/src/db/index.ts
@@ -0,0 +1,22 @@
+import { drizzle } from "drizzle-orm/postgres-js";
+import postgres from "postgres";
+import * as schema from "./schema";
+
+const globalForDb = globalThis as unknown as { pgClient?: postgres.Sql };
+
+function client(): postgres.Sql {
+  const url = process.env.DATABASE_URL;
+  if (!url) throw new Error("DATABASE_URL is not set (see .env.example)");
+  // Reuse the connection across dev hot reloads.
+  return (globalForDb.pgClient ??= postgres(url));
+}
+
+let instance: ReturnType<typeof create> | undefined;
+function create() {
+  return drizzle(client(), { schema });
+}
+
+// Lazy so importing this module (e.g. during `next build`) doesn't need a database.
+export function db() {
+  return (instance ??= create());
+}
