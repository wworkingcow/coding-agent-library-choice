@@ -0,0 +1,89 @@
+import { NextRequest, NextResponse } from "next/server";
+import { searchNotes, type SearchResult } from "@/lib/notes";
+
+function serialize(results: SearchResult[]) {
+  return results.map(({ note, score }) => ({
+    id: note.id,
+    title: note.title,
+    content: note.content,
+    createdAt: note.createdAt,
+    author: note.author
+      ? { id: note.author.id, name: note.author.name, email: note.author.email }
+      : null,
+    score,
+  }));
+}
+
+function parseLimit(raw: string | null): number | undefined {
+  if (raw === null) return undefined;
+  const limit = Number(raw);
+  if (!Number.isFinite(limit) || limit <= 0) {
+    throw new Error("'limit' must be a positive number.");
+  }
+  return limit;
+}
+
+async function runSearch(
+  query: string | undefined,
+  limit: number | undefined,
+  userId: string | undefined
+) {
+  const trimmed = query?.trim();
+  if (!trimmed) {
+    return NextResponse.json(
+      { error: "Missing required query 'q' (or 'query')." },
+      { status: 400 }
+    );
+  }
+
+  const results = await searchNotes(trimmed, { limit, userId });
+  return NextResponse.json({ query: trimmed, results: serialize(results) });
+}
+
+// GET /api/search?q=roadmap&limit=5&userId=1
+export async function GET(request: NextRequest) {
+  const { searchParams } = new URL(request.url);
+
+  let limit: number | undefined;
+  try {
+    limit = parseLimit(searchParams.get("limit"));
+  } catch (err) {
+    const message = err instanceof Error ? err.message : "Invalid 'limit'.";
+    return NextResponse.json({ error: message }, { status: 400 });
+  }
+
+  try {
+    return await runSearch(
+      searchParams.get("q") ?? undefined,
+      limit,
+      searchParams.get("userId") ?? undefined
+    );
+  } catch (err) {
+    const message = err instanceof Error ? err.message : "Unknown error";
+    return NextResponse.json({ error: message }, { status: 500 });
+  }
+}
+
+// POST /api/search { "query": "roadmap", "limit": 5, "userId": "1" }
+export async function POST(request: NextRequest) {
+  let body: { query?: string; limit?: number; userId?: string };
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400 });
+  }
+
+  if (body.limit !== undefined && (!Number.isFinite(body.limit) || body.limit <= 0)) {
+    return NextResponse.json(
+      { error: "'limit' must be a positive number." },
+      { status: 400 }
+    );
+  }
+
+  try {
+    return await runSearch(body.query, body.limit, body.userId);
+  } catch (err) {
+    const message = err instanceof Error ? err.message : "Unknown error";
+    return NextResponse.json({ error: message }, { status: 500 });
+  }
+}
diff --git a/src/lib/embeddings.ts b/src/lib/embeddings.ts
