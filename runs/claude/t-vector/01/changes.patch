 }
+
+// Other modules (e.g. notes) key their data off a real user id. This gives them
+// a single place to validate that id instead of reaching into the `users` array.
+export async function requireUser(id: string): Promise<User> {
+  const user = await getUser(id);
+  if (!user) {
+    throw new Error(`Unknown user: ${id}`);
+  }
+  return user;
+}
