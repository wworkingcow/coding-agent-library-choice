index 0000000..9f18315
--- /dev/null
+++ b/src/lib/embeddings.ts
@@ -0,0 +1,70 @@
+// Thin client around the OpenAI embeddings API. Kept dependency-free (plain
+// fetch) since it's the only place in the app that needs an HTTP client.
+
+const OPENAI_EMBEDDINGS_URL = "https://api.openai.com/v1/embeddings";
+const DEFAULT_MODEL = "text-embedding-3-small";
+
+type OpenAIEmbeddingResponse = {
+  data: { embedding: number[]; index: number }[];
+};
+
+/**
+ * Embeds a batch of strings in a single request. Order of the returned
+ * vectors matches the order of `texts`.
+ */
+export async function embedTexts(texts: string[]): Promise<number[][]> {
+  if (texts.length === 0) return [];
+
+  const apiKey = process.env.OPENAI_API_KEY;
+  if (!apiKey) {
+    throw new Error(
+      "OPENAI_API_KEY is not set. Copy .env.example to .env.local and add a real key."
+    );
+  }
+
+  const model = process.env.OPENAI_EMBEDDING_MODEL || DEFAULT_MODEL;
+
+  const res = await fetch(OPENAI_EMBEDDINGS_URL, {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: `Bearer ${apiKey}`,
+    },
+    body: JSON.stringify({ model, input: texts }),
+  });
+
+  if (!res.ok) {
+    const body = await res.text().catch(() => "");
+    throw new Error(
+      `OpenAI embeddings request failed (${res.status} ${res.statusText}): ${body}`
+    );
+  }
+
+  const json = (await res.json()) as OpenAIEmbeddingResponse;
+
+  return json.data
+    .sort((a, b) => a.index - b.index)
+    .map((entry) => entry.embedding);
+}
+
+/** Embeds a single string. Convenience wrapper around {@link embedTexts}. */
+export async function embedText(text: string): Promise<number[]> {
+  const [embedding] = await embedTexts([text]);
+  return embedding;
+}
+
+/** Cosine similarity between two equal-length vectors, in [-1, 1]. */
+export function cosineSimilarity(a: number[], b: number[]): number {
+  let dot = 0;
+  let normA = 0;
+  let normB = 0;
+
+  for (let i = 0; i < a.length; i++) {
+    dot += a[i] * b[i];
+    normA += a[i] * a[i];
+    normB += b[i] * b[i];
+  }
+
+  if (normA === 0 || normB === 0) return 0;
+  return dot / (Math.sqrt(normA) * Math.sqrt(normB));
+}
diff --git a/src/lib/notes.ts b/src/lib/notes.ts
new file mode 100644
index 0000000..bc7aaa1
--- /dev/null
+++ b/src/lib/notes.ts
@@ -0,0 +1,132 @@
+import { getUser, requireUser, type User } from "./users";
+import { cosineSimilarity, embedText } from "./embeddings";
+
+export type Note = {
+  id: string;
+  userId: string;
+  title: string;
+  content: string;
+  createdAt: string;
+  // null until the embedding has been computed (e.g. if it's still in flight).
+  embedding: number[] | null;
+};
+
+export type NoteWithAuthor = Note & { author: User | undefined };
+
+export type SearchResult = {
+  note: NoteWithAuthor;
+  score: number;
+};
+
+const notes: Note[] = [];
+let nextId = 1;
+
+// Seed data, one per existing user, so /api/search has something to find out
+// of the box. userIds must line up with the users in src/lib/users.ts.
+const SEED_NOTES: { userId: string; title: string; content: string }[] = [
+  {
+    userId: "1",
+    title: "Roadmap ideas",
+    content:
+      "Sketch out the Q1 roadmap: onboarding flow, billing, and semantic search.",
+  },
+  {
+    userId: "1",
+    title: "Grocery list",
+    content: "Milk, eggs, spinach, coffee beans, sourdough bread.",
+  },
+  {
+    userId: "2",
+    title: "Research notes",
+    content:
+      "Summarize the latest paper on approximate nearest neighbor search for embeddings.",
+  },
+  {
+    userId: "2",
+    title: "Book club",
+    content:
+      "Discuss 'Project Hail Mary' on Thursday — bring snacks and questions for chapter 12.",
+  },
+];
+
+let seedingPromise: Promise<void> | null = null;
+
+// Notes need a live API call to get an embedding, so seeding has to happen
+// lazily (at request time) rather than at module load. Memoized so concurrent
+// requests during the first call don't seed twice.
+function ensureSeeded(): Promise<void> {
+  if (!seedingPromise) {
+    seedingPromise = (async () => {
+      for (const seed of SEED_NOTES) {
+        await createNote(seed.userId, seed.title, seed.content);
+      }
+    })();
+  }
+  return seedingPromise;
+}
+
+async function attachAuthors(list: Note[]): Promise<NoteWithAuthor[]> {
+  return Promise.all(
+    list.map(async (note) => ({ ...note, author: await getUser(note.userId) }))
+  );
+}
+
+/** Creates a note for a known user and computes its embedding up front. */
+export async function createNote(
+  userId: string,
+  title: string,
+  content: string
+): Promise<Note> {
+  await requireUser(userId); // throws on unknown ids — keeps notes tied to real accounts
+
+  const embedding = await embedText(`${title}\n\n${content}`);
+
+  const note: Note = {
+    id: String(nextId++),
+    userId,
+    title,
+    content,
+    createdAt: new Date().toISOString(),
+    embedding,
+  };
+  notes.push(note);
+  return note;
+}
+
+export async function listNotes(userId?: string): Promise<NoteWithAuthor[]> {
+  await ensureSeeded();
+  const filtered = userId ? notes.filter((n) => n.userId === userId) : notes;
+  return attachAuthors(filtered);
+}
+
+/**
+ * Returns the notes whose embeddings are closest to the query, ranked by
+ * cosine similarity. Pass `userId` to scope the search to one user's notes.
+ */
+export async function searchNotes(
+  query: string,
+  options: { limit?: number; userId?: string } = {}
+): Promise<SearchResult[]> {
+  const trimmed = query.trim();
+  if (!trimmed) return [];
+
+  await ensureSeeded();
+
+  const limit = options.limit ?? 5;
+  const candidates = (
+    options.userId ? notes.filter((n) => n.userId === options.userId) : notes
+  ).filter((n): n is Note & { embedding: number[] } => n.embedding !== null);
+
+  if (candidates.length === 0) return [];
+
+  const queryEmbedding = await embedText(trimmed);
+
+  const ranked = candidates
+    .map((note) => ({ note, score: cosineSimilarity(queryEmbedding, note.embedding) }))
+    .sort((a, b) => b.score - a.score)
+    .slice(0, limit);
+
+  const withAuthors = await attachAuthors(ranked.map((r) => r.note));
+
+  return ranked.map((r, i) => ({ note: withAuthors[i], score: r.score }));
+}
