diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..db0ee50
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,59 @@
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+function getClient(): Resend | undefined {
+  const key = process.env.RESEND_API_KEY;
+  if (!key) return undefined;
+  client ??= new Resend(key);
+  return client;
+}
+
+function escapeHtml(s: string): string {
+  return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+type Message = { to: string; subject: string; html: string; text: string };
+
+// Never throws: Resend resolves with `error` on refusal, and a failed email must not
+// break the request that triggered it.
+async function send({ to, subject, html, text }: Message): Promise<boolean> {
+  const resend = getClient();
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!resend || !from) {
+    console.warn(`[email] RESEND_API_KEY/RESEND_FROM_EMAIL not set; skipping "${subject}"`);
+    return false;
+  }
+  try {
+    const { error } = await resend.emails.send({ from, to, subject, html, text });
+    if (error) {
+      console.error(`[email] "${subject}" failed: ${error.name}: ${error.message}`);
+      return false;
+    }
+    return true;
+  } catch (err) {
+    console.error(`[email] "${subject}" failed`, err);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(to: string, name: string): Promise<boolean> {
+  const appUrl = process.env.APP_URL ?? "http://localhost:3000";
+  return send({
+    to,
+    subject: "Welcome to Notely",
+    html: `<p>Hi ${escapeHtml(name)},</p><p>Welcome to Notely! Your account is ready.</p><p><a href="${escapeHtml(appUrl)}/dashboard">Open your dashboard</a></p>`,
+    text: `Hi ${name},\n\nWelcome to Notely! Your account is ready.\n\n${appUrl}/dashboard`,
+  });
+}
+
+export function sendPasswordResetEmail(to: string, name: string, token: string): Promise<boolean> {
+  const appUrl = process.env.APP_URL ?? "http://localhost:3000";
+  const url = `${appUrl}/reset-password?token=${encodeURIComponent(token)}`;
+  return send({
+    to,
+    subject: "Reset your Notely password",
+    html: `<p>Hi ${escapeHtml(name)},</p><p>We received a request to reset your password. This link expires in 1 hour:</p><p><a href="${escapeHtml(url)}">Reset password</a></p><p>If you didn't ask for this, you can ignore this email.</p>`,
+    text: `Hi ${name},\n\nReset your password (link expires in 1 hour):\n${url}\n\nIf you didn't ask for this, ignore this email.`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..954cc18 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,45 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  await sendWelcomeEmail(user.email, user.name);
+  return user;
+}
+
+const RESET_TTL_MS = 60 * 60 * 1000;
+// Keyed by SHA-256 of the token so a leaked store doesn't leak usable links.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+// Always resolves silently, whether or not the email is registered, so callers can't
+// use it to enumerate accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === email.trim().toLowerCase());
+  if (!user) return;
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), { userId: user.id, expiresAt: Date.now() + RESET_TTL_MS });
+  await sendPasswordResetEmail(user.email, user.name, token);
+}
+
+// Returns the user the token belongs to and consumes it, or undefined if invalid/expired.
+// TODO: there is no password storage yet — the caller must set the new password.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
