diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..c042341
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,71 @@
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+function getClient(): Resend {
+  client ??= new Resend(process.env.RESEND_API_KEY);
+  return client;
+}
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+export function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
+}
+
+type Message = { to: string; subject: string; html: string; text: string };
+
+// Resend resolves to { error } instead of throwing on refused messages. Email is a side
+// effect of the request that triggers it, so log failures and never break that request.
+async function send(message: Message): Promise<boolean> {
+  if (!process.env.RESEND_API_KEY || !process.env.RESEND_FROM_EMAIL) {
+    console.warn(`[email] RESEND_API_KEY/RESEND_FROM_EMAIL not set; skipping "${message.subject}"`);
+    return false;
+  }
+  try {
+    const { error } = await getClient().emails.send({
+      from: process.env.RESEND_FROM_EMAIL,
+      ...message,
+    });
+    if (error) {
+      console.error(`[email] Resend refused "${message.subject}": ${error.name}: ${error.message}`);
+      return false;
+    }
+    return true;
+  } catch (err) {
+    console.error(`[email] failed to send "${message.subject}"`, err);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  const name = escapeHtml(user.name);
+  const url = `${appUrl()}/dashboard`;
+  return send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    html: `<p>Hi ${name},</p><p>Welcome to Notely! Your account is ready.</p><p><a href="${url}">Open your dashboard</a></p>`,
+    text: `Hi ${user.name},\n\nWelcome to Notely! Your account is ready.\n\nOpen your dashboard: ${url}\n`,
+  });
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+) {
+  const name = escapeHtml(user.name);
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    html: `<p>Hi ${name},</p><p>We received a request to reset your password. This link expires in ${expiresInMinutes} minutes.</p><p><a href="${url}">Reset password</a></p><p>If you didn't request this, you can ignore this email.</p>`,
+    text: `Hi ${user.name},\n\nWe received a request to reset your password. This link expires in ${expiresInMinutes} minutes:\n${url}\n\nIf you didn't request this, you can ignore this email.\n`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..50dbbbb 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,51 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  // sendWelcomeEmail never throws, so a failed email does not undo signup.
+  await sendWelcomeEmail(user);
+  return user;
+}
+
+const RESET_TTL_MINUTES = 60;
+// In-memory like the user list: token hash -> reset request. Only the hash is stored.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+// Always resolves the same way whether or not the email exists, to avoid account enumeration.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const normalized = email.trim().toLowerCase();
+  const user = users.find((u) => u.email === normalized);
+  if (!user) return;
+  for (const [hash, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(hash);
+  }
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TTL_MINUTES * 60_000,
+  });
+  await sendPasswordResetEmail(user, token, RESET_TTL_MINUTES);
+}
+
+// Single-use: returns the user the token belongs to and consumes it, or undefined if invalid/expired.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = resetTokens.get(hash);
+  resetTokens.delete(hash);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return users.find((u) => u.id === entry.userId);
+}
