+import { betterAuth } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+import { db } from "./db";
+
+// Server-side auth instance. Better Auth owns the `user`, `session`,
+// `account` and `verification` tables in the sqlite db above; `users.ts`
+// reads the `user` table it manages.
+export const auth = betterAuth({
+  database: db,
+  secret: process.env.BETTER_AUTH_SECRET,
+  baseURL: process.env.BETTER_AUTH_URL ?? "http://localhost:3000",
+  emailAndPassword: {
+    enabled: true,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID ?? "",
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET ?? "",
+    },
+  },
+  // Lets server actions/route handlers set session cookies directly.
+  plugins: [nextCookies()],
+});
