+      <p className="mt-1 text-sm opacity-70">Get started with Notely.</p>
+
+      {params.error && (
+        <p className="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
+          {params.error}
+        </p>
+      )}
+
+      <form action={signup} className="mt-6 flex flex-col gap-3">
+        <label className="text-sm">
+          Name
+          <input
+            name="name"
+            type="text"
+            required
+            autoComplete="name"
+            className="mt-1 w-full rounded-md border border-black/[.1] px-3 py-2 text-sm dark:border-white/[.15] dark:bg-black"
+          />
+        </label>
+        <label className="text-sm">
+          Email
+          <input
+            name="email"
+            type="email"
+            required
+            autoComplete="email"
+            className="mt-1 w-full rounded-md border border-black/[.1] px-3 py-2 text-sm dark:border-white/[.15] dark:bg-black"
+          />
+        </label>
+        <label className="text-sm">
+          Password
+          <input
+            name="password"
+            type="password"
+            required
+            minLength={8}
+            autoComplete="new-password"
+            className="mt-1 w-full rounded-md border border-black/[.1] px-3 py-2 text-sm dark:border-white/[.15] dark:bg-black"
+          />
+        </label>
+        <button
+          type="submit"
+          className="mt-2 rounded-full bg-foreground px-5 py-2 text-sm font-medium text-background transition-colors hover:bg-[#383838] dark:hover:bg-[#ccc]"
+        >
+          Sign up
+        </button>
+      </form>
+
+      <div className="my-6 flex items-center gap-3 text-xs uppercase opacity-50">
+        <span className="h-px flex-1 bg-current" />
+        or
+        <span className="h-px flex-1 bg-current" />
+      </div>
+
+      <form action={signupWithGoogle}>
+        <button
+          type="submit"
+          className="flex w-full items-center justify-center gap-2 rounded-full border border-black/[.1] px-5 py-2 text-sm font-medium transition-colors hover:bg-black/[.04] dark:border-white/[.15] dark:hover:bg-[#1a1a1a]"
+        >
+          Continue with Google
+        </button>
+      </form>
+
+      <p className="mt-6 text-sm opacity-70">
+        Already have an account?{" "}
+        <Link href="/login" className="font-medium underline">
+          Sign in
+        </Link>
+      </p>
+    </main>
+  );
+}
