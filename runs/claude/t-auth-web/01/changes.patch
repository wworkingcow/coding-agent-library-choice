+AUTH_SECRET=changeme-generate-a-random-32-byte-secret
+
+# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
+# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
+# Authorized redirect URI (prod): https://YOUR_DOMAIN/api/auth/callback/google
+AUTH_GOOGLE_ID=changeme-google-oauth-client-id.apps.googleusercontent.com
+AUTH_GOOGLE_SECRET=changeme-google-oauth-client-secret
+
+# Required when self-hosting behind a proxy / on a platform other than
+# Vercel, so Auth.js trusts the incoming Host header.
+# AUTH_TRUST_HOST=true
