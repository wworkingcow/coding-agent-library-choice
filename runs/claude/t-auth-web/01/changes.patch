+import { redirect } from "next/navigation";
+import Link from "next/link";
+import { AuthError } from "next-auth";
+
+import { signIn } from "@/lib/auth";
+
+const ERROR_MESSAGES: Record<string, string> = {
+  CredentialsSignin: "Invalid email or password.",
+  OAuthAccountNotLinked: "That email is already in use with a different sign-in method.",
+};
+
+export default async function LoginPage({
+  searchParams,
+}: {
+  searchParams: Promise<{ callbackUrl?: string; error?: string }>;
+}) {
+  const params = await searchParams;
+  const callbackUrl = params.callbackUrl || "/dashboard";
+
+  async function loginWithCredentials(formData: FormData) {
+    "use server";
+    const email = String(formData.get("email") ?? "");
+    const password = String(formData.get("password") ?? "");
+
+    try {
+      await signIn("credentials", {
+        email,
+        password,
+        redirectTo: callbackUrl,
+      });
+    } catch (error) {
+      if (error instanceof AuthError) {
+        const type = error.type ?? "CredentialsSignin";
+        redirect(
+          `/login?error=${encodeURIComponent(type)}&callbackUrl=${encodeURIComponent(callbackUrl)}`
+        );
+      }
+      throw error;
+    }
+  }
+
+  async function loginWithGoogle() {
+    "use server";
+    await signIn("google", { redirectTo: callbackUrl });
+  }
+
+  const errorMessage = params.error
+    ? ERROR_MESSAGES[params.error] ?? "Something went wrong signing you in."
+    : null;
+
+  return (
+    <main className="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center p-8">
+      <h1 className="text-2xl font-semibold">Sign in</h1>
+      <p className="mt-1 text-sm opacity-70">Welcome back to Notely.</p>
+
+      {errorMessage && (
+        <p className="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
+          {errorMessage}
+        </p>
+      )}
+
+      <form action={loginWithCredentials} className="mt-6 flex flex-col gap-3">
+        <label className="text-sm">
+          Email
+          <input
+            name="email"
+            type="email"
+            required
+            autoComplete="email"
+            className="mt-1 w-full rounded-md border border-black/[.1] px-3 py-2 text-sm dark:border-white/[.15] dark:bg-black"
+          />
+        </label>
+        <label className="text-sm">
+          Password
+          <input
+            name="password"
+            type="password"
+            required
+            autoComplete="current-password"
+            className="mt-1 w-full rounded-md border border-black/[.1] px-3 py-2 text-sm dark:border-white/[.15] dark:bg-black"
+          />
+        </label>
+        <button
+          type="submit"
+          className="mt-2 rounded-full bg-foreground px-5 py-2 text-sm font-medium text-background transition-colors hover:bg-[#383838] dark:hover:bg-[#ccc]"
+        >
+          Sign in
+        </button>
+      </form>
+
+      <div className="my-6 flex items-center gap-3 text-xs uppercase opacity-50">
+        <span className="h-px flex-1 bg-current" />
+        or
+        <span className="h-px flex-1 bg-current" />
+      </div>
+
+      <form action={loginWithGoogle}>
+        <button
+          type="submit"
+          className="flex w-full items-center justify-center gap-2 rounded-full border border-black/[.1] px-5 py-2 text-sm font-medium transition-colors hover:bg-black/[.04] dark:border-white/[.15] dark:hover:bg-[#1a1a1a]"
+        >
+          Continue with Google
+        </button>
+      </form>
+
+      <p className="mt-6 text-sm opacity-70">
+        No account?{" "}
+        <Link href="/signup" className="font-medium underline">
+          Sign up
+        </Link>
+      </p>
+    </main>
+  );
+}
