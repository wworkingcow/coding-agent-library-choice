+// Internal record — never leaves this module. `passwordHash` is null for
+// accounts that only ever signed in via an OAuth provider (e.g. Google).
+type StoredUser = User & { passwordHash: string | null };
+
+const users: StoredUser[] = [
+  {
+    id: "1",
+    email: "ada@example.com",
+    name: "Ada",
+    createdAt: "2026-01-04",
+    passwordHash: null,
+  },
