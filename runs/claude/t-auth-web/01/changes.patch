+    name: "Grace",
+    createdAt: "2026-02-11",
+    passwordHash: null,
+  },
 ];
 
+let nextId = users.length + 1;
+
+function toPublicUser(stored: StoredUser): User {
+  const { id, email, name, createdAt } = stored;
+  return { id, email, name, createdAt };
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toPublicUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const user = users.find((u) => u.id === id);
+  return user ? toPublicUser(user) : undefined;
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const target = normalizeEmail(email);
+  const user = users.find((u) => u.email === target);
+  return user ? toPublicUser(user) : undefined;
+}
+
+/**
+ * Registers a new email + password account. Used by the sign-up flow.
+ * Throws if the email is already taken (by a password or OAuth account).
+ */
+export async function createUserWithPassword(params: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = normalizeEmail(params.email);
+  if (!email || !params.password) {
+    throw new Error("Email and password are required.");
+  }
+  if (users.some((u) => u.email === email)) {
+    throw new Error("An account with this email already exists.");
+  }
+
+  const passwordHash = await bcrypt.hash(params.password, 10);
+  const user: StoredUser = {
+    id: String(nextId++),
+    email,
+    name: params.name.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return toPublicUser(user);
+}
+
+/**
+ * Validates email + password credentials. Used by the Credentials provider.
+ * Returns null (never throws) on any mismatch so callers can't leak which
+ * part of the check failed.
+ */
+export async function verifyPassword(
+  email: string,
+  password: string
+): Promise<User | null> {
+  const target = normalizeEmail(email);
+  const user = users.find((u) => u.email === target);
+  if (!user || !user.passwordHash || !password) return null;
+
+  const ok = await bcrypt.compare(password, user.passwordHash);
+  return ok ? toPublicUser(user) : null;
 }
 
