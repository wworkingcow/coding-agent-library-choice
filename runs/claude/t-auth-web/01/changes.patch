+/**
+ * Finds an existing account by email or provisions a new one. Used to wire
+ * OAuth sign-ins (Google) into the same user store as password accounts —
+ * signing in with Google using an email that already has a password account
+ * simply logs into that same account.
+ */
+export async function findOrCreateOAuthUser(params: {
+  email: string;
+  name: string;
+}): Promise<User> {
