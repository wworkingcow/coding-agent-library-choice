+// Internal shape — never returned to callers directly. passwordHash is null
+// for accounts that only ever signed in via an OAuth provider (Google).
+type StoredUser = User & {
+  passwordHash: string | null;
+};
+
+const users: StoredUser[] = [
+  {
+    id: "1",
+    email: "ada@example.com",
+    name: "Ada",
+    createdAt: "2026-01-04",
+    passwordHash: null,
+  },
+  {
+    id: "2",
+    email: "grace@example.com",
+    name: "Grace",
+    createdAt: "2026-02-11",
+    passwordHash: null,
+  },
 ];
 
+let nextId = users.length + 1;
+
+function toPublic(u: StoredUser): User {
+  return { id: u.id, email: u.email, name: u.name, createdAt: u.createdAt };
+}
+
+function findByEmail(email: string): StoredUser | undefined {
+  const needle = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === needle);
+}
+
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toPublic);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const u = users.find((u) => u.id === id);
+  return u ? toPublic(u) : undefined;
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const u = findByEmail(email);
+  return u ? toPublic(u) : undefined;
+}
+
+// Email + password sign up. Throws if the email is already taken.
+export async function createUser(params: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  if (findByEmail(params.email)) {
+    throw new Error("An account with this email already exists.");
+  }
+  const passwordHash = await bcrypt.hash(params.password, 10);
+  const user: StoredUser = {
+    id: String(nextId++),
+    email: params.email.trim(),
+    name: params.name.trim() || params.email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return toPublic(user);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+// Email + password sign in. Returns the user on match, null otherwise —
+// deliberately doesn't distinguish "no such user" from "wrong password".
+export async function verifyPassword(
+  email: string,
+  password: string
+): Promise<User | null> {
+  const u = findByEmail(email);
+  if (!u || !u.passwordHash) return null;
+  const ok = await bcrypt.compare(password, u.passwordHash);
+  return ok ? toPublic(u) : null;
+}
+
+// Used on Google sign-in: look up the account by email, or provision a new
+// one with no password (it can only ever sign in via Google).
+export async function findOrCreateOAuthUser(params: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const existing = findByEmail(params.email);
+  if (existing) return toPublic(existing);
+  const user: StoredUser = {
+    id: String(nextId++),
+    email: params.email.trim(),
+    name: params.name.trim() || params.email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: null,
+  };
+  users.push(user);
+  return toPublic(user);
 }
