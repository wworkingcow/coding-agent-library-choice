+import { createAuthClient } from "better-auth/react";
+
+// Browser-side client for the sign-in/sign-up forms — talks to the
+// /api/auth/* routes exposed by src/app/api/auth/[...all]/route.ts.
+// No baseURL needed: it defaults to same-origin, which is correct here.
+export const authClient = createAuthClient();
+
+export const { signIn, signUp, signOut, useSession } = authClient;
