+import Database from "better-sqlite3";
+import fs from "node:fs";
+import path from "node:path";
+
+// Single shared SQLite connection that backs both Better Auth (users,
+// sessions, accounts) and any app-level reads in src/lib/users.ts.
+// File lives outside of source control — see .gitignore.
+const dataDir = path.join(process.cwd(), "data");
+fs.mkdirSync(dataDir, { recursive: true });
+
+const dbPath = path.join(dataDir, "notely.sqlite");
+
+export const db = new Database(dbPath);
+db.pragma("journal_mode = WAL");
