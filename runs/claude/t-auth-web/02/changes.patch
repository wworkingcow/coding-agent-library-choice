+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+
+import { authClient } from "@/lib/auth-client";
+
+export function SignOutButton() {
+  const router = useRouter();
+  const [pending, setPending] = useState(false);
+
+  return (
+    <button
+      type="button"
+      disabled={pending}
+      onClick={async () => {
+        setPending(true);
+        await authClient.signOut({
+          fetchOptions: {
+            onSuccess: () => {
+              router.push("/sign-in");
+              router.refresh();
+            },
+          },
+        });
+        setPending(false);
+      }}
+      className="text-sm font-medium text-zinc-950 underline underline-offset-4 hover:opacity-70 disabled:opacity-50 dark:text-zinc-50"
+    >
+      {pending ? "Signing out…" : "Sign out"}
+    </button>
+  );
+}
