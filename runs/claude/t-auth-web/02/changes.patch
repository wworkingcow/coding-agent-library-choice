+import { redirect } from "next/navigation";
+
+import { getCurrentUser } from "@/lib/users";
+
+// Server-side guard: this is the authoritative check that protects every
+// route under /dashboard. Next.js 16 proxies (app/proxy.ts) run before
+// routing and aren't meant for auth decisions, so the real check lives here,
+// next to the data it protects.
+export default async function DashboardLayout({
+  children,
+}: {
+  children: React.ReactNode;
+}) {
+  const me = await getCurrentUser();
+  if (!me) {
+    redirect("/sign-in?next=/dashboard");
+  }
+
+  return <>{children}</>;
+}
