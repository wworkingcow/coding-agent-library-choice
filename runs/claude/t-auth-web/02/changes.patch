+// Real session handling: reads the Better Auth session cookie for the
+// current request and resolves it to a signed-in user, or undefined.
+// Wrapped in React's cache() so layout + page can both call it per request
+// without hitting the session store twice.
+export const getCurrentUser = cache(async (): Promise<User | undefined> => {
+  const session = await auth.api.getSession({ headers: await headers() });
+  if (!session?.user) return undefined;
+
+  return {
+    id: session.user.id,
+    email: session.user.email,
+    name: session.user.name,
+    createdAt: new Date(session.user.createdAt).toISOString().slice(0, 10),
+  };
+});
