@@ -0,0 +1,26 @@
+import { betterAuth } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+
+import { db } from "@/lib/db";
+
+// Better Auth owns credentials, sessions, and OAuth linking. It reads and
+// writes its "user" table on the same SQLite database that src/lib/users.ts
+// reads from, so a signed-up user is immediately visible to the rest of the
+// app — see src/lib/users.ts for the read side of that wiring.
+export const auth = betterAuth({
+  database: db,
+  secret: process.env.BETTER_AUTH_SECRET,
+  baseURL: process.env.BETTER_AUTH_URL,
+  emailAndPassword: {
+    enabled: true,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID ?? "",
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET ?? "",
+    },
+  },
+  // Lets server actions/route handlers set auth cookies correctly under
+  // the Next.js App Router.
+  plugins: [nextCookies()],
+});
