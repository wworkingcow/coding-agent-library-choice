+# Copy this file to .env.local and fill in real values.
+# .env.local is gitignored — never commit real secrets.
+
+# Session/cookie signing secret for Better Auth. Must be a long random string.
+# Generate one with: openssl rand -base64 32
+BETTER_AUTH_SECRET=replace-with-a-long-random-secret
+
+# Base URL Better Auth uses to build callback/redirect URLs.
+BETTER_AUTH_URL=http://localhost:3000
+
+# Google OAuth client, from https://console.cloud.google.com/apis/credentials
+# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
+GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
+GOOGLE_CLIENT_SECRET=your-google-client-secret
