+import type { DefaultSession } from "next-auth";
+
+// Augment the session's user with the id from src/lib/users.ts, so
+// `session.user.id` is available (and typed) everywhere `auth()` is used.
+declare module "next-auth" {
+  interface Session {
+    user: {
+      id: string;
+    } & DefaultSession["user"];
+  }
+}
