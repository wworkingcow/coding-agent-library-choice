+import bcrypt from "bcryptjs";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  image?: string;
+};
+
+type StoredUser = User & {
+  // Absent for users that only ever signed in via Google.
+  passwordHash?: string;
 };
 
-const users: User[] = [
+const users: StoredUser[] = [
   { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+let nextId = users.length + 1;
+
+function toPublicUser(user: StoredUser): User {
+  const publicUser = { ...user };
+  delete publicUser.passwordHash;
+  return publicUser;
+}
+
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toPublicUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const user = users.find((u) => u.id === id);
+  return user && toPublicUser(user);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const user = users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+  return user && toPublicUser(user);
+}
+
+/**
+ * Creates a new email/password account. Returns undefined if the email is
+ * already taken.
+ */
+export async function createUserWithPassword(params: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User | undefined> {
+  const { email, name, password } = params;
+  if (users.some((u) => u.email.toLowerCase() === email.toLowerCase())) {
+    return undefined;
+  }
+
+  const passwordHash = await bcrypt.hash(password, 10);
+  const user: StoredUser = {
+    id: String(nextId++),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return toPublicUser(user);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+/**
+ * Checks email/password credentials. Returns the user on success, or
+ * undefined if the email is unknown, has no password set (Google-only
+ * account), or the password doesn't match.
+ */
+export async function verifyPassword(
+  email: string,
+  password: string
+): Promise<User | undefined> {
+  const user = users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!user?.passwordHash) return undefined;
+  const valid = await bcrypt.compare(password, user.passwordHash);
+  return valid ? toPublicUser(user) : undefined;
+}
+
+/**
+ * Finds or creates the user for a Google sign-in. Existing email/password
+ * accounts are linked (matched by email) rather than duplicated.
+ */
+export async function upsertGoogleUser(params: {
+  email: string;
+  name: string;
+  image?: string;
+}): Promise<User> {
+  const { email, name, image } = params;
+  const existing = users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+  if (existing) {
+    existing.name = name;
+    existing.image = image ?? existing.image;
+    return toPublicUser(existing);
+  }
+
+  const user: StoredUser = {
+    id: String(nextId++),
+    email,
+    name,
+    image,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return toPublicUser(user);
 }
diff --git a/src/proxy.ts b/src/proxy.ts
