diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..bb02408
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,63 @@
+import NextAuth from "next-auth";
+import Credentials from "next-auth/providers/credentials";
+import Google from "next-auth/providers/google";
+
+import { upsertGoogleUser, verifyPassword } from "@/lib/users";
+
+export const { handlers, signIn, signOut, auth } = NextAuth({
+  session: { strategy: "jwt" },
+  pages: {
+    signIn: "/sign-in",
+  },
+  providers: [
+    Google,
+    Credentials({
+      credentials: {
+        email: { label: "Email", type: "email" },
+        password: { label: "Password", type: "password" },
+      },
+      async authorize(credentials) {
+        const email = credentials?.email;
+        const password = credentials?.password;
+        if (typeof email !== "string" || typeof password !== "string") {
+          return null;
+        }
+        const user = await verifyPassword(email, password);
+        return user ?? null;
+      },
+    }),
+  ],
+  callbacks: {
+    async signIn({ user, account }) {
+      if (account?.provider === "google" && !user.email) return false;
+      return true;
+    },
+    async jwt({ token, user, account }) {
+      // Only runs on fresh sign-in, when `user`/`account` are populated.
+      if (user && account?.provider === "google" && user.email) {
+        // Google users need to be created/linked in our own user store. The
+        // default `sub` here is Google's account id — replace it with our
+        // own user id so `session.user.id` lines up with src/lib/users.ts.
+        const appUser = await upsertGoogleUser({
+          email: user.email,
+          name: user.name ?? user.email,
+          image: user.image ?? undefined,
+        });
+        token.sub = appUser.id;
+        token.name = appUser.name;
+        token.picture = appUser.image;
+      } else if (user) {
+        // Credentials sign-in: authorize() already returned our own user id.
+        token.name = user.name;
+        token.picture = user.image ?? undefined;
+      }
+      return token;
+    },
+    async session({ session, token }) {
+      if (session.user && token.sub) {
+        session.user.id = token.sub;
+      }
+      return session;
+    },
+  },
+});
