+import { betterAuth, type BetterAuthOptions } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+import { getMigrations } from "better-auth/db/migration";
+import Database from "better-sqlite3";
+
+// SQLite file that backs both Better Auth's own tables (user/session/account)
+// and the read-only queries in src/lib/users.ts. Fine for this scaffold;
+// swap `database` for a real Postgres/MySQL connection before shipping.
+export const DB_PATH = process.env.AUTH_DB_PATH ?? "./notely.db";
+
+const authOptions = {
+  database: new Database(DB_PATH),
+  secret: process.env.BETTER_AUTH_SECRET,
+  baseURL: process.env.BETTER_AUTH_URL,
+  emailAndPassword: {
+    enabled: true,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID ?? "",
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET ?? "",
+    },
+  },
+  // Lets Server Actions/Route Handlers set auth cookies directly.
+  plugins: [nextCookies()],
+} satisfies BetterAuthOptions;
+
+// This scaffold has no separate migration step — sync the (idempotent) schema
+// before `betterAuth()` ever constructs its own context, which does its own
+// schema check on first use and would otherwise race a lazily-run migration.
+// For a real deployment, run Better Auth's migrations as a proper build/deploy
+// step instead and drop this.
+const { runMigrations } = await getMigrations(authOptions);
+await runMigrations();
+
+export const auth = betterAuth(authOptions);
