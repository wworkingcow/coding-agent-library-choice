@@ -0,0 +1,8 @@
+// Ensures the SQLite auth schema (user/session/account/verification tables)
+// exists before Next.js starts. Run once, single-process, via the predev/
+// prebuild npm hooks — importing src/lib/auth.ts runs the same migration,
+// but Next's dev server and `next build` both spin up several worker
+// processes that would otherwise race to create the tables concurrently on
+// a fresh checkout. Running it here first means those workers just see an
+// already-current schema and no-op.
+import "../src/lib/auth.ts";
