+++ b/src/lib/db.ts
@@ -0,0 +1,10 @@
+import Database from "better-sqlite3";
+import path from "node:path";
+
+// Single shared SQLite connection for the app. Better Auth owns the
+// user/session/account/verification tables in here (see src/lib/auth.ts);
+// src/lib/users.ts reads the `user` table from the same connection.
+export const db = new Database(
+  process.env.DATABASE_PATH ?? path.join(process.cwd(), "notely.db"),
+);
+db.pragma("journal_mode = WAL");
