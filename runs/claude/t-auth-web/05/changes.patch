+++ b/src/lib/auth.ts
@@ -0,0 +1,24 @@
+import { betterAuth } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+import { db } from "./db";
+
+// Server-side auth instance. Chose Better Auth over Auth.js v5 / Clerk:
+// self-hosted (no vendor lock-in or per-user billing), TypeScript-native,
+// stores users in our own SQLite db, and is the option the ecosystem has
+// converged on for new Next.js apps in 2026 (Auth.js is in maintenance mode).
+export const auth = betterAuth({
+  database: db,
+  secret: process.env.BETTER_AUTH_SECRET,
+  baseURL: process.env.BETTER_AUTH_URL ?? "http://localhost:3000",
+  emailAndPassword: {
+    enabled: true,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID ?? "",
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET ?? "",
+    },
+  },
+  // Lets server actions / route handlers set session cookies directly.
+  plugins: [nextCookies()],
+});
