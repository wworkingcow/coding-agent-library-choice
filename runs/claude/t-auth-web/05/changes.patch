diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..083242b
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,21 @@
+import { NextRequest, NextResponse } from "next/server";
+import { auth } from "@/lib/auth";
+
+// Protects /dashboard. Runs on the Node.js runtime (default for proxy.ts in
+// Next.js 16), so a real DB-backed session check is fine here — no need to
+// fall back to the cookie-only "optimistic" check.
+export default async function proxy(request: NextRequest) {
+  const session = await auth.api.getSession({ headers: request.headers });
+
+  if (!session) {
+    const signInUrl = new URL("/sign-in", request.url);
+    signInUrl.searchParams.set("callbackURL", request.nextUrl.pathname);
+    return NextResponse.redirect(signInUrl);
+  }
+
+  return NextResponse.next();
+}
+
+export const config = {
+  matcher: ["/dashboard"],
+};
