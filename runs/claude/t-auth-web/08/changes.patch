+import path from "node:path";
+import Database from "better-sqlite3";
+import { betterAuth } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+
+// Local file-backed SQLite DB. Better Auth owns the schema (users, sessions,
+// accounts, verification tokens) and creates/migrates it on first run via
+// `npx @better-auth/cli migrate`. Exported so src/lib/users.ts can read the
+// "user" table directly for plain (non-admin) listing/lookup.
+export const db = new Database(path.join(process.cwd(), "data", "notely.db"));
+
+export const auth = betterAuth({
+  database: db,
+  secret: process.env.BETTER_AUTH_SECRET,
+  baseURL: process.env.BETTER_AUTH_URL ?? "http://localhost:3000",
+  emailAndPassword: {
+    enabled: true,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID ?? "",
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET ?? "",
+    },
+  },
+  // Lets server actions/components set auth cookies directly.
+  plugins: [nextCookies()],
+});
