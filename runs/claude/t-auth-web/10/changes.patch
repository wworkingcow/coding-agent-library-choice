@@ -0,0 +1,33 @@
+import path from "node:path";
+import { betterAuth } from "better-auth";
+import Database from "better-sqlite3";
+
+// SQLite file next to the project root. Swap `database: db` for a hosted
+// Postgres/MySQL adapter before shipping to production; nothing else here
+// needs to change, since src/lib/users.ts only talks to Better Auth's API,
+// not to this database directly.
+export const db = new Database(path.join(process.cwd(), "notely.db"));
+
+const googleClientId = process.env.GOOGLE_CLIENT_ID;
+const googleClientSecret = process.env.GOOGLE_CLIENT_SECRET;
+
+export const auth = betterAuth({
+  database: db,
+  baseURL: process.env.BETTER_AUTH_URL,
+  secret: process.env.BETTER_AUTH_SECRET,
+  emailAndPassword: {
+    enabled: true,
+  },
+  // Only registered when both env vars are set, so the placeholder values in
+  // .env.example don't break email/password auth for anyone who hasn't
+  // configured a real Google OAuth client yet.
+  socialProviders:
+    googleClientId && googleClientSecret
+      ? {
+          google: {
+            clientId: googleClientId,
+            clientSecret: googleClientSecret,
+          },
+        }
+      : undefined,
+});
