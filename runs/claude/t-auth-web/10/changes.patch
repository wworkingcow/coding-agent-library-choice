+# Copy this file to .env.local and fill in real values for local dev.
+
+# Random 32+ char secret used to sign sessions/cookies.
+# Generate one with: openssl rand -base64 32
+BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
+
+# Base URL Better Auth is served from.
+BETTER_AUTH_URL=http://localhost:3000
+
+# Google OAuth client, from https://console.cloud.google.com/apis/credentials
+# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
+# Google sign-in is disabled automatically until both of these are set.
+GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
+GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
