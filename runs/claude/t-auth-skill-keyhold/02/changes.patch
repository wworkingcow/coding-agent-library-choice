-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+// Creates an email+password account. Throws if the email is already taken.
+export async function createUser(params: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = params.email.toLowerCase();
+  if (users.some((u) => u.email.toLowerCase() === email)) {
+    throw new Error("An account with this email already exists");
+  }
+  const passwordHash = await bcrypt.hash(params.password, 10);
+  const user: StoredUser = {
+    id: String(nextId++),
+    email,
+    name: params.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return toPublicUser(user);
+}
+
+// Verifies email+password credentials. Returns null on any mismatch,
+// including accounts that only have Google sign-in (no passwordHash).
+export async function verifyPassword(
+  email: string,
+  password: string
+): Promise<User | null> {
+  const user = users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!user || !user.passwordHash) return null;
+  const valid = await bcrypt.compare(password, user.passwordHash);
+  return valid ? toPublicUser(user) : null;
+}
+
+// Finds or creates the user record for an OAuth (Google) sign-in.
+export async function upsertOAuthUser(params: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const email = params.email.toLowerCase();
+  const existing = users.find((u) => u.email.toLowerCase() === email);
+  if (existing) return toPublicUser(existing);
+  const user: StoredUser = {
+    id: String(nextId++),
+    email,
+    name: params.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: null,
+  };
+  users.push(user);
+  return toPublicUser(user);
 }
