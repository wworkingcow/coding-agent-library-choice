+import NextAuth from "next-auth";
+import { authConfig } from "@/auth.config";
+
+// A separate, edge-safe NextAuth instance (no Credentials/bcrypt) just for
+// route protection. Next.js 16 renamed the "middleware" file convention to
+// "proxy" — this runs at the same point in the request lifecycle.
+const { auth } = NextAuth(authConfig);
+
+export default auth;
+
+export const config = {
+  matcher: ["/dashboard/:path*"],
+};
