@@ -0,0 +1,45 @@
+import NextAuth from "next-auth";
+import Credentials from "next-auth/providers/credentials";
+import { authConfig } from "@/auth.config";
+import { getOrCreateOAuthUser, verifyPassword } from "@/lib/users";
+
+export const { handlers, auth, signIn, signOut } = NextAuth({
+  ...authConfig,
+  session: { strategy: "jwt" },
+  providers: [
+    ...authConfig.providers,
+    Credentials({
+      credentials: {
+        email: { label: "Email", type: "email" },
+        password: { label: "Password", type: "password" },
+      },
+      authorize: async (credentials) => {
+        const email = typeof credentials?.email === "string" ? credentials.email : undefined;
+        const password =
+          typeof credentials?.password === "string" ? credentials.password : undefined;
+        if (!email || !password) return null;
+
+        const user = await verifyPassword(email, password);
+        if (!user) return null;
+
+        return { id: user.id, email: user.email, name: user.name };
+      },
+    }),
+  ],
+  callbacks: {
+    ...authConfig.callbacks,
+    async signIn({ user, account }) {
+      // Credentials users are already validated in authorize(). Google users
+      // get linked to (or created in) our own user store here, keyed by email.
+      if (account?.provider === "google") {
+        if (!user.email) return false;
+        const dbUser = await getOrCreateOAuthUser({
+          email: user.email,
+          name: user.name ?? user.email,
+        });
+        user.id = dbUser.id;
+      }
+      return true;
+    },
+  },
+});
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..efb024c 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,10 +1,16 @@
+import bcrypt from "bcryptjs";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  /** Hashed password. Absent for users who only ever signed in via Google. */
+  passwordHash?: string;
 };
 
+let nextId = 3;
+
 const users: User[] = [
   { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
@@ -18,7 +24,58 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  return users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+}
+
+/** Creates a new user with an email/password credential. Throws if the email is taken. */
+export async function createUser(params: {
+  email: string;
+  password: string;
+  name: string;
+}): Promise<User> {
+  const existing = await getUserByEmail(params.email);
+  if (existing) {
+    throw new Error("A user with this email already exists.");
+  }
+
+  const passwordHash = await bcrypt.hash(params.password, 10);
+  const user: User = {
+    id: String(nextId++),
+    email: params.email,
+    name: params.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return user;
+}
+
+/** Verifies email/password credentials, returning the user on success. */
+export async function verifyPassword(
+  email: string,
+  password: string
+): Promise<User | undefined> {
+  const user = await getUserByEmail(email);
+  if (!user?.passwordHash) return undefined;
+  const valid = await bcrypt.compare(password, user.passwordHash);
+  return valid ? user : undefined;
+}
+
+/** Finds an existing user for this email (e.g. from an OAuth provider) or creates one. */
+export async function getOrCreateOAuthUser(params: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const existing = await getUserByEmail(params.email);
+  if (existing) return existing;
+
+  const user: User = {
+    id: String(nextId++),
+    email: params.email,
+    name: params.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return user;
 }
