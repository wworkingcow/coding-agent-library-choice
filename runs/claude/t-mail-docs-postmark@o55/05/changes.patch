+import "server-only";
+import { createHash, randomBytes, randomUUID, timingSafeEqual } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email/send";
+
 export type User = {
   id: string;
   email: string;
@@ -10,6 +14,20 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+const RESET_TOKEN_TTL_MINUTES = 60;
+
+// Only a hash of each reset token is kept, so a leaked store can't be used to reset passwords.
+type PasswordResetToken = { userId: string; tokenHash: Buffer; expiresAt: number };
+const passwordResetTokens: PasswordResetToken[] = [];
+
+function hashToken(token: string): Buffer {
+  return createHash("sha256").update(token).digest();
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +36,79 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (await getUserByEmail(email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // The account exists whether or not the email goes out; a failed send must not fail sign-up.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error(`Failed to send welcome email to user ${user.id}:`, err);
+  }
+
+  return user;
+}
+
+/**
+ * Starts a password reset. Resolves the same way whether or not the email belongs to a user,
+ * so callers can't use it to find out which addresses have accounts.
+ */
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // One live token per user: a new request invalidates older links.
+  for (let i = passwordResetTokens.length - 1; i >= 0; i--) {
+    if (passwordResetTokens[i].userId === user.id) passwordResetTokens.splice(i, 1);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  passwordResetTokens.push({
+    userId: user.id,
+    tokenHash: hashToken(token),
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  try {
+    await sendPasswordResetEmail(user, token, RESET_TOKEN_TTL_MINUTES);
+  } catch (err) {
+    console.error(`Failed to send password reset email to user ${user.id}:`, err);
+  }
+}
+
+/**
+ * Validates and consumes a reset token. Returns the user it was issued for, or undefined if the
+ * token is unknown or expired. Each token works once.
+ */
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const now = Date.now();
+  const index = passwordResetTokens.findIndex(
+    (t) => t.expiresAt > now && timingSafeEqual(t.tokenHash, hash),
+  );
+  if (index === -1) return undefined;
+
+  const [entry] = passwordResetTokens.splice(index, 1);
+  return getUser(entry.userId);
+}
