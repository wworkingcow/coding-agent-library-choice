new file mode 100644
index 0000000..762f565
--- /dev/null
+++ b/src/lib/email/postmark.ts
@@ -0,0 +1,19 @@
+import "server-only";
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so importing this module never throws when the token is missing
+// (e.g. during `next build` or in local dev without email configured).
+export function getPostmark(): ServerClient {
+  const token = process.env.POSTMARK_SERVER_TOKEN;
+  if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+  client ??= new ServerClient(token);
+  return client;
+}
+
+export function fromAddress(): string {
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!from) throw new Error("POSTMARK_FROM_EMAIL is not set");
+  return from;
+}
diff --git a/src/lib/email/send.ts b/src/lib/email/send.ts
new file mode 100644
index 0000000..f7d619e
--- /dev/null
+++ b/src/lib/email/send.ts
@@ -0,0 +1,84 @@
+import "server-only";
+import { fromAddress, getPostmark } from "./postmark";
+
+const TRANSACTIONAL_STREAM = process.env.POSTMARK_MESSAGE_STREAM ?? "outbound";
+
+function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  tag: string;
+};
+
+async function send(email: Email): Promise<void> {
+  await getPostmark().sendEmail({
+    From: fromAddress(),
+    To: email.to,
+    Subject: email.subject,
+    HtmlBody: email.html,
+    TextBody: email.text,
+    Tag: email.tag,
+    MessageStream: TRANSACTIONAL_STREAM,
+  });
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const name = escapeHtml(user.name);
+  const dashboard = appUrl("/dashboard");
+  await send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    tag: "welcome",
+    html: `<p>Hi ${name},</p>
+<p>Welcome to Notely! Your account is ready.</p>
+<p><a href="${dashboard}">Open your dashboard</a></p>
+<p>— The Notely team</p>`,
+    text: `Hi ${user.name},
+
+Welcome to Notely! Your account is ready.
+
+Open your dashboard: ${dashboard}
+
+— The Notely team`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const name = escapeHtml(user.name);
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+  await send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    tag: "password-reset",
+    html: `<p>Hi ${name},</p>
+<p>Someone asked to reset the password for your Notely account. If that was you, use the link below. It expires in ${expiresInMinutes} minutes.</p>
+<p><a href="${resetUrl}">Reset password</a></p>
+<p>If you didn't ask for this, you can ignore this email — your password won't change.</p>`,
+    text: `Hi ${user.name},
+
+Someone asked to reset the password for your Notely account. If that was you, open the link below. It expires in ${expiresInMinutes} minutes.
+
+${resetUrl}
+
+If you didn't ask for this, you can ignore this email — your password won't change.`,
+  });
+}
