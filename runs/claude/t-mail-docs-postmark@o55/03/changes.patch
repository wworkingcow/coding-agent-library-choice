new file mode 100644
index 0000000..06920d8
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,85 @@
+import "server-only";
+import { getPostmark } from "@/lib/postmark";
+
+const MESSAGE_STREAM = "outbound";
+
+type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  tag: string;
+};
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+async function send({ to, subject, html, text, tag }: Email): Promise<void> {
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!from) throw new Error("POSTMARK_FROM_EMAIL is not set");
+
+  await getPostmark().sendEmail({
+    From: from,
+    To: to,
+    Subject: subject,
+    HtmlBody: html,
+    TextBody: text,
+    Tag: tag,
+    MessageStream: MESSAGE_STREAM,
+  });
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const url = `${appUrl()}/dashboard`;
+  const name = escapeHtml(user.name);
+
+  await send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    tag: "welcome",
+    html: `<p>Hi ${name},</p>
+<p>Welcome to Notely! Your account is ready.</p>
+<p><a href="${url}">Open your dashboard</a></p>`,
+    text: `Hi ${user.name},
+
+Welcome to Notely! Your account is ready.
+
+Open your dashboard: ${url}`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  const name = escapeHtml(user.name);
+
+  await send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    tag: "password-reset",
+    html: `<p>Hi ${name},</p>
+<p>We received a request to reset your Notely password.</p>
+<p><a href="${url}">Reset your password</a></p>
+<p>This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email.</p>`,
+    text: `Hi ${user.name},
+
+We received a request to reset your Notely password.
+
+Reset your password: ${url}
+
+This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email.`,
+  });
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..ea0b496
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,14 @@
+import "server-only";
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so a missing token fails at send time, not at import/build time.
+export function getPostmark(): ServerClient {
+  if (!client) {
+    const token = process.env.POSTMARK_SERVER_TOKEN;
+    if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+    client = new ServerClient(token);
+  }
+  return client;
+}
