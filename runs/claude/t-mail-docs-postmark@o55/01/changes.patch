@@ -0,0 +1,89 @@
+import "server-only";
+import { getPostmark } from "@/lib/postmark";
+
+const MESSAGE_STREAM = "outbound";
+
+function fromAddress(): string {
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!from) throw new Error("POSTMARK_FROM_EMAIL is not set");
+  return from;
+}
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+type Email = { to: string; subject: string; html: string; text: string; tag: string };
+
+// Email is a side effect: log failures instead of failing the request that triggered it.
+async function send({ to, subject, html, text, tag }: Email): Promise<boolean> {
+  try {
+    await getPostmark().sendEmail({
+      From: fromAddress(),
+      To: to,
+      Subject: subject,
+      HtmlBody: html,
+      TextBody: text,
+      Tag: tag,
+      MessageStream: MESSAGE_STREAM,
+    });
+    return true;
+  } catch (err) {
+    console.error(`[email] failed to send "${tag}" to ${to}:`, err);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }): Promise<boolean> {
+  const name = escapeHtml(user.name);
+  const dashboardUrl = `${appUrl()}/dashboard`;
+  return send({
+    to: user.email,
+    tag: "welcome",
+    subject: "Welcome to Notely",
+    html: `<p>Hi ${name},</p>
+<p>Welcome to Notely! Your account is ready.</p>
+<p><a href="${escapeHtml(dashboardUrl)}">Open your dashboard</a></p>
+<p>— The Notely team</p>`,
+    text: `Hi ${user.name},
+
+Welcome to Notely! Your account is ready.
+
+Open your dashboard: ${dashboardUrl}
+
+— The Notely team`,
+  });
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+  expiresInMinutes: number,
+): Promise<boolean> {
+  const name = escapeHtml(user.name);
+  return send({
+    to: user.email,
+    tag: "password-reset",
+    subject: "Reset your Notely password",
+    html: `<p>Hi ${name},</p>
+<p>We received a request to reset your Notely password. This link expires in ${expiresInMinutes} minutes.</p>
+<p><a href="${escapeHtml(resetUrl)}">Reset your password</a></p>
+<p>If you didn't ask for this, you can ignore this email — your password won't change.</p>`,
+    text: `Hi ${user.name},
+
+We received a request to reset your Notely password. This link expires in ${expiresInMinutes} minutes.
+
+Reset your password: ${resetUrl}
+
+If you didn't ask for this, you can ignore this email — your password won't change.`,
+  });
+}
+
+export function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/+$/, "");
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..e04a801
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,14 @@
+import "server-only";
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so `next build` and pages that never send email work without a token.
+export function getPostmark(): ServerClient {
+  if (!client) {
+    const token = process.env.POSTMARK_SERVER_TOKEN;
+    if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+    client = new ServerClient(token);
+  }
+  return client;
+}
