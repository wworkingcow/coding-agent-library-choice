@@ -1,3 +1,10 @@
+import "server-only";
+import { createHash, randomBytes, randomUUID, scrypt, timingSafeEqual } from "node:crypto";
+import { promisify } from "node:util";
+import { appUrl, sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
+const scryptAsync = promisify(scrypt) as (password: string, salt: Buffer, keylen: number) => Promise<Buffer>;
+
 export type User = {
   id: string;
   email: string;
@@ -10,6 +17,13 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+// Kept apart from User so password data never leaks through listUsers/getUser.
+const passwordHashes = new Map<string, string>(); // userId -> "salt:hash" (hex)
+
+const RESET_TOKEN_TTL_MINUTES = 60;
+// Keyed by sha256(token) so a leaked store can't be used to reset passwords.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +32,87 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string; password?: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  const name = input.name.trim();
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error("Invalid email address");
+  if (!name) throw new Error("Name is required");
+  if (await getUserByEmail(email)) throw new Error("A user with this email already exists");
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  if (input.password) await setPassword(user.id, input.password);
+
+  // Never throws: a failed welcome email must not fail sign-up.
+  await sendWelcomeEmail(user);
+  return user;
+}
+
+// Always resolves the same way whether or not the email exists, so callers can't enumerate accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  for (const [key, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(key);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await sendPasswordResetEmail(user, resetUrl, RESET_TOKEN_TTL_MINUTES);
+}
+
+export async function resetPassword(token: string, newPassword: string): Promise<boolean> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  if (!entry) return false;
+  resetTokens.delete(key); // single use
+  if (entry.expiresAt < Date.now()) return false;
+
+  await setPassword(entry.userId, newPassword);
+  return true;
+}
+
+export async function verifyPassword(userId: string, password: string): Promise<boolean> {
+  const stored = passwordHashes.get(userId);
+  if (!stored) return false;
+  const [saltHex, hashHex] = stored.split(":");
+  const expected = Buffer.from(hashHex, "hex");
+  const actual = await scryptAsync(password, Buffer.from(saltHex, "hex"), expected.length);
+  return timingSafeEqual(actual, expected);
+}
+
+async function setPassword(userId: string, password: string): Promise<void> {
+  if (password.length < 8) throw new Error("Password must be at least 8 characters");
+  const salt = randomBytes(16);
+  const hash = await scryptAsync(password, salt, 64);
+  passwordHashes.set(userId, `${salt.toString("hex")}:${hash.toString("hex")}`);
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
