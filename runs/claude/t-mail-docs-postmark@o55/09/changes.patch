diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..8940be8
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,78 @@
+import "server-only";
+import { Errors } from "postmark";
+import { getPostmark } from "@/lib/postmark";
+
+type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  tag: string;
+};
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+// Never throws: a failed email must not break the request that triggered it.
+async function send({ to, subject, html, text, tag }: Email): Promise<boolean> {
+  try {
+    await getPostmark().sendEmail({
+      From: process.env.POSTMARK_FROM_EMAIL!,
+      To: to,
+      Subject: subject,
+      HtmlBody: html,
+      TextBody: text,
+      Tag: tag,
+      MessageStream: "outbound",
+    });
+    return true;
+  } catch (err) {
+    const detail =
+      err instanceof Errors.PostmarkError ? `${err.name} (code ${err.code}): ${err.message}` : err;
+    console.error(`[email] failed to send "${tag}" email to ${to}:`, detail);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }): Promise<boolean> {
+  const name = escapeHtml(user.name);
+  const url = `${appUrl()}/dashboard`;
+  return send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    tag: "welcome",
+    html: `<p>Hi ${name},</p>
+<p>Thanks for signing up for Notely. Your account is ready.</p>
+<p><a href="${url}">Open your dashboard</a></p>`,
+    text: `Hi ${user.name},\n\nThanks for signing up for Notely. Your account is ready.\n\nOpen your dashboard: ${url}\n`,
+  });
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<boolean> {
+  const name = escapeHtml(user.name);
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    tag: "password-reset",
+    html: `<p>Hi ${name},</p>
+<p>We received a request to reset your Notely password.</p>
+<p><a href="${url}">Reset your password</a></p>
+<p>This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email.</p>`,
+    text: `Hi ${user.name},\n\nWe received a request to reset your Notely password.\n\nReset your password: ${url}\n\nThis link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email.\n`,
+  });
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..9f823d9
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,15 @@
+import "server-only";
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so a missing token fails at send time (and is caught there)
+// instead of crashing every module that imports users.ts.
+export function getPostmark(): ServerClient {
+  if (!client) {
+    const token = process.env.POSTMARK_SERVER_TOKEN;
+    if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+    client = new ServerClient(token);
+  }
+  return client;
+}
