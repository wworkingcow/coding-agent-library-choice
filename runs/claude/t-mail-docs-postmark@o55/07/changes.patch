+import "server-only";
+import { createHash, randomBytes, randomUUID, scrypt, timingSafeEqual } from "node:crypto";
+import { promisify } from "node:util";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
+const scryptAsync = promisify(scrypt) as (password: string, salt: string, keylen: number) => Promise<Buffer>;
+
 export type User = {
   id: string;
   email: string;
@@ -10,6 +17,13 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+// In-memory like the users list. Password hashes are kept off the User type so they never reach the UI.
+const passwordHashes = new Map<string, string>();
+
+const RESET_TOKEN_TTL_MINUTES = 60;
+// Keyed by the SHA-256 of the token; the raw token only ever exists in the email.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +32,87 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email === normalized);
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // A failed welcome email must not fail the signup.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (error) {
+    console.error(`Failed to send welcome email to user ${user.id}`, error);
+  }
+
+  return user;
+}
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+// Always resolves the same way whether or not the email exists, so callers can't use it to probe accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  for (const [key, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(key);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  try {
+    await sendPasswordResetEmail(user, token, RESET_TOKEN_TTL_MINUTES);
+  } catch (error) {
+    console.error(`Failed to send password reset email to user ${user.id}`, error);
+  }
+}
+
+// Returns false for unknown, expired or already-used tokens.
+export async function resetPassword(token: string, newPassword: string): Promise<boolean> {
+  if (newPassword.length < 8) throw new Error("Password must be at least 8 characters");
+
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  if (!entry) return false;
+  resetTokens.delete(key);
+  if (entry.expiresAt < Date.now()) return false;
+
+  const salt = randomBytes(16).toString("hex");
+  const hash = await scryptAsync(newPassword, salt, 64);
+  passwordHashes.set(entry.userId, `${salt}:${hash.toString("hex")}`);
+  return true;
+}
+
+export async function verifyPassword(userId: string, password: string): Promise<boolean> {
+  const stored = passwordHashes.get(userId);
+  if (!stored) return false;
+  const [salt, hashHex] = stored.split(":");
+  const expected = Buffer.from(hashHex, "hex");
+  const actual = await scryptAsync(password, salt, expected.length);
+  return timingSafeEqual(expected, actual);
+}
