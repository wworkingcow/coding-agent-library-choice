new file mode 100644
index 0000000..2020fae
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,87 @@
+import "server-only";
+import { getPostmark } from "@/lib/postmark";
+
+type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  tag: string;
+};
+
+async function send({ to, subject, html, text, tag }: Email): Promise<void> {
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!from) throw new Error("POSTMARK_FROM_EMAIL is not set");
+
+  await getPostmark().sendEmail({
+    From: from,
+    To: to,
+    Subject: subject,
+    HtmlBody: html,
+    TextBody: text,
+    Tag: tag,
+    MessageStream: process.env.POSTMARK_MESSAGE_STREAM ?? "outbound",
+  });
+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+export function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const name = escapeHtml(user.name);
+  const dashboardUrl = appUrl("/dashboard");
+
+  await send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    tag: "welcome",
+    html: `<p>Hi ${name},</p>
+<p>Thanks for signing up for Notely. Your account is ready.</p>
+<p><a href="${dashboardUrl}">Open your dashboard</a></p>
+<p>— The Notely team</p>`,
+    text: `Hi ${user.name},
+
+Thanks for signing up for Notely. Your account is ready.
+
+Open your dashboard: ${dashboardUrl}
+
+— The Notely team`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const name = escapeHtml(user.name);
+  const href = escapeHtml(resetUrl);
+
+  await send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    tag: "password-reset",
+    html: `<p>Hi ${name},</p>
+<p>We received a request to reset your Notely password. This link expires in ${expiresInMinutes} minutes.</p>
+<p><a href="${href}">Reset your password</a></p>
+<p>If you didn't request this, you can ignore this email — your password won't change.</p>`,
+    text: `Hi ${user.name},
+
+We received a request to reset your Notely password. This link expires in ${expiresInMinutes} minutes.
+
+Reset your password: ${resetUrl}
+
+If you didn't request this, you can ignore this email — your password won't change.`,
+  });
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..0fe1c18
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,14 @@
+import "server-only";
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so builds and tests don't need the token present.
+export function getPostmark(): ServerClient {
+  if (!client) {
+    const token = process.env.POSTMARK_SERVER_TOKEN;
+    if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+    client = new ServerClient(token);
+  }
+  return client;
+}
