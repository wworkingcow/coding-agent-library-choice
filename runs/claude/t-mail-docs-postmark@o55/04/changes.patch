new file mode 100644
index 0000000..a265565
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,86 @@
+import "server-only";
+import { getPostmark } from "@/lib/postmark";
+
+type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  tag: string;
+};
+
+const APP_NAME = "Notely";
+
+function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+async function send(email: Email): Promise<void> {
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!from) throw new Error("POSTMARK_FROM_EMAIL is not set");
+
+  await getPostmark().sendEmail({
+    From: `${APP_NAME} <${from}>`,
+    To: email.to,
+    Subject: email.subject,
+    HtmlBody: email.html,
+    TextBody: email.text,
+    Tag: email.tag,
+    MessageStream: "outbound",
+  });
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const name = escapeHtml(user.name);
+  const dashboardUrl = appUrl("/dashboard");
+
+  await send({
+    to: user.email,
+    subject: `Welcome to ${APP_NAME}`,
+    tag: "welcome",
+    html: `<p>Hi ${name},</p>
+<p>Thanks for signing up for ${APP_NAME}. Your account is ready.</p>
+<p><a href="${dashboardUrl}">Open your dashboard</a></p>`,
+    text: `Hi ${user.name},
+
+Thanks for signing up for ${APP_NAME}. Your account is ready.
+
+Open your dashboard: ${dashboardUrl}`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const name = escapeHtml(user.name);
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+
+  await send({
+    to: user.email,
+    subject: `Reset your ${APP_NAME} password`,
+    tag: "password-reset",
+    html: `<p>Hi ${name},</p>
+<p>We received a request to reset your ${APP_NAME} password.</p>
+<p><a href="${resetUrl}">Choose a new password</a></p>
+<p>This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email.</p>`,
+    text: `Hi ${user.name},
+
+We received a request to reset your ${APP_NAME} password.
+
+Choose a new password: ${resetUrl}
+
+This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email.`,
+  });
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..f845260
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,15 @@
+import "server-only";
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so importing this module never fails when the token is missing
+// (e.g. during `next build`); the error surfaces on the first send instead.
+export function getPostmark(): ServerClient {
+  if (!client) {
+    const token = process.env.POSTMARK_SERVER_TOKEN;
+    if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+    client = new ServerClient(token);
+  }
+  return client;
+}
