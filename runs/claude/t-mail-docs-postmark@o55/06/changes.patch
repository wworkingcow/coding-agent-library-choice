new file mode 100644
index 0000000..6372b7c
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,90 @@
+import "server-only";
+import { getPostmark } from "@/lib/postmark";
+
+type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  tag: string;
+};
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
+
+async function send(email: Email): Promise<void> {
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!from) throw new Error("POSTMARK_FROM_EMAIL is not set");
+
+  await getPostmark().sendEmail({
+    From: from,
+    To: email.to,
+    Subject: email.subject,
+    HtmlBody: email.html,
+    TextBody: email.text,
+    Tag: email.tag,
+    MessageStream: "outbound",
+  });
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const name = escapeHtml(user.name);
+  const dashboardUrl = appUrl("/dashboard");
+
+  await send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    tag: "welcome",
+    html: `<p>Hi ${name},</p>
+<p>Thanks for signing up for Notely. Your account is ready.</p>
+<p><a href="${dashboardUrl}">Open your dashboard</a></p>
+<p>— The Notely team</p>`,
+    text: `Hi ${user.name},
+
+Thanks for signing up for Notely. Your account is ready.
+
+Open your dashboard: ${dashboardUrl}
+
+— The Notely team`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const name = escapeHtml(user.name);
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+
+  await send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    tag: "password-reset",
+    html: `<p>Hi ${name},</p>
+<p>We received a request to reset your Notely password.</p>
+<p><a href="${resetUrl}">Choose a new password</a></p>
+<p>This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email.</p>
+<p>— The Notely team</p>`,
+    text: `Hi ${user.name},
+
+We received a request to reset your Notely password.
+
+Choose a new password: ${resetUrl}
+
+This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email.
+
+— The Notely team`,
+  });
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..bd97eda
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,14 @@
+import "server-only";
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so a missing token fails when an email is sent, not when the module is imported.
+export function getPostmark(): ServerClient {
+  if (!client) {
+    const token = process.env.POSTMARK_SERVER_TOKEN;
+    if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+    client = new ServerClient(token);
+  }
+  return client;
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..de856ed 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,7 @@
+import "server-only";
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +26,70 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // A failed welcome email must not fail signup.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error(`Failed to send welcome email to user ${user.id}`, err);
+  }
+
+  return user;
+}
+
+const RESET_TOKEN_TTL_MINUTES = 60;
+
+// Keyed by SHA-256 of the token, so the raw token only ever exists in the email.
+const passwordResetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+// Resolves the same way whether or not the email exists, so callers can't use it to probe accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === email.trim().toLowerCase());
+  if (!user) return;
+
+  for (const [hash, entry] of passwordResetTokens) {
+    if (entry.userId === user.id) passwordResetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  passwordResetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  try {
+    await sendPasswordResetEmail(user, token, RESET_TOKEN_TTL_MINUTES);
+  } catch (err) {
+    console.error(`Failed to send password reset email to user ${user.id}`, err);
+  }
+}
+
+// Single use: a valid token is consumed. Returns the user the reset is for.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = passwordResetTokens.get(hash);
+  if (!entry) return undefined;
+
+  passwordResetTokens.delete(hash);
+  if (entry.expiresAt < Date.now()) return undefined;
+
+  return getUser(entry.userId);
+}
