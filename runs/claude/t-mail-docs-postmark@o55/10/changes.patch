@@ -0,0 +1,71 @@
+export type EmailContent = { subject: string; html: string; text: string };
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+function layout(body: string): string {
+  return `<!doctype html>
+<html>
+  <body style="margin:0;padding:24px;background:#f6f6f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#111;">
+    <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:8px;padding:32px;">
+      ${body}
+      <p style="margin-top:32px;font-size:12px;color:#888;">Notely</p>
+    </div>
+  </body>
+</html>`;
+}
+
+function button(href: string, label: string): string {
+  return `<p><a href="${escapeHtml(href)}" style="display:inline-block;padding:12px 20px;background:#111;color:#fff;text-decoration:none;border-radius:6px;">${escapeHtml(label)}</a></p>`;
+}
+
+export function welcomeEmail({ name, dashboardUrl }: { name: string; dashboardUrl: string }): EmailContent {
+  return {
+    subject: "Welcome to Notely",
+    html: layout(`
+      <h1 style="font-size:20px;">Welcome to Notely, ${escapeHtml(name)}!</h1>
+      <p>Your account is ready. Jump in and write your first note.</p>
+      ${button(dashboardUrl, "Open Notely")}
+    `),
+    text: `Welcome to Notely, ${name}!
+
+Your account is ready. Jump in and write your first note:
+${dashboardUrl}
+
+— Notely`,
+  };
+}
+
+export function passwordResetEmail({
+  name,
+  resetUrl,
+  expiresInMinutes,
+}: {
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}): EmailContent {
+  return {
+    subject: "Reset your Notely password",
+    html: layout(`
+      <h1 style="font-size:20px;">Reset your password</h1>
+      <p>Hi ${escapeHtml(name)}, we received a request to reset your Notely password.</p>
+      ${button(resetUrl, "Choose a new password")}
+      <p style="font-size:14px;color:#555;">This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email — your password won't change.</p>
+    `),
+    text: `Hi ${name},
+
+We received a request to reset your Notely password. Choose a new one here:
+${resetUrl}
+
+This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email — your password won't change.
+
+— Notely`,
+  };
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..ddc4bbd
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,14 @@
+import "server-only";
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so `next build` works without the token set.
+export function getPostmark(): ServerClient {
+  if (!client) {
+    const token = process.env.POSTMARK_SERVER_TOKEN;
+    if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+    client = new ServerClient(token);
+  }
+  return client;
+}
