-const users: User[] = [
+type StoredUser = User & { passwordHash?: string };
+
+const users: StoredUser[] = [
   { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+// Keyed by SHA-256 of the token so a leaked store doesn't leak usable links.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+const RESET_TOKEN_TTL_MINUTES = 60;
+
+function toPublic({ id, email, name, createdAt }: StoredUser): User {
+  return { id, email, name, createdAt };
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+async function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(16).toString("hex");
+  const key = await scryptAsync(password, salt, 64);
+  return `${salt}:${key.toString("hex")}`;
+}
+
+export async function verifyPassword(user: User, password: string): Promise<boolean> {
+  const stored = users.find((u) => u.id === user.id)?.passwordHash;
+  if (!stored) return false;
+  const [salt, keyHex] = stored.split(":");
+  const key = await scryptAsync(password, salt, 64);
+  return timingSafeEqual(key, Buffer.from(keyHex, "hex"));
+}
+
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toPublic);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const user = users.find((u) => u.id === id);
+  return user && toPublic(user);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  const user = users.find((u) => u.email === normalized);
+  return user && toPublic(user);
 }
 
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  return users[0] && toPublic(users[0]);
+}
+
+export async function createUser(input: { email: string; name: string; password?: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (users.some((u) => u.email === email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: StoredUser = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: input.password ? await hashPassword(input.password) : undefined,
+  };
+  users.push(user);
+
+  // Failures are logged inside the email module; signup still succeeds.
+  await sendWelcomeEmail(user);
+
+  return toPublic(user);
+}
+
+// Always resolves the same way whether or not the email exists, so callers
+// can't use it to discover which addresses have accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === normalizeEmail(email));
+  if (!user) return;
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  await sendPasswordResetEmail(user, token, RESET_TOKEN_TTL_MINUTES);
+}
+
+// Returns the user whose password was changed, or undefined if the token is
+// invalid or expired. Tokens are single-use.
+export async function resetPassword(token: string, newPassword: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  if (!entry) return undefined;
+  resetTokens.delete(key);
+  if (entry.expiresAt < Date.now()) return undefined;
+
+  const user = users.find((u) => u.id === entry.userId);
+  if (!user) return undefined;
+
+  user.passwordHash = await hashPassword(newPassword);
+  // Invalidate any other outstanding links for this user.
+  for (const [k, v] of resetTokens) {
+    if (v.userId === user.id) resetTokens.delete(k);
+  }
+  return toPublic(user);
 }
