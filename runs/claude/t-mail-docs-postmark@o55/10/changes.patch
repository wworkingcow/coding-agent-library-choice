@@ -0,0 +1,61 @@
+import "server-only";
+import { Errors } from "postmark";
+import { getPostmark } from "@/lib/postmark";
+import { passwordResetEmail, welcomeEmail, type EmailContent } from "./templates";
+
+const MESSAGE_STREAM = process.env.POSTMARK_MESSAGE_STREAM ?? "outbound";
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
+}
+
+async function send(to: string, content: EmailContent): Promise<void> {
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!from) throw new Error("POSTMARK_FROM_EMAIL is not set");
+
+  await getPostmark().sendEmail({
+    From: from,
+    To: to,
+    Subject: content.subject,
+    HtmlBody: content.html,
+    TextBody: content.text,
+    MessageStream: MESSAGE_STREAM,
+  });
+}
+
+// Email failures are logged, never thrown: a failed email must not break the
+// request that triggered it (signup, reset request).
+async function sendSafely(kind: string, to: string, content: EmailContent): Promise<boolean> {
+  try {
+    await send(to, content);
+    return true;
+  } catch (err) {
+    const detail =
+      err instanceof Errors.PostmarkError
+        ? `${err.name} (code ${err.code}): ${err.message}`
+        : String(err);
+    console.error(`[email] failed to send ${kind} email to ${to}: ${detail}`);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  return sendSafely(
+    "welcome",
+    user.email,
+    welcomeEmail({ name: user.name, dashboardUrl: `${appUrl()}/dashboard` }),
+  );
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+) {
+  const resetUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return sendSafely(
+    "password-reset",
+    user.email,
+    passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes }),
+  );
+}
