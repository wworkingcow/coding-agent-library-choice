+function linkClerkAccount(clerkId: string, email: string, name: string): User {
+  const existing = users.find((u) => u.clerkId === clerkId || u.email === email);
+  if (existing) {
+    existing.clerkId = clerkId;
+    return existing;
+  }
+
+  const created: User = {
+    id: crypto.randomUUID(),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+    clerkId,
+  };
+  users.push(created);
+  return created;
+}
