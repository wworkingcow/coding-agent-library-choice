@@ -18,7 +22,40 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+// Backed by the real Clerk session. Returns undefined when nobody is signed
+// in — callers (e.g. the /dashboard page) are responsible for redirecting to
+// /sign-in in that case.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const signedInUser = await currentUser();
+  if (!signedInUser) return undefined;
+
+  const email =
+    signedInUser.primaryEmailAddress?.emailAddress ??
+    signedInUser.emailAddresses[0]?.emailAddress ??
+    "";
+  const name =
+    [signedInUser.firstName, signedInUser.lastName].filter(Boolean).join(" ") ||
+    signedInUser.username ||
+    email;
+
+  // Link (or lazily create) the local user record by Clerk id, falling back
+  // to email for the first sign-in of a seeded user.
+  let user = users.find(
+    (u) => u.clerkId === signedInUser.id || (!!email && u.email === email)
+  );
+
+  if (!user) {
+    user = {
+      id: signedInUser.id,
+      email,
+      name,
+      createdAt: new Date(signedInUser.createdAt).toISOString().slice(0, 10),
+      clerkId: signedInUser.id,
+    };
+    users.push(user);
+  } else if (!user.clerkId) {
+    user.clerkId = signedInUser.id;
+  }
+
+  return user;
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..79dc224
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,18 @@
+import { clerkMiddleware } from "@clerk/nextjs/server";
+
+// Next.js 16 renamed the middleware file convention to "proxy". This runs on
+// every matched request so Clerk can attach session state; the actual
+// /dashboard gate lives in the page itself (see src/app/dashboard/page.tsx),
+// which is the pattern Clerk recommends for Next.js 16's proxy runtime.
+export default clerkMiddleware();
+
+export const config = {
+  matcher: [
+    // Skip Next.js internals and static files, unless found in search params.
+    "/((?!_next|[^?]*\\.(?:html?|css|js(?!on)|jpe?g|webp|png|gif|svg|ttf|woff2?|ico|csv|docx?|xlsx?|zip|webmanifest)).*)",
+    // Always run for API routes.
+    "/(api|trpc)(.*)",
+    // Required so Clerk's internal proxy requests are handled.
+    "/__clerk/(.*)",
+  ],
+};
