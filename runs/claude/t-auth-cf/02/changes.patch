@@ -0,0 +1,28 @@
+import type { NextAuthConfig } from "next-auth";
+
+/**
+ * The subset of the Auth.js config that's safe to run in `middleware.ts`.
+ * Middleware runs on a restricted edge-style runtime, so this file must
+ * stay free of provider `authorize` callbacks, bcryptjs, and anything else
+ * from src/lib/users.ts — the full config with providers lives in auth.ts.
+ */
+export const authConfig = {
+  pages: {
+    signIn: "/sign-in",
+  },
+  session: {
+    strategy: "jwt",
+  },
+  // Required for platforms other than Vercel (e.g. Cloudflare Workers) so
+  // Auth.js trusts the incoming request's Host header when building URLs.
+  trustHost: true,
+  providers: [],
+  callbacks: {
+    authorized({ auth, request: { nextUrl } }) {
+      const isSignedIn = !!auth?.user;
+      const isProtected = nextUrl.pathname.startsWith("/dashboard");
+      if (!isProtected) return true;
+      return isSignedIn;
+    },
+  },
+} satisfies NextAuthConfig;
