+  }
+
+  const passwordHash = await bcrypt.hash(password, 10);
+  const user: StoredUser = {
+    id: String(nextId++),
+    email: normalized,
+    name: name.trim() || normalized,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return toPublicUser(user);
+}
+
+/**
+ * Verifies email/password credentials for sign-in. Returns the public user
+ * on success, or null if the email is unknown, the account has no password
+ * (OAuth-only), or the password doesn't match.
+ */
+export async function verifyPassword(
+  email: string,
+  password: string,
+): Promise<User | null> {
+  const normalized = normalizeEmail(email);
+  const user = users.find((u) => u.email.toLowerCase() === normalized);
+  if (!user || !user.passwordHash) return null;
+
+  const valid = await bcrypt.compare(password, user.passwordHash);
+  return valid ? toPublicUser(user) : null;
+}
+
+/**
+ * Finds the account for an OAuth sign-in (e.g. Google), creating one on
+ * first sign-in. OAuth-only accounts have no password set.
+ */
+export async function findOrCreateOAuthUser(profile: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const normalized = normalizeEmail(profile.email);
+  const existing = users.find((u) => u.email.toLowerCase() === normalized);
+  if (existing) return toPublicUser(existing);
+
+  const user: StoredUser = {
+    id: String(nextId++),
+    email: normalized,
+    name: profile.name?.trim() || normalized,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: null,
+  };
+  users.push(user);
+  return toPublicUser(user);
 }
