diff --git a/src/lib/db/client.ts b/src/lib/db/client.ts
new file mode 100644
index 0000000..bbb071e
--- /dev/null
+++ b/src/lib/db/client.ts
@@ -0,0 +1,30 @@
+import { drizzle } from "drizzle-orm/postgres-js";
+import postgres from "postgres";
+import * as schema from "./schema";
+
+const connectionString = process.env.DATABASE_URL;
+
+if (!connectionString) {
+  throw new Error(
+    "DATABASE_URL is not set. Copy .env.example to .env.local and point it at a Postgres database."
+  );
+}
+
+// Reuse a single connection (and drizzle instance) across hot reloads in dev,
+// so `next dev` doesn't leak a new postgres pool on every module reload.
+const globalForDb = globalThis as unknown as {
+  __dbConnection?: postgres.Sql;
+};
+
+const queryClient =
+  globalForDb.__dbConnection ??
+  postgres(connectionString, {
+    // Small pool: this is a lightweight app, not a connection-hungry service.
+    max: 10,
+  });
+
+if (process.env.NODE_ENV !== "production") {
+  globalForDb.__dbConnection = queryClient;
+}
+
+export const db = drizzle(queryClient, { schema });
diff --git a/src/lib/db/migrate.ts b/src/lib/db/migrate.ts
new file mode 100644
index 0000000..a9f0056
--- /dev/null
+++ b/src/lib/db/migrate.ts
@@ -0,0 +1,28 @@
+import "dotenv/config";
+import { drizzle } from "drizzle-orm/postgres-js";
+import { migrate } from "drizzle-orm/postgres-js/migrator";
+import postgres from "postgres";
+
+// Standalone script (run via `npm run db:migrate`), separate from the app's
+// pooled `db` client in `client.ts` — migrations want a single, short-lived
+// connection that exits cleanly when done.
+async function main() {
+  const connectionString = process.env.DATABASE_URL;
+  if (!connectionString) {
+    throw new Error("DATABASE_URL is not set. Copy .env.example to .env.local first.");
+  }
+
+  const sql = postgres(connectionString, { max: 1 });
+  const db = drizzle(sql);
+
+  console.log("Running migrations...");
+  await migrate(db, { migrationsFolder: "./src/lib/db/migrations" });
+  console.log("Migrations complete.");
+
+  await sql.end();
+}
+
+main().catch((err) => {
+  console.error("Migration failed:", err);
+  process.exit(1);
+});
