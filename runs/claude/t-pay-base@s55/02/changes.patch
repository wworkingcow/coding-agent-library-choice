+}
+
+// Idempotent: Stripe retries webhooks, so calling this twice is harmless.
+export async function setPlan(
+  id: string,
+  plan: Plan,
+  stripeSubscriptionId?: string,
+): Promise<User | undefined> {
+  const user = users.find((u) => u.id === id);
+  if (!user) return undefined;
+  user.plan = plan;
+  user.stripeSubscriptionId = plan === "pro" ? stripeSubscriptionId : undefined;
+  return user;
+}
