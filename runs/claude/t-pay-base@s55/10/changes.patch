+// In-memory like the rest of this file; swap for a DB write when persistence lands.
+export async function setUserPlan(
+  id: string,
+  plan: Plan,
+  billing: { stripeCustomerId?: string; stripeSubscriptionId?: string } = {},
+): Promise<User | undefined> {
+  const user = users.find((u) => u.id === id);
+  if (!user) return undefined;
+  user.plan = plan;
+  if (billing.stripeCustomerId) user.stripeCustomerId = billing.stripeCustomerId;
+  if (plan === "free") {
+    user.stripeSubscriptionId = undefined;
+  } else if (billing.stripeSubscriptionId) {
+    user.stripeSubscriptionId = billing.stripeSubscriptionId;
+  }
+  return user;
+}
