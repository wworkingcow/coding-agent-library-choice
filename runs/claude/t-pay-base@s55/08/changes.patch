+export async function getUserByStripeCustomerId(
+  customerId: string,
+): Promise<User | undefined> {
+  return users.find((u) => u.stripeCustomerId === customerId);
+}
+
+// NOTE: users live in memory, so plan changes are lost on restart. Swap this for a DB write.
+export async function updateUserBilling(
+  id: string,
+  patch: Partial<Pick<User, "plan" | "stripeCustomerId" | "stripeSubscriptionId">>,
+): Promise<User | undefined> {
+  const user = users.find((u) => u.id === id);
+  if (user) Object.assign(user, patch);
+  return user;
+}
