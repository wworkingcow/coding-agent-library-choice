+++ b/src/app/api/checkout/route.ts
@@ -0,0 +1,31 @@
+import { getStripe } from "@/lib/stripe";
+import { getCurrentUser } from "@/lib/users";
+
+export async function POST(request: Request) {
+  const user = await getCurrentUser();
+  if (!user) return new Response("Unauthorized", { status: 401 });
+  if (user.plan === "pro") {
+    return Response.redirect(new URL("/dashboard", request.url), 303);
+  }
+
+  const priceId = process.env.STRIPE_PRO_PRICE_ID;
+  if (!priceId) return new Response("Billing is not configured", { status: 500 });
+
+  const baseUrl = process.env.NEXT_PUBLIC_APP_URL ?? new URL(request.url).origin;
+  const session = await getStripe().checkout.sessions.create({
+    mode: "subscription",
+    line_items: [{ price: priceId, quantity: 1 }],
+    client_reference_id: user.id,
+    // Reuse the Stripe customer if we already have one, else prefill the email.
+    ...(user.stripeCustomerId
+      ? { customer: user.stripeCustomerId }
+      : { customer_email: user.email }),
+    // Copied onto the subscription so later subscription events can find the user.
+    subscription_data: { metadata: { userId: user.id } },
+    success_url: `${baseUrl}/dashboard?checkout=success`,
+    cancel_url: `${baseUrl}/dashboard?checkout=cancelled`,
+  });
+
+  if (!session.url) return new Response("Could not start checkout", { status: 502 });
+  return Response.redirect(session.url, 303);
+}
diff --git a/src/app/api/webhooks/stripe/route.ts b/src/app/api/webhooks/stripe/route.ts
new file mode 100644
index 0000000..1dc0190
--- /dev/null
+++ b/src/app/api/webhooks/stripe/route.ts
@@ -0,0 +1,43 @@
+import type Stripe from "stripe";
+import { getStripe } from "@/lib/stripe";
+import { getUserByStripeCustomerId, setUserPlan } from "@/lib/users";
+
+export const runtime = "nodejs";
+
+export async function POST(request: Request) {
+  const secret = process.env.STRIPE_WEBHOOK_SECRET;
+  const signature = request.headers.get("stripe-signature");
+  if (!secret || !signature) return new Response("Bad request", { status: 400 });
+
+  // Signature verification needs the raw, unparsed body.
+  const body = await request.text();
+  let event: Stripe.Event;
+  try {
+    event = getStripe().webhooks.constructEvent(body, signature, secret);
+  } catch {
+    return new Response("Invalid signature", { status: 400 });
+  }
+
+  switch (event.type) {
+    case "checkout.session.completed":
+    case "checkout.session.async_payment_succeeded": {
+      const session = event.data.object;
+      if (session.mode !== "subscription" || session.payment_status !== "paid") break;
+      const customerId =
+        typeof session.customer === "string" ? session.customer : session.customer?.id;
+      if (session.client_reference_id) {
+        await setUserPlan(session.client_reference_id, "pro", customerId);
+      }
+      break;
+    }
+    case "customer.subscription.deleted": {
+      const sub = event.data.object;
+      const customerId = typeof sub.customer === "string" ? sub.customer : sub.customer.id;
+      const user = await getUserByStripeCustomerId(customerId);
+      if (user) await setUserPlan(user.id, "free");
+      break;
+    }
+  }
+
+  return new Response(null, { status: 200 });
+}
