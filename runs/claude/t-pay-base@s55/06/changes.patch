index 0000000..f90325d
--- /dev/null
+++ b/src/app/api/checkout/route.ts
@@ -0,0 +1,39 @@
+import { NextResponse } from "next/server";
+import { appUrl, getStripe } from "@/lib/stripe";
+import { getCurrentUser } from "@/lib/users";
+
+export async function POST() {
+  const user = await getCurrentUser();
+  if (!user) {
+    return NextResponse.json({ error: "Not signed in" }, { status: 401 });
+  }
+  if (user.plan === "pro") {
+    return NextResponse.redirect(`${appUrl()}/dashboard`, 303);
+  }
+
+  const priceId = process.env.STRIPE_PRO_PRICE_ID;
+  if (!priceId) {
+    return NextResponse.json({ error: "Billing is not configured" }, { status: 500 });
+  }
+
+  const session = await getStripe().checkout.sessions.create({
+    mode: "subscription",
+    line_items: [{ price: priceId, quantity: 1 }],
+    // Reuse the Stripe customer if we already have one, otherwise prefill the email.
+    ...(user.stripeCustomerId
+      ? { customer: user.stripeCustomerId }
+      : { customer_email: user.email }),
+    // The webhook maps the payment back to our user through these.
+    client_reference_id: user.id,
+    metadata: { userId: user.id },
+    subscription_data: { metadata: { userId: user.id } },
+    success_url: `${appUrl()}/dashboard?checkout=success`,
+    cancel_url: `${appUrl()}/dashboard?checkout=cancelled`,
+  });
+
+  if (!session.url) {
+    return NextResponse.json({ error: "Could not start checkout" }, { status: 502 });
+  }
+  // 303 so the browser follows the POST with a GET.
+  return NextResponse.redirect(session.url, 303);
+}
diff --git a/src/app/api/stripe/webhook/route.ts b/src/app/api/stripe/webhook/route.ts
new file mode 100644
index 0000000..2ab1901
--- /dev/null
+++ b/src/app/api/stripe/webhook/route.ts
@@ -0,0 +1,60 @@
+import { NextResponse } from "next/server";
+import type Stripe from "stripe";
+import { getStripe } from "@/lib/stripe";
+import { getUser, getUserByStripeCustomerId, updateUser } from "@/lib/users";
+
+// Stripe needs the exact raw body to verify the signature, so read it as text.
+export async function POST(request: Request) {
+  const secret = process.env.STRIPE_WEBHOOK_SECRET;
+  const signature = request.headers.get("stripe-signature");
+  if (!secret || !signature) {
+    return NextResponse.json({ error: "Missing signature" }, { status: 400 });
+  }
+
+  let event: Stripe.Event;
+  try {
+    event = getStripe().webhooks.constructEvent(await request.text(), signature, secret);
+  } catch {
+    return NextResponse.json({ error: "Invalid signature" }, { status: 400 });
+  }
+
+  switch (event.type) {
+    case "checkout.session.completed":
+    case "checkout.session.async_payment_succeeded": {
+      const session = event.data.object;
+      // Delayed payment methods complete the session before the money arrives.
+      if (session.payment_status !== "paid") break;
+      const userId = session.client_reference_id ?? session.metadata?.userId;
+      const user = userId ? await getUser(userId) : undefined;
+      if (!user) break;
+      await updateUser(user.id, {
+        plan: "pro",
+        stripeCustomerId: stringId(session.customer),
+        stripeSubscriptionId: stringId(session.subscription),
+      });
+      break;
+    }
+    case "customer.subscription.updated":
+    case "customer.subscription.deleted": {
+      const sub = event.data.object;
+      const user = await getUserByStripeCustomerId(stringId(sub.customer));
+      if (!user) break;
+      // Only react to the subscription we know about, not stale ones.
+      if (user.stripeSubscriptionId && user.stripeSubscriptionId !== sub.id) break;
+      const active = sub.status === "active" || sub.status === "trialing";
+      const ended = event.type === "customer.subscription.deleted" ||
+        sub.status === "canceled" || sub.status === "unpaid" || sub.status === "incomplete_expired";
+      if (ended) await updateUser(user.id, { plan: "free", stripeSubscriptionId: undefined });
+      else if (active) await updateUser(user.id, { plan: "pro" });
+      break;
+    }
+  }
+
+  return NextResponse.json({ received: true });
+}
+
+function stringId(
+  value: string | { id: string } | null | undefined,
+): string | undefined {
+  return typeof value === "string" ? value : value?.id;
+}
