index 0000000..9237838
--- /dev/null
+++ b/src/app/api/checkout/route.ts
@@ -0,0 +1,30 @@
+import { getStripe } from "@/lib/stripe";
+import { getCurrentUser } from "@/lib/users";
+
+export async function POST(req: Request) {
+  const user = await getCurrentUser();
+  if (!user) return new Response("Not signed in", { status: 401 });
+  if (user.plan === "pro") {
+    return Response.redirect(new URL("/dashboard", req.url), 303);
+  }
+
+  const priceId = process.env.STRIPE_PRO_PRICE_ID;
+  const baseUrl = process.env.APP_URL ?? new URL(req.url).origin;
+  if (!priceId) return new Response("STRIPE_PRO_PRICE_ID is not set", { status: 500 });
+
+  const session = await getStripe().checkout.sessions.create({
+    mode: "subscription",
+    line_items: [{ price: priceId, quantity: 1 }],
+    // Ties the payment back to our user in the webhook.
+    client_reference_id: user.id,
+    ...(user.stripeCustomerId
+      ? { customer: user.stripeCustomerId }
+      : { customer_email: user.email }),
+    subscription_data: { metadata: { userId: user.id } },
+    success_url: `${baseUrl}/dashboard?checkout=success`,
+    cancel_url: `${baseUrl}/dashboard?checkout=cancelled`,
+  });
+
+  if (!session.url) return new Response("Stripe returned no checkout URL", { status: 502 });
+  return Response.redirect(session.url, 303);
+}
diff --git a/src/app/api/webhooks/stripe/route.ts b/src/app/api/webhooks/stripe/route.ts
new file mode 100644
index 0000000..9d0eceb
--- /dev/null
+++ b/src/app/api/webhooks/stripe/route.ts
@@ -0,0 +1,48 @@
+import type Stripe from "stripe";
+import { getStripe } from "@/lib/stripe";
+import { getUserByStripeCustomerId, updateUserBilling } from "@/lib/users";
+
+const id = (x: string | { id: string } | null): string | undefined =>
+  typeof x === "string" ? x : (x?.id ?? undefined);
+
+export async function POST(req: Request) {
+  const secret = process.env.STRIPE_WEBHOOK_SECRET;
+  const signature = req.headers.get("stripe-signature");
+  if (!secret || !signature) return new Response("Bad request", { status: 400 });
+
+  // Signature verification needs the exact raw body.
+  const body = await req.text();
+  let event: Stripe.Event;
+  try {
+    event = getStripe().webhooks.constructEvent(body, signature, secret);
+  } catch {
+    return new Response("Invalid signature", { status: 400 });
+  }
+
+  switch (event.type) {
+    case "checkout.session.completed": {
+      const session = event.data.object;
+      // Only upgrade once the money has actually landed.
+      if (session.mode !== "subscription" || session.payment_status !== "paid") break;
+      if (!session.client_reference_id) break;
+      await updateUserBilling(session.client_reference_id, {
+        plan: "pro",
+        stripeCustomerId: id(session.customer),
+        stripeSubscriptionId: id(session.subscription),
+      });
+      break;
+    }
+    case "customer.subscription.updated":
+    case "customer.subscription.deleted": {
+      const sub = event.data.object;
+      const customerId = id(sub.customer);
+      const user = customerId && (await getUserByStripeCustomerId(customerId));
+      if (!user || user.stripeSubscriptionId !== sub.id) break;
+      const active = sub.status === "active" || sub.status === "trialing";
+      await updateUserBilling(user.id, { plan: active ? "pro" : "free" });
+      break;
+    }
+  }
+
+  return new Response(null, { status: 200 });
+}
