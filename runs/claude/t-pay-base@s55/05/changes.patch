index 0000000..1a2fb50
--- /dev/null
+++ b/src/app/api/webhooks/stripe/route.ts
@@ -0,0 +1,51 @@
+import { NextResponse } from "next/server";
+import type Stripe from "stripe";
+import { getStripe } from "@/lib/stripe";
+import { getUserByStripeCustomerId, updateUserBilling } from "@/lib/users";
+
+export const runtime = "nodejs";
+
+function id(ref: string | { id: string } | null): string | undefined {
+  return typeof ref === "string" ? ref : ref?.id;
+}
+
+export async function POST(request: Request) {
+  const secret = process.env.STRIPE_WEBHOOK_SECRET;
+  const signature = request.headers.get("stripe-signature");
+  if (!secret || !signature) {
+    return NextResponse.json({ error: "Missing signature" }, { status: 400 });
+  }
+
+  // Signature verification needs the exact raw body.
+  const body = await request.text();
+  let event: Stripe.Event;
+  try {
+    event = getStripe().webhooks.constructEvent(body, signature, secret);
+  } catch {
+    return NextResponse.json({ error: "Invalid signature" }, { status: 400 });
+  }
+
+  switch (event.type) {
+    case "checkout.session.completed":
+    case "checkout.session.async_payment_succeeded": {
+      const session = event.data.object;
+      // Delayed payment methods complete before funds arrive; wait for the success event.
+      if (session.mode !== "subscription" || session.payment_status !== "paid") break;
+      if (!session.client_reference_id) break;
+      await updateUserBilling(session.client_reference_id, {
+        plan: "pro",
+        stripeCustomerId: id(session.customer),
+        stripeSubscriptionId: id(session.subscription),
+      });
+      break;
+    }
+    case "customer.subscription.deleted": {
+      const customerId = id(event.data.object.customer);
+      const user = customerId && (await getUserByStripeCustomerId(customerId));
+      if (user) await updateUserBilling(user.id, { plan: "free" });
+      break;
+    }
+  }
+
+  return NextResponse.json({ received: true });
+}
