+++ b/src/lib/stripe.ts
@@ -0,0 +1,34 @@
+import Stripe from "stripe";
+
+let stripeClient: Stripe | null = null;
+
+/** Lazily-created Stripe SDK client, shared across requests. */
+export function getStripe(): Stripe {
+  if (stripeClient) return stripeClient;
+
+  const secretKey = process.env.STRIPE_SECRET_KEY;
+  if (!secretKey) {
+    throw new Error(
+      "STRIPE_SECRET_KEY is not set. Copy .env.example to .env.local and fill in your Stripe test keys."
+    );
+  }
+
+  stripeClient = new Stripe(secretKey);
+  return stripeClient;
+}
+
+/** Price ID for the monthly Pro plan, configured in the Stripe dashboard. */
+export function getProPriceId(): string {
+  const priceId = process.env.STRIPE_PRO_PRICE_ID;
+  if (!priceId) {
+    throw new Error(
+      "STRIPE_PRO_PRICE_ID is not set. Create a monthly Price for the Pro plan in Stripe and set its id in .env.local."
+    );
+  }
+  return priceId;
+}
+
+/** Base URL Stripe should redirect back to after checkout. */
+export function getAppUrl(): string {
+  return process.env.NEXT_PUBLIC_APP_URL ?? "http://localhost:3000";
+}
