+"use server";
+
+import { redirect } from "next/navigation";
+import { getAppUrl, getProPriceId, getStripe } from "@/lib/stripe";
+import { getCurrentUser } from "@/lib/users";
+
+/**
+ * Starts a Stripe Checkout session for the signed-in user's monthly Pro
+ * subscription and redirects them to Stripe to pay. The user's plan is
+ * NOT flipped here — that only happens once our webhook receives
+ * confirmation that payment succeeded (see src/app/api/webhooks/stripe).
+ */
+export async function startProCheckout(): Promise<void> {
+  const user = await getCurrentUser();
+  if (!user) {
+    throw new Error("No signed-in user to start checkout for.");
+  }
+
+  const stripe = getStripe();
+  const appUrl = getAppUrl();
+
+  const session = await stripe.checkout.sessions.create({
+    mode: "subscription",
+    line_items: [{ price: getProPriceId(), quantity: 1 }],
+    // Reuse the Stripe customer we already created for this user, if any,
+    // so repeat checkouts (e.g. after a cancelled subscription) don't fork
+    // into duplicate customers.
+    customer: user.stripeCustomerId,
+    customer_email: user.stripeCustomerId ? undefined : user.email,
+    // Lets the webhook map the completed session back to our local user.
+    client_reference_id: user.id,
+    metadata: { userId: user.id },
+    subscription_data: { metadata: { userId: user.id } },
+    success_url: `${appUrl}/dashboard?checkout=success`,
+    cancel_url: `${appUrl}/dashboard?checkout=cancelled`,
+  });
+
+  if (!session.url) {
+    throw new Error("Stripe did not return a checkout URL.");
+  }
+
+  redirect(session.url);
+}
