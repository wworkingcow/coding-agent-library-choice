+import { NextRequest, NextResponse } from "next/server";
+import { stripe, PRO_PRICE_ID } from "@/lib/stripe";
+import { getCurrentUser } from "@/lib/users";
+
+// Starts a Stripe Checkout session for the monthly Pro plan. The dashboard
+// posts a plain HTML form here so this works with or without client JS.
+export async function POST(request: NextRequest) {
+  const user = await getCurrentUser();
+  if (!user) {
+    return NextResponse.redirect(new URL("/dashboard", request.url));
+  }
+
+  if (user.plan === "pro") {
+    // Already subscribed — nothing to check out.
+    return NextResponse.redirect(new URL("/dashboard", request.url));
+  }
+
+  const origin = request.nextUrl.origin;
+
+  const session = await stripe.checkout.sessions.create({
+    mode: "subscription",
+    line_items: [{ price: PRO_PRICE_ID, quantity: 1 }],
+    // Ties the Checkout session back to our user so the webhook knows who
+    // to upgrade once payment succeeds.
+    client_reference_id: user.id,
+    customer: user.stripeCustomerId,
+    customer_email: user.stripeCustomerId ? undefined : user.email,
+    success_url: `${origin}/dashboard?checkout=success`,
+    cancel_url: `${origin}/dashboard?checkout=cancelled`,
+  });
+
+  if (!session.url) {
+    return NextResponse.redirect(
+      new URL("/dashboard?checkout=error", request.url),
+    );
+  }
+
+  return NextResponse.redirect(session.url, 303);
+}
