+import Stripe from "stripe";
+
+// Placeholder so the module can be imported (e.g. at build time) even when
+// STRIPE_SECRET_KEY hasn't been configured yet. Real API calls will fail
+// with a clear Stripe error until a real key is set in .env.local.
+const apiKey = process.env.STRIPE_SECRET_KEY || "sk_test_placeholder";
+
+export const stripe = new Stripe(apiKey, {
+  apiVersion: "2026-08-26.dahlia",
+});
+
+// The monthly Pro plan's Stripe Price ID (recurring price), e.g. "price_123".
+export const PRO_PRICE_ID = process.env.STRIPE_PRICE_ID_PRO || "price_placeholder_pro_monthly";
+
+export const STRIPE_WEBHOOK_SECRET = process.env.STRIPE_WEBHOOK_SECRET || "whsec_placeholder";
