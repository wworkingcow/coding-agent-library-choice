diff --git a/src/lib/stripe.ts b/src/lib/stripe.ts
new file mode 100644
index 0000000..53bdb56
--- /dev/null
+++ b/src/lib/stripe.ts
@@ -0,0 +1,18 @@
+import Stripe from "stripe";
+
+let stripeClient: Stripe | null = null;
+
+// Lazily constructed so a missing key only breaks the routes that need
+// Stripe (checkout, webhook) instead of breaking the whole app at build time.
+export function getStripe(): Stripe {
+  if (!stripeClient) {
+    const secretKey = process.env.STRIPE_SECRET_KEY;
+    if (!secretKey) {
+      throw new Error(
+        "STRIPE_SECRET_KEY is not set. Copy .env.example to .env.local and fill in your Stripe test keys."
+      );
+    }
+    stripeClient = new Stripe(secretKey);
+  }
+  return stripeClient;
+}
