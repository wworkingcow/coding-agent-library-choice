diff --git a/src/lib/notes.ts b/src/lib/notes.ts
new file mode 100644
index 0000000..78ed973
--- /dev/null
+++ b/src/lib/notes.ts
@@ -0,0 +1,55 @@
+export type Note = {
+  id: string;
+  userId: string;
+  title: string;
+  body: string;
+  attachmentUrl: string | null;
+  createdAt: string;
+};
+
+// In-memory store, same spirit as src/lib/users.ts — swap for a real
+// database when one exists. The attachment itself lives in durable blob
+// storage (see src/lib/storage.ts); only its URL is kept here.
+const notes: Note[] = [];
+let nextId = 1;
+
+export async function listNotesForUser(userId: string): Promise<Note[]> {
+  return notes
+    .filter((n) => n.userId === userId)
+    .sort((a, b) => b.createdAt.localeCompare(a.createdAt));
+}
+
+export async function getNote(id: string): Promise<Note | undefined> {
+  return notes.find((n) => n.id === id);
+}
+
+export async function createNote(input: {
+  userId: string;
+  title: string;
+  body: string;
+  attachmentUrl?: string | null;
+}): Promise<Note> {
+  const note: Note = {
+    id: String(nextId++),
+    userId: input.userId,
+    title: input.title,
+    body: input.body,
+    attachmentUrl: input.attachmentUrl ?? null,
+    createdAt: new Date().toISOString(),
+  };
+  notes.push(note);
+  return note;
+}
+
+// Attaches (or replaces) the image on a note. Scoped to userId so one user
+// can't overwrite another user's note attachment.
+export async function setNoteAttachment(
+  id: string,
+  userId: string,
+  attachmentUrl: string
+): Promise<Note | undefined> {
+  const note = notes.find((n) => n.id === id && n.userId === userId);
+  if (!note) return undefined;
+  note.attachmentUrl = attachmentUrl;
+  return note;
+}
diff --git a/src/lib/storage.ts b/src/lib/storage.ts
new file mode 100644
index 0000000..2d164c0
--- /dev/null
+++ b/src/lib/storage.ts
@@ -0,0 +1,50 @@
+import { put } from "@vercel/blob";
+
+// Durable file storage for user-uploaded attachments, backed by Vercel Blob.
+// Vercel Blob was picked over rolling our own S3 setup because it needs a
+// single env var (BLOB_READ_WRITE_TOKEN), works the same in local dev and on
+// Vercel, and gives back a stable public URL we can store directly on a note
+// — no bucket policies, signed URLs, or extra infra to manage.
+
+const MAX_FILE_SIZE_BYTES = 5 * 1024 * 1024; // 5MB
+
+const ALLOWED_MIME_TYPES: Record<string, string> = {
+  "image/png": "png",
+  "image/jpeg": "jpg",
+  "image/gif": "gif",
+  "image/webp": "webp",
+};
+
+export class UploadValidationError extends Error {}
+
+export async function uploadImage(
+  file: File,
+  pathPrefix: string
+): Promise<{ url: string }> {
+  const extension = ALLOWED_MIME_TYPES[file.type];
+  if (!extension) {
+    throw new UploadValidationError(
+      `Unsupported file type "${file.type || "unknown"}". Allowed types: PNG, JPEG, GIF, WEBP.`
+    );
+  }
+  if (file.size === 0) {
+    throw new UploadValidationError("File is empty.");
+  }
+  if (file.size > MAX_FILE_SIZE_BYTES) {
+    throw new UploadValidationError(
+      `File is too large. Max size is ${MAX_FILE_SIZE_BYTES / (1024 * 1024)}MB.`
+    );
+  }
+
+  const filename = `${pathPrefix}/${crypto.randomUUID()}.${extension}`;
+
+  const blob = await put(filename, file, {
+    access: "public",
+    contentType: file.type,
+    // Vercel Blob already appends a random suffix by default, but keep this
+    // explicit — the UUID above is the primary defense against collisions.
+    addRandomSuffix: true,
+  });
+
+  return { url: blob.url };
+}
