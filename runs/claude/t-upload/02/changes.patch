@@ -0,0 +1,46 @@
+import { NextRequest, NextResponse } from "next/server";
+import { getCurrentUser } from "@/lib/users";
+import { createNote, listNotesForUser } from "@/lib/notes";
+import { uploadImage, UploadValidationError } from "@/lib/storage";
+
+export async function GET() {
+  const user = await getCurrentUser();
+  if (!user) {
+    return NextResponse.json({ error: "Not signed in" }, { status: 401 });
+  }
+
+  const notes = await listNotesForUser(user.id);
+  return NextResponse.json({ notes });
+}
+
+export async function POST(request: NextRequest) {
+  const user = await getCurrentUser();
+  if (!user) {
+    return NextResponse.json({ error: "Not signed in" }, { status: 401 });
+  }
+
+  const form = await request.formData();
+  const title = String(form.get("title") ?? "").trim();
+  const body = String(form.get("body") ?? "").trim();
+  const image = form.get("image");
+
+  if (!title) {
+    return NextResponse.json({ error: "Title is required" }, { status: 400 });
+  }
+
+  let attachmentUrl: string | null = null;
+  if (image instanceof File && image.size > 0) {
+    try {
+      const uploaded = await uploadImage(image, `notes/${user.id}`);
+      attachmentUrl = uploaded.url;
+    } catch (err) {
+      if (err instanceof UploadValidationError) {
+        return NextResponse.json({ error: err.message }, { status: 400 });
+      }
+      throw err;
+    }
+  }
+
+  const note = await createNote({ userId: user.id, title, body, attachmentUrl });
+  return NextResponse.json({ note }, { status: 201 });
+}
