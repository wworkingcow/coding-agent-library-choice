@@ -0,0 +1,44 @@
+import { put } from "@vercel/blob";
+
+// Durable file storage for user uploads, backed by Vercel Blob.
+// https://vercel.com/docs/storage/vercel-blob
+//
+// Requires BLOB_READ_WRITE_TOKEN to be set (see .env.example). In local dev
+// without a token this throws a clear error instead of silently failing.
+
+export const MAX_IMAGE_BYTES = 5 * 1024 * 1024; // 5MB
+
+export const ALLOWED_IMAGE_TYPES = new Set([
+  "image/png",
+  "image/jpeg",
+  "image/webp",
+  "image/gif",
+]);
+
+export async function uploadImage(
+  file: File,
+  pathPrefix: string
+): Promise<{ url: string }> {
+  if (!ALLOWED_IMAGE_TYPES.has(file.type)) {
+    throw new Error(`Unsupported image type: ${file.type || "unknown"}`);
+  }
+  if (file.size > MAX_IMAGE_BYTES) {
+    throw new Error("Image is too large (max 5MB)");
+  }
+  if (!process.env.BLOB_READ_WRITE_TOKEN) {
+    throw new Error(
+      "BLOB_READ_WRITE_TOKEN is not set. Copy .env.example to .env.local and fill in a real token."
+    );
+  }
+
+  const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, "_");
+  const pathname = `${pathPrefix}/${crypto.randomUUID()}-${safeName}`;
+
+  const blob = await put(pathname, file, {
+    access: "public",
+    token: process.env.BLOB_READ_WRITE_TOKEN,
+    addRandomSuffix: false,
+  });
+
+  return { url: blob.url };
+}
