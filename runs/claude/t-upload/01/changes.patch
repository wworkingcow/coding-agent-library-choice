@@ -0,0 +1,55 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useRef, useState } from "react";
+
+export function NoteImageUpload({ noteId }: { noteId: string }) {
+  const router = useRouter();
+  const inputRef = useRef<HTMLInputElement>(null);
+  const [uploading, setUploading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  async function handleChange(e: React.ChangeEvent<HTMLInputElement>) {
+    const file = e.target.files?.[0];
+    if (!file) return;
+
+    setUploading(true);
+    setError(null);
+
+    const formData = new FormData();
+    formData.append("file", file);
+
+    const res = await fetch(`/api/notes/${noteId}/image`, {
+      method: "POST",
+      body: formData,
+    });
+
+    setUploading(false);
+
+    if (!res.ok) {
+      const data = await res.json().catch(() => null);
+      setError(data?.error ?? "Upload failed");
+      if (inputRef.current) inputRef.current.value = "";
+      return;
+    }
+
+    router.refresh();
+  }
+
+  return (
+    <div className="mt-1">
+      <label className="inline-flex cursor-pointer items-center text-xs font-medium text-blue-600 hover:underline dark:text-blue-400">
+        {uploading ? "Uploading…" : "Attach image"}
+        <input
+          ref={inputRef}
+          type="file"
+          accept="image/png,image/jpeg,image/webp,image/gif"
+          onChange={handleChange}
+          disabled={uploading}
+          className="hidden"
+        />
+      </label>
+      {error && <p className="text-xs text-red-600">{error}</p>}
+    </div>
+  );
+}
