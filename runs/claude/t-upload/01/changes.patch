@@ -0,0 +1,68 @@
+import { getCurrentUser, type User } from "./users";
+
+export type Note = {
+  id: string;
+  userId: string;
+  title: string;
+  body: string;
+  imageUrl?: string;
+  createdAt: string;
+};
+
+const notes: Note[] = [
+  {
+    id: "1",
+    userId: "1",
+    title: "Welcome to Notely",
+    body: "This is your first note. Attach an image to try it out.",
+    createdAt: "2026-01-04",
+  },
+];
+
+let nextId = notes.length + 1;
+
+export async function listNotes(): Promise<Note[]> {
+  return notes;
+}
+
+export async function listNotesForUser(userId: User["id"]): Promise<Note[]> {
+  return notes.filter((n) => n.userId === userId);
+}
+
+export async function getNote(id: string): Promise<Note | undefined> {
+  return notes.find((n) => n.id === id);
+}
+
+// Notes are always created for the signed-in user — there is no real
+// session handling yet (see users.ts), so we lean on getCurrentUser().
+export async function createNote(input: {
+  title: string;
+  body: string;
+}): Promise<Note> {
+  const user = await getCurrentUser();
+  if (!user) throw new Error("No current user");
+
+  const note: Note = {
+    id: String(nextId++),
+    userId: user.id,
+    title: input.title.trim() || "Untitled",
+    body: input.body.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  notes.push(note);
+  return note;
+}
+
+// Attaches an already-uploaded image URL to a note. Only the note's owner
+// may attach an image to it.
+export async function setNoteImage(
+  id: string,
+  imageUrl: string
+): Promise<Note | undefined> {
+  const user = await getCurrentUser();
+  const note = notes.find((n) => n.id === id);
+  if (!note || !user || note.userId !== user.id) return undefined;
+
+  note.imageUrl = imageUrl;
+  return note;
+}
