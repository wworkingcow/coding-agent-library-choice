diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..7e3b376
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,13 @@
+import { clerkMiddleware } from "@clerk/nextjs/server";
+
+// Just attaches Clerk's auth context to every request; it does not gate any
+// route itself. `createRouteMatcher` + path-based `auth.protect()` here is
+// Clerk's older pattern and is now deprecated in favor of resource-based
+// checks, since path matching can drift from how Next.js actually routes a
+// request. The real protection for /dashboard lives in
+// src/app/dashboard/layout.tsx, next to the page it guards.
+export default clerkMiddleware();
+
+export const config = {
+  matcher: ["/((?!_next|.*\\..*).*)", "/(api|trpc)(.*)"],
+};
