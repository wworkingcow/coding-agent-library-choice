@@ -1,3 +1,5 @@
+import { currentUser } from "@clerk/nextjs/server";
+
 export type User = {
   id: string;
   email: string;
@@ -18,7 +20,30 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+// Backed by Clerk: resolves the signed-in session (via middleware/auth()) to
+// our own User record, keyed by the stable Clerk user id. First sign-in for a
+// given Clerk account upserts a matching record into the in-memory store.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const clerkUser = await currentUser();
+  if (!clerkUser) return undefined;
+
+  const existing = users.find((u) => u.id === clerkUser.id);
+  if (existing) return existing;
+
+  const email = clerkUser.primaryEmailAddress?.emailAddress ?? "";
+  const name =
+    [clerkUser.firstName, clerkUser.lastName].filter(Boolean).join(" ") ||
+    email ||
+    "Unnamed";
+
+  const created: User = {
+    id: clerkUser.id,
+    email,
+    name,
+    createdAt: new Date(clerkUser.createdAt ?? Date.now())
+      .toISOString()
+      .slice(0, 10),
+  };
+  users.push(created);
+  return created;
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..e5f7fba
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,13 @@
+import { clerkMiddleware, createRouteMatcher } from "@clerk/nextjs/server";
+
+const isProtectedRoute = createRouteMatcher(["/dashboard(.*)"]);
+
+export default clerkMiddleware(async (auth, req) => {
+  if (isProtectedRoute(req)) {
+    await auth.protect();
+  }
+});
+
+export const config = {
+  matcher: ["/((?!_next|.*\\..*).*)", "/(api|trpc)(.*)"],
+};
