@@ -1,3 +1,5 @@
+import { currentUser } from "@clerk/nextjs/server";
+
 export type User = {
   id: string;
   email: string;
@@ -18,7 +20,30 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+// Reads the signed-in identity from Clerk and upserts it into the local
+// user list, keyed by Clerk's user id, so it shows up in listUsers() too.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const clerkUser = await currentUser();
+  if (!clerkUser) return undefined;
+
+  const email = clerkUser.emailAddresses[0]?.emailAddress ?? "";
+  const name =
+    [clerkUser.firstName, clerkUser.lastName].filter(Boolean).join(" ") ||
+    email;
+
+  const existing = users.find((u) => u.id === clerkUser.id);
+  if (existing) {
+    existing.email = email;
+    existing.name = name;
+    return existing;
+  }
+
+  const created: User = {
+    id: clerkUser.id,
+    email,
+    name,
+    createdAt: new Date(clerkUser.createdAt).toISOString().slice(0, 10),
+  };
+  users.push(created);
+  return created;
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..9b05534
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,10 @@
+import { clerkMiddleware } from "@clerk/nextjs/server";
+
+// Populates Clerk's auth context for every request. Actual route
+// protection happens per-resource (see src/app/dashboard/page.tsx),
+// per Clerk's current guidance over path-matcher-based middleware checks.
+export default clerkMiddleware();
+
+export const config = {
+  matcher: ["/((?!_next|.*\\..*).*)", "/(api|trpc)(.*)"],
+};
