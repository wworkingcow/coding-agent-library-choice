+import { Resend } from "resend";
+
+// Transactional email, powered by Resend (https://resend.com).
+//
+// Required env vars (see .env.example):
+//   RESEND_API_KEY   - API key from the Resend dashboard
+//   EMAIL_FROM       - verified "from" address, e.g. "Notely <notifications@notely.app>"
+//   NEXT_PUBLIC_APP_URL - base URL used to build links inside emails (e.g. reset links)
+
+const RESEND_API_KEY = process.env.RESEND_API_KEY;
+const EMAIL_FROM = process.env.EMAIL_FROM ?? "Notely <onboarding@notely.app>";
+const APP_URL = process.env.NEXT_PUBLIC_APP_URL ?? "http://localhost:3000";
+
+// The client is created lazily so the module can be imported freely (e.g. in
+// tests) without requiring an API key to be set.
+let client: Resend | null = null;
+
+function getClient(): Resend {
+  if (!client) {
+    if (!RESEND_API_KEY) {
+      throw new Error(
+        "RESEND_API_KEY is not set. Add it to your .env (see .env.example) to send email."
+      );
+    }
+    client = new Resend(RESEND_API_KEY);
+  }
+  return client;
+}
+
+function layout(title: string, bodyHtml: string): string {
+  return `<!doctype html>
+<html>
+  <body style="margin:0;padding:0;background-color:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
+    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f5;padding:32px 0;">
+      <tr>
+        <td align="center">
+          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;padding:32px;">
+            <tr>
+              <td>
+                <h1 style="margin:0 0 16px;font-size:20px;color:#18181b;">${title}</h1>
+                ${bodyHtml}
+                <p style="margin:32px 0 0;font-size:12px;color:#a1a1aa;">Notely &middot; this is an automated message, please don't reply.</p>
+              </td>
+            </tr>
+          </table>
+        </td>
+      </tr>
+    </table>
+  </body>
+</html>`;
+}
+
+/**
+ * Sends a welcome email to a newly created user.
+ * Failures are logged but not thrown, so signup never fails because email delivery did.
+ */
+export async function sendWelcomeEmail(to: string, name: string): Promise<void> {
+  const html = layout(
+    `Welcome to Notely, ${name}!`,
+    `
+      <p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#3f3f46;">
+        Your account (${to}) is ready to go. Jump into your dashboard to start capturing notes.
+      </p>
+      <a href="${APP_URL}/dashboard"
+         style="display:inline-block;margin-top:8px;padding:10px 20px;background-color:#18181b;color:#ffffff;
+                text-decoration:none;border-radius:6px;font-size:14px;font-weight:600;">
+        Go to your dashboard
+      </a>
+    `
+  );
+
+  await sendEmail({
+    to,
+    subject: "Welcome to Notely",
+    html,
+  });
+}
+
+/**
+ * Sends a password reset email containing a link with the given reset token.
+ * Failures are logged but not thrown, so the caller can decide how to respond
+ * (e.g. still returning a generic "check your email" message to avoid leaking
+ * whether an account exists).
+ */
+export async function sendPasswordResetEmail(
+  to: string,
+  name: string,
+  resetToken: string
+): Promise<void> {
+  const resetUrl = `${APP_URL}/reset-password?token=${encodeURIComponent(resetToken)}`;
+
+  const html = layout(
+    "Reset your password",
+    `
+      <p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#3f3f46;">
+        Hi ${name}, we received a request to reset the password for your Notely account (${to}).
+        This link expires in 1 hour. If you didn't request this, you can safely ignore this email.
+      </p>
+      <a href="${resetUrl}"
+         style="display:inline-block;margin-top:8px;padding:10px 20px;background-color:#18181b;color:#ffffff;
+                text-decoration:none;border-radius:6px;font-size:14px;font-weight:600;">
+        Reset password
+      </a>
+      <p style="margin:16px 0 0;font-size:12px;color:#a1a1aa;word-break:break-all;">
+        Or paste this link into your browser: ${resetUrl}
+      </p>
+    `
+  );
+
+  await sendEmail({
+    to,
+    subject: "Reset your Notely password",
+    html,
+  });
+}
+
+async function sendEmail(options: { to: string; subject: string; html: string }): Promise<void> {
+  try {
+    const { error } = await getClient().emails.send({
+      from: EMAIL_FROM,
+      to: options.to,
+      subject: options.subject,
+      html: options.html,
+    });
+    if (error) {
+      console.error(`Failed to send email "${options.subject}" to ${options.to}:`, error);
+    }
+  } catch (err) {
+    // Never let email delivery problems break the caller's flow (signup, reset, etc).
+    console.error(`Failed to send email "${options.subject}" to ${options.to}:`, err);
+  }
+}
