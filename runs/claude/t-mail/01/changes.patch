@@ -0,0 +1,18 @@
+import { NextResponse } from "next/server";
+import { requestPasswordReset } from "@/lib/users";
+
+export async function POST(request: Request) {
+  const body = await request.json().catch(() => null);
+  const email = typeof body?.email === "string" ? body.email.trim() : "";
+
+  if (!email) {
+    return NextResponse.json({ error: "email is required" }, { status: 400 });
+  }
+
+  // Always responds the same way regardless of whether the email is
+  // registered, so this endpoint can't be used to enumerate accounts. The
+  // reset email (if any) is sent from src/lib/users.ts.
+  await requestPasswordReset(email);
+
+  return NextResponse.json({ ok: true });
+}
