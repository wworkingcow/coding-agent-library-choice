 export type User = {
   id: string;
   email: string;
@@ -10,6 +13,13 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+// Password reset tokens, keyed by token. In-memory only, like `users` above
+// — fine for this scaffold, but swap for persisted + hashed storage before
+// this app has real accounts.
+type ResetToken = { userId: string; expiresAt: number };
+const resetTokens = new Map<string, ResetToken>();
+const RESET_TOKEN_TTL_MS = 60 * 60 * 1000; // 1 hour
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +28,76 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  return users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export type CreateUserInput = {
+  email: string;
+  name: string;
+};
+
+/**
+ * Creates a new user and sends them a welcome email.
+ */
+export async function createUser(input: CreateUserInput): Promise<User> {
+  const user: User = {
+    id: randomUUID(),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  await sendWelcomeEmail(user.email, user.name);
+
+  return user;
+}
+
+/**
+ * Starts a password reset: if the email matches a user, generates a
+ * short-lived token and emails a reset link. Always resolves without error
+ * (even for unknown emails) so callers can't use it to enumerate accounts.
+ */
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  const token = randomBytes(32).toString("hex");
+  resetTokens.set(token, { userId: user.id, expiresAt: Date.now() + RESET_TOKEN_TTL_MS });
+
+  const appUrl = process.env.APP_URL ?? "http://localhost:3000";
+  const resetUrl = `${appUrl}/reset-password?token=${token}`;
+
+  await sendPasswordResetEmail(user.email, resetUrl);
+}
+
+/**
+ * Validates a password reset token without consuming it. Real password
+ * storage/hashing isn't implemented yet — this just proves out the token
+ * lifecycle so a `resetPassword` step can be added alongside real auth.
+ */
+export async function validatePasswordResetToken(token: string): Promise<User | undefined> {
+  const entry = resetTokens.get(token);
+  if (!entry) return undefined;
+
+  if (entry.expiresAt < Date.now()) {
+    resetTokens.delete(token);
+    return undefined;
+  }
+
+  return getUser(entry.userId);
+}
+
+/**
+ * Consumes a password reset token, single-use. Call after the new password
+ * has actually been persisted.
+ */
+export async function consumePasswordResetToken(token: string): Promise<void> {
+  resetTokens.delete(token);
+}
