--- /dev/null
+++ b/src/app/api/account/delete/route.ts
@@ -0,0 +1,32 @@
+import { NextResponse } from "next/server";
+import { auth, signOut } from "@/auth";
+import { deleteUser, getUser, verifyPassword } from "@/lib/users";
+
+export async function POST(req: Request) {
+  const session = await auth();
+  const userId = session?.user?.id;
+  if (!userId) {
+    return NextResponse.json({ error: "Not signed in." }, { status: 401 });
+  }
+
+  const user = await getUser(userId);
+  if (!user) {
+    return NextResponse.json({ error: "Not signed in." }, { status: 401 });
+  }
+
+  // Require password confirmation before a destructive, irreversible action —
+  // but only when the account has a password to confirm with.
+  if (user.passwordHash) {
+    const body = await req.json().catch(() => null);
+    const password = typeof body?.password === "string" ? body.password : "";
+    const verified = await verifyPassword(user.email, password);
+    if (!verified) {
+      return NextResponse.json({ error: "Password is incorrect." }, { status: 400 });
+    }
+  }
+
+  await deleteUser(userId);
+  await signOut({ redirect: false });
+
+  return NextResponse.json({ ok: true });
+}
