+import { redirect } from "next/navigation";
+import { getCurrentUser } from "@/lib/users";
+import { ChangePasswordForm } from "./change-password-form";
+import { SignOutAllButton } from "./sign-out-all-button";
+import { DeleteAccountForm } from "./delete-account-form";
+
+export default async function AccountPage() {
+  const me = await getCurrentUser();
+  if (!me) {
+    redirect("/signin?callbackUrl=/account");
+  }
+
+  return (
+    <main className="mx-auto w-full max-w-2xl space-y-10 p-8">
+      <div>
+        <h1 className="text-2xl font-semibold">Account</h1>
+        <p className="mt-1 text-sm opacity-70">
+          Signed in as {me.name} ({me.email})
+        </p>
+      </div>
+
+      <section className="space-y-3 rounded-xl border border-black/[.08] p-6 dark:border-white/[.145]">
+        <h2 className="text-lg font-medium">
+          {me.passwordHash ? "Change password" : "Set a password"}
+        </h2>
+        <p className="text-sm opacity-70">
+          {me.passwordHash
+            ? "Update the password you use to sign in."
+            : "You signed up with Google or an email link. Set a password to also sign in that way."}
+        </p>
+        <ChangePasswordForm hasPassword={!!me.passwordHash} />
+      </section>
+
+      <section className="space-y-3 rounded-xl border border-black/[.08] p-6 dark:border-white/[.145]">
+        <h2 className="text-lg font-medium">Sessions</h2>
+        <p className="text-sm opacity-70">
+          Sign out everywhere you&apos;re currently signed in, including this device.
+        </p>
+        <SignOutAllButton />
+      </section>
+
+      <section className="space-y-3 rounded-xl border border-red-900/20 bg-red-50/50 p-6 dark:border-red-500/20 dark:bg-red-950/10">
+        <h2 className="text-lg font-medium text-red-700 dark:text-red-400">Delete account</h2>
+        <p className="text-sm opacity-70">
+          Permanently deletes your account and signs you out. This can&apos;t be undone.
+        </p>
+        <DeleteAccountForm hasPassword={!!me.passwordHash} />
+      </section>
+    </main>
+  );
+}
