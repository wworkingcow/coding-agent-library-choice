@@ -0,0 +1,26 @@
+import { Resend } from "resend";
+
+const apiKey = process.env.RESEND_API_KEY;
+const from = process.env.EMAIL_FROM ?? "Notely <onboarding@notely.dev>";
+
+// Falls back to logging when no real key is configured, so the magic-link flow
+// still works end to end locally with only the placeholder values from .env.example.
+const resend = apiKey && !apiKey.startsWith("placeholder") ? new Resend(apiKey) : null;
+
+export async function sendMagicLinkEmail(email: string, url: string): Promise<void> {
+  if (!resend) {
+    console.log(`[magic-link] RESEND_API_KEY not configured — sign-in link for ${email}: ${url}`);
+    return;
+  }
+
+  await resend.emails.send({
+    from,
+    to: email,
+    subject: "Your Notely sign-in link",
+    html: `
+      <p>Click below to sign in to Notely. This link expires in 15 minutes and can only be used once.</p>
+      <p><a href="${url}">${url}</a></p>
+      <p>If you didn't request this, you can safely ignore this email.</p>
+    `,
+  });
+}
