@@ -0,0 +1,21 @@
+import { redirect } from "next/navigation";
+import { AuthError } from "next-auth";
+import { signIn } from "@/auth";
+
+export async function GET(req: Request) {
+  const token = new URL(req.url).searchParams.get("token");
+  if (!token) {
+    redirect("/signin?error=InvalidMagicLink");
+  }
+
+  try {
+    // On success, signIn() itself redirects (it throws Next's internal redirect
+    // signal) — that must propagate, not be swallowed by the catch below.
+    await signIn("magic-link", { token, redirectTo: "/dashboard" });
+  } catch (error) {
+    if (error instanceof AuthError) {
+      redirect("/signin?error=InvalidMagicLink");
+    }
+    throw error;
+  }
+}
