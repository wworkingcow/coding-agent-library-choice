--- /dev/null
+++ b/src/lib/magic-link-tokens.ts
@@ -0,0 +1,28 @@
+import crypto from "crypto";
+
+type TokenRecord = { email: string; expiresAt: number };
+
+// Same globalThis-pinning as src/lib/users.ts — needed for the same reason
+// (module can load more than once within a process).
+const globalForTokens = globalThis as unknown as {
+  __notelyMagicLinkTokens?: Map<string, TokenRecord>;
+};
+
+const tokens: Map<string, TokenRecord> =
+  globalForTokens.__notelyMagicLinkTokens ?? (globalForTokens.__notelyMagicLinkTokens = new Map());
+
+const TOKEN_TTL_MS = 15 * 60 * 1000; // 15 minutes
+
+export function createMagicLinkToken(email: string): string {
+  const token = crypto.randomBytes(32).toString("hex");
+  tokens.set(token, { email: email.toLowerCase(), expiresAt: Date.now() + TOKEN_TTL_MS });
+  return token;
+}
+
+// Single-use: consuming a token deletes it, whether or not it turned out to be valid.
+export function consumeMagicLinkToken(token: string): string | null {
+  const record = tokens.get(token);
+  tokens.delete(token);
+  if (!record || record.expiresAt < Date.now()) return null;
+  return record.email;
+}
