+import { NextResponse } from "next/server";
+import { auth } from "@/auth";
+import { bumpSessionVersion } from "@/lib/users";
+
+export async function POST() {
+  const session = await auth();
+  if (!session?.user?.id) {
+    return NextResponse.json({ error: "Not signed in." }, { status: 401 });
+  }
+
+  // Invalidates every JWT issued for this user so far, including the one
+  // backing the current request — see the `jwt` callback in auth.ts. The
+  // client follows up with signOut() to also clear its own cookie right away.
+  await bumpSessionVersion(session.user.id);
+  return NextResponse.json({ ok: true });
+}
