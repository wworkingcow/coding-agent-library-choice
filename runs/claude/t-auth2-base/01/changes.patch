diff --git a/src/lib/auth-adapter.ts b/src/lib/auth-adapter.ts
new file mode 100644
index 0000000..35a9ba5
--- /dev/null
+++ b/src/lib/auth-adapter.ts
@@ -0,0 +1,76 @@
+import type { Adapter, AdapterUser } from "next-auth/adapters";
+import {
+  consumeVerificationToken,
+  createVerificationTokenRecord,
+  findOrCreateOAuthUser,
+  getUser,
+  getUserByAccount,
+  getUserByEmail,
+  linkAccount,
+  setEmailVerified,
+  type User,
+} from "@/lib/users";
+
+// A minimal Auth.js adapter over the in-memory user store in @/lib/users.
+//
+// Only exists to support two things that need durable state beyond a single
+// request: magic-link (Resend) sign-in, which needs somewhere to stash
+// verification tokens and mark an email verified, and linking Google's account
+// id to a local user across sign-ins. Sessions stay JWT-based (see auth.ts),
+// so the session/database-session methods (createSession, deleteSession, etc.)
+// are deliberately left unimplemented — Auth.js never calls them under the
+// "jwt" strategy.
+function toAdapterUser(user: User): AdapterUser {
+  return {
+    id: user.id,
+    email: user.email,
+    name: user.name,
+    emailVerified: user.emailVerified ? new Date(user.emailVerified) : null,
+  };
+}
+
+export const usersAdapter: Adapter = {
+  async getUser(id) {
+    const user = await getUser(id);
+    return user ? toAdapterUser(user) : null;
+  },
+  async getUserByEmail(email) {
+    const user = await getUserByEmail(email);
+    return user ? toAdapterUser(user) : null;
+  },
+  async getUserByAccount({ provider, providerAccountId }) {
+    const user = await getUserByAccount({ provider, providerAccountId });
+    return user ? toAdapterUser(user) : null;
+  },
+  async createUser(data) {
+    const name = data.name ?? data.email.split("@")[0];
+    const user = await findOrCreateOAuthUser({ email: data.email, name });
+    const verified = await setEmailVerified(user.id, data.emailVerified ?? null);
+    return toAdapterUser(verified ?? user);
+  },
+  async updateUser(data) {
+    if (data.emailVerified === undefined) {
+      const existing = await getUser(data.id);
+      if (!existing) throw new Error("User not found.");
+      return toAdapterUser(existing);
+    }
+    const updated = await setEmailVerified(data.id, data.emailVerified);
+    if (!updated) throw new Error("User not found.");
+    return toAdapterUser(updated);
+  },
+  async linkAccount(account) {
+    await linkAccount({
+      provider: account.provider,
+      providerAccountId: account.providerAccountId,
+      userId: account.userId,
+    });
+  },
+  async createVerificationToken(token) {
+    await createVerificationTokenRecord(token);
+    return token;
+  },
+  async useVerificationToken(params) {
+    const token = await consumeVerificationToken(params);
+    return token ?? null;
+  },
+};
