+import type { DefaultSession } from "next-auth";
+
+// Augments the built-in types with the extra fields auth.ts's callbacks add:
+// - session.user.id, so pages/APIs can key off it without a second email lookup.
+// - JWT.uid / JWT.sessionVersion, used to re-validate (and revoke) sessions on
+//   every request — see the `jwt` callback in auth.ts.
+declare module "next-auth" {
+  interface Session {
+    user: {
+      id: string;
+    } & DefaultSession["user"];
+  }
+}
+
+declare module "next-auth/jwt" {
+  interface JWT {
+    uid?: string;
+    sessionVersion?: number;
+  }
+}
