+++ b/src/app/api/account/delete/route.ts
@@ -0,0 +1,18 @@
+import { NextResponse } from "next/server";
+import { auth } from "@/auth";
+import { deleteUser } from "@/lib/users";
+
+export async function POST() {
+  const session = await auth();
+  if (!session?.user?.id) {
+    return NextResponse.json({ error: "Not signed in." }, { status: 401 });
+  }
+
+  await deleteUser(session.user.id);
+  // The account's user record is now gone, which is enough on its own to make
+  // the current session (and any other) invalid on its next request — see the
+  // `jwt` callback in auth.ts. The client still calls signOut() right after
+  // this to clear the local cookie immediately rather than leaving a
+  // now-dead session hanging around in the browser.
+  return NextResponse.json({ ok: true });
+}
