+import { NextResponse } from "next/server";
+import bcrypt from "bcryptjs";
+import { auth } from "@/auth";
+import { bumpSessionVersion, getUserByEmail, setUserPassword } from "@/lib/users";
+
+export async function POST(req: Request) {
+  const session = await auth();
+  const email = session?.user?.email;
+  if (!email) {
+    return NextResponse.json({ error: "Not signed in." }, { status: 401 });
+  }
+
+  const body = await req.json().catch(() => null);
+  const currentPassword = typeof body?.currentPassword === "string" ? body.currentPassword : "";
+  const newPassword = typeof body?.newPassword === "string" ? body.newPassword : "";
+
+  if (newPassword.length < 8) {
+    return NextResponse.json({ error: "New password must be at least 8 characters." }, { status: 400 });
+  }
+
+  const user = await getUserByEmail(email);
+  if (!user) {
+    return NextResponse.json({ error: "Account not found." }, { status: 404 });
+  }
+
+  // Users who signed up via Google or a magic link have no password yet —
+  // let them set one without proving a "current" password that never
+  // existed. Anyone who already has one must confirm it first.
+  if (user.passwordHash) {
+    const valid = await bcrypt.compare(currentPassword, user.passwordHash);
+    if (!valid) {
+      return NextResponse.json({ error: "Current password is incorrect." }, { status: 400 });
+    }
+  }
+
+  await setUserPassword(email, newPassword);
+  // A password change invalidates every outstanding session, including this
+  // one — the client re-authenticates immediately afterward with the new
+  // password to pick up a fresh token.
+  await bumpSessionVersion(email);
+
+  return NextResponse.json({ ok: true });
+}
