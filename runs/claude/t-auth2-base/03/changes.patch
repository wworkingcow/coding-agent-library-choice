--- /dev/null
+++ b/src/lib/magic-links.ts
@@ -0,0 +1,45 @@
+import { randomBytes } from "node:crypto";
+
+type MagicLinkToken = {
+  email: string;
+  expiresAt: number;
+};
+
+const TOKEN_TTL_MS = 15 * 60 * 1000; // 15 minutes
+
+// Same globalThis-pinning trick as src/lib/users.ts — Next.js can load this
+// module more than once per process, and a token issued from one copy must
+// still be readable from another.
+const globalForMagicLinks = globalThis as unknown as {
+  __notelyMagicLinks?: Map<string, MagicLinkToken>;
+};
+
+const tokens: Map<string, MagicLinkToken> =
+  globalForMagicLinks.__notelyMagicLinks ?? (globalForMagicLinks.__notelyMagicLinks = new Map());
+
+function sweepExpired(now: number) {
+  for (const [token, entry] of tokens) {
+    if (entry.expiresAt <= now) tokens.delete(token);
+  }
+}
+
+// Issues a one-time sign-in token for the given email. Doesn't check whether
+// the email belongs to an existing account — passwordless sign-in provisions
+// one on first use, same as Google sign-in does.
+export function createMagicLinkToken(email: string): string {
+  const now = Date.now();
+  sweepExpired(now);
+  const token = randomBytes(32).toString("base64url");
+  tokens.set(token, { email: email.toLowerCase(), expiresAt: now + TOKEN_TTL_MS });
+  return token;
+}
+
+// Validates and burns a token. Returns the associated email, or null if the
+// token is unknown, expired, or already used.
+export function consumeMagicLinkToken(token: string): string | null {
+  const entry = tokens.get(token);
+  tokens.delete(token); // single use, whether or not it was valid
+  if (!entry) return null;
+  if (entry.expiresAt <= Date.now()) return null;
+  return entry.email;
+}
