+++ b/src/lib/email.ts
@@ -0,0 +1,43 @@
+// Minimal Resend integration for transactional email (currently just magic
+// links). Uses a plain fetch call against Resend's REST API rather than
+// pulling in their SDK — one endpoint doesn't need a dependency.
+//
+// Without a real RESEND_API_KEY configured, sending is skipped and the
+// email's content is logged instead, so magic-link sign-in works out of the
+// box in local dev without any credentials.
+
+const RESEND_API_URL = "https://api.resend.com/emails";
+
+function isConfigured(): boolean {
+  const key = process.env.RESEND_API_KEY;
+  return typeof key === "string" && key.length > 0 && !key.startsWith("placeholder");
+}
+
+export async function sendMagicLinkEmail(email: string, url: string): Promise<void> {
+  if (!isConfigured()) {
+    console.log(`[email:dev] Magic link for ${email}: ${url}`);
+    return;
+  }
+
+  const from = process.env.EMAIL_FROM || "Notely <onboarding@resend.dev>";
+
+  const res = await fetch(RESEND_API_URL, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${process.env.RESEND_API_KEY}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({
+      from,
+      to: email,
+      subject: "Sign in to Notely",
+      html: `<p>Click below to sign in to Notely. This link expires in 15 minutes and can only be used once.</p><p><a href="${url}">Sign in to Notely</a></p><p>If you didn't request this, you can ignore this email.</p>`,
+      text: `Sign in to Notely: ${url}\n\nThis link expires in 15 minutes and can only be used once. If you didn't request this, you can ignore this email.`,
+    }),
+  });
+
+  if (!res.ok) {
+    const body = await res.text().catch(() => "");
+    throw new Error(`Failed to send magic-link email (${res.status}): ${body}`);
+  }
+}
