+++ b/src/types/next-auth.d.ts
@@ -0,0 +1,17 @@
+import type { DefaultSession } from "next-auth";
+
+// The session/jwt callbacks in src/auth.ts blank out `user` and drop
+// `sessionVersion` to invalidate a token (password change, account deletion,
+// or "sign out of all devices"). Reflect that in the types instead of
+// casting past them at every call site.
+declare module "next-auth" {
+  interface Session {
+    user?: DefaultSession["user"];
+  }
+}
+
+declare module "next-auth/jwt" {
+  interface JWT {
+    sessionVersion?: number;
+  }
+}
