+import { UserProfile } from "@clerk/nextjs";
+import { auth } from "@clerk/nextjs/server";
+import { SignOutEverywhere } from "../sign-out-everywhere";
+
+function DevicesIcon() {
+  return (
+    <svg
+      xmlns="http://www.w3.org/2000/svg"
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth={2}
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      width="16"
