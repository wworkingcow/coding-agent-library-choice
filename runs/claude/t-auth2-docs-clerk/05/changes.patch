+++ b/src/app/account/actions.ts
@@ -0,0 +1,19 @@
+"use server";
+
+import { auth, clerkClient } from "@clerk/nextjs/server";
+
+// Revokes every active session for the signed-in user — including the one
+// making this request — so "sign out of all devices" actually means all of
+// them. The client redirects to /signin once this resolves.
+export async function signOutOfAllDevices() {
+  const { userId } = await auth();
+  if (!userId) throw new Error("Not signed in");
+
+  const client = await clerkClient();
+  const { data: sessions } = await client.sessions.getSessionList({
+    userId,
+    status: "active",
+  });
+
+  await Promise.all(sessions.map((session) => client.sessions.revokeSession(session.id)));
+}
