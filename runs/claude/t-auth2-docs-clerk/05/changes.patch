+}
+
+// Password change and account deletion are both built into Clerk's <UserProfile />
+// "Security" tab (account deletion needs to be turned on in the Clerk Dashboard
+// under User & Authentication -> "Allow users to delete their own account").
+// "Sign out of all devices" isn't a built-in page, so it's added as a custom one.
+export default async function AccountPage() {
+  await auth.protect();
+
+  return (
+    <div className="flex flex-1 items-start justify-center bg-zinc-50 px-4 py-16 dark:bg-black">
+      <UserProfile path="/account" routing="path">
+        <UserProfile.Page label="Devices" url="devices" labelIcon={<DevicesIcon />}>
+          <SignOutEverywhere />
+        </UserProfile.Page>
+      </UserProfile>
+    </div>
+  );
+}
