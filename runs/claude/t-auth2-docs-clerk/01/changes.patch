+++ b/src/lib/auth-adapter.ts
@@ -0,0 +1,82 @@
+import type { Adapter, AdapterUser } from "next-auth/adapters";
+import {
+  createUserRecord,
+  createVerificationToken,
+  getUser,
+  getUserByAccount,
+  getUserByEmail,
+  linkAccount,
+  updateUserRecord,
+  useVerificationToken as consumeVerificationToken,
+  type User,
+} from "@/lib/users";
+
+// Adapts our in-memory user store (src/lib/users.ts) to the Auth.js Adapter
+// interface. This is only needed for two things:
+//  - Google OAuth and magic-link email both need somewhere to resolve
+//    "this provider account" -> "this local user" and provision one on first use.
+//  - The Email (magic-link) provider needs somewhere to store one-time
+//    verification tokens.
+// Sessions are NOT handled here — the app uses JWT sessions (see src/auth.ts),
+// so Auth.js never calls the session-related adapter methods.
+function toAdapterUser(user: User): AdapterUser {
+  return {
+    id: user.id,
+    email: user.email,
+    name: user.name,
+    emailVerified: user.emailVerified ? new Date(user.emailVerified) : null,
+  };
+}
+
