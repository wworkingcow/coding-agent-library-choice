+import { getCurrentUser } from "@/lib/users";
+import { ensureSignedIn } from "./actions";
+import { ChangePasswordForm } from "./change-password-form";
+import { DeleteAccountButton, SignOutAllDevicesButton } from "./danger-zone";
+
+export default async function AccountPage() {
+  await ensureSignedIn();
+  const user = await getCurrentUser();
+
+  return (
+    <main className="mx-auto w-full max-w-2xl space-y-10 p-8">
+      <div>
+        <h1 className="text-2xl font-semibold">Account</h1>
+        <p className="mt-1 text-sm opacity-70">
+          Signed in as {user?.name} ({user?.email})
+        </p>
+      </div>
+
+      <section className="space-y-4 rounded-xl border border-black/[.08] p-6 dark:border-white/[.145]">
+        <h2 className="text-lg font-medium">
+          {user?.passwordHash ? "Change password" : "Set a password"}
+        </h2>
+        <p className="text-sm opacity-70">
+          {user?.passwordHash
+            ? "Update the password you use to sign in."
+            : "You've only signed in with Google or a magic link so far. Set a password to also sign in with email and password."}
+        </p>
+        <ChangePasswordForm hasPassword={!!user?.passwordHash} />
+      </section>
+
+      <section className="space-y-4 rounded-xl border border-black/[.08] p-6 dark:border-white/[.145]">
+        <h2 className="text-lg font-medium">Sessions</h2>
+        <p className="text-sm opacity-70">
+          Signs this and every other device out. You&apos;ll need to sign in again everywhere.
+        </p>
+        <SignOutAllDevicesButton />
+      </section>
+
+      <section className="space-y-4 rounded-xl border border-red-600/20 p-6 dark:border-red-400/20">
+        <h2 className="text-lg font-medium text-red-600 dark:text-red-400">Danger zone</h2>
+        <p className="text-sm opacity-70">
+          Permanently delete your account and all of your data. This can&apos;t be undone.
+        </p>
+        <DeleteAccountButton />
+      </section>
+    </main>
+  );
+}
