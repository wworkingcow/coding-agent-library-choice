+"use client";
+
+import { useTransition, type FormEvent } from "react";
+import { deleteAccountAction, signOutAllDevicesAction } from "./actions";
+
+export function SignOutAllDevicesButton() {
+  const [pending, startTransition] = useTransition();
+
+  function handleSubmit(e: FormEvent) {
+    e.preventDefault();
+    startTransition(() => {
+      signOutAllDevicesAction();
+    });
+  }
+
+  return (
+    <form onSubmit={handleSubmit}>
+      <button
+        type="submit"
+        disabled={pending}
+        className="flex h-10 items-center justify-center rounded-full border border-black/[.08] px-5 text-sm font-medium transition-colors hover:bg-black/[.04] disabled:opacity-60 dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
+      >
+        {pending ? "Signing out…" : "Sign out of all devices"}
+      </button>
+    </form>
+  );
+}
+
+export function DeleteAccountButton() {
+  const [pending, startTransition] = useTransition();
+
+  function handleSubmit(e: FormEvent) {
+    e.preventDefault();
+    if (!window.confirm("Delete your account? This can't be undone.")) return;
+    startTransition(() => {
+      deleteAccountAction();
+    });
+  }
+
+  return (
+    <form onSubmit={handleSubmit}>
+      <button
+        type="submit"
+        disabled={pending}
+        className="flex h-10 items-center justify-center rounded-full border border-red-600/30 px-5 text-sm font-medium text-red-600 transition-colors hover:bg-red-600/10 disabled:opacity-60 dark:border-red-400/30 dark:text-red-400 dark:hover:bg-red-400/10"
+      >
+        {pending ? "Deleting…" : "Delete account"}
+      </button>
+    </form>
+  );
+}
