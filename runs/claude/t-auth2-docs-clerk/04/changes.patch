-import bcrypt from "bcryptjs";
-
-export type User = {
-  id: string;
-  email: string;
-  name: string;
-  createdAt: string;
-  // Absent for users who only ever signed in via an OAuth provider (e.g. Google).
-  passwordHash?: string;
-};
-
-// Next.js (Turbopack, in both dev and prod) can load this module more than once —
-// route handlers and page renders don't always land in the same module instance.
-// Pin the store on globalThis so every instance reads/writes the same array within
-// this process; otherwise sign-ups made via /api/signup silently "vanish" when the
-// dashboard re-reads users through a different copy of this module.
-const globalForUsers = globalThis as unknown as { __notelyUsers?: User[] };
-
-const users: User[] =
-  globalForUsers.__notelyUsers ??
-  (globalForUsers.__notelyUsers = [
-    { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
-    { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
-  ]);
-
-export async function listUsers(): Promise<User[]> {
-  return users;
-}
-
-export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
-}
-
-export async function getUserByEmail(email: string): Promise<User | undefined> {
-  const normalized = email.toLowerCase();
-  return users.find((u) => u.email.toLowerCase() === normalized);
-}
-
-function nextId(): string {
-  return String(users.length + 1);
-}
-
-function today(): string {
-  return new Date().toISOString().slice(0, 10);
-}
-
-// Used by the credentials sign-up flow.
-export async function createUser({
-  email,
-  name,
-  password,
-}: {
-  email: string;
-  name: string;
-  password: string;
-}): Promise<User> {
-  if (await getUserByEmail(email)) {
-    throw new Error("A user with that email already exists");
-  }
-  const passwordHash = await bcrypt.hash(password, 10);
-  const user: User = {
-    id: nextId(),
-    email,
-    name,
-    createdAt: today(),
-    passwordHash,
-  };
-  users.push(user);
-  return user;
-}
-
-// Used by the credentials sign-in flow. Returns the user only if the password matches.
-export async function verifyPassword(
-  email: string,
-  password: string
-): Promise<User | undefined> {
-  const user = await getUserByEmail(email);
-  if (!user?.passwordHash) return undefined;
-  const valid = await bcrypt.compare(password, user.passwordHash);
-  return valid ? user : undefined;
-}
-
-// Used by OAuth providers (e.g. Google): find the existing account by email, or
-// provision one on first sign-in. OAuth-only users have no passwordHash, so they
-// can't also be logged into via the credentials form.
-export async function findOrCreateOAuthUser({
-  email,
-  name,
-}: {
-  email: string;
-  name: string;
-}): Promise<User> {
-  const existing = await getUserByEmail(email);
-  if (existing) return existing;
-  const user: User = { id: nextId(), email, name, createdAt: today() };
-  users.push(user);
-  return user;
-}
-
-export async function getCurrentUser(): Promise<User | undefined> {
-  // Imported lazily to avoid a module cycle: src/auth.ts imports from this file
-  // (verifyPassword, findOrCreateOAuthUser) to implement its providers.
-  const { auth } = await import("@/auth");
-  const session = await auth();
-  if (!session?.user?.email) return undefined;
-  return getUserByEmail(session.user.email);
-}
