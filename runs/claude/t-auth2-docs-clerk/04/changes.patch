@@ -0,0 +1,25 @@
+"use server";
+
+import { auth, clerkClient } from "@clerk/nextjs/server";
+import { redirect } from "next/navigation";
+
+// Revokes every active session for the current user (including the one
+// making this request), forcing sign-out on every device at once. Clerk's
+// prebuilt <UserProfile/> only lets a user sign a *single* other device out
+// at a time, so this uses the Backend API directly to do it in one action.
+export async function signOutAllDevices() {
+  const { userId } = await auth();
+  if (!userId) redirect("/signin");
+
+  const client = await clerkClient();
+  const { data: sessions } = await client.sessions.getSessionList({
+    userId,
+    status: "active",
+  });
+
+  await Promise.all(
+    sessions.map((session) => client.sessions.revokeSession(session.id)),
+  );
+
+  redirect("/signin");
+}
