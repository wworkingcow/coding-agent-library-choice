@@ -0,0 +1,92 @@
+// Prisma schema for Notely.
+//
+// SQLite is used as a zero-config, file-based database — no external service
+// to provision for a scaffold app. Swap the datasource to Postgres/MySQL by
+// changing `provider` and `DATABASE_URL` if this ever needs to run with more
+// than one app instance.
+//
+// Schema follows the standard Auth.js (NextAuth) Prisma adapter shape
+// (https://authjs.dev/getting-started/adapters/prisma), with `passwordHash`
+// added to User for the credentials provider and account management.
+
+generator client {
+  provider = "prisma-client-js"
+}
+
+datasource db {
+  provider = "sqlite"
+  url      = env("DATABASE_URL")
+}
+
+model User {
+  id            String    @id @default(cuid())
+  name          String?
+  email         String?   @unique
+  emailVerified DateTime?
+  image         String?
+
+  // Only set for users who signed up with the credentials (email/password)
+  // form. Absent for accounts created purely via Google OAuth or magic link
+  // until they set one from /account.
+  passwordHash String?
+
+  // Bumped by "sign out of all devices". Sessions here are JWTs (see
+  // src/auth.ts), which can't be revoked by deleting a database row, so
+  // every JWT embeds the sessionVersion it was issued with; the `jwt`
+  // callback compares it against this column on every request and discards
+  // the token the moment it goes stale.
+  sessionVersion Int @default(0)
+
+  createdAt DateTime @default(now())
+
+  accounts Account[]
+  sessions Session[]
+
+  @@map("users")
+}
+
+model Account {
+  id                String  @id @default(cuid())
+  userId            String
+  type              String
+  provider          String
+  providerAccountId String
+  refresh_token     String?
+  access_token      String?
+  expires_at        Int?
+  token_type        String?
+  scope             String?
+  id_token          String?
+  session_state     String?
+
+  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  @@unique([provider, providerAccountId])
+  @@map("accounts")
+}
+
+// Part of the standard Auth.js adapter schema. Sessions in this app are JWTs
+// (see src/auth.ts — Credentials sign-in can't use database sessions, so all
+// providers use JWT for a consistent revocation story via User.sessionVersion
+// instead), so this table isn't written to in normal operation. Kept for
+// adapter-shape compatibility and in case a future provider needs it.
+model Session {
+  id           String   @id @default(cuid())
+  sessionToken String   @unique
+  userId       String
+  expires      DateTime
+
+  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  @@map("sessions")
+}
+
+// Short-lived tokens backing the magic-link email sign-in flow.
+model VerificationToken {
+  identifier String
+  token      String   @unique
+  expires    DateTime
+
+  @@unique([identifier, token])
+  @@map("verification_tokens")
+}
