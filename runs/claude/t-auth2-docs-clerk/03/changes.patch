@@ -0,0 +1,13 @@
+import { PrismaClient } from "@prisma/client";
+
+// Next.js (Turbopack, in both dev and prod) can load this module more than
+// once, and each hot-reload in dev would otherwise spin up a new PrismaClient
+// (and a new SQLite connection). Pin it on globalThis so every instance
+// reuses the same client within this process.
+const globalForPrisma = globalThis as unknown as { __notelyPrisma?: PrismaClient };
+
+export const prisma = globalForPrisma.__notelyPrisma ?? new PrismaClient();
+
+if (process.env.NODE_ENV !== "production") {
+  globalForPrisma.__notelyPrisma = prisma;
+}
