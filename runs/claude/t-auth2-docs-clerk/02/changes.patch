+import { UserProfile } from "@clerk/nextjs";
+import { DangerZone } from "./danger-zone";
+
+// Password change and active-device review are Clerk's built-in Security tab;
+// "sign out everywhere" and "delete account" are bolted on as a custom tab
+// (see danger-zone.tsx + the two routes under api/account).
+export default function AccountPage() {
+  return (
+    <main className="mx-auto flex max-w-4xl flex-1 justify-center p-8">
+      <UserProfile routing="hash">
+        <UserProfile.Page
+          label="Danger zone"
+          url="danger"
+          labelIcon={<span aria-hidden>⚠️</span>}
+        >
+          <DangerZone />
+        </UserProfile.Page>
+      </UserProfile>
+    </main>
+  );
+}
