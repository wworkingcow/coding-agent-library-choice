@@ -0,0 +1,82 @@
+"use client";
+
+import { useState } from "react";
+import { useClerk } from "@clerk/nextjs";
+
+// Rendered as a custom tab inside <UserProfile>. Password changes and
+// per-device session review already live in Clerk's own Security tab; this
+// covers the two actions that need our own backend route because Clerk's
+// frontend SDK only ever sees sessions on *this* browser, not other devices.
+export function DangerZone() {
+  const { signOut } = useClerk();
+  const [signingOut, setSigningOut] = useState(false);
+  const [deleting, setDeleting] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  async function handleSignOutEverywhere() {
+    setError(null);
+    setSigningOut(true);
+    try {
+      const res = await fetch("/api/account/sign-out-everywhere", { method: "POST" });
+      if (!res.ok) throw new Error("Could not sign out of all devices.");
+      await signOut({ redirectUrl: "/signin" });
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Something went wrong.");
+      setSigningOut(false);
+    }
+  }
+
+  async function handleDeleteAccount() {
+    if (!window.confirm("Delete your account? This can't be undone.")) return;
+    setError(null);
+    setDeleting(true);
+    try {
+      const res = await fetch("/api/account/delete", { method: "POST" });
+      if (!res.ok) throw new Error("Could not delete your account.");
+      window.location.href = "/";
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Something went wrong.");
+      setDeleting(false);
+    }
+  }
+
+  return (
+    <div className="space-y-8 px-1 py-4">
+      <section className="space-y-2">
+        <h2 className="text-base font-medium">Sign out of all devices</h2>
+        <p className="text-sm text-zinc-500">
+          Ends every active session for your account — this browser and any others
+          (phone, other computers, etc.) — and signs you out here too.
+        </p>
+        <button
+          type="button"
+          onClick={handleSignOutEverywhere}
+          disabled={signingOut}
+          className="h-9 rounded-full border border-black/[.08] px-4 text-sm font-medium transition-colors hover:bg-black/[.04] disabled:opacity-60 dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
+        >
+          {signingOut ? "Signing out…" : "Sign out everywhere"}
+        </button>
+      </section>
+
+      <section className="space-y-2 border-t border-black/[.08] pt-6 dark:border-white/[.145]">
+        <h2 className="text-base font-medium text-red-600 dark:text-red-400">
+          Delete account
+        </h2>
+        <p className="text-sm text-zinc-500">
+          Permanently deletes your account and signs you out everywhere. There is no
+          undo.
+        </p>
+        <button
+          type="button"
+          onClick={handleDeleteAccount}
+          disabled={deleting}
+          className="h-9 rounded-full bg-red-600 px-4 text-sm font-medium text-white transition-colors hover:bg-red-700 disabled:opacity-60"
+        >
+          {deleting ? "Deleting…" : "Delete my account"}
+        </button>
+      </section>
+
+      {error && <p className="text-sm text-red-600 dark:text-red-400">{error}</p>}
+    </div>
+  );
+}
