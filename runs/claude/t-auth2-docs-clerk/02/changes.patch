+++ b/src/app/api/account/delete/route.ts
@@ -0,0 +1,17 @@
+import { NextResponse } from "next/server";
+import { auth, clerkClient } from "@clerk/nextjs/server";
+
+// Self-service delete via the Backend API — this works regardless of the
+// Clerk Dashboard's "allow users to delete their own account" toggle, since
+// we're deleting the same user the verified session belongs to.
+export async function POST() {
+  const { userId } = await auth();
+  if (!userId) {
+    return NextResponse.json({ error: "Not signed in." }, { status: 401 });
+  }
+
+  const client = await clerkClient();
+  await client.users.deleteUser(userId);
+
+  return NextResponse.json({ ok: true });
+}
