@@ -0,0 +1,22 @@
+import { NextResponse } from "next/server";
+import { auth, clerkClient } from "@clerk/nextjs/server";
+
+// Revokes every active session for the current user across all devices —
+// Clerk's frontend SDK only ever sees sessions on the calling browser, so this
+// has to go through the Backend API.
+export async function POST() {
+  const { userId } = await auth();
+  if (!userId) {
+    return NextResponse.json({ error: "Not signed in." }, { status: 401 });
+  }
+
+  const client = await clerkClient();
+  const { data: sessions } = await client.sessions.getSessionList({
+    userId,
+    status: "active",
+  });
+
+  await Promise.all(sessions.map((session) => client.sessions.revokeSession(session.id)));
+
+  return NextResponse.json({ ok: true });
+}
