+import { inngest } from "./client";
+
+export const USER_CREATED_EVENT = "notely/user.created";
+
+export type UserCreatedData = {
+  userId: string;
+  email: string;
+  name: string;
+};
+
+export const userReminder = inngest.createFunction(
+  {
+    id: "user-reminder",
+    triggers: [{ event: USER_CREATED_EVENT }],
+    // Up to 4 retries (5 attempts) with Inngest's exponential backoff.
+    retries: 4,
+  },
+  async ({ event, step, logger }) => {
+    const { userId, email, name } = event.data as UserCreatedData;
+
+    await step.sleep("wait-10-minutes", "10m");
+
+    // Each step is retried independently, so a failure here never restarts the sleep.
+    await step.run("log-reminder", () => {
+      logger.info(`Reminder: say hello to ${name} <${email}> (user ${userId}), signed up 10 minutes ago`);
+    });
+  },
+);
+
+export const functions = [userReminder];
