@@ -10,6 +13,25 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const user: User = {
+    id: String(users.length + 1),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Schedules the 10-minute reminder job; the id makes duplicate sends a no-op.
+  await inngest.send({
+    id: `user-created-${user.id}`,
+    name: USER_CREATED_EVENT,
+    data: { userId: user.id, email: user.email, name: user.name },
+  });
+
+  return user;
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
