@@ -10,6 +12,28 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const user: User = {
+    id: String(users.length + 1),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString(),
+  };
+  users.push(user);
+
+  // The reminder job runs 10 minutes later (see src/inngest/functions.ts).
+  // Don't fail user creation if the queue is unreachable.
+  try {
+    await inngest.send({
+      name: "notely/user.created",
+      data: { userId: user.id, email: user.email, name: user.name },
+    });
+  } catch (err) {
+    console.error("Failed to schedule reminder job", err);
+  }
+  return user;
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
