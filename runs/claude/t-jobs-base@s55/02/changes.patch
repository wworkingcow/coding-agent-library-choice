+import { inngest } from "./client";
+
+export const USER_CREATED_EVENT = "notely/user.created";
+export const REMINDER_DELAY_MS = 10 * 60 * 1000;
+
+export type UserCreatedData = { userId: string; email: string; name: string };
+
+// Runs once per created user. The event is sent with a future `ts`, so Inngest
+// holds it until then. A thrown error is retried with backoff (up to `retries`).
+export const userReminder = inngest.createFunction(
+  {
+    id: "user-reminder",
+    retries: 4,
+    triggers: [{ event: USER_CREATED_EVENT }],
+  },
+  async ({ event, attempt, logger }) => {
+    const { userId, email, name } = event.data as UserCreatedData;
+    logger.info(
+      `Reminder: say hello to ${name} <${email}> (user ${userId}), attempt ${attempt + 1}`,
+    );
+    return { userId, reminded: true };
+  },
+);
+
+export const functions = [userReminder];
