+import { inngest } from "./client";
+
+export const USER_CREATED_EVENT = "notely/user.created";
+
+export type UserCreatedData = { userId: string; email: string; name: string };
+
+// Sleeps 10 minutes, then logs a reminder. Inngest retries the function
+// (with backoff) if the step throws; the sleep is not repeated on retry.
+export const userReminder = inngest.createFunction(
+  { id: "user-reminder", retries: 5, triggers: [{ event: USER_CREATED_EVENT }] },
+  async ({ event, step }) => {
+    const data = event.data as UserCreatedData;
+    await step.sleep("wait-10-minutes", "10m");
+    await step.run("log-reminder", () => {
+      console.log(`[reminder] ${data.name} <${data.email}> (user ${data.userId}) joined Notely 10 minutes ago`);
+    });
+  },
+);
