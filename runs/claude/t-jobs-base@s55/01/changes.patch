 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,24 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const user: User = {
+    id: String(users.length + 1),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Schedule the reminder job. A queueing failure must not fail user creation.
+  try {
+    await inngest.send({
+      name: USER_CREATED_EVENT,
+      data: { userId: user.id, email: user.email, name: user.name } satisfies UserCreatedData,
+    });
+  } catch (err) {
+    console.error("Failed to schedule reminder job for user", user.id, err);
+  }
+  return user;
+}
