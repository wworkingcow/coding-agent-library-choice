@@ -22,3 +25,26 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const user: User = {
+    id: String(users.length + 1),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Schedule the reminder; the user is already created, so a scheduling failure must not undo it.
+  try {
+    await inngest.send({
+      id: `user-reminder-${user.id}`, // idempotency key
+      name: USER_CREATED_EVENT,
+      data: { userId: user.id, email: user.email, name: user.name } satisfies UserCreatedData,
+      ts: Date.now() + REMINDER_DELAY_MS,
+    });
+  } catch (err) {
+    console.error(`Failed to schedule reminder for user ${user.id}`, err);
+  }
+  return user;
+}
