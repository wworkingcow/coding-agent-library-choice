+import { inngest } from "./client";
+
+export const USER_CREATED_EVENT = "notely/user.created";
+export const REMINDER_DELAY_MS = 10 * 60 * 1000;
+
+export type UserCreatedData = { userId: string; email: string; name: string };
+
+// The event is sent with a `ts` 10 minutes in the future, so this runs then.
+// Inngest retries a failed run with backoff, up to `retries` extra attempts.
+export const userReminder = inngest.createFunction(
+  { id: "user-reminder", retries: 5, triggers: [{ event: USER_CREATED_EVENT }] },
+  async ({ event, step }) => {
+    const { userId, email, name } = event.data as UserCreatedData;
+    await step.run("log-reminder", () => {
+      console.log(`[reminder] ${name} <${email}> (user ${userId}) signed up 10 minutes ago`);
+    });
+  },
+);
