+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const user: User = {
+    id: String(users.length + 1),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Schedules the 10-minute reminder job (see src/inngest/functions.ts).
+  // A scheduling failure must not fail user creation.
+  try {
+    await inngest.send({
+      name: USER_CREATED_EVENT,
+      data: { userId: user.id, email: user.email, name: user.name },
+    });
+  } catch (err) {
+    console.error("Failed to schedule user reminder", err);
+  }
+
+  return user;
+}
+
 export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
