+import { inngest } from "./client";
+
+export const USER_CREATED_EVENT = "notely/user.created";
+
+export const REMINDER_DELAY = "10m";
+
+export const userReminder = inngest.createFunction(
+  { id: "user-reminder", retries: 4, triggers: [{ event: USER_CREATED_EVENT }] },
+  async ({ event, step }) => {
+    // Durable sleep: survives restarts and doesn't hold a serverless invocation open.
+    await step.sleep("wait-before-reminder", REMINDER_DELAY);
+
+    // Retried with backoff by Inngest if it throws.
+    await step.run("log-reminder", async () => {
+      const { userId, email, name } = event.data;
+      console.log(`[reminder] ${name} <${email}> (user ${userId}) signed up ${REMINDER_DELAY} ago`);
+    });
+  },
+);
+
+export const functions = [userReminder];
