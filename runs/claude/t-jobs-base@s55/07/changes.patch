@@ -0,0 +1,22 @@
+import { inngest } from "./client";
+
+export const USER_CREATED = "user/created";
+export const REMINDER_DELAY = "10m";
+
+export type UserCreatedData = { userId: string; email: string; name: string };
+
+export const userReminder = inngest.createFunction(
+  { id: "user-reminder", retries: 5, triggers: [{ event: USER_CREATED }] },
+  async ({ event, step }) => {
+    const { userId, email, name } = event.data as UserCreatedData;
+
+    await step.sleep("wait-before-reminder", REMINDER_DELAY);
+
+    // Each step is retried independently with backoff if it throws.
+    await step.run("log-reminder", () => {
+      console.log(`[reminder] ${name} <${email}> (user ${userId}) signed up ${REMINDER_DELAY} ago`);
+    });
+  },
+);
+
+export const functions = [userReminder];
