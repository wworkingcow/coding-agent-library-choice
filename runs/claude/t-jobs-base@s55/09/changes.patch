 }
 
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const user: User = {
+    id: String(users.length + 1),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Fire-and-forget: a failed enqueue must not fail signup.
+  try {
+    await inngest.send({
+      name: "notely/user.created",
+      data: { userId: user.id, email: user.email, name: user.name },
+    });
+  } catch (err) {
+    console.error("Failed to schedule reminder job", err);
+  }
+
+  return user;
+}
+
 export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
