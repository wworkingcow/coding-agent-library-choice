+++ b/src/inngest/functions.ts
@@ -0,0 +1,18 @@
+import { inngest } from "./client";
+
+export const userReminder = inngest.createFunction(
+  {
+    id: "user-reminder",
+    retries: 5,
+    triggers: [{ event: "notely/user.created" }],
+  },
+  async ({ event, step }) => {
+    await step.sleep("wait-10-minutes", "10m");
+    await step.run("log-reminder", async () => {
+      const { userId, email, name } = event.data;
+      console.log(`[reminder] Hi ${name} (${email}), user ${userId} signed up 10 minutes ago.`);
+    });
+  },
+);
+
+export const functions = [userReminder];
