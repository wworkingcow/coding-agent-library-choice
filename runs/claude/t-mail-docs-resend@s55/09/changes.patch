diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..902d325
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,40 @@
+import { resend } from "@/lib/resend";
+import { WelcomeEmail } from "@/emails/welcome";
+import { PasswordResetEmail } from "@/emails/password-reset";
+
+const appUrl = () => process.env.APP_URL ?? "http://localhost:3000";
+
+// Resend resolves to { error } instead of throwing on refused messages. Email is
+// best-effort: log failures and return false so they never break the calling request.
+async function send(opts: Parameters<typeof resend.emails.send>[0]): Promise<boolean> {
+  try {
+    const { error } = await resend.emails.send(opts);
+    if (error) {
+      console.error(`[email] send failed (${error.name}): ${error.message}`);
+      return false;
+    }
+    return true;
+  } catch (err) {
+    console.error("[email] send threw", err);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  return send({
+    from: process.env.RESEND_FROM_EMAIL!,
+    to: user.email,
+    subject: "Welcome to Notely",
+    react: WelcomeEmail({ name: user.name, appUrl: appUrl() }),
+  });
+}
+
+export function sendPasswordResetEmail(user: { email: string; name: string }, token: string) {
+  const actionUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return send({
+    from: process.env.RESEND_FROM_EMAIL!,
+    to: user.email,
+    subject: "Reset your Notely password",
+    react: PasswordResetEmail({ name: user.name, actionUrl }),
+  });
+}
