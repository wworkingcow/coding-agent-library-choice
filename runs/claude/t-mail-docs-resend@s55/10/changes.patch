index 1b4b6c1..ca7a7c7 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,26 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) throw new Error("Email already registered");
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  await sendWelcomeEmail(user);
+  return user;
+}
+
+// TODO: persist tokens (hashed, with expiry) once there is a database; the reset
+// page that consumes the token doesn't exist yet either.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === email.trim().toLowerCase());
+  // Unknown addresses return silently so callers can't probe which emails exist.
+  if (!user) return;
+  await sendPasswordResetEmail(user, randomBytes(32).toString("hex"));
+}
