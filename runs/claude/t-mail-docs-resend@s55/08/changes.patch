diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..011be2c
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,30 @@
+import type { ReactElement } from "react";
+import { getResend } from "@/lib/resend";
+import { WelcomeEmail } from "@/emails/welcome";
+import { PasswordResetEmail } from "@/emails/password-reset";
+
+const appUrl = () => process.env.APP_URL ?? "http://localhost:3000";
+
+// Resend resolves to { error } instead of throwing; a failed email must not break the caller.
+async function send(to: string, subject: string, react: ReactElement) {
+  try {
+    const { error } = await getResend().emails.send({
+      from: process.env.RESEND_FROM_EMAIL ?? "onboarding@resend.dev",
+      to,
+      subject,
+      react,
+    });
+    if (error) console.error(`Email "${subject}" failed: ${error.name}: ${error.message}`);
+  } catch (e) {
+    console.error(`Email "${subject}" failed:`, e);
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  return send(user.email, "Welcome to Notely", WelcomeEmail({ name: user.name, appUrl: appUrl() }));
+}
+
+export function sendPasswordResetEmail(user: { email: string; name: string }, token: string) {
+  const actionUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return send(user.email, "Reset your Notely password", PasswordResetEmail({ name: user.name, actionUrl }));
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..d84c305
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,9 @@
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+export function getResend(): Resend {
+  const key = process.env.RESEND_API_KEY;
+  if (!key) throw new Error("RESEND_API_KEY is not set");
+  return (client ??= new Resend(key));
+}
