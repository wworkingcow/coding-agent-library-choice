diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..e2b9de3
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,46 @@
+import { WelcomeEmail } from "@/emails/welcome";
+import { PasswordResetEmail } from "@/emails/password-reset";
+import { getResend } from "@/lib/resend";
+import type { User } from "@/lib/users";
+
+const appUrl = () => process.env.APP_URL ?? "http://localhost:3000";
+
+type Message = { to: string; subject: string; react: React.ReactElement };
+
+// Email failures are logged, never thrown: they must not break the request that triggered them.
+async function send({ to, subject, react }: Message): Promise<boolean> {
+  const resend = getResend();
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!resend || !from) {
+    console.warn(`[email] RESEND_API_KEY / RESEND_FROM_EMAIL not set; skipping "${subject}"`);
+    return false;
+  }
+  try {
+    const { error } = await resend.emails.send({ from, to, subject, react });
+    if (error) {
+      console.error(`[email] "${subject}" refused: ${error.name}: ${error.message}`);
+      return false;
+    }
+    return true;
+  } catch (e) {
+    console.error(`[email] "${subject}" failed`, e);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(user: User) {
+  return send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    react: WelcomeEmail({ name: user.name, appUrl: appUrl() }),
+  });
+}
+
+export function sendPasswordResetEmail(user: User, token: string) {
+  const actionUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    react: PasswordResetEmail({ name: user.name, actionUrl }),
+  });
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..85972f4
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,11 @@
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+// Server-only. Created lazily so builds and dev work without a key configured.
+export function getResend(): Resend | undefined {
+  const key = process.env.RESEND_API_KEY;
+  if (!key) return undefined;
+  client ??= new Resend(key);
+  return client;
+}
