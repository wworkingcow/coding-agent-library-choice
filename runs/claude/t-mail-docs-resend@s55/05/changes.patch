diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..f215e0e
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,47 @@
+import { resend } from "@/lib/resend";
+
+const appUrl = () => process.env.NEXT_PUBLIC_APP_URL ?? "http://localhost:3000";
+
+const escapeHtml = (s: string) =>
+  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+// Resolves to false (never throws) so a failed email doesn't break the request that triggered it.
+async function send(to: string, subject: string, html: string, text: string): Promise<boolean> {
+  try {
+    const { error } = await resend.emails.send({
+      from: process.env.RESEND_FROM_EMAIL!,
+      to,
+      subject,
+      html,
+      text,
+    });
+    if (error) {
+      console.error(`[email] "${subject}" failed: ${error.name}: ${error.message}`);
+      return false;
+    }
+    return true;
+  } catch (err) {
+    console.error(`[email] "${subject}" failed:`, err);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  const url = `${appUrl()}/dashboard`;
+  return send(
+    user.email,
+    "Welcome to Notely",
+    `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a> to start taking notes.</p>`,
+    `Hi ${user.name},\n\nWelcome to Notely! Open your dashboard to start taking notes: ${url}`,
+  );
+}
+
+export function sendPasswordResetEmail(user: { email: string; name: string }, token: string) {
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return send(
+    user.email,
+    "Reset your Notely password",
+    `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${url}">Reset your password</a>. This link expires in 1 hour. If you didn't request it, you can ignore this email.</p>`,
+    `Hi ${user.name},\n\nReset your password (link expires in 1 hour): ${url}\n\nIf you didn't request this, ignore this email.`,
+  );
+}
