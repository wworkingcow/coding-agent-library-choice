 export type User = {
   id: string;
   email: string;
@@ -14,6 +17,33 @@ export async function listUsers(): Promise<User[]> {
   return users;
 }
 
+export async function createUser(input: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const user: User = {
+    id: String(users.length + 1),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Schedule the "10 minutes later" reminder job. This just enqueues the
+  // event — Inngest owns the delay/retry logic in src/lib/inngest/functions.ts.
+  await inngest.send({
+    name: USER_CREATED_EVENT,
+    data: {
+      userId: user.id,
+      email: user.email,
+      name: user.name,
+      createdAt: user.createdAt,
+    },
+  });
+
+  return user;
+}
+
 export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
