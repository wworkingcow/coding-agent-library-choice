--- /dev/null
+++ b/src/lib/inngest/functions.ts
@@ -0,0 +1,38 @@
+import { inngest } from "./client";
+
+// Fired whenever a new user is created (see createUser in src/lib/users.ts).
+export const USER_CREATED_EVENT = "user/created";
+
+export type UserCreatedEvent = {
+  name: typeof USER_CREATED_EVENT;
+  data: {
+    userId: string;
+    email: string;
+    name: string;
+    createdAt: string;
+  };
+};
+
+// Waits 10 minutes after a user is created, then logs a reminder.
+// Inngest persists the sleep durably (it doesn't hold a server/process open)
+// and automatically retries the run — with backoff — if the log step throws,
+// up to `retries` times, before giving up.
+export const sendUserCreatedReminder = inngest.createFunction(
+  {
+    id: "send-user-created-reminder",
+    retries: 3,
+    triggers: [{ event: USER_CREATED_EVENT }],
+  },
+  async ({ event, step }) => {
+    await step.sleep("wait-10-minutes", "10m");
+
+    await step.run("log-reminder", async () => {
+      console.log(
+        `[reminder] Follow up with ${event.data.name} <${event.data.email}> ` +
+          `(user ${event.data.userId}, created ${event.data.createdAt})`
+      );
+    });
+  }
+);
+
+export const functions = [sendUserCreatedReminder];
