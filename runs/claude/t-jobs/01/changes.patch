+import { Inngest } from "inngest";
+
+// Central Inngest client. Every background job (scheduled reminders, retries,
+// etc.) is sent and handled through this instance.
+//
+// In dev, Inngest runs against the local Inngest Dev Server (`npx inngest-cli dev`)
+// with no credentials needed. In production, set INNGEST_EVENT_KEY and
+// INNGEST_SIGNING_KEY (see .env.example) so the app can talk to Inngest Cloud.
+export const inngest = new Inngest({ id: "notely" });
