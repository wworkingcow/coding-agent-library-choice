+export async function createUser(input: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const user: User = {
+    id: String(nextId++),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Schedule the 10-minute welcome reminder as a background job (see
+  // src/lib/inngest/functions.ts). Sending the event just enqueues it —
+  // Inngest owns the delay and retries from here, so this doesn't block
+  // or fail user creation if the job itself has trouble later.
+  await inngest.send(
+    userCreatedEvent.create({
+      userId: user.id,
+      email: user.email,
+      name: user.name,
+    })
+  );
+
+  return user;
+}
