@@ -0,0 +1,22 @@
+import { Inngest, eventType, staticSchema } from "inngest";
+
+// Background job runner for Notely.
+//
+// Inngest was picked because it needs no infra of its own (no Redis/queue to
+// stand up) — it's a hosted event + durable-function service with a single
+// Next.js route handler (see src/app/api/inngest/route.ts). Locally it runs
+// against the free `inngest-cli dev` dev server; in production it talks to
+// the Inngest Cloud API using the keys below.
+export const inngest = new Inngest({ id: "notely" });
+
+// The typed contract between "something happened" (a user was created) and
+// the functions that react to it (src/lib/inngest/functions.ts). staticSchema
+// gives us compile-time typing for the event data without pulling in a
+// runtime validation library.
+export const userCreatedEvent = eventType("user/created", {
+  schema: staticSchema<{
+    userId: string;
+    email: string;
+    name: string;
+  }>(),
+});
diff --git a/src/lib/inngest/functions.ts b/src/lib/inngest/functions.ts
new file mode 100644
index 0000000..19ada7d
--- /dev/null
+++ b/src/lib/inngest/functions.ts
@@ -0,0 +1,29 @@
+import { inngest, userCreatedEvent } from "@/lib/inngest/client";
+
+// Fires whenever a "user/created" event is sent (see createUser in
+// src/lib/users.ts). Waits 10 minutes, then logs a reminder for that user.
+//
+// step.sleep durably suspends the function — Inngest persists the wakeup
+// time and resumes the function itself, so this survives deploys/restarts
+// without needing a timer to keep running in process.
+//
+// retries: 4 means the reminder step gets up to 4 retry attempts (5 tries
+// total) with backoff if it throws, before the run is marked failed.
+export const sendUserReminder = inngest.createFunction(
+  {
+    id: "send-user-reminder",
+    retries: 4,
+    triggers: [{ event: userCreatedEvent }],
+  },
+  async ({ event, step }) => {
+    const { userId, email, name } = event.data;
+
+    await step.sleep("wait-10-minutes", "10m");
+
+    await step.run("log-reminder", async () => {
+      console.log(
+        `[reminder] Hi ${name} (${email}, id=${userId}) — this is your 10-minute welcome reminder.`
+      );
+    });
+  }
+);
