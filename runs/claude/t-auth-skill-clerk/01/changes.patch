+++ b/src/middleware.ts
@@ -0,0 +1,12 @@
+import { clerkMiddleware } from "@clerk/nextjs/server";
+
+// Just wires up Clerk's session/auth context for every request. The actual
+// protection check lives on the /dashboard route itself (see
+// src/app/dashboard/page.tsx) via `auth.protect()` — Clerk recommends
+// resource-based checks over middleware path matching, since path matching
+// can drift out of sync with how Next.js actually routes requests.
+export default clerkMiddleware();
+
+export const config = {
+  matcher: ["/((?!_next|.*\\..*).*)", "/(api|trpc)(.*)"],
+};
