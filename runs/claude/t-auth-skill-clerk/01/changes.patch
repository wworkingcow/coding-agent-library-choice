+type ClerkUser = {
+  id: string;
+  firstName: string | null;
+  username: string | null;
+  emailAddresses: { emailAddress: string }[];
+};
+
+// Mirrors the signed-in Clerk user into the local user store, keyed by
+// Clerk's user id. Creates an entry the first time we see them, and keeps
+// name/email up to date on later calls.
+function syncClerkUser(clerkUser: ClerkUser): User {
+  const email = clerkUser.emailAddresses[0]?.emailAddress ?? "";
+  const name =
+    clerkUser.firstName ?? clerkUser.username ?? email.split("@")[0] ?? "User";
+
+  const existing = users.find((u) => u.id === clerkUser.id);
+  if (existing) {
+    existing.email = email;
+    existing.name = name;
+    return existing;
+  }
+
+  const created: User = {
+    id: clerkUser.id,
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(created);
+  return created;
+}
+
