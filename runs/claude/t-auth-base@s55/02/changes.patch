+// Internal record: the public User plus auth data that must never leave the server.
+type UserRecord = User & {
+  passwordHash?: string;
+  emailVerified: boolean;
+};
+
+// NOTE: in-memory store, as before. Accounts reset on server restart and are not
+// shared between instances. Swap these functions for a real database before production.
+const records: UserRecord[] = [
+  { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04", emailVerified: true },
+  { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11", emailVerified: true },
 ];
 
+const normalizeEmail = (email: string) => email.trim().toLowerCase();
+
+const toUser = ({ id, email, name, createdAt }: UserRecord): User => ({
+  id,
+  email,
+  name,
+  createdAt,
+});
+
+// Compared against when the email is unknown, so timing doesn't reveal which emails exist.
+const DUMMY_HASH = bcrypt.hashSync("dummy-password", 12);
+
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return records.map(toUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const r = records.find((u) => u.id === id);
+  return r && toUser(r);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const e = normalizeEmail(email);
+  const r = records.find((u) => u.email === e);
+  return r && toUser(r);
+}
+
+export async function createUserWithPassword(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (records.some((u) => u.email === email)) {
+    throw new Error("EMAIL_TAKEN");
+  }
+  const record: UserRecord = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: await bcrypt.hash(input.password, 12),
+    // Nobody has proven they own this address yet.
+    emailVerified: false,
+  };
+  records.push(record);
+  return toUser(record);
+}
+
+export async function verifyCredentials(
+  email: string,
+  password: string,
+): Promise<User | null> {
+  const e = normalizeEmail(email);
+  const r = records.find((u) => u.email === e);
+  const ok = await bcrypt.compare(password, r?.passwordHash ?? DUMMY_HASH);
+  return r && r.passwordHash && ok ? toUser(r) : null;
+}
+
+/**
+ * Find or create the user for a Google identity. Only call with an email Google
+ * reports as verified.
+ */
+export async function upsertGoogleUser(input: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const email = normalizeEmail(input.email);
+  const existing = records.find((u) => u.email === email);
+  if (existing) {
+    if (!existing.emailVerified) {
+      // The account was created by password sign-up with an unverified email. Whoever
+      // set that password may not own the address (pre-hijacking), so drop it. The
+      // verified owner can sign in with Google.
+      existing.passwordHash = undefined;
+      existing.emailVerified = true;
+    }
+    return toUser(existing);
+  }
+  const record: UserRecord = {
+    id: randomUUID(),
+    email,
+    name: input.name?.trim() || email.split("@")[0],
+    createdAt: new Date().toISOString().slice(0, 10),
+    emailVerified: true,
+  };
+  records.push(record);
+  return toUser(record);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+// Resolves the signed-in user from the session, or undefined if not signed in.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  // Imported lazily: auth.ts imports this module.
+  const { auth } = await import("@/auth");
+  const session = await auth();
+  return session?.user?.id ? getUser(session.user.id) : undefined;
 }
