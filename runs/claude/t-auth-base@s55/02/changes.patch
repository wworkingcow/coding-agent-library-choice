+"use server";
+
+import { AuthError } from "next-auth";
+import { z } from "zod";
+import { signIn, signOut } from "@/auth";
+import { createUserWithPassword } from "@/lib/users";
+
+export type FormState = { error?: string } | undefined;
+
+// Only allow same-site relative redirects.
+function safeRedirect(value: FormDataEntryValue | null): string {
+  const s = typeof value === "string" ? value : "";
+  return s.startsWith("/") && !s.startsWith("//") && !s.startsWith("/\\") ? s : "/dashboard";
+}
+
+export async function signInWithPassword(_: FormState, form: FormData): Promise<FormState> {
+  try {
+    await signIn("credentials", {
+      email: form.get("email"),
+      password: form.get("password"),
+      redirectTo: safeRedirect(form.get("callbackUrl")),
+    });
+  } catch (e) {
+    if (e instanceof AuthError) return { error: "Invalid email or password." };
+    throw e; // the redirect on success is thrown
+  }
+}
+
+const signUpSchema = z.object({
+  name: z.string().trim().min(1, "Name is required.").max(100),
+  email: z.string().email("Enter a valid email.").max(254),
+  password: z.string().min(8, "Password must be at least 8 characters.").max(72),
+});
+
+export async function signUp(_: FormState, form: FormData): Promise<FormState> {
+  const parsed = signUpSchema.safeParse({
+    name: form.get("name"),
+    email: form.get("email"),
+    password: form.get("password"),
+  });
+  if (!parsed.success) return { error: parsed.error.issues[0].message };
+
+  try {
+    await createUserWithPassword(parsed.data);
+  } catch (e) {
+    if (e instanceof Error && e.message === "EMAIL_TAKEN") {
+      return { error: "Could not create account. Try signing in instead." };
+    }
+    throw e;
+  }
+  await signIn("credentials", {
+    email: parsed.data.email,
+    password: parsed.data.password,
+    redirectTo: "/dashboard",
+  });
+}
+
+export async function signInWithGoogle(form: FormData) {
+  await signIn("google", { redirectTo: safeRedirect(form.get("callbackUrl")) });
+}
+
+export async function signOutAction() {
+  await signOut({ redirectTo: "/" });
+}
