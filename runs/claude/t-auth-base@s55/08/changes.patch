+// Internal record: never returned from the public helpers below.
+type UserRecord = User & {
+  passwordHash?: string;
+  // True once the email has been proven (Google reports email_verified).
+  // Password sign-ups start unverified.
+  emailVerified: boolean;
+};
+
+// NOTE: in-memory store (no database in this project yet). Data resets on restart.
+// Kept on globalThis so dev-mode hot reloads don't wipe it. Swap these functions
+// for real DB queries when a database is added; the exported API can stay the same.
+const g = globalThis as unknown as { __notelyUsers?: UserRecord[] };
+const users: UserRecord[] = (g.__notelyUsers ??= [
+  { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04", emailVerified: true },
+  { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11", emailVerified: true },
+]);
+
+const normalize = (email: string) => email.trim().toLowerCase();
+
+function toUser({ id, email, name, createdAt }: UserRecord): User {
+  return { id, email, name, createdAt };
+}
 
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const u = users.find((u) => u.id === id);
+  return u && toUser(u);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const e = normalize(email);
+  const u = users.find((u) => u.email === e);
+  return u && toUser(u);
+}
+
+export class EmailTakenError extends Error {}
+
+export async function createUserWithPassword(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = normalize(input.email);
+  if (users.some((u) => u.email === email)) throw new EmailTakenError();
+  const record: UserRecord = {
+    id: crypto.randomUUID(),
+    email,
+    name: input.name.trim() || email.split("@")[0],
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: await bcrypt.hash(input.password, 12),
+    emailVerified: false,
+  };
+  users.push(record);
+  return toUser(record);
+}
+
+// Returns the user if email/password match, otherwise undefined.
+export async function verifyPassword(
+  email: string,
+  password: string,
+): Promise<User | undefined> {
+  const u = users.find((u) => u.email === normalize(email));
+  // Compare against a dummy hash when the user is unknown, to keep timing similar.
+  const hash = u?.passwordHash ?? "$2b$12$C6UzMDM.H6dfI/f/IKcEeO5Yq3q6m7iQxFZ3s1m5Yb5m3Zq5kqzGa";
+  const ok = await bcrypt.compare(password, hash);
+  return u && u.passwordHash && ok ? toUser(u) : undefined;
+}
+
+// Finds or creates the user for a Google sign-in. Only call with a verified email.
+export async function upsertGoogleUser(input: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const email = normalize(input.email);
+  const existing = users.find((u) => u.email === email);
+  if (existing) {
+    if (!existing.emailVerified) {
+      // Someone may have pre-registered this address with a password they chose
+      // before the real owner proved ownership via Google. Drop that password.
+      existing.passwordHash = undefined;
+      existing.emailVerified = true;
+    }
+    return toUser(existing);
+  }
+  const record: UserRecord = {
+    id: crypto.randomUUID(),
+    email,
+    name: input.name?.trim() || email.split("@")[0],
+    createdAt: new Date().toISOString().slice(0, 10),
+    emailVerified: true,
+  };
+  users.push(record);
+  return toUser(record);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+// The signed-in user from the session, or undefined when signed out.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const session = await auth();
+  const id = session?.user?.id;
+  return id ? getUser(id) : undefined;
 }
