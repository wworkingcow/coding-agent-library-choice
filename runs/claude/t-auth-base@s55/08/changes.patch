+"use client";
+
+import Link from "next/link";
+import { useActionState } from "react";
+import { signInWithGoogle, type FormState } from "./actions";
+
+const input = "w-full rounded border border-black/20 bg-transparent px-3 py-2 text-sm dark:border-white/25";
+const button = "w-full rounded bg-foreground px-3 py-2 text-sm font-medium text-background disabled:opacity-60";
+
+export function AuthForm({
+  mode,
+  action,
+}: {
+  mode: "signin" | "signup";
+  action: (s: FormState, f: FormData) => Promise<FormState>;
+}) {
+  const [state, formAction, pending] = useActionState(action, undefined);
+  const isSignUp = mode === "signup";
+  return (
+    <main className="mx-auto w-full max-w-sm p-8">
+      <h1 className="text-2xl font-semibold">{isSignUp ? "Create account" : "Sign in"}</h1>
+      <form action={formAction} className="mt-6 space-y-3">
+        {isSignUp && <input name="name" placeholder="Name" autoComplete="name" className={input} />}
+        <input name="email" type="email" placeholder="Email" required autoComplete="email" className={input} />
+        <input
+          name="password"
+          type="password"
+          placeholder="Password"
+          required
+          minLength={isSignUp ? 8 : undefined}
+          autoComplete={isSignUp ? "new-password" : "current-password"}
+          className={input}
+        />
+        {state?.error && <p role="alert" className="text-sm text-red-600">{state.error}</p>}
+        <button disabled={pending} className={button}>{isSignUp ? "Sign up" : "Sign in"}</button>
+      </form>
+      <form action={signInWithGoogle} className="mt-3">
+        <button className="w-full rounded border border-black/20 px-3 py-2 text-sm dark:border-white/25">
+          Continue with Google
+        </button>
+      </form>
+      <p className="mt-6 text-sm opacity-70">
+        {isSignUp ? (
+          <>Have an account? <Link href="/signin" className="underline">Sign in</Link></>
+        ) : (
+          <>New here? <Link href="/signup" className="underline">Create an account</Link></>
+        )}
+      </p>
+    </main>
+  );
+}
