+import NextAuth from "next-auth";
+import Credentials from "next-auth/providers/credentials";
+import Google from "next-auth/providers/google";
+import authConfig from "./auth.config";
+import { upsertGoogleUser, verifyPassword } from "@/lib/users";
+
+export const { handlers, auth, signIn, signOut } = NextAuth({
+  ...authConfig,
+  providers: [
+    // Reads AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET from the environment.
+    Google,
+    Credentials({
+      credentials: { email: {}, password: {} },
+      async authorize(raw) {
+        const { email, password } = raw as Record<string, unknown>;
+        if (typeof email !== "string" || typeof password !== "string") return null;
+        return (await verifyPassword(email, password)) ?? null;
+      },
+    }),
+  ],
+  callbacks: {
+    ...authConfig.callbacks,
+    async jwt({ token, user, account, profile }) {
+      if (account?.provider === "google") {
+        // Refuse unverified Google emails so they can't claim someone else's account.
+        if (!profile?.email || profile.email_verified !== true) {
+          throw new Error("Google email not verified");
+        }
+        const u = await upsertGoogleUser({ email: profile.email, name: profile.name });
+        token.uid = u.id;
+      } else if (user?.id) {
+        token.uid = user.id;
+      }
+      return token;
+    },
+    session({ session, token }) {
+      if (typeof token.uid === "string") session.user.id = token.uid;
+      return session;
+    },
+  },
+});
