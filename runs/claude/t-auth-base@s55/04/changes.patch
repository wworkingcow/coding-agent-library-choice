-const users: User[] = [
+// Internal record: the password hash never leaves this module.
+type UserRecord = User & { passwordHash?: string };
+
+// NOTE: still an in-memory store (resets on restart). Swap for a database later;
+// the exported functions are the only surface the rest of the app uses.
+const globalStore = globalThis as unknown as { __notelyUsers?: UserRecord[] };
+const users: UserRecord[] = (globalStore.__notelyUsers ??= [
   { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
-];
+]);
+
+const normalizeEmail = (email: string) => email.trim().toLowerCase();
+
+const toUser = ({ passwordHash: _omit, ...user }: UserRecord): User => user;
+
+// Used to keep sign-in timing similar when the email is unknown.
+const DUMMY_HASH = bcrypt.hashSync("not-a-real-password", 12);
 
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const u = users.find((u) => u.id === id);
+  return u && toUser(u);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const e = normalizeEmail(email);
+  const u = users.find((u) => u.email === e);
+  return u && toUser(u);
+}
+
+export class EmailTakenError extends Error {
+  constructor() {
+    super("Email already registered");
+  }
+}
+
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (users.some((u) => u.email === email)) throw new EmailTakenError();
+  const record: UserRecord = {
+    id: crypto.randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: await bcrypt.hash(input.password, 12),
+  };
+  users.push(record);
+  return toUser(record);
+}
+
+/** Returns the user if the email/password pair is valid, otherwise null. */
+export async function verifyCredentials(
+  email: string,
+  password: string,
+): Promise<User | null> {
+  const e = normalizeEmail(email);
+  const record = users.find((u) => u.email === e);
+  const ok = await bcrypt.compare(password, record?.passwordHash ?? DUMMY_HASH);
+  return record?.passwordHash && ok ? toUser(record) : null;
+}
+
+/** Finds the user for a verified Google identity, creating one if needed. */
+export async function findOrCreateOAuthUser(input: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const existing = await getUserByEmail(input.email);
+  if (existing) return existing;
+  const email = normalizeEmail(input.email);
+  const record: UserRecord = {
+    id: crypto.randomUUID(),
+    email,
+    name: input.name?.trim() || email.split("@")[0],
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(record);
+  return toUser(record);
 }
 
