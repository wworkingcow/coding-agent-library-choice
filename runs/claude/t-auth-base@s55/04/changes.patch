@@ -0,0 +1,45 @@
+import NextAuth from "next-auth";
+import Credentials from "next-auth/providers/credentials";
+import Google from "next-auth/providers/google";
+import { z } from "zod";
+import { findOrCreateOAuthUser, verifyCredentials } from "@/lib/users";
+
+const credentialsSchema = z.object({
+  email: z.string().email(),
+  password: z.string().min(1).max(200),
+});
+
+export const { handlers, auth, signIn, signOut } = NextAuth({
+  session: { strategy: "jwt" },
+  pages: { signIn: "/signin" },
+  providers: [
+    Google,
+    Credentials({
+      async authorize(raw) {
+        const parsed = credentialsSchema.safeParse(raw);
+        if (!parsed.success) return null;
+        return verifyCredentials(parsed.data.email, parsed.data.password);
+      },
+    }),
+  ],
+  callbacks: {
+    async signIn({ account, profile }) {
+      if (account?.provider !== "google") return true;
+      // Only trust Google identities with a verified email (we link accounts by email).
+      return Boolean(profile?.email && profile.email_verified);
+    },
+    async jwt({ token, account, profile, user }) {
+      if (account?.provider === "google" && profile?.email) {
+        const u = await findOrCreateOAuthUser({ email: profile.email, name: profile.name });
+        token.sub = u.id;
+      } else if (user?.id) {
+        token.sub = user.id;
+      }
+      return token;
+    },
+    async session({ session, token }) {
+      if (token.sub) session.user.id = token.sub;
+      return session;
+    },
+  },
+});
