@@ -0,0 +1,60 @@
+"use server";
+
+import { AuthError } from "next-auth";
+import { z } from "zod";
+import { signIn, signOut } from "@/auth";
+import { createUser, EmailTakenError } from "@/lib/users";
+
+export type FormState = { error?: string } | undefined;
+
+const signUpSchema = z.object({
+  name: z.string().trim().min(1, "Name is required").max(100),
+  email: z.string().email("Enter a valid email"),
+  password: z.string().min(8, "Password must be at least 8 characters").max(200),
+});
+
+// Only allow same-site relative redirects.
+const safePath = (v: FormDataEntryValue | null) =>
+  typeof v === "string" && v.startsWith("/") && !v.startsWith("//") ? v : "/dashboard";
+
+export async function signInWithCredentials(_: FormState, formData: FormData): Promise<FormState> {
+  try {
+    await signIn("credentials", {
+      email: formData.get("email"),
+      password: formData.get("password"),
+      redirectTo: safePath(formData.get("callbackUrl")),
+    });
+  } catch (e) {
+    if (e instanceof AuthError) return { error: "Invalid email or password" };
+    throw e; // redirect
+  }
+}
+
+export async function signUp(_: FormState, formData: FormData): Promise<FormState> {
+  const parsed = signUpSchema.safeParse(Object.fromEntries(formData));
+  if (!parsed.success) return { error: parsed.error.issues[0].message };
+  try {
+    await createUser(parsed.data);
+  } catch (e) {
+    if (e instanceof EmailTakenError) return { error: "That email is already registered" };
+    throw e;
+  }
+  try {
+    await signIn("credentials", {
+      email: parsed.data.email,
+      password: parsed.data.password,
+      redirectTo: "/dashboard",
+    });
+  } catch (e) {
+    if (e instanceof AuthError) return { error: "Account created, but sign-in failed" };
+    throw e;
+  }
+}
+
+export async function signInWithGoogle(formData: FormData) {
+  await signIn("google", { redirectTo: safePath(formData.get("callbackUrl")) });
+}
+
+export async function signOutAction() {
+  await signOut({ redirectTo: "/" });
+}
