@@ -5,20 +7,98 @@ export type User = {
   createdAt: string;
 };
 
-const users: User[] = [
+type StoredUser = User & { passwordHash?: string };
+
+// In-memory store (no database in this project yet). Kept on globalThis so dev
+// hot reloads don't wipe sign-ups. Swap for a real DB before production.
+const globalStore = globalThis as unknown as { __notelyUsers?: StoredUser[] };
+const users: StoredUser[] = (globalStore.__notelyUsers ??= [
   { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
-];
+]);
+
+const normalizeEmail = (email: string) => email.trim().toLowerCase();
+
+function toPublic(stored: StoredUser): User {
+  const { passwordHash, ...user } = stored;
+  void passwordHash;
+  return user;
+}
 
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toPublic);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const u = users.find((u) => u.id === id);
+  return u && toPublic(u);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const e = normalizeEmail(email);
+  const u = users.find((u) => u.email === e);
+  return u && toPublic(u);
+}
+
+export class EmailTakenError extends Error {}
+
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (users.some((u) => u.email === email)) throw new EmailTakenError();
+  const user: StoredUser = {
+    id: crypto.randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: await bcrypt.hash(input.password, 12),
+  };
+  users.push(user);
+  return toPublic(user);
+}
+
+// Dummy hash so unknown emails cost the same as wrong passwords (timing).
+const DUMMY_HASH = bcrypt.hashSync("not-a-real-password", 12);
+
+export async function verifyCredentials(
+  email: string,
+  password: string,
+): Promise<User | null> {
+  const e = normalizeEmail(email);
+  const u = users.find((u) => u.email === e);
+  const ok = await bcrypt.compare(password, u?.passwordHash ?? DUMMY_HASH);
+  return u?.passwordHash && ok ? toPublic(u) : null;
+}
+
+// Called after Google verified the email. If a password account already uses
+// this email, its password is dropped: password sign-ups aren't email-verified,
+// so someone could have pre-registered a victim's address.
+export async function upsertGoogleUser(input: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const email = normalizeEmail(input.email);
+  const existing = users.find((u) => u.email === email);
+  if (existing) {
+    delete existing.passwordHash;
+    return toPublic(existing);
+  }
+  const user: StoredUser = {
+    id: crypto.randomUUID(),
+    email,
+    name: input.name?.trim() || email.split("@")[0],
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return toPublic(user);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  // Lazy import keeps users.ts free of a load-time cycle with auth.ts.
+  const { auth } = await import("@/auth");
+  const session = await auth();
+  return session?.user?.id ? getUser(session.user.id) : undefined;
 }
