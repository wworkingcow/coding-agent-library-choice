+"use client";
+
+import { useActionState } from "react";
+import type { FormState } from "./actions";
+
+const input = "w-full rounded border border-black/20 bg-transparent px-3 py-2 dark:border-white/20";
+const button = "w-full rounded bg-foreground px-3 py-2 text-background disabled:opacity-50";
+
+export function AuthForm({
+  action,
+  next,
+  submitLabel,
+  withName,
+}: {
+  action: (s: FormState, f: FormData) => Promise<FormState>;
+  next?: string;
+  submitLabel: string;
+  withName?: boolean;
+}) {
+  const [state, formAction, pending] = useActionState(action, undefined);
+  return (
+    <form action={formAction} className="space-y-3">
+      {next && <input type="hidden" name="next" value={next} />}
+      {withName && <input name="name" placeholder="Name" autoComplete="name" required className={input} />}
+      <input name="email" type="email" placeholder="Email" autoComplete="email" required className={input} />
+      <input
+        name="password"
+        type="password"
+        placeholder="Password"
+        autoComplete={withName ? "new-password" : "current-password"}
+        required
+        minLength={withName ? 8 : undefined}
+        className={input}
+      />
+      {state?.error && <p role="alert" className="text-sm text-red-600">{state.error}</p>}
+      <button disabled={pending} className={button}>{submitLabel}</button>
+    </form>
+  );
+}
