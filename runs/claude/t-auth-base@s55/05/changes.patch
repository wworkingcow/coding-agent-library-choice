+"use client";
+
+import { useActionState } from "react";
+import type { FormState } from "./actions";
+
+const input = "w-full rounded border border-black/20 bg-transparent px-3 py-2 text-sm dark:border-white/25";
+
+export function AuthForm({
+  action,
+  submitLabel,
+  withName,
+  next,
+}: {
+  action: (state: FormState, form: FormData) => Promise<FormState>;
+  submitLabel: string;
+  withName?: boolean;
+  next?: string;
+}) {
+  const [state, formAction, pending] = useActionState(action, undefined);
+  return (
+    <form action={formAction} className="space-y-3">
+      {next && <input type="hidden" name="next" value={next} />}
+      {withName && <input name="name" placeholder="Name" autoComplete="name" className={input} />}
+      <input name="email" type="email" placeholder="Email" required autoComplete="email" className={input} />
+      <input
+        name="password"
+        type="password"
+        placeholder="Password"
+        required
+        minLength={withName ? 8 : undefined}
+        autoComplete={withName ? "new-password" : "current-password"}
+        className={input}
+      />
+      {state?.error && <p role="alert" className="text-sm text-red-600">{state.error}</p>}
+      <button disabled={pending} className="w-full rounded bg-foreground px-3 py-2 text-sm text-background disabled:opacity-50">
+        {submitLabel}
+      </button>
+    </form>
+  );
+}
