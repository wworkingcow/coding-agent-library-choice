+"use server";
+
+import { AuthError } from "next-auth";
+import { signIn, signOut } from "@/auth";
+import { createUser, EmailTakenError } from "@/lib/users";
+
+export type FormState = { error?: string } | undefined;
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+// Only allow same-site relative redirects.
+function safeNext(value: FormDataEntryValue | null): string {
+  return typeof value === "string" && value.startsWith("/") && !value.startsWith("//")
+    ? value
+    : "/dashboard";
+}
+
+export async function signInWithPassword(_: FormState, form: FormData): Promise<FormState> {
+  try {
+    await signIn("credentials", {
+      email: String(form.get("email") ?? ""),
+      password: String(form.get("password") ?? ""),
+      redirectTo: safeNext(form.get("next")),
+    });
+  } catch (e) {
+    if (e instanceof AuthError) return { error: "Invalid email or password." };
+    throw e; // redirect
+  }
+}
+
+export async function signUp(_: FormState, form: FormData): Promise<FormState> {
+  const email = String(form.get("email") ?? "").trim();
+  const password = String(form.get("password") ?? "");
+  const name = String(form.get("name") ?? "");
+  if (!EMAIL_RE.test(email)) return { error: "Enter a valid email address." };
+  if (password.length < 8 || password.length > 128)
+    return { error: "Password must be 8–128 characters." };
+  try {
+    await createUser({ email, name, password });
+  } catch (e) {
+    if (e instanceof EmailTakenError) return { error: "That email is already registered." };
+    throw e;
+  }
+  try {
+    await signIn("credentials", { email, password, redirectTo: "/dashboard" });
+  } catch (e) {
+    if (e instanceof AuthError) return { error: "Account created, but sign-in failed. Try signing in." };
+    throw e;
+  }
+}
+
+export async function signInWithGoogle() {
+  await signIn("google", { redirectTo: "/dashboard" });
+}
+
+export async function signOutAction() {
+  await signOut({ redirectTo: "/" });
+}
