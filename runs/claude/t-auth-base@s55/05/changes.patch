+  const u = users.find((u) => u.email === normalizeEmail(email));
+  // Hash even for unknown users so response time doesn't reveal which emails exist.
+  const ok = await checkPassword(password, u?.passwordHash ?? DUMMY_HASH);
+  return u?.passwordHash && ok ? toUser(u) : undefined;
