   createdAt: string;
 };
 
-const users: User[] = [
+type StoredUser = User & {
+  passwordHash?: string;
+  googleId?: string;
+};
+
+// In-memory store, as before. Swap for a real database before production:
+// users (and their password hashes) are lost on restart.
+const users: StoredUser[] = [
   { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+function toPublic({ id, email, name, createdAt }: StoredUser): User {
+  return { id, email, name, createdAt };
+}
+
+function normalizeEmail(email: string) {
+  return email.trim().toLowerCase();
+}
+
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toPublic);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const u = users.find((u) => u.id === id);
+  return u && toPublic(u);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const e = normalizeEmail(email);
+  const u = users.find((u) => u.email === e);
+  return u && toPublic(u);
+}
+
+export class EmailTakenError extends Error {
+  constructor() {
+    super("An account with that email already exists");
+  }
+}
+
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (users.some((u) => u.email === email)) throw new EmailTakenError();
+  const user: StoredUser = {
+    id: crypto.randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: await bcrypt.hash(input.password, 12),
+  };
+  users.push(user);
+  return toPublic(user);
+}
+
+// Precomputed so unknown emails cost the same as wrong passwords.
+const DUMMY_HASH = bcrypt.hashSync("not-a-real-password", 12);
+
+export async function verifyCredentials(
+  email: string,
+  password: string,
+): Promise<User | null> {
+  const e = normalizeEmail(email);
+  const u = users.find((u) => u.email === e);
+  const ok = await bcrypt.compare(password, u?.passwordHash ?? DUMMY_HASH);
+  return u?.passwordHash && ok ? toPublic(u) : null;
+}
+
+// Called after Google has verified the email. Links to an existing account
+// with the same email, otherwise creates one.
+export async function findOrCreateGoogleUser(profile: {
+  googleId: string;
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const email = normalizeEmail(profile.email);
+  let u =
+    users.find((u) => u.googleId === profile.googleId) ??
+    users.find((u) => u.email === email);
+  if (!u) {
+    u = {
+      id: crypto.randomUUID(),
+      email,
+      name: profile.name?.trim() || email.split("@")[0],
+      createdAt: new Date().toISOString().slice(0, 10),
+    };
+    users.push(u);
+  }
+  u.googleId ??= profile.googleId;
+  return toPublic(u);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const session = await auth();
+  return session?.user?.id ? getUser(session.user.id) : undefined;
 }
diff --git a/src/proxy.ts b/src/proxy.ts
