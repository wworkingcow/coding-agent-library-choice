+import { redirect } from "next/navigation";
+import { auth } from "@/auth";
+import { signInWithCredentials } from "@/app/actions";
+import { AuthForm } from "@/app/auth-form";
+
+export default async function SignInPage({ searchParams }: PageProps<"/sign-in">) {
+  const params = await searchParams;
+  const rawNext = params.next ?? params.callbackUrl;
+  const next = typeof rawNext === "string" && rawNext.startsWith("/") && !rawNext.startsWith("//") ? rawNext : undefined;
+  if (await auth()) redirect(next ?? "/dashboard");
+  return <AuthForm mode="sign-in" action={signInWithCredentials} next={next} />;
+}
