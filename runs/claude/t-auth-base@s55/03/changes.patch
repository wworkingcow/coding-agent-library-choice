+const normalize = (email: string) => email.trim().toLowerCase();
+
+function toUser({ id, email, name, createdAt }: UserRecord): User {
+  return { id, email, name, createdAt };
+}
 
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const u = users.find((u) => u.id === id);
+  return u && toUser(u);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const u = users.find((u) => u.email === normalize(email));
+  return u && toUser(u);
+}
+
+export class EmailTakenError extends Error {}
+
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = normalize(input.email);
+  if (users.some((u) => u.email === email)) throw new EmailTakenError();
+  const record: UserRecord = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: await hash(input.password, 12),
+  };
+  users.push(record);
+  return toUser(record);
+}
+
+// Dummy hash so unknown emails cost the same as wrong passwords (timing).
+const DUMMY_HASH = "$2b$12$aRdlSdR3RgRzwlmYTzC9CudRLGw6.TNEXMdq.cu5xcuwSDETU7nZ.";
+
+export async function verifyCredentials(
+  email: string,
+  password: string,
+): Promise<User | null> {
+  const u = users.find((u) => u.email === normalize(email));
+  const ok = await compare(password, u?.passwordHash ?? DUMMY_HASH);
+  return u && u.passwordHash && ok ? toUser(u) : null;
+}
+
+// Called only with Google profiles whose email Google reports as verified,
+// so linking to an existing account by email is safe.
+export async function upsertGoogleUser(profile: {
+  googleId: string;
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const email = normalize(profile.email);
+  let u =
+    users.find((u) => u.googleId === profile.googleId) ??
+    users.find((u) => u.email === email);
+  if (!u) {
+    u = {
+      id: randomUUID(),
+      email,
+      name: profile.name?.trim() || email.split("@")[0],
+      createdAt: new Date().toISOString().slice(0, 10),
+    };
+    users.push(u);
+  }
+  u.googleId ??= profile.googleId;
+  return toUser(u);
 }
 
