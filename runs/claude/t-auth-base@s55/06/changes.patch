+"use client";
+
+import Link from "next/link";
+import { useActionState } from "react";
+import type { FormState } from "./actions";
+
+const input =
+  "w-full rounded border border-black/15 bg-transparent px-3 py-2 text-sm dark:border-white/20";
+
+export function AuthForm({
+  mode,
+  action,
+  next,
+}: {
+  mode: "sign-in" | "sign-up";
+  action: (prev: FormState, fd: FormData) => Promise<FormState>;
+  next?: string;
+}) {
+  const [state, formAction, pending] = useActionState(action, undefined);
+  const up = mode === "sign-up";
+  return (
+    <form action={formAction} className="space-y-3">
+      {next && <input type="hidden" name="next" value={next} />}
+      {up && (
+        <input name="name" placeholder="Name" required autoComplete="name" className={input} />
+      )}
+      <input name="email" type="email" placeholder="Email" required autoComplete="email" className={input} />
+      <input
+        name="password"
+        type="password"
+        placeholder="Password"
+        required
+        minLength={up ? 8 : undefined}
+        autoComplete={up ? "new-password" : "current-password"}
+        className={input}
+      />
+      {state?.error && (
+        <p role="alert" className="text-sm text-red-600">
+          {state.error}
+        </p>
+      )}
+      <button
+        disabled={pending}
+        className="w-full rounded bg-foreground px-3 py-2 text-sm text-background disabled:opacity-50"
+      >
+        {up ? "Create account" : "Sign in"}
+      </button>
+      <p className="text-sm opacity-70">
+        {up ? "Already have an account? " : "No account? "}
+        <Link className="underline" href={up ? "/sign-in" : "/sign-up"}>
+          {up ? "Sign in" : "Sign up"}
+        </Link>
+      </p>
+    </form>
+  );
+}
