@@ -0,0 +1,32 @@
+import { redirect } from "next/navigation";
+import { auth } from "@/auth";
+import { signInWithGoogle, signInWithPassword } from "../actions";
+import { AuthForm } from "../auth-form";
+
+export default async function SignInPage({
+  searchParams,
+}: {
+  searchParams: Promise<{ callbackUrl?: string }>;
+}) {
+  if ((await auth())?.user) redirect("/dashboard");
+  const { callbackUrl } = await searchParams;
+  // Proxy sends an absolute URL; keep only the path.
+  let next: string | undefined;
+  try {
+    const u = callbackUrl && new URL(callbackUrl, "http://x");
+    next = u ? u.pathname + u.search : undefined;
+  } catch {}
+
+  return (
+    <main className="mx-auto max-w-sm p-8">
+      <h1 className="mb-6 text-2xl font-semibold">Sign in to Notely</h1>
+      <AuthForm mode="sign-in" action={signInWithPassword} next={next} />
+      <form action={signInWithGoogle} className="mt-4">
+        {next && <input type="hidden" name="next" value={next} />}
+        <button className="w-full rounded border border-black/15 px-3 py-2 text-sm dark:border-white/20">
+          Continue with Google
+        </button>
+      </form>
+    </main>
+  );
+}
