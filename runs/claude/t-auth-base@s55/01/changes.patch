+"use client";
+
+import { useActionState } from "react";
+import type { FormState } from "./actions";
+
+const input = "w-full rounded border border-black/20 bg-transparent px-3 py-2 text-sm dark:border-white/25";
+
+export function AuthForm({
+  action,
+  mode,
+}: {
+  action: (state: FormState, data: FormData) => Promise<FormState>;
+  mode: "signin" | "signup";
+}) {
+  const [state, formAction, pending] = useActionState(action, undefined);
+  return (
+    <form action={formAction} className="space-y-3">
+      {mode === "signup" && (
+        <input name="name" placeholder="Name" autoComplete="name" required className={input} />
+      )}
+      <input name="email" type="email" placeholder="Email" autoComplete="email" required className={input} />
+      <input
+        name="password"
+        type="password"
+        placeholder="Password"
+        autoComplete={mode === "signup" ? "new-password" : "current-password"}
+        minLength={mode === "signup" ? 8 : undefined}
+        required
+        className={input}
+      />
+      {state?.error && <p role="alert" className="text-sm text-red-600">{state.error}</p>}
+      <button
+        disabled={pending}
+        className="w-full rounded bg-foreground px-3 py-2 text-sm text-background disabled:opacity-50"
+      >
+        {mode === "signup" ? "Create account" : "Sign in"}
+      </button>
+    </form>
+  );
+}
