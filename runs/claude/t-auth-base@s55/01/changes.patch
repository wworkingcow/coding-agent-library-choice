 };
 
-const users: User[] = [
+type StoredUser = User & { passwordHash?: string };
+
+// In-memory store, kept on globalThis so dev hot reloads don't wipe signed-up users.
+// Swap for a real database before production: accounts are lost on restart.
+const globalStore = globalThis as unknown as { __notelyUsers?: StoredUser[] };
+const users: StoredUser[] = (globalStore.__notelyUsers ??= [
   { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
-];
+]);
+
+function toUser(user: StoredUser): User {
+  return { id: user.id, email: user.email, name: user.name, createdAt: user.createdAt };
+}
+
+function normalizeEmail(email: string) {
+  return email.trim().toLowerCase();
+}
+
+function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(16);
+  return new Promise((resolve, reject) =>
+    scrypt(password, salt, 64, (err, key) =>
+      err ? reject(err) : resolve(`${salt.toString("hex")}:${key.toString("hex")}`),
+    ),
+  );
+}
+
+function checkPassword(password: string, stored: string): Promise<boolean> {
+  const [saltHex, keyHex] = stored.split(":");
+  const expected = Buffer.from(keyHex, "hex");
+  return new Promise((resolve, reject) =>
+    scrypt(password, Buffer.from(saltHex, "hex"), expected.length, (err, key) =>
+      err ? reject(err) : resolve(timingSafeEqual(key, expected)),
+    ),
+  );
+}
 
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const found = users.find((u) => u.id === id);
+  return found && toUser(found);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const e = normalizeEmail(email);
+  const found = users.find((u) => u.email === e);
+  return found && toUser(found);
+}
+
+/** Returns undefined if the email is already registered. */
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password?: string;
+}): Promise<User | undefined> {
+  const email = normalizeEmail(input.email);
+  if (users.some((u) => u.email === email)) return undefined;
+  const user: StoredUser = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: input.password ? await hashPassword(input.password) : undefined,
+  };
+  users.push(user);
+  return toUser(user);
+}
+
+/** Returns the user when email + password match, otherwise undefined. */
+export async function verifyCredentials(
+  email: string,
+  password: string,
+): Promise<User | undefined> {
+  const found = users.find((u) => u.email === normalizeEmail(email));
+  // Hash anyway when the user is unknown/has no password so timing doesn't leak existence.
+  const ok = await checkPassword(
+    password,
+    found?.passwordHash ?? `${"00".repeat(16)}:${"00".repeat(64)}`,
+  );
+  return found?.passwordHash && ok ? toUser(found) : undefined;
+}
+
+/** Google sign-in: reuse the account with this (verified) email, or create one. */
+export async function findOrCreateOAuthUser(input: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const existing = await getUserByEmail(input.email);
+  if (existing) return existing;
+  const created = await createUser({
+    email: input.email,
+    name: input.name || input.email.split("@")[0],
+  });
+  return created!;
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  // Imported lazily: auth.ts itself imports this module.
+  const { auth } = await import("@/auth");
+  const session = await auth();
+  return session?.user?.id ? getUser(session.user.id) : undefined;
 }
