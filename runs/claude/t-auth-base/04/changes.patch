+      >
+        Continue with Google
+      </button>
+
+      <div className="my-6 flex items-center gap-3 text-xs uppercase opacity-50">
+        <span className="h-px flex-1 bg-current" />
+        or
+        <span className="h-px flex-1 bg-current" />
+      </div>
