+ * Finds or creates a user for an OAuth sign-in (e.g. Google), matched by
+ * email. Used so credentials and OAuth sign-ins share the same user record.
+ */
+export async function upsertOAuthUser(email: string, name: string): Promise<User> {
+  const existing = users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+  if (existing) return toPublicUser(existing);
+  const user: InternalUser = {
+    id: String(nextId++),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return toPublicUser(user);
 }
