+import type { NextAuthConfig } from "next-auth";
+
+/**
+ * Edge-safe part of the NextAuth config: no Credentials provider here (its
+ * authorize() uses bcrypt, which needs the Node runtime), so this file can
+ * be imported from middleware. The full config lives in src/auth.ts.
+ */
+export const authConfig = {
+  // Needed for self-hosted deployments (not Vercel) where the host isn't
+  // otherwise verified — set AUTH_URL in production if behind a fixed domain.
+  trustHost: true,
+  pages: {
+    signIn: "/signin",
+  },
+  session: {
+    strategy: "jwt",
+  },
+  providers: [],
+  callbacks: {
+    authorized({ auth, request }) {
+      const isLoggedIn = !!auth?.user;
+      const isDashboard = request.nextUrl.pathname.startsWith("/dashboard");
+      if (!isDashboard) return true;
+      return isLoggedIn;
+    },
+  },
+} satisfies NextAuthConfig;
