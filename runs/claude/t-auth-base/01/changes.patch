+import bcrypt from "bcryptjs";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  // Present for users created via email+password sign up.
+  // Absent for users provisioned by an OAuth provider (e.g. Google).
+  passwordHash?: string;
 };
 
 const users: User[] = [
@@ -10,6 +15,8 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+let nextId = users.length + 1;
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +25,58 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === normalized);
+}
+
+// Creates a user with a hashed password (email+password sign up).
+export async function createUser(params: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = params.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error("A user with that email already exists.");
+  }
+  const passwordHash = await bcrypt.hash(params.password, 10);
+  const user: User = {
+    id: String(nextId++),
+    email,
+    name: params.name.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return user;
+}
+
+// Finds or creates a user for an OAuth sign-in (e.g. Google). OAuth users
+// have no passwordHash — they can never be used with the credentials login.
+export async function findOrCreateOAuthUser(params: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const existing = await getUserByEmail(params.email);
+  if (existing) return existing;
+  const email = params.email.trim().toLowerCase();
+  const user: User = {
+    id: String(nextId++),
+    email,
+    name: params.name?.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return user;
+}
+
+export async function verifyPassword(
+  email: string,
+  password: string
+): Promise<User | null> {
+  const user = await getUserByEmail(email);
+  if (!user?.passwordHash) return null;
+  const valid = await bcrypt.compare(password, user.passwordHash);
+  return valid ? user : null;
 }
