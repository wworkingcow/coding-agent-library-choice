diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..ea40215
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,67 @@
+// Transactional email via Resend (https://resend.com) using its REST API — no SDK dependency.
+
+type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+const RESEND_URL = "https://api.resend.com/emails";
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+export async function sendEmail(email: Email): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM;
+
+  // Without credentials (local dev) log instead of sending.
+  if (!apiKey || !from) {
+    console.warn(`[email] RESEND_API_KEY/EMAIL_FROM not set; skipping "${email.subject}" to ${email.to}`);
+    return;
+  }
+
+  const res = await fetch(RESEND_URL, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({ from, to: email.to, subject: email.subject, html: email.html, text: email.text }),
+  });
+
+  if (!res.ok) {
+    throw new Error(`Email send failed: ${res.status} ${await res.text()}`);
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const appUrl = process.env.APP_URL ?? "http://localhost:3000";
+  return sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Start taking notes at ${appUrl}/dashboard.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${appUrl}/dashboard">Start taking notes</a>.</p>`,
+  });
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const appUrl = process.env.APP_URL ?? "http://localhost:3000";
+  const link = `${appUrl}/reset-password?token=${encodeURIComponent(token)}`;
+  return sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password: ${link}\n\nThis link expires in ${expiresInMinutes} minutes. If you didn't request it, ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${link}">Reset your password</a>. The link expires in ${expiresInMinutes} minutes.</p><p>If you didn't request this, you can ignore this email.</p>`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..e045932 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,55 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with that email already exists");
+  }
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // A failed email must not fail signup.
+  sendWelcomeEmail(user).catch((err) => console.error("[email] welcome email failed", err));
+  return user;
+}
+
+const RESET_TTL_MINUTES = 60;
+// Only the SHA-256 of each token is stored. Replace with a DB table once users are persisted.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+// Always resolves the same way whether or not the email exists, so callers can't enumerate accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const normalized = email.trim().toLowerCase();
+  const user = users.find((u) => u.email === normalized);
+  if (!user) return;
+
+  const token = randomBytes(32).toString("hex");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TTL_MINUTES * 60_000,
+  });
+
+  try {
+    await sendPasswordResetEmail(user, token, RESET_TTL_MINUTES);
+  } catch (err) {
+    console.error("[email] password reset email failed", err);
+  }
+}
+
+// Validates and consumes a reset token. Returns the user it belongs to, or undefined if invalid/expired.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
