diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..9b195bd
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,57 @@
+// Transactional email via Resend's REST API (no SDK dependency).
+// If RESEND_API_KEY is unset (local dev), emails are logged instead of sent.
+
+type Email = { to: string; subject: string; html: string; text: string };
+
+const RESEND_URL = "https://api.resend.com/emails";
+
+export async function sendEmail(email: Email): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM;
+
+  if (!apiKey || !from) {
+    console.log(`[email:dev] to=${email.to} subject="${email.subject}"\n${email.text}`);
+    return;
+  }
+
+  const res = await fetch(RESEND_URL, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({ from, to: email.to, subject: email.subject, html: email.html, text: email.text }),
+  });
+
+  if (!res.ok) {
+    throw new Error(`Email send failed: ${res.status} ${await res.text()}`);
+  }
+}
+
+function escapeHtml(s: string): string {
+  return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const name = escapeHtml(user.name);
+  await sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    html: `<p>Hi ${name},</p><p>Welcome to Notely! Your account is ready.</p>`,
+    text: `Hi ${user.name},\n\nWelcome to Notely! Your account is ready.`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+): Promise<void> {
+  const name = escapeHtml(user.name);
+  const url = escapeHtml(resetUrl);
+  await sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    html: `<p>Hi ${name},</p><p><a href="${url}">Reset your password</a>. This link expires in 1 hour.</p><p>If you didn't request this, you can ignore this email.</p>`,
+    text: `Hi ${user.name},\n\nReset your password: ${resetUrl}\n\nThis link expires in 1 hour. If you didn't request this, ignore this email.`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..970b34d 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,54 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Email failure must not fail signup.
+  sendWelcomeEmail(user).catch((err) => console.error("Welcome email failed", err));
+  return user;
+}
+
+const RESET_TTL_MS = 60 * 60 * 1000;
+// token hash -> reset record (in-memory, like the user store above)
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+// Always resolves without revealing whether the email is registered.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === email.trim().toLowerCase());
+  if (!user) return;
+
+  const token = randomBytes(32).toString("hex");
+  resetTokens.set(hashToken(token), { userId: user.id, expiresAt: Date.now() + RESET_TTL_MS });
+
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  const resetUrl = `${base}/reset-password?token=${token}`;
+  try {
+    await sendPasswordResetEmail(user, resetUrl);
+  } catch (err) {
+    console.error("Password reset email failed", err);
+  }
+}
+
+// Validates and consumes a reset token; returns the user it belongs to.
+// Setting the new password is left to the auth layer, which doesn't exist yet.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const record = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!record || record.expiresAt < Date.now()) return undefined;
+  return getUser(record.userId);
+}
