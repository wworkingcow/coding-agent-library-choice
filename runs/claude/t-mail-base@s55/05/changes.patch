diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..01fcaae
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,63 @@
+// Transactional email via Resend's REST API (no SDK dependency needed).
+// https://resend.com/docs/api-reference/emails/send-email
+
+type Message = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+const escapeHtml = (s: string) =>
+  s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+
+async function send(message: Message): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM;
+
+  if (!apiKey || !from) {
+    // Local dev without credentials: log instead of failing.
+    console.warn(`[email] RESEND_API_KEY/EMAIL_FROM not set; skipping "${message.subject}" to ${message.to}`);
+    return;
+  }
+
+  const res = await fetch("https://api.resend.com/emails", {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({ from, ...message }),
+  });
+
+  if (!res.ok) {
+    throw new Error(`Email send failed (${res.status}): ${await res.text()}`);
+  }
+}
+
+export function appUrl(): string {
+  return process.env.APP_URL ?? "http://localhost:3000";
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }) {
+  const url = `${appUrl()}/dashboard`;
+  await send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Get started here: ${url}\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a>.</p>`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+) {
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password using this link (valid for 1 hour): ${url}\n\nIf you didn't request this, ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${url}">Reset your password</a>. The link is valid for 1 hour.</p><p>If you didn't request this, ignore this email.</p>`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..c406bef 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,54 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Email failure must not undo account creation.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error("[users] welcome email failed", err);
+  }
+  return user;
+}
+
+// Reset tokens are stored hashed, so a leaked store can't be used to reset passwords.
+const RESET_TTL_MS = 60 * 60 * 1000;
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+const hashToken = (t: string) => createHash("sha256").update(t).digest("hex");
+
+// Always resolves the same way whether or not the email exists (no account enumeration).
+export async function requestPasswordReset(email: string): Promise<void> {
+  const normalized = email.trim().toLowerCase();
+  const user = users.find((u) => u.email === normalized);
+  if (!user) return;
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), { userId: user.id, expiresAt: Date.now() + RESET_TTL_MS });
+  try {
+    await sendPasswordResetEmail(user, token);
+  } catch (err) {
+    console.error("[users] password reset email failed", err);
+  }
+}
+
+// Validates and consumes a reset token; returns the user it belongs to.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
