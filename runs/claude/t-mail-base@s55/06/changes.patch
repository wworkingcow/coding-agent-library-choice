@@ -0,0 +1,52 @@
+// Transactional email via Resend's REST API (https://resend.com/docs/api-reference/emails/send-email).
+// No SDK needed: a single fetch call keeps the dependency list unchanged.
+
+type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+const escapeHtml = (s: string) =>
+  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+export async function sendEmail({ to, subject, html, text }: Email): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM;
+  if (!apiKey || !from) {
+    // Without credentials (local dev) log instead of failing.
+    console.warn(`[email] RESEND_API_KEY/EMAIL_FROM not set; skipping "${subject}" to ${to}`);
+    return;
+  }
+
+  const res = await fetch("https://api.resend.com/emails", {
+    method: "POST",
+    headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" },
+    body: JSON.stringify({ from, to, subject, html, text }),
+  });
+  if (!res.ok) {
+    throw new Error(`Resend error ${res.status}: ${await res.text()}`);
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  const appUrl = process.env.APP_URL ?? "http://localhost:3000";
+  return sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Start taking notes at ${appUrl}.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${appUrl}">Start taking notes</a>.</p>`,
+  });
+}
+
+export function sendPasswordResetEmail(user: { email: string; name: string }, token: string, ttlMinutes: number) {
+  const appUrl = process.env.APP_URL ?? "http://localhost:3000";
+  const link = `${appUrl}/reset-password?token=${encodeURIComponent(token)}`;
+  return sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password: ${link}\n\nThis link expires in ${ttlMinutes} minutes. If you didn't request it, ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${link}">Reset your password</a>. This link expires in ${ttlMinutes} minutes.</p><p>If you didn't request this, ignore this email.</p>`,
+  });
+}
