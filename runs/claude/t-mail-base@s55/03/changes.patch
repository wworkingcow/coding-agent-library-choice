--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,70 @@
+// Transactional email via Resend (https://resend.com), called over plain fetch — no SDK dependency.
+
+const RESEND_ENDPOINT = "https://api.resend.com/emails";
+
+type Message = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
+}
+
+async function send(message: Message): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM;
+
+  // Without credentials (local dev) log instead of sending.
+  if (!apiKey || !from) {
+    console.warn(`[email] RESEND_API_KEY/EMAIL_FROM not set; skipping "${message.subject}" to ${message.to}`);
+    return;
+  }
+
+  const res = await fetch(RESEND_ENDPOINT, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({ from, ...message }),
+  });
+
+  if (!res.ok) {
+    throw new Error(`Email send failed (${res.status}): ${await res.text()}`);
+  }
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const url = `${appUrl()}/dashboard`;
+  await send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Get started here: ${url}\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a> to get started.</p>`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password using this link (valid for ${expiresInMinutes} minutes): ${url}\n\nIf you didn't request this, you can ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${url}">Reset your password</a>. The link is valid for ${expiresInMinutes} minutes.</p><p>If you didn't request this, you can ignore this email.</p>`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..9271bef 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,55 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // A failed email must not fail signup.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error("Failed to send welcome email", err);
+  }
+  return user;
+}
+
+const RESET_TTL_MINUTES = 60;
+// token hash -> reset request. In-memory like the user store; move to the DB with it.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+// Resolves silently for unknown emails so callers can't use it to enumerate accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const normalized = email.trim().toLowerCase();
+  const user = users.find((u) => u.email === normalized);
+  if (!user) return;
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TTL_MINUTES * 60_000,
+  });
+  await sendPasswordResetEmail(user, token, RESET_TTL_MINUTES);
+}
+
+// Single-use: returns the user the token belongs to, or undefined if invalid/expired.
+// Call from the reset-password handler, then set the new password (none is stored yet).
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
