@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,47 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  // Email failure must not fail signup.
+  await sendWelcomeEmail(user).catch((err) => console.error("[email] welcome failed", err));
+  return user;
+}
+
+const RESET_TTL_MS = 60 * 60 * 1000;
+// Stored by SHA-256 hash so a leaked store doesn't expose usable tokens. In-memory like `users`.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (t: string) => createHash("sha256").update(t).digest("hex");
+
+// Always resolves without revealing whether the email is registered.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === email.trim().toLowerCase());
+  if (!user) return;
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), { userId: user.id, expiresAt: Date.now() + RESET_TTL_MS });
+  await sendPasswordResetEmail(user, token).catch((err) =>
+    console.error("[email] password reset failed", err),
+  );
+}
+
+// Validates and consumes a reset token (single use). Returns the user, or undefined if invalid/expired.
+// TODO: setting the new password belongs to the caller once credentials exist.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
