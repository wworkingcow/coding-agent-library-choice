diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..ecdaaf6
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,49 @@
+const RESEND_URL = "https://api.resend.com/emails";
+
+type Email = { to: string; subject: string; html: string; text: string };
+
+function escapeHtml(s: string): string {
+  return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+export function appUrl(): string {
+  return process.env.APP_URL ?? "http://localhost:3000";
+}
+
+async function sendEmail({ to, subject, html, text }: Email): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM;
+  if (!apiKey || !from) {
+    // No provider configured (local dev): log instead of failing.
+    console.warn(`[email] RESEND_API_KEY/EMAIL_FROM not set; skipping "${subject}" to ${to}`);
+    return;
+  }
+  const res = await fetch(RESEND_URL, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" },
+    body: JSON.stringify({ from, to, subject, html, text }),
+  });
+  if (!res.ok) {
+    throw new Error(`Email send failed (${res.status}): ${await res.text()}`);
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  const name = escapeHtml(user.name);
+  return sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Get started: ${appUrl()}/dashboard\n`,
+    html: `<p>Hi ${name},</p><p>Welcome to Notely! <a href="${appUrl()}/dashboard">Open your dashboard</a>.</p>`,
+  });
+}
+
+export function sendPasswordResetEmail(user: { email: string; name: string }, token: string) {
+  const link = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password (link valid for 1 hour): ${link}\n\nIf you didn't request this, ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${link}">Reset your password</a>. The link is valid for 1 hour.</p><p>If you didn't request this, ignore this email.</p>`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
