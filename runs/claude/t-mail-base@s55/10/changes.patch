+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,60 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Email failure must not fail signup.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error("[users] welcome email failed", err);
+  }
+  return user;
+}
+
+const RESET_TTL_MINUTES = 60;
+// token hash -> reset request. In-memory like the rest of this file; move to the DB with users.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+// Always resolves the same way whether or not the email exists, to avoid account enumeration.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const normalized = email.trim().toLowerCase();
+  const user = users.find((u) => u.email === normalized);
+  if (!user) return;
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TTL_MINUTES * 60_000,
+  });
+  try {
+    await sendPasswordResetEmail(user, token, RESET_TTL_MINUTES);
+  } catch (err) {
+    console.error("[users] password reset email failed", err);
+  }
+}
+
+// Validates and consumes a reset token; returns the user it belongs to.
+// There is no password storage yet, so the caller applies the new password.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  if (!entry) return undefined;
+  resetTokens.delete(key);
+  if (entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
