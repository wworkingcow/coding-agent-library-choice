@@ -0,0 +1,56 @@
+// Transactional email via Resend's REST API (https://resend.com/docs/api-reference/emails/send-email).
+// Plain fetch, so no extra dependency.
+
+const RESEND_URL = "https://api.resend.com/emails";
+
+type Email = { to: string; subject: string; html: string; text: string };
+
+export async function sendEmail({ to, subject, html, text }: Email): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM;
+  if (!apiKey || !from) {
+    // No credentials (local dev): log instead of failing.
+    console.warn(`[email] RESEND_API_KEY/EMAIL_FROM not set; skipping "${subject}" to ${to}`);
+    return;
+  }
+
+  const res = await fetch(RESEND_URL, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" },
+    body: JSON.stringify({ from, to, subject, html, text }),
+  });
+  if (!res.ok) {
+    throw new Error(`Resend error ${res.status}: ${await res.text()}`);
+  }
+}
+
+const escapeHtml = (s: string) =>
+  s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const url = `${appUrl()}/dashboard`;
+  await sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Get started here: ${url}\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a>.</p>`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  ttlMinutes: number,
+): Promise<void> {
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password (link valid for ${ttlMinutes} minutes): ${url}\n\nIf you didn't request this, ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${url}">Reset your password</a> (valid for ${ttlMinutes} minutes).</p><p>If you didn't request this, ignore this email.</p>`,
+  });
+}
