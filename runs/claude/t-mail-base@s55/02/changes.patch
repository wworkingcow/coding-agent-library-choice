@@ -0,0 +1,73 @@
+// Transactional email via Resend's HTTP API (https://resend.com/docs/api-reference/emails/send-email).
+// Plain fetch, no SDK. Without RESEND_API_KEY (local dev) emails are logged instead of sent.
+
+const RESEND_URL = "https://api.resend.com/emails";
+
+export type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+export function appUrl(): string {
+  return process.env.APP_URL ?? "http://localhost:3000";
+}
+
+export function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+export async function sendEmail(email: Email): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) {
+    console.log(`[email:dev] to=${email.to} subject=${email.subject}\n${email.text}`);
+    return;
+  }
+
+  const res = await fetch(RESEND_URL, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({
+      from: process.env.EMAIL_FROM ?? "Notely <onboarding@resend.dev>",
+      to: [email.to],
+      subject: email.subject,
+      html: email.html,
+      text: email.text,
+    }),
+  });
+
+  if (!res.ok) {
+    throw new Error(`Email send failed: ${res.status} ${await res.text()}`);
+  }
+}
+
+export function welcomeEmail(user: { email: string; name: string }): Email {
+  const url = `${appUrl()}/dashboard`;
+  return {
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Get started here: ${url}\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a>.</p>`,
+  };
+}
+
+export function passwordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+  ttlMinutes: number,
+): Email {
+  return {
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password: ${resetUrl}\n\nThis link expires in ${ttlMinutes} minutes. If you didn't ask for it, ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${resetUrl}">Reset your password</a>. This link expires in ${ttlMinutes} minutes.</p><p>If you didn't ask for it, ignore this email.</p>`,
+  };
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
