@@ -0,0 +1,64 @@
+// Transactional email via Resend's REST API (https://resend.com/docs/api-reference/emails/send-email).
+// Plain fetch, so no extra dependency. Without RESEND_API_KEY (local dev) emails are logged instead.
+
+export type Email = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+const FROM = process.env.EMAIL_FROM ?? "Notely <onboarding@resend.dev>";
+const APP_URL = process.env.APP_URL ?? "http://localhost:3000";
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+export async function sendEmail(email: Email): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) {
+    console.log(`[email:dev] to=${email.to} subject="${email.subject}"\n${email.text}`);
+    return;
+  }
+
+  const res = await fetch("https://api.resend.com/emails", {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({ from: FROM, ...email, to: [email.to] }),
+  });
+  if (!res.ok) {
+    throw new Error(`Email send failed (${res.status}): ${await res.text()}`);
+  }
+}
+
+export function welcomeEmail(user: { email: string; name: string }): Email {
+  const url = `${APP_URL}/dashboard`;
+  return {
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Get started here: ${url}\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a>.</p>`,
+  };
+}
+
+export function passwordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  ttlMinutes: number,
+): Email {
+  const url = `${APP_URL}/reset-password?token=${encodeURIComponent(token)}`;
+  return {
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password (link valid for ${ttlMinutes} minutes): ${url}\n\nIf you didn't request this, ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${url}">Reset your password</a>. The link is valid for ${ttlMinutes} minutes.</p><p>If you didn't request this, ignore this email.</p>`,
+  };
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
