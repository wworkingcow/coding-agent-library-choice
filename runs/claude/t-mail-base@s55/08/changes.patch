diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..075eb15
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,60 @@
+// Transactional email via Resend's REST API (no SDK dependency needed).
+// Without RESEND_API_KEY (local dev) emails are logged instead of sent.
+
+type Email = { to: string; subject: string; html: string; text: string };
+
+const escapeHtml = (s: string) =>
+  s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+
+async function send({ to, subject, html, text }: Email): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) {
+    console.log(`[email:dev] to=${to} subject=${subject}\n${text}`);
+    return;
+  }
+  const res = await fetch("https://api.resend.com/emails", {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({
+      from: process.env.EMAIL_FROM ?? "Notely <noreply@notely.example.com>",
+      to,
+      subject,
+      html,
+      text,
+    }),
+  });
+  if (!res.ok) {
+    throw new Error(`Email send failed: ${res.status} ${await res.text()}`);
+  }
+}
+
+export function appUrl(): string {
+  return process.env.APP_URL ?? "http://localhost:3000";
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }) {
+  const url = `${appUrl()}/dashboard`;
+  await send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Get started here: ${url}\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a>.</p>`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  ttlMinutes: number,
+) {
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nReset your password (valid for ${ttlMinutes} minutes): ${url}\n\nIf you didn't request this, ignore this email.\n`,
+    html: `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${url}">Reset your password</a> (valid for ${ttlMinutes} minutes).</p><p>If you didn't request this, ignore this email.</p>`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..02e568b 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,56 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  // The account exists either way; a mail failure must not fail signup.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error("Failed to send welcome email", err);
+  }
+  return user;
+}
+
+const RESET_TTL_MINUTES = 60;
+// Only the hash of each token is stored. In-memory like `users` above.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+const hashToken = (t: string) => createHash("sha256").update(t).digest("hex");
+
+// Silent when the email is unknown, so callers can't probe for registered users.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === email.trim().toLowerCase());
+  if (!user) return;
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TTL_MINUTES * 60_000,
+  });
+  await sendPasswordResetEmail(user, token, RESET_TTL_MINUTES);
+}
+
+// Single-use: returns the user id the token belongs to, or undefined.
+// TODO: the caller must set the new password once users have credentials.
+export async function consumePasswordResetToken(
+  token: string,
+): Promise<string | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return entry.userId;
+}
