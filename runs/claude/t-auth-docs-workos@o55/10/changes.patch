 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+function displayName(authUser: AuthUser): string {
+  const full = [authUser.firstName, authUser.lastName].filter(Boolean).join(" ");
+  return authUser.name || full || authUser.email.split("@")[0];
+}
+
+// Maps a WorkOS user onto a Notely user, creating one on first sign-in.
+// An existing row is claimed by email only when WorkOS has verified that email,
+// so nobody can take over Ada's account by signing up unverified with her address.
+export async function upsertUserFromAuth(authUser: AuthUser): Promise<User> {
+  const byAuthId = users.find((u) => u.authId === authUser.id);
+  if (byAuthId) {
+    byAuthId.email = authUser.email;
+    return byAuthId;
+  }
+
+  if (authUser.emailVerified) {
+    const email = authUser.email.toLowerCase();
+    const byEmail = users.find((u) => !u.authId && u.email.toLowerCase() === email);
+    if (byEmail) {
+      byEmail.authId = authUser.id;
+      return byEmail;
+    }
+  }
+
+  const user: User = {
+    id: String(users.length + 1),
+    email: authUser.email,
+    name: displayName(authUser),
+    createdAt: new Date().toISOString().slice(0, 10),
+    authId: authUser.id,
+  };
+  users.push(user);
+  return user;
+}
+
+// The signed-in Notely user, or undefined for visitors without a session.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const { user } = await withAuth();
+  return user ? upsertUserFromAuth(user) : undefined;
+}
+
+// Like getCurrentUser, but sends visitors without a session to sign in.
+export async function requireCurrentUser(): Promise<User> {
+  const { user } = await withAuth({ ensureSignedIn: true });
+  return upsertUserFromAuth(user);
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..288efed
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,13 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Secure by default: every matched path needs a session unless listed here.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/", "/sign-in", "/sign-up", "/auth/callback"],
+  },
+});
+
+export const config = {
+  matcher: ["/", "/dashboard/:path*", "/sign-in", "/sign-up", "/auth/callback"],
+};
