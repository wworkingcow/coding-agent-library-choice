-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+// Links a WorkOS identity to a Notely user: matched by WorkOS id first, then by
+// email (so seeded users keep their record), otherwise a new user is created.
+export async function upsertUserFromAuth(authUser: AuthUser): Promise<User> {
+  const email = authUser.email.toLowerCase();
+  const name =
+    [authUser.firstName, authUser.lastName].filter(Boolean).join(" ") || email.split("@")[0];
+
+  const existing =
+    users.find((u) => u.authId === authUser.id) ??
+    users.find((u) => !u.authId && u.email.toLowerCase() === email);
+
+  if (existing) {
+    existing.authId = authUser.id;
+    existing.email = email;
+    return existing;
+  }
+
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+    authId: authUser.id,
+  };
+  users.push(user);
+  return user;
+}
+
+// Returns the signed-in user, or undefined for signed-out visitors.
