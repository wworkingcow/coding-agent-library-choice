-  return users[0];
+  const { user } = await withAuth();
+  return user ? upsertUserFromAuth(user) : undefined;
+}
+
+// Like getCurrentUser, but redirects signed-out visitors to sign in.
+export async function requireUser(): Promise<User> {
+  const { user } = await withAuth({ ensureSignedIn: true });
+  return upsertUserFromAuth(user);
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..57306fb
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,14 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Keeps the session fresh on every request and redirects signed-out visitors
+// to AuthKit for anything that isn't listed as public.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/", "/sign-in", "/sign-up", "/auth/callback"],
+  },
+});
+
+export const config = {
+  matcher: ["/((?!_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp|ico)$).*)"],
+};
