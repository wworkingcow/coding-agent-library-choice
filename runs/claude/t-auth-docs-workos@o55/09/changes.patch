-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+type AuthUser = {
+  id: string;
+  email: string;
+  firstName: string | null;
+  lastName: string | null;
+};
+
+// Links a WorkOS identity to a Notely user: by WorkOS id first, then by email
+// (so seeded users keep their record), otherwise creates a new one.
+export async function upsertUserFromAuth(authUser: AuthUser): Promise<User> {
+  const email = authUser.email.toLowerCase();
+  const existing =
+    users.find((u) => u.workosId === authUser.id) ??
+    users.find((u) => u.email.toLowerCase() === email);
+
+  if (existing) {
+    existing.workosId = authUser.id;
+    existing.email = authUser.email;
+    return existing;
+  }
+
+  const fullName = [authUser.firstName, authUser.lastName].filter(Boolean).join(" ");
+  const user: User = {
+    id: String(users.length + 1),
+    email: authUser.email,
+    name: fullName || authUser.email.split("@")[0],
+    createdAt: new Date().toISOString().slice(0, 10),
+    workosId: authUser.id,
+  };
+  users.push(user);
+  return user;
+}
+
+// Returns the signed-in user, or undefined for visitors without a session.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const { user } = await withAuth();
+  if (!user) return undefined;
+  return upsertUserFromAuth(user);
+}
+
+// For pages that must have a user: redirects to AuthKit sign-in when there is no session.
+export async function requireCurrentUser(): Promise<User> {
+  const { user } = await withAuth({ ensureSignedIn: true });
+  return upsertUserFromAuth(user);
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..c29884f
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,14 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Every matched route requires a session unless listed in unauthenticatedPaths,
+// so anything new under /dashboard is protected by default.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/", "/sign-in", "/sign-up", "/auth/callback"],
+  },
+});
+
+export const config = {
+  matcher: ["/((?!_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp|ico)$).*)"],
+};
