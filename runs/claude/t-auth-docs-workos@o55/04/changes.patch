+type AuthUser = {
+  id: string;
+  email: string;
+  firstName: string | null;
+  lastName: string | null;
+  createdAt: string | Date;
+};
+
+// Links an authenticated WorkOS user to a Notely user: matched by WorkOS id, then by
+// email (so existing users keep their record on first sign-in), otherwise created.
+export async function upsertUserFromAuth(authUser: AuthUser): Promise<User> {
+  const email = authUser.email.toLowerCase();
+  const existing =
+    users.find((u) => u.workosId === authUser.id) ??
+    users.find((u) => u.email.toLowerCase() === email);
+
+  if (existing) {
+    existing.workosId = authUser.id;
+    existing.email = authUser.email;
+    return existing;
+  }
+
+  const fullName = [authUser.firstName, authUser.lastName].filter(Boolean).join(" ");
+  const user: User = {
+    id: String(users.length + 1),
+    email: authUser.email,
+    name: fullName || email.split("@")[0],
+    createdAt: new Date(authUser.createdAt).toISOString().slice(0, 10),
+    workosId: authUser.id,
+  };
+  users.push(user);
+  return user;
+}
+
+// Returns the signed-in user, or undefined for signed-out visitors.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const { user } = await withAuth();
+  if (!user) return undefined;
+  return upsertUserFromAuth(user);
+}
+
+// Like getCurrentUser, but redirects signed-out visitors to sign-in.
+export async function requireCurrentUser(): Promise<User> {
+  const { user } = await withAuth({ ensureSignedIn: true });
+  return upsertUserFromAuth(user);
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..a998434
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,15 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Everything matched below requires a session except the listed public paths;
+// signed-out visitors to /dashboard are redirected to AuthKit sign-in.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/", "/sign-in", "/sign-up"],
+  },
+  signUpPaths: ["/sign-up"],
+});
+
+export const config = {
+  matcher: ["/", "/dashboard/:path*", "/sign-in", "/sign-up"],
+};
