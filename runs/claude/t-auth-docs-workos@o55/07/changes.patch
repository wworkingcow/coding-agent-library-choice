-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+// Links a WorkOS identity to a Notely user by email, creating the Notely user on
+// first sign-in. Identity (passwords, Google) lives in WorkOS; this list stays the
+// source of truth for app data.
+function syncUser(authUser: AuthUser): User {
+  const email = authUser.email.toLowerCase();
+  const existing = users.find((u) => u.email.toLowerCase() === email);
+  if (existing) return existing;
+
+  const name =
+    [authUser.firstName, authUser.lastName].filter(Boolean).join(" ") ||
+    email.split("@")[0];
+  // The session cookie round-trips through JSON, so createdAt may arrive as a string.
+  const createdAt = new Date(authUser.createdAt).toISOString().slice(0, 10);
+  const user: User = { id: authUser.id, email: authUser.email, name, createdAt };
+  users.push(user);
+  return user;
+}
+
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const { user } = await withAuth();
+  return user ? syncUser(user) : undefined;
+}
+
+// For pages that require a session: redirects signed-out visitors to sign-in.
+export async function requireUser(): Promise<User> {
+  const { user } = await withAuth({ ensureSignedIn: true });
+  return syncUser(user);
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..8507843
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,12 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Keeps the AuthKit session fresh and redirects signed-out visitors away from
+// /dashboard. Pages that read the session (withAuth) must be covered by the matcher.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/", "/sign-in", "/sign-up", "/auth/callback"],
+  },
+});
+
+export const config = { matcher: ["/", "/dashboard/:path*"] };
