-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+// Links a WorkOS identity to a local user: match by WorkOS id, then by email
+// (so existing users keep their record), otherwise create one on first sign-in.
+function upsertFromAuth(authUser: AuthUser): User {
+  const email = authUser.email.toLowerCase();
+  let user =
+    users.find((u) => u.workosId === authUser.id) ??
+    users.find((u) => u.email.toLowerCase() === email);
+
+  if (!user) {
+    const name =
+      [authUser.firstName, authUser.lastName].filter(Boolean).join(" ") || email.split("@")[0];
+    user = {
+      id: String(users.length + 1),
+      email,
+      name,
+      createdAt: new Date(authUser.createdAt).toISOString().slice(0, 10),
+    };
+    users.push(user);
+  }
+
+  user.workosId = authUser.id;
+  return user;
+}
+
+// Returns the signed-in user, or undefined for signed-out visitors.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const { user } = await withAuth();
+  return user ? upsertFromAuth(user) : undefined;
+}
+
+// Same as getCurrentUser, but redirects signed-out visitors to sign in.
+export async function requireUser(): Promise<User> {
+  const { user } = await withAuth({ ensureSignedIn: true });
+  return upsertFromAuth(user);
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..e5769b8
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,12 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Refreshes the session on every matched route and blocks signed-out visitors
+// from anything not listed in unauthenticatedPaths.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/"],
+  },
+});
+
+export const config = { matcher: ["/", "/dashboard/:path*"] };
