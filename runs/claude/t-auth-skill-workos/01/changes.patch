+
+function upsertFromAuthKitUser(authKitUser: AuthKitUser): User {
+  const name =
+    [authKitUser.firstName, authKitUser.lastName].filter(Boolean).join(" ") ||
+    authKitUser.email;
+
+  const existing = users.find((u) => u.id === authKitUser.id);
+  if (existing) {
+    existing.email = authKitUser.email;
+    existing.name = name;
+    return existing;
+  }
+
+  const created: User = {
+    id: authKitUser.id,
+    email: authKitUser.email,
+    name,
+    createdAt: authKitUser.createdAt.slice(0, 10),
+  };
+  users.push(created);
+  return created;
 }
diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..26a4766
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,15 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Secure by default: every matched route requires a signed-in session except
+// the ones listed in unauthenticatedPaths. This enforces the /dashboard
+// redirect here (in the proxy response) rather than via
+// withAuth({ ensureSignedIn: true }) in a page — that variant tries to set a
+// cookie during a Server Component render, which Next.js rejects.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/"],
+  },
+});
+
+export const config = { matcher: ["/", "/dashboard/:path*"] };
