+function syncUser(workosUser: WorkOSUser): User {
+  const existing = users.find((u) => u.id === workosUser.id);
+  const synced: User = {
+    id: workosUser.id,
+    email: workosUser.email,
+    name: workosUser.name ?? workosUser.email,
+    createdAt: existing?.createdAt ?? workosUser.createdAt,
+  };
+
+  if (existing) {
+    Object.assign(existing, synced);
+  } else {
+    users.push(synced);
+  }
+
+  return synced;
+}
+
