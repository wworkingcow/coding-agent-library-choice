+function syncUser(input: { id: string; email: string; name: string }): User {
+  const existing = users.find((u) => u.id === input.id);
+  if (existing) {
+    existing.email = input.email;
+    existing.name = input.name;
+    return existing;
+  }
+
+  const created: User = { ...input, createdAt: new Date().toISOString().slice(0, 10) };
+  users.push(created);
+  return created;
+}
