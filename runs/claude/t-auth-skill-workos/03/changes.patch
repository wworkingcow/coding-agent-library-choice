@@ -0,0 +1,13 @@
+import { authkitMiddleware } from "@workos-inc/authkit-nextjs";
+
+// Gates /dashboard for signed-out visitors, redirecting them into the
+// AuthKit sign-in flow. "/" stays public so the marketing page still
+// renders when signed out.
+export default authkitMiddleware({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/"],
+  },
+});
+
+export const config = { matcher: ["/", "/dashboard/:path*"] };
