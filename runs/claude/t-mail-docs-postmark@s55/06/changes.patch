diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..50e8552
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,49 @@
+import { getPostmark } from "@/lib/postmark";
+
+type Recipient = { email: string; name: string };
+
+const escapeHtml = (s: string) =>
+  s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+
+const appUrl = () => process.env.APP_URL ?? "http://localhost:3000";
+
+// Email must never break the request that triggered it, so failures are logged, not thrown.
+async function send(to: string, subject: string, html: string, text: string) {
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!from || !process.env.POSTMARK_SERVER_TOKEN) {
+    console.warn(`[email] Postmark not configured; skipping "${subject}"`);
+    return;
+  }
+  try {
+    await getPostmark().sendEmail({
+      From: from,
+      To: to,
+      Subject: subject,
+      HtmlBody: html,
+      TextBody: text,
+      MessageStream: "outbound",
+    });
+  } catch (err) {
+    console.error(`[email] failed to send "${subject}"`, err);
+  }
+}
+
+export async function sendWelcomeEmail({ email, name }: Recipient) {
+  const url = `${appUrl()}/dashboard`;
+  await send(
+    email,
+    "Welcome to Notely",
+    `<p>Hi ${escapeHtml(name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a> to get started.</p>`,
+    `Hi ${name},\n\nWelcome to Notely! Open your dashboard to get started: ${url}\n`,
+  );
+}
+
+export async function sendPasswordResetEmail({ email, name }: Recipient, token: string) {
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await send(
+    email,
+    "Reset your Notely password",
+    `<p>Hi ${escapeHtml(name)},</p><p><a href="${url}">Reset your password</a>. This link expires in 1 hour. If you didn't ask for this, ignore this email.</p>`,
+    `Hi ${name},\n\nReset your password: ${url}\n\nThis link expires in 1 hour. If you didn't ask for this, ignore this email.\n`,
+  );
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..5aec5b5
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,10 @@
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Created lazily so importing this module (e.g. during `next build`) doesn't require the token.
+export function getPostmark(): ServerClient {
+  const token = process.env.POSTMARK_SERVER_TOKEN;
+  if (!token) throw new Error("POSTMARK_SERVER_TOKEN is not set");
+  return (client ??= new ServerClient(token));
+}
