new file mode 100644
index 0000000..9f8aff8
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,41 @@
+import { postmark } from "@/lib/postmark";
+
+const escapeHtml = (s: string) =>
+  s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+
+async function send(to: string, subject: string, html: string, text: string) {
+  try {
+    await postmark.sendEmail({
+      From: process.env.POSTMARK_FROM_EMAIL!,
+      To: to,
+      Subject: subject,
+      HtmlBody: html,
+      TextBody: text,
+      MessageStream: "outbound",
+    });
+  } catch (err) {
+    // A failed email must not break the request that triggered it.
+    console.error(`[email] failed to send "${subject}"`, err);
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  return send(
+    user.email,
+    "Welcome to Notely",
+    `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely — thanks for signing up.</p>`,
+    `Hi ${user.name},\n\nWelcome to Notely — thanks for signing up.`,
+  );
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+) {
+  return send(
+    user.email,
+    "Reset your Notely password",
+    `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${escapeHtml(resetUrl)}">Reset your password</a>. This link expires in 1 hour. If you didn't ask for it, ignore this email.</p>`,
+    `Hi ${user.name},\n\nReset your password: ${resetUrl}\n\nThis link expires in 1 hour. If you didn't ask for it, ignore this email.`,
+  );
+}
