index 1b4b6c1..0876b9f 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendWelcomeEmail, sendPasswordResetEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,40 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const user: User = {
+    id: String(users.length + 1),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  await sendWelcomeEmail(user);
+  return user;
+}
+
+const RESET_TTL_MS = 60 * 60 * 1000;
+// In-memory like the users list; keyed by SHA-256 of the token so raw tokens are never stored.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+  // Resolve silently for unknown emails so callers can't enumerate accounts.
+  if (!user) return;
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), { userId: user.id, expiresAt: Date.now() + RESET_TTL_MS });
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  await sendPasswordResetEmail(user, `${base}/reset-password?token=${token}`);
+}
+
+// Returns the user the token belongs to and consumes it, or undefined if invalid/expired.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
