new file mode 100644
index 0000000..6daa908
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,43 @@
+import { postmark } from "@/lib/postmark";
+import type { User } from "@/lib/users";
+
+function escapeHtml(s: string): string {
+  return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+async function send(to: string, subject: string, html: string, text: string) {
+  try {
+    await postmark.sendEmail({
+      From: process.env.POSTMARK_FROM_EMAIL!,
+      To: to,
+      Subject: subject,
+      HtmlBody: html,
+      TextBody: text,
+      MessageStream: process.env.POSTMARK_MESSAGE_STREAM ?? "outbound",
+    });
+  } catch (err) {
+    // A failed email must not break the request that triggered it.
+    console.error("Failed to send email", { subject, error: err });
+  }
+}
+
+export async function sendWelcomeEmail(user: User) {
+  const name = escapeHtml(user.name);
+  await send(
+    user.email,
+    "Welcome to Notely",
+    `<p>Hi ${name},</p><p>Welcome to Notely — your team's notes are ready.</p>`,
+    `Hi ${user.name},\n\nWelcome to Notely — your team's notes are ready.`,
+  );
+}
+
+export async function sendPasswordResetEmail(user: User, resetUrl: string) {
+  const name = escapeHtml(user.name);
+  const url = escapeHtml(resetUrl);
+  await send(
+    user.email,
+    "Reset your Notely password",
+    `<p>Hi ${name},</p><p><a href="${url}">Reset your password</a>. This link expires in 1 hour.</p><p>If you didn't ask for this, you can ignore this email.</p>`,
+    `Hi ${user.name},\n\nReset your password: ${resetUrl}\nThis link expires in 1 hour.\n\nIf you didn't ask for this, you can ignore this email.`,
+  );
+}
