diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..c97b83b
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,59 @@
+import { getPostmark } from "@/lib/postmark";
+
+type Message = { to: string; subject: string; html: string; text: string };
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+// Never throws: a failed email must not break the request that triggered it.
+async function send({ to, subject, html, text }: Message): Promise<boolean> {
+  const postmark = getPostmark();
+  const from = process.env.POSTMARK_FROM_EMAIL;
+  if (!postmark || !from) {
+    console.warn(`[email] Postmark not configured; skipped "${subject}" to ${to}`);
+    return false;
+  }
+  try {
+    await postmark.sendEmail({
+      From: from,
+      To: to,
+      Subject: subject,
+      HtmlBody: html,
+      TextBody: text,
+      MessageStream: process.env.POSTMARK_MESSAGE_STREAM || "outbound",
+    });
+    return true;
+  } catch (err) {
+    console.error(`[email] failed to send "${subject}" to ${to}:`, err);
+    return false;
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  const name = escapeHtml(user.name);
+  return send({
+    to: user.email,
+    subject: "Welcome to Notely",
+    html: `<p>Hi ${name},</p><p>Welcome to Notely! Your account is ready.</p>`,
+    text: `Hi ${user.name},\n\nWelcome to Notely! Your account is ready.`,
+  });
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+) {
+  const name = escapeHtml(user.name);
+  const url = escapeHtml(resetUrl);
+  return send({
+    to: user.email,
+    subject: "Reset your Notely password",
+    html: `<p>Hi ${name},</p><p><a href="${url}">Reset your password</a>. This link expires in 1 hour.</p><p>If you didn't ask for this, you can ignore this email.</p>`,
+    text: `Hi ${user.name},\n\nReset your password: ${resetUrl}\n\nThis link expires in 1 hour. If you didn't ask for this, ignore this email.`,
+  });
+}
diff --git a/src/lib/postmark.ts b/src/lib/postmark.ts
new file mode 100644
index 0000000..b089508
--- /dev/null
+++ b/src/lib/postmark.ts
@@ -0,0 +1,11 @@
+import { ServerClient } from "postmark";
+
+let client: ServerClient | undefined;
+
+// Server-only. Created lazily so the app still builds and runs without a token.
+export function getPostmark(): ServerClient | undefined {
+  const token = process.env.POSTMARK_SERVER_TOKEN;
+  if (!token) return undefined;
+  client ??= new ServerClient(token);
+  return client;
+}
