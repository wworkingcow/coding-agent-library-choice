@@ -0,0 +1,10 @@
+import { auth } from "@/lib/auth";
+import { getUser, type User } from "@/lib/users";
+
+// Resolves the signed-in user's full record from the session cookie.
+// Lives outside users.ts to avoid a circular import (auth.ts already imports users.ts).
+export async function getCurrentUser(): Promise<User | undefined> {
+  const session = await auth();
+  if (!session?.user?.id) return undefined;
+  return getUser(session.user.id);
+}
