+      >
+        Continue with Google
+      </button>
+
+      <div className="my-6 flex items-center gap-3 text-xs uppercase opacity-50">
+        <div className="h-px flex-1 bg-current opacity-20" />
+        or
+        <div className="h-px flex-1 bg-current opacity-20" />
+      </div>
+
+      <form onSubmit={handleSubmit} className="flex flex-col gap-3">
+        <input
+          required
+          placeholder="Name"
+          value={name}
+          onChange={(e) => setName(e.target.value)}
+          className="rounded-lg border border-black/[.08] px-3 py-2 text-sm dark:border-white/[.145]"
+        />
+        <input
+          type="email"
+          required
+          placeholder="Email"
+          value={email}
+          onChange={(e) => setEmail(e.target.value)}
+          className="rounded-lg border border-black/[.08] px-3 py-2 text-sm dark:border-white/[.145]"
+        />
+        <input
+          type="password"
+          required
+          minLength={8}
+          placeholder="Password (min 8 characters)"
+          value={password}
+          onChange={(e) => setPassword(e.target.value)}
+          className="rounded-lg border border-black/[.08] px-3 py-2 text-sm dark:border-white/[.145]"
+        />
+        {error && <p className="text-sm text-red-600">{error}</p>}
+        <button
+          type="submit"
+          disabled={loading}
+          className="rounded-full bg-foreground px-5 py-3 text-sm font-medium text-background transition-colors hover:bg-[#383838] disabled:opacity-50 dark:hover:bg-[#ccc]"
+        >
+          {loading ? "Creating account…" : "Sign up"}
+        </button>
+      </form>
+
+      <p className="mt-6 text-sm opacity-70">
+        Already have an account?{" "}
+        <Link href="/signin" className="font-medium underline">
+          Sign in
+        </Link>
+      </p>
+    </main>
+  );
+}
