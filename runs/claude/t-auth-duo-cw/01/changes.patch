new file mode 100644
index 0000000..8d2852e
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,57 @@
+import NextAuth from "next-auth";
+import Credentials from "next-auth/providers/credentials";
+import Google from "next-auth/providers/google";
+import { findOrCreateOAuthUser, verifyPassword } from "@/lib/users";
+
+export const { handlers, auth, signIn, signOut } = NextAuth({
+  session: { strategy: "jwt" },
+  pages: { signIn: "/signin" },
+  // Needed for self-hosted deployments (Vercel sets this automatically).
+  // See https://errors.authjs.dev#untrustedhost
+  trustHost: true,
+  providers: [
+    Credentials({
+      name: "Email and password",
+      credentials: {
+        email: { label: "Email", type: "email" },
+        password: { label: "Password", type: "password" },
+      },
+      async authorize(credentials) {
+        const email = credentials?.email;
+        const password = credentials?.password;
+        if (typeof email !== "string" || typeof password !== "string") return null;
+
+        const user = await verifyPassword(email, password);
+        if (!user) return null;
+
+        return { id: user.id, email: user.email, name: user.name };
+      },
+    }),
+    Google({
+      clientId: process.env.AUTH_GOOGLE_ID,
+      clientSecret: process.env.AUTH_GOOGLE_SECRET,
+    }),
+  ],
+  callbacks: {
+    async signIn({ user, account }) {
+      if (account?.provider === "google") {
+        if (!user.email) return false;
+        // Provision (or reuse) the local user record so downstream code only
+        // ever deals with our own `User` shape from src/lib/users.ts.
+        const dbUser = await findOrCreateOAuthUser(user.email, user.name ?? user.email);
+        user.id = dbUser.id;
+      }
+      return true;
+    },
+    async jwt({ token, user }) {
+      if (user?.id) token.id = user.id;
+      return token;
+    },
+    async session({ session, token }) {
+      if (session.user && typeof token.id === "string") {
+        session.user.id = token.id;
+      }
+      return session;
+    },
+  },
+});
