+function syncFromClerk(clerkUser: NonNullable<Awaited<ReturnType<typeof currentUser>>>): User {
+  const existing = users.find((u) => u.id === clerkUser.id);
+  if (existing) return existing;
+
+  const email = clerkUser.primaryEmailAddress?.emailAddress ?? "";
