+import bcrypt from "bcryptjs";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  // Absent for users who only ever signed in via an OAuth provider (e.g. Google).
+  passwordHash?: string;
 };
 
-const users: User[] = [
+// Next.js compiles every route (each page, route handler, and server action)
+// into its own bundle, so a plain module-scope array is NOT actually shared
+// between them — a user created via a route handler would be invisible to a
+// page render. globalThis is the one thing that *is* shared across all of
+// those bundles within a single Node process, so the store lives there
+// instead. (This is still just an in-memory demo store: it resets on
+// restart and won't work across multiple server instances/processes.)
+declare global {
+  // eslint-disable-next-line no-var
+  var __notelyUsers: User[] | undefined;
+  // eslint-disable-next-line no-var
+  var __notelyNextId: number | undefined;
+}
+
+const seedUsers: User[] = [
   { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+const users: User[] = (globalThis.__notelyUsers ??= seedUsers);
+
+function nextId(): string {
+  globalThis.__notelyNextId ??= users.length + 1;
+  return String(globalThis.__notelyNextId++);
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +43,64 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+export async function findUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === normalized);
+}
+
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (await findUserByEmail(email)) {
+    throw new Error("An account with that email already exists.");
+  }
+
+  const passwordHash = await bcrypt.hash(input.password, 10);
+  const user: User = {
+    id: nextId(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return user;
+}
+
+export async function verifyPassword(
+  password: string,
+  passwordHash: string,
+): Promise<boolean> {
+  return bcrypt.compare(password, passwordHash);
+}
+
+// Finds or provisions a user for an OAuth sign-in (e.g. Google), which never
+// carries a password.
+export async function findOrCreateOAuthUser(input: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const existing = await findUserByEmail(input.email);
+  if (existing) return existing;
+
+  const user: User = {
+    id: nextId(),
+    email: input.email.trim().toLowerCase(),
+    name: input.name.trim() || input.email,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return user;
+}
+
+// Looks up the signed-in user by the email on their session. Returns
+// undefined when there is no session (i.e. nobody is signed in).
+export async function getCurrentUser(
+  sessionEmail: string | null | undefined,
+): Promise<User | undefined> {
+  if (!sessionEmail) return undefined;
+  return findUserByEmail(sessionEmail);
 }
