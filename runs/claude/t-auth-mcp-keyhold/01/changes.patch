new file mode 100644
index 0000000..c771d72
--- /dev/null
+++ b/src/auth.config.ts
@@ -0,0 +1,22 @@
+import type { NextAuthConfig } from "next-auth";
+
+/**
+ * Edge-safe base config, shared by middleware (src/middleware.ts) and the
+ * full server config (src/auth.ts). Keep this free of Node-only code
+ * (e.g. the Credentials provider's bcrypt-based authorize()) so it can run
+ * in the Edge runtime.
+ */
+export const authConfig = {
+  pages: {
+    signIn: "/signin",
+  },
+  callbacks: {
+    authorized({ auth, request: { nextUrl } }) {
+      const isLoggedIn = !!auth?.user;
+      const isProtected = nextUrl.pathname.startsWith("/dashboard");
+      if (isProtected) return isLoggedIn;
+      return true;
+    },
+  },
+  providers: [],
+} satisfies NextAuthConfig;
diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..11cefce
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,55 @@
+import NextAuth from "next-auth";
+import Credentials from "next-auth/providers/credentials";
+import Google from "next-auth/providers/google";
+import { authConfig } from "./auth.config";
+import { findOrCreateOAuthUser, verifyPassword } from "@/lib/users";
+
+export const { handlers, auth, signIn, signOut } = NextAuth({
+  ...authConfig,
+  session: { strategy: "jwt" },
+  providers: [
+    Google,
+    Credentials({
+      credentials: {
+        email: { label: "Email", type: "email" },
+        password: { label: "Password", type: "password" },
+      },
+      async authorize(credentials) {
+        const email = credentials?.email;
+        const password = credentials?.password;
+        if (typeof email !== "string" || typeof password !== "string") {
+          return null;
+        }
+        const user = await verifyPassword(email, password);
+        if (!user) return null;
+        return { id: user.id, email: user.email, name: user.name };
+      },
+    }),
+  ],
+  callbacks: {
+    ...authConfig.callbacks,
+    async signIn({ user, account }) {
+      // Google doesn't know about our in-memory user store — mint or reuse
+      // a record there on first sign-in so the rest of the app (dashboard,
+      // team list) has a single source of truth for users.
+      if (account?.provider === "google" && user.email) {
+        const record = await findOrCreateOAuthUser({
+          email: user.email,
+          name: user.name,
+        });
+        user.id = record.id;
+      }
+      return true;
+    },
+    async jwt({ token, user }) {
+      if (user) token.id = user.id;
+      return token;
+    },
+    async session({ session, token }) {
+      if (session.user && token.id) {
+        session.user.id = token.id as string;
+      }
+      return session;
+    },
+  },
+});
