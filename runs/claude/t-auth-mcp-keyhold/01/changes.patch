+import NextAuth from "next-auth";
+import { authConfig } from "./auth.config";
+
+// A lightweight, Edge-compatible auth instance (no Credentials/bcrypt)
+// used only to gate routes based on the session cookie.
+const { auth } = NextAuth(authConfig);
+
+export default auth;
+
+export const config = {
+  // Protect /dashboard and everything under it. Add more paths here as
+  // the app grows.
+  matcher: ["/dashboard/:path*"],
+};
