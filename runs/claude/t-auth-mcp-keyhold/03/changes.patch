--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,8 +1,13 @@
+import { randomUUID } from "crypto";
+import bcrypt from "bcryptjs";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  /** Present for email/password accounts; absent for OAuth-only accounts (e.g. Google). */
+  passwordHash?: string;
 };
 
 const users: User[] = [
@@ -10,6 +15,10 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+function today(): string {
+  return new Date().toISOString().slice(0, 10);
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +27,69 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === normalized);
+}
+
+/**
+ * Creates a new email/password account. Used by the sign-up flow.
+ * Throws if the email is already registered.
+ */
+export async function createUserWithPassword(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error("An account with that email already exists.");
+  }
+
+  const passwordHash = await bcrypt.hash(input.password, 10);
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: today(),
+    passwordHash,
+  };
+  users.push(user);
+  return user;
+}
+
+/**
+ * Verifies email/password credentials for sign-in. Returns the user on success,
+ * or undefined if the email is unknown, has no password (OAuth-only), or the
+ * password doesn't match.
+ */
+export async function verifyCredentials(
+  email: string,
+  password: string
+): Promise<User | undefined> {
+  const user = await getUserByEmail(email);
+  if (!user?.passwordHash) return undefined;
+  const ok = await bcrypt.compare(password, user.passwordHash);
+  return ok ? user : undefined;
+}
+
+/**
+ * Finds or creates a user for an OAuth sign-in (e.g. Google), which never
+ * carries a password. Used by the Auth.js `signIn` callback.
+ */
+export async function upsertOAuthUser(input: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const existing = await getUserByEmail(input.email);
+  if (existing) return existing;
+
+  const user: User = {
+    id: randomUUID(),
+    email: input.email.trim().toLowerCase(),
+    name: input.name.trim() || input.email,
+    createdAt: today(),
+  };
+  users.push(user);
+  return user;
 }
