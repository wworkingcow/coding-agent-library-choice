@@ -22,3 +22,49 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export type Note = {
+  id: string;
+  userId: string;
+  title: string;
+  imageUrl?: string;
+  imageKey?: string;
+  createdAt: string;
+};
+
+// In-memory like `users`, but kept on globalThis so route handlers and pages share one store.
+const g = globalThis as unknown as { __notes?: Note[] };
+const notes: Note[] = (g.__notes ??= []);
+
+export async function listNotes(userId: string): Promise<Note[]> {
+  return notes.filter((n) => n.userId === userId);
+}
+
+export async function getNote(id: string): Promise<Note | undefined> {
+  return notes.find((n) => n.id === id);
+}
+
+export async function createNote(userId: string, title: string): Promise<Note> {
+  const note: Note = {
+    id: crypto.randomUUID(),
+    userId,
+    title,
+    createdAt: new Date().toISOString(),
+  };
+  notes.push(note);
+  return note;
+}
+
+/** Saves the image URL on the note and returns the previous storage key (if any) so the caller can delete it. */
+export async function setNoteImage(
+  id: string,
+  imageUrl: string,
+  imageKey: string,
+): Promise<string | undefined> {
+  const note = notes.find((n) => n.id === id);
+  if (!note) throw new Error("Note not found");
+  const previous = note.imageKey;
+  note.imageUrl = imageUrl;
+  note.imageKey = imageKey;
+  return previous;
+}
