diff --git a/src/lib/storage.ts b/src/lib/storage.ts
new file mode 100644
index 0000000..2474c64
--- /dev/null
+++ b/src/lib/storage.ts
@@ -0,0 +1,66 @@
+import { randomUUID } from "node:crypto";
+import {
+  DeleteObjectCommand,
+  PutObjectCommand,
+  S3Client,
+} from "@aws-sdk/client-s3";
+
+// S3-compatible storage: works with AWS S3, Cloudflare R2, MinIO, etc.
+export const MAX_IMAGE_BYTES = 5 * 1024 * 1024;
+
+let client: S3Client | undefined;
+
+function env(name: string): string {
+  const v = process.env[name];
+  if (!v) throw new Error(`Missing env var ${name}`);
+  return v;
+}
+
+function getClient(): S3Client {
+  return (client ??= new S3Client({
+    region: process.env.S3_REGION ?? "auto",
+    endpoint: process.env.S3_ENDPOINT || undefined,
+    forcePathStyle: process.env.S3_FORCE_PATH_STYLE === "true",
+    credentials: {
+      accessKeyId: env("S3_ACCESS_KEY_ID"),
+      secretAccessKey: env("S3_SECRET_ACCESS_KEY"),
+    },
+  }));
+}
+
+type ImageType = { mime: string; ext: string };
+
+// Sniff the real type from magic bytes; never trust the client-supplied type or filename.
+export function sniffImage(b: Uint8Array): ImageType | undefined {
+  const starts = (sig: number[], off = 0) => sig.every((v, i) => b[off + i] === v);
+  if (starts([0xff, 0xd8, 0xff])) return { mime: "image/jpeg", ext: "jpg" };
+  if (starts([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])) return { mime: "image/png", ext: "png" };
+  if (starts([0x47, 0x49, 0x46, 0x38])) return { mime: "image/gif", ext: "gif" };
+  if (starts([0x52, 0x49, 0x46, 0x46]) && starts([0x57, 0x45, 0x42, 0x50], 8))
+    return { mime: "image/webp", ext: "webp" };
+  return undefined;
+}
+
+export async function uploadNoteImage(
+  userId: string,
+  noteId: string,
+  body: Uint8Array,
+  type: ImageType,
+): Promise<{ key: string; url: string }> {
+  const key = `notes/${userId}/${noteId}/${randomUUID()}.${type.ext}`;
+  await getClient().send(
+    new PutObjectCommand({
+      Bucket: env("S3_BUCKET"),
+      Key: key,
+      Body: body,
+      ContentType: type.mime,
+      CacheControl: "public, max-age=31536000, immutable",
+    }),
+  );
+  const base = env("S3_PUBLIC_URL").replace(/\/+$/, "");
+  return { key, url: `${base}/${key}` };
+}
+
+export async function deleteObject(key: string): Promise<void> {
+  await getClient().send(new DeleteObjectCommand({ Bucket: env("S3_BUCKET"), Key: key }));
+}
