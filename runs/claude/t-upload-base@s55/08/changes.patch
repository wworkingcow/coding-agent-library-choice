@@ -0,0 +1,48 @@
+import { NextResponse } from "next/server";
+import { deleteObject, MAX_IMAGE_BYTES, sniffImage, uploadNoteImage } from "@/lib/storage";
+import { getCurrentUser, getNote, setNoteImage } from "@/lib/users";
+
+export async function POST(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  const { id } = await ctx.params;
+
+  const me = await getCurrentUser();
+  if (!me) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+
+  const note = await getNote(id);
+  if (!note || note.userId !== me.id) {
+    return NextResponse.json({ error: "Note not found" }, { status: 404 });
+  }
+
+  const declared = Number(req.headers.get("content-length") ?? 0);
+  if (declared > MAX_IMAGE_BYTES + 64 * 1024) {
+    return NextResponse.json({ error: "Image too large (max 5 MB)" }, { status: 413 });
+  }
+
+  const form = await req.formData().catch(() => null);
+  const file = form?.get("file");
+  if (!(file instanceof File)) {
+    return NextResponse.json({ error: "Missing file" }, { status: 400 });
+  }
+  if (file.size > MAX_IMAGE_BYTES) {
+    return NextResponse.json({ error: "Image too large (max 5 MB)" }, { status: 413 });
+  }
+
+  const bytes = new Uint8Array(await file.arrayBuffer());
+  const type = sniffImage(bytes);
+  if (!type) {
+    return NextResponse.json({ error: "Only JPEG, PNG, GIF or WebP images" }, { status: 415 });
+  }
+
+  let uploaded;
+  try {
+    uploaded = await uploadNoteImage(me.id, note.id, bytes, type);
+  } catch (err) {
+    console.error("image upload failed", err);
+    return NextResponse.json({ error: "Upload failed" }, { status: 502 });
+  }
+
+  const previousKey = await setNoteImage(note.id, uploaded.url, uploaded.key);
+  if (previousKey) await deleteObject(previousKey).catch((e) => console.error("cleanup failed", e));
+
+  return NextResponse.json({ imageUrl: uploaded.url });
+}
