@@ -0,0 +1,23 @@
+"use client";
+
+import { useActionState } from "react";
+import { addNote, type NoteFormState } from "./actions";
+
+export function NoteForm() {
+  const [state, action, pending] = useActionState<NoteFormState, FormData>(addNote, {});
+  return (
+    <form action={action} className="mt-2 space-y-2">
+      <textarea name="text" required className="w-full rounded border p-2 text-sm" rows={3} />
+      <input
+        type="file"
+        name="image"
+        accept="image/png,image/jpeg,image/webp,image/gif"
+        className="block text-sm"
+      />
+      {state.error && <p className="text-sm text-red-600">{state.error}</p>}
+      <button disabled={pending} className="rounded border px-3 py-1 text-sm">
+        {pending ? "Saving…" : "Add note"}
+      </button>
+    </form>
+  );
+}
