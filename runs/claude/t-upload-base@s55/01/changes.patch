@@ -0,0 +1,34 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { UploadError, uploadImage } from "@/lib/storage";
+import { createNote, getCurrentUser } from "@/lib/users";
+
+export type NoteFormState = { error?: string };
+
+export async function addNote(
+  _prev: NoteFormState,
+  formData: FormData,
+): Promise<NoteFormState> {
+  const me = await getCurrentUser();
+  if (!me) return { error: "Not signed in." };
+
+  const text = String(formData.get("text") ?? "").trim();
+  if (!text) return { error: "Write something first." };
+
+  const file = formData.get("image");
+  let imageUrl: string | undefined;
+  if (file instanceof File && file.size > 0) {
+    try {
+      imageUrl = await uploadImage(file, me.id);
+    } catch (e) {
+      if (e instanceof UploadError) return { error: e.message };
+      console.error("upload failed", e);
+      return { error: "Upload failed, try again." };
+    }
+  }
+
+  await createNote(me.id, text, imageUrl);
+  revalidatePath("/dashboard");
+  return {};
+}
