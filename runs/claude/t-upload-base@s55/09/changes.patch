@@ -0,0 +1,18 @@
+"use client";
+
+import { useActionState } from "react";
+import { createNote, type NoteState } from "./actions";
+
+export function NoteForm() {
+  const [state, action, pending] = useActionState<NoteState, FormData>(createNote, {});
+  return (
+    <form action={action} className="mt-2 space-y-2">
+      <textarea name="text" rows={3} placeholder="New note" className="w-full rounded border p-2 text-sm" />
+      <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" className="text-sm" />
+      {state.error && <p className="text-sm text-red-600">{state.error}</p>}
+      <button disabled={pending} className="rounded border px-3 py-1 text-sm disabled:opacity-50">
+        {pending ? "Saving…" : "Add note"}
+      </button>
+    </form>
+  );
+}
