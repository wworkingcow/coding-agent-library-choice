+++ b/src/app/dashboard/actions.ts
@@ -0,0 +1,32 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { addNote, getCurrentUser } from "@/lib/users";
+import { UploadError, uploadImage } from "@/lib/storage";
+
+export type NoteState = { error?: string };
+
+export async function createNote(_prev: NoteState, formData: FormData): Promise<NoteState> {
+  const me = await getCurrentUser();
+  if (!me) return { error: "Not signed in." };
+
+  const text = String(formData.get("text") ?? "").trim();
+  const file = formData.get("image");
+  const hasFile = file instanceof File && file.size > 0;
+  if (!text && !hasFile) return { error: "Write something or attach an image." };
+
+  let imageUrl: string | undefined;
+  if (hasFile) {
+    try {
+      imageUrl = await uploadImage(file, `notes/${me.id}`);
+    } catch (e) {
+      if (e instanceof UploadError) return { error: e.message };
+      console.error("upload failed", e);
+      return { error: "Upload failed. Please try again." };
+    }
+  }
+
+  await addNote(me.id, { text, imageUrl });
+  revalidatePath("/dashboard");
+  return {};
+}
