+# S3-compatible object storage for note images (AWS S3, Cloudflare R2, MinIO...)
+S3_BUCKET=notely-uploads
+S3_REGION=us-east-1
+S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
+S3_SECRET_ACCESS_KEY=replace-me
+# Leave empty for AWS S3; set for R2/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
+S3_ENDPOINT=
+# Public base URL the bucket's objects are served from (bucket policy/CDN/R2 public domain)
+S3_PUBLIC_BASE_URL=https://notely-uploads.s3.us-east-1.amazonaws.com
