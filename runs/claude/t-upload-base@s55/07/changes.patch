@@ -0,0 +1,35 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+
+export function ImageUpload({ noteId }: { noteId: string }) {
+  const router = useRouter();
+  const [state, setState] = useState<{ busy: boolean; error?: string }>({ busy: false });
+
+  async function onChange(e: React.ChangeEvent<HTMLInputElement>) {
+    const input = e.currentTarget;
+    const file = input.files?.[0];
+    if (!file) return;
+    setState({ busy: true });
+    const body = new FormData();
+    body.set("file", file);
+    try {
+      const res = await fetch(`/api/notes/${noteId}/image`, { method: "POST", body });
+      if (!res.ok) throw new Error((await res.json()).error ?? "Upload failed");
+      setState({ busy: false });
+      router.refresh();
+    } catch (err) {
+      setState({ busy: false, error: err instanceof Error ? err.message : "Upload failed" });
+    }
+    input.value = "";
+  }
+
+  return (
+    <div className="mt-2 text-sm">
+      <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" disabled={state.busy} onChange={onChange} />
+      {state.busy && <span className="ml-2 opacity-70">Uploading…</span>}
+      {state.error && <p className="text-red-600">{state.error}</p>}
+    </div>
+  );
+}
