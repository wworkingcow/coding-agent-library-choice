+import { getNote, setNoteImage } from "@/lib/notes";
+import { UploadError, uploadImage } from "@/lib/storage";
+import { getCurrentUser } from "@/lib/users";
+
+export const runtime = "nodejs";
+
+export async function POST(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  const me = await getCurrentUser();
+  if (!me) return Response.json({ error: "Not signed in" }, { status: 401 });
+
+  const { id } = await ctx.params;
+  const note = await getNote(id);
+  if (!note || note.userId !== me.id) return Response.json({ error: "Note not found" }, { status: 404 });
+
+  try {
+    const file = (await req.formData()).get("file");
+    if (!(file instanceof File)) throw new UploadError("Missing file", 400);
+    const url = await uploadImage(file, me.id);
+    await setNoteImage(note.id, url);
+    return Response.json({ url });
+  } catch (e) {
+    if (e instanceof UploadError) return Response.json({ error: e.message }, { status: e.status });
+    console.error("image upload failed", e);
+    return Response.json({ error: "Upload failed" }, { status: 500 });
+  }
+}
