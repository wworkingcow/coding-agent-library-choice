diff --git a/src/lib/storage.ts b/src/lib/storage.ts
new file mode 100644
index 0000000..fa0db77
--- /dev/null
+++ b/src/lib/storage.ts
@@ -0,0 +1,74 @@
+import { randomUUID } from "node:crypto";
+import { PutObjectCommand, S3Client } from "@aws-sdk/client-s3";
+import { getSignedUrl } from "@aws-sdk/s3-request-presigner";
+
+export const MAX_UPLOAD_BYTES = 5 * 1024 * 1024;
+
+const EXTENSIONS: Record<string, string> = {
+  "image/jpeg": "jpg",
+  "image/png": "png",
+  "image/webp": "webp",
+  "image/gif": "gif",
+};
+
+export const ALLOWED_IMAGE_TYPES = Object.keys(EXTENSIONS);
+
+function env(name: string): string {
+  const v = process.env[name];
+  if (!v) throw new Error(`Missing env var ${name}`);
+  return v;
+}
+
+let client: S3Client | undefined;
+function s3(): S3Client {
+  client ??= new S3Client({
+    region: env("S3_REGION"),
+    endpoint: process.env.S3_ENDPOINT || undefined,
+    credentials: {
+      accessKeyId: env("S3_ACCESS_KEY_ID"),
+      secretAccessKey: env("S3_SECRET_ACCESS_KEY"),
+    },
+  });
+  return client;
+}
+
+function userPrefix(userId: string): string {
+  return `notes/${userId}/`;
+}
+
+export function publicUrlFor(key: string): string {
+  return `${env("S3_PUBLIC_BASE_URL").replace(/\/$/, "")}/${key}`;
+}
+
+/** True only for URLs we issued for this user — stops clients attaching arbitrary URLs. */
+export function isOwnUploadUrl(userId: string, url: string): boolean {
+  return url.startsWith(publicUrlFor(userPrefix(userId)));
+}
+
+export class UploadRejected extends Error {}
+
+/** Presigned PUT so the browser uploads straight to the bucket (file bytes never pass through Next). */
+export async function createImageUpload(
+  userId: string,
+  contentType: string,
+  size: number,
+): Promise<{ uploadUrl: string; publicUrl: string }> {
+  const ext = EXTENSIONS[contentType];
+  if (!ext) throw new UploadRejected("Unsupported file type");
+  if (!Number.isInteger(size) || size <= 0 || size > MAX_UPLOAD_BYTES) {
+    throw new UploadRejected("File must be between 1 byte and 5 MB");
+  }
+
+  const key = `${userPrefix(userId)}${randomUUID()}.${ext}`;
+  const uploadUrl = await getSignedUrl(
+    s3(),
+    new PutObjectCommand({
+      Bucket: env("S3_BUCKET"),
+      Key: key,
+      ContentType: contentType,
+      ContentLength: size,
+    }),
+    { expiresIn: 60 },
+  );
+  return { uploadUrl, publicUrl: publicUrlFor(key) };
+}
