+
+export type Note = {
+  id: string;
+  userId: string;
+  text: string;
+  imageUrl?: string;
+  createdAt: string;
+};
+
+const notes: Note[] = [];
+
+export async function listNotes(userId: string): Promise<Note[]> {
+  return notes.filter((n) => n.userId === userId).reverse();
+}
+
+export async function addNote(userId: string, text: string, imageUrl?: string): Promise<Note> {
+  const note: Note = {
+    id: String(notes.length + 1),
+    userId,
+    text,
+    imageUrl,
+    createdAt: new Date().toISOString(),
+  };
+  notes.push(note);
+  return note;
+}
