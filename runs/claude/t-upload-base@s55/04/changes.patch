+"use server";
+
+import { revalidatePath } from "next/cache";
+import { addNote, getCurrentUser } from "@/lib/users";
+import { isOwnUploadUrl } from "@/lib/storage";
+
+export async function createNote(text: string, imageUrl?: string) {
+  const user = await getCurrentUser();
+  if (!user) throw new Error("Unauthorized");
+  if (!text.trim()) throw new Error("Note is empty");
+  if (imageUrl && !isOwnUploadUrl(user.id, imageUrl)) throw new Error("Invalid image URL");
+
+  await addNote(user.id, text.trim(), imageUrl);
+  revalidatePath("/dashboard");
+}
