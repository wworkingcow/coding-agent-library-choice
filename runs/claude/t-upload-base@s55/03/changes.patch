index 0000000..6ad2727
--- /dev/null
+++ b/src/app/dashboard/actions.ts
@@ -0,0 +1,31 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { UploadError, uploadImage } from "@/lib/storage";
+import { createNote, getCurrentUser } from "@/lib/users";
+
+export type NoteFormState = { error?: string };
+
+export async function addNote(_prev: NoteFormState, formData: FormData): Promise<NoteFormState> {
+  const me = await getCurrentUser();
+  if (!me) return { error: "Not signed in" };
+
+  const text = String(formData.get("text") ?? "").trim();
+  if (!text) return { error: "Note text is required" };
+
+  const image = formData.get("image");
+  let imageUrl: string | undefined;
+  if (image instanceof File && image.size > 0) {
+    try {
+      imageUrl = await uploadImage(image, me.id);
+    } catch (e) {
+      if (e instanceof UploadError) return { error: e.message };
+      console.error("Image upload failed", e);
+      return { error: "Upload failed, please try again" };
+    }
+  }
+
+  await createNote(me.id, text, imageUrl);
+  revalidatePath("/dashboard");
+  return {};
+}
diff --git a/src/app/dashboard/note-form.tsx b/src/app/dashboard/note-form.tsx
new file mode 100644
index 0000000..328ec54
--- /dev/null
+++ b/src/app/dashboard/note-form.tsx
@@ -0,0 +1,24 @@
+"use client";
+
+import { useActionState, useRef } from "react";
+import { addNote, type NoteFormState } from "./actions";
+
+export function NoteForm() {
+  const ref = useRef<HTMLFormElement>(null);
+  const [state, action, pending] = useActionState(async (prev: NoteFormState, fd: FormData) => {
+    const res = await addNote(prev, fd);
+    if (!res.error) ref.current?.reset();
+    return res;
+  }, {});
+
+  return (
+    <form ref={ref} action={action} className="mt-2 space-y-2">
+      <textarea name="text" required rows={3} className="w-full rounded border p-2 text-sm" />
+      <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" className="text-sm" />
+      {state.error && <p className="text-sm text-red-600">{state.error}</p>}
+      <button disabled={pending} className="rounded border px-3 py-1 text-sm disabled:opacity-50">
+        {pending ? "Saving…" : "Add note"}
+      </button>
+    </form>
+  );
+}
