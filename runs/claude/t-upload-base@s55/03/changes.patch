+
+export type Note = {
+  id: string;
+  userId: string;
+  text: string;
+  imageUrl?: string;
+  createdAt: string;
+};
+
+// In-memory like users above; swap for a real DB later.
+const notes: Note[] = [];
+
+export async function listNotes(userId: string): Promise<Note[]> {
+  return notes.filter((n) => n.userId === userId).reverse();
+}
+
+export async function createNote(userId: string, text: string, imageUrl?: string): Promise<Note> {
+  const note: Note = {
+    id: crypto.randomUUID(),
+    userId,
+    text,
+    imageUrl,
+    createdAt: new Date().toISOString(),
+  };
+  notes.push(note);
+  return note;
+}
