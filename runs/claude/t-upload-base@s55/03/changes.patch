diff --git a/src/lib/storage.ts b/src/lib/storage.ts
new file mode 100644
index 0000000..c92dd49
--- /dev/null
+++ b/src/lib/storage.ts
@@ -0,0 +1,71 @@
+import "server-only";
+import { randomUUID } from "node:crypto";
+import { PutObjectCommand, S3Client } from "@aws-sdk/client-s3";
+
+// Any S3-compatible bucket works (AWS S3, Cloudflare R2, MinIO). Set S3_ENDPOINT for non-AWS.
+export const MAX_IMAGE_BYTES = 5 * 1024 * 1024;
+
+const TYPES = {
+  "image/png": "png",
+  "image/jpeg": "jpg",
+  "image/webp": "webp",
+  "image/gif": "gif",
+} as const;
+
+type ImageType = keyof typeof TYPES;
+
+function env(name: string): string {
+  const v = process.env[name];
+  if (!v) throw new Error(`Missing env var ${name}`);
+  return v;
+}
+
+let client: S3Client | undefined;
+function s3() {
+  client ??= new S3Client({
+    region: process.env.S3_REGION ?? "auto",
+    endpoint: process.env.S3_ENDPOINT || undefined,
+    forcePathStyle: !!process.env.S3_ENDPOINT,
+    credentials: {
+      accessKeyId: env("S3_ACCESS_KEY_ID"),
+      secretAccessKey: env("S3_SECRET_ACCESS_KEY"),
+    },
+  });
+  return client;
+}
+
+// Don't trust the client-supplied Content-Type: detect from magic bytes.
+function sniff(b: Uint8Array): ImageType | null {
+  if (b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47) return "image/png";
+  if (b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return "image/jpeg";
+  if (b[0] === 0x47 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x38) return "image/gif";
+  if (
+    b[0] === 0x52 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x46 &&
+    b[8] === 0x57 && b[9] === 0x45 && b[10] === 0x42 && b[11] === 0x50
+  )
+    return "image/webp";
+  return null;
+}
+
+export class UploadError extends Error {}
+
+/** Validates and uploads an image, returning its public URL. */
+export async function uploadImage(file: File, userId: string): Promise<string> {
+  if (file.size === 0) throw new UploadError("Empty file");
+  if (file.size > MAX_IMAGE_BYTES) throw new UploadError("Image must be 5 MB or smaller");
+  const body = new Uint8Array(await file.arrayBuffer());
+  const type = sniff(body);
+  if (!type) throw new UploadError("Only PNG, JPEG, WebP or GIF images are allowed");
+
+  const key = `notes/${userId}/${randomUUID()}.${TYPES[type]}`;
+  await s3().send(
+    new PutObjectCommand({
+      Bucket: env("S3_BUCKET"),
+      Key: key,
+      Body: body,
+      ContentType: type,
+      CacheControl: "public, max-age=31536000, immutable",
+    }),
+  );
+  return `${env("S3_PUBLIC_URL").replace(/\/$/, "")}/${key}`;
+}
