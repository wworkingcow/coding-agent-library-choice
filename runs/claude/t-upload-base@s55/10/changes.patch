+"use server";
+
+import { revalidatePath } from "next/cache";
+import { keyPrefixFor, publicUrlForKey } from "@/lib/storage";
+import { createNote, getCurrentUser } from "@/lib/users";
+
+export async function createNoteAction(body: string, imageKey?: string) {
+  const user = await getCurrentUser();
+  if (!user) throw new Error("Unauthorized");
+  if (!body.trim()) throw new Error("Note can't be empty");
+  // Only accept keys we issued for this user; the URL is built server-side.
+  if (imageKey && (!imageKey.startsWith(keyPrefixFor(user.id)) || imageKey.includes(".."))) {
+    throw new Error("Invalid image");
+  }
+  await createNote(user.id, body.trim(), imageKey ? publicUrlForKey(imageKey) : undefined);
+  revalidatePath("/dashboard");
+}
