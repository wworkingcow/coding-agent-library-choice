+
+export type Note = {
+  id: string;
+  userId: string;
+  body: string;
+  imageUrl?: string;
+  createdAt: string;
+};
+
+// In-memory like `users` above; swap for a real DB together with the user store.
+const notes: Note[] = [];
+
+export async function createNote(
+  userId: string,
+  body: string,
+  imageUrl?: string,
+): Promise<Note> {
+  const note: Note = {
+    id: crypto.randomUUID(),
+    userId,
+    body,
+    imageUrl,
+    createdAt: new Date().toISOString(),
+  };
+  notes.push(note);
+  return note;
+}
+
+export async function listNotes(userId: string): Promise<Note[]> {
+  return notes.filter((n) => n.userId === userId).reverse();
+}
