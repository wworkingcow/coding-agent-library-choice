diff --git a/src/lib/storage.ts b/src/lib/storage.ts
new file mode 100644
index 0000000..93efd8d
--- /dev/null
+++ b/src/lib/storage.ts
@@ -0,0 +1,62 @@
+import { randomUUID } from "node:crypto";
+import { PutObjectCommand, S3Client } from "@aws-sdk/client-s3";
+
+export const MAX_IMAGE_BYTES = 5 * 1024 * 1024;
+
+const IMAGE_TYPES: Record<string, string> = {
+  "image/png": "png",
+  "image/jpeg": "jpg",
+  "image/webp": "webp",
+  "image/gif": "gif",
+};
+
+function env(name: string): string {
+  const v = process.env[name];
+  if (!v) throw new Error(`Missing env var ${name} (see .env.example)`);
+  return v;
+}
+
+let client: S3Client | undefined;
+function s3(): S3Client {
+  client ??= new S3Client({
+    region: env("S3_REGION"),
+    endpoint: process.env.S3_ENDPOINT || undefined,
+    credentials: {
+      accessKeyId: env("S3_ACCESS_KEY_ID"),
+      secretAccessKey: env("S3_SECRET_ACCESS_KEY"),
+    },
+  });
+  return client;
+}
+
+// Check the real bytes, not just the client-declared content type.
+function sniff(b: Uint8Array): string | undefined {
+  const starts = (...sig: number[]) => sig.every((x, i) => b[i] === x);
+  if (starts(0x89, 0x50, 0x4e, 0x47)) return "image/png";
+  if (starts(0xff, 0xd8, 0xff)) return "image/jpeg";
+  if (starts(0x47, 0x49, 0x46, 0x38)) return "image/gif";
+  if (starts(0x52, 0x49, 0x46, 0x46) && b[8] === 0x57 && b[9] === 0x45) return "image/webp";
+  return undefined;
+}
+
+/** Uploads an image under a server-generated key and returns its public URL. */
+export async function uploadImage(userId: string, file: File): Promise<string> {
+  if (file.size === 0) throw new Error("Choose an image to upload.");
+  if (file.size > MAX_IMAGE_BYTES) throw new Error("Image must be 5 MB or smaller.");
+
+  const body = new Uint8Array(await file.arrayBuffer());
+  const type = sniff(body);
+  if (!type || !(type in IMAGE_TYPES)) throw new Error("Only PNG, JPEG, WebP or GIF images are allowed.");
+
+  const key = `notes/${userId}/${randomUUID()}.${IMAGE_TYPES[type]}`;
+  await s3().send(
+    new PutObjectCommand({
+      Bucket: env("S3_BUCKET"),
+      Key: key,
+      Body: body,
+      ContentType: type,
+      CacheControl: "public, max-age=31536000, immutable",
+    }),
+  );
+  return `${env("S3_PUBLIC_BASE_URL").replace(/\/$/, "")}/${key}`;
+}
