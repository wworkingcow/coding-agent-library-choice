+"use server";
+
+import { revalidatePath } from "next/cache";
+import { uploadImage } from "@/lib/storage";
+import { createNote, getCurrentUser } from "@/lib/users";
+
+export type NoteFormState = { error?: string };
+
+export async function addNote(_prev: NoteFormState, form: FormData): Promise<NoteFormState> {
+  const me = await getCurrentUser();
+  if (!me) return { error: "Not signed in." };
+
+  const text = String(form.get("text") ?? "").trim();
+  const image = form.get("image");
+  const file = image instanceof File && image.size > 0 ? image : undefined;
+  if (!text && !file) return { error: "Write something or attach an image." };
+
+  try {
+    const imageUrl = file ? await uploadImage(me.id, file) : undefined;
+    await createNote(me.id, text, imageUrl);
+  } catch (e) {
+    console.error("addNote failed", e);
+    const known = e instanceof Error && /image|Image|Choose/.test(e.message);
+    return { error: known ? (e as Error).message : "Upload failed. Try again." };
+  }
+  revalidatePath("/dashboard");
+  return {};
+}
