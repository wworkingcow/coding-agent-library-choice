+import { NextResponse } from "next/server";
+import { IMAGE_TYPES, MAX_IMAGE_BYTES, createImageUpload } from "@/lib/storage";
+import { getCurrentUser } from "@/lib/users";
+
+export async function POST(req: Request) {
+  const me = await getCurrentUser();
+  if (!me) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+
+  const { contentType, size } = await req.json().catch(() => ({}));
+  if (typeof contentType !== "string" || !(contentType in IMAGE_TYPES)) {
+    return NextResponse.json({ error: "Unsupported image type" }, { status: 400 });
+  }
+  if (!Number.isInteger(size) || size <= 0 || size > MAX_IMAGE_BYTES) {
+    return NextResponse.json({ error: "Image must be under 5 MB" }, { status: 400 });
+  }
+  return NextResponse.json(await createImageUpload(me.id, contentType, size));
+}
