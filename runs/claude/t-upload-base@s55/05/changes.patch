@@ -0,0 +1,18 @@
+import { NextResponse } from "next/server";
+import { userPrefix } from "@/lib/storage";
+import { getCurrentUser, setNoteImage } from "@/lib/users";
+
+export async function PUT(req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const me = await getCurrentUser();
+  if (!me) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+
+  const { url } = await req.json().catch(() => ({}));
+  // Only accept URLs inside this user's own storage prefix.
+  if (typeof url !== "string" || !url.startsWith(userPrefix(me.id)) || url.includes("..")) {
+    return NextResponse.json({ error: "Invalid image URL" }, { status: 400 });
+  }
+  const { id } = await params;
+  const note = await setNoteImage(me.id, id, url);
+  if (!note) return NextResponse.json({ error: "Not found" }, { status: 404 });
+  return NextResponse.json(note);
+}
