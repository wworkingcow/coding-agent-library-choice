@@ -0,0 +1,18 @@
+"use client";
+
+import { useActionState } from "react";
+import { createNoteAction, type NoteFormState } from "./actions";
+
+export function NoteForm() {
+  const [state, action, pending] = useActionState<NoteFormState, FormData>(createNoteAction, {});
+  return (
+    <form action={action} className="mt-2 space-y-2">
+      <textarea name="text" required rows={3} placeholder="Write a note…" className="w-full rounded border p-2 text-sm" />
+      <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp" className="block text-sm" />
+      <button disabled={pending} className="rounded bg-black px-3 py-1 text-sm text-white disabled:opacity-50">
+        {pending ? "Saving…" : "Add note"}
+      </button>
+      {state.error && <p className="text-sm text-red-600">{state.error}</p>}
+    </form>
+  );
+}
