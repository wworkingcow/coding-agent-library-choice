diff --git a/src/lib/storage.ts b/src/lib/storage.ts
new file mode 100644
index 0000000..4956439
--- /dev/null
+++ b/src/lib/storage.ts
@@ -0,0 +1,61 @@
+import { randomUUID } from "node:crypto";
+import { PutObjectCommand, S3Client } from "@aws-sdk/client-s3";
+
+export const MAX_IMAGE_BYTES = 5 * 1024 * 1024;
+
+const TYPES = {
+  "image/png": "png",
+  "image/jpeg": "jpg",
+  "image/gif": "gif",
+  "image/webp": "webp",
+} as const;
+type ImageType = keyof typeof TYPES;
+
+function env(name: string): string {
+  const v = process.env[name];
+  if (!v) throw new Error(`Missing env var ${name} (see .env.example)`);
+  return v;
+}
+
+let client: S3Client | undefined;
+function s3() {
+  client ??= new S3Client({
+    region: env("S3_REGION"),
+    endpoint: process.env.S3_ENDPOINT || undefined,
+    credentials: {
+      accessKeyId: env("S3_ACCESS_KEY_ID"),
+      secretAccessKey: env("S3_SECRET_ACCESS_KEY"),
+    },
+  });
+  return client;
+}
+
+// Detect the real type from magic bytes — the client-supplied MIME type can't be trusted.
+function sniff(b: Buffer): ImageType | undefined {
+  if (b.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) return "image/png";
+  if (b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return "image/jpeg";
+  if (b.subarray(0, 4).toString("ascii") === "GIF8") return "image/gif";
+  if (b.subarray(0, 4).toString("ascii") === "RIFF" && b.subarray(8, 12).toString("ascii") === "WEBP") return "image/webp";
+  return undefined;
+}
+
+/** Validates and uploads an image under `prefix`; returns its public URL. */
+export async function uploadImage(file: File, prefix: string): Promise<string> {
+  if (file.size === 0) throw new Error("File is empty");
+  if (file.size > MAX_IMAGE_BYTES) throw new Error("Image must be 5 MB or smaller");
+  const body = Buffer.from(await file.arrayBuffer());
+  const type = sniff(body);
+  if (!type) throw new Error("Only PNG, JPEG, GIF or WebP images are allowed");
+
+  const key = `${prefix}/${randomUUID()}.${TYPES[type]}`;
+  await s3().send(
+    new PutObjectCommand({
+      Bucket: env("S3_BUCKET"),
+      Key: key,
+      Body: body,
+      ContentType: type,
+      CacheControl: "public, max-age=31536000, immutable",
+    }),
+  );
+  return `${env("S3_PUBLIC_BASE_URL").replace(/\/$/, "")}/${key}`;
+}
