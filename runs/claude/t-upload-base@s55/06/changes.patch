@@ -0,0 +1,27 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { uploadImage } from "@/lib/storage";
+import { createNote, getCurrentUser } from "@/lib/users";
+
+export type NoteFormState = { error?: string };
+
+export async function createNoteAction(_prev: NoteFormState, form: FormData): Promise<NoteFormState> {
+  const me = await getCurrentUser();
+  if (!me) return { error: "Not signed in" };
+
+  const text = String(form.get("text") ?? "").trim();
+  if (!text) return { error: "Note text is required" };
+
+  try {
+    const file = form.get("image");
+    const imageUrl =
+      file instanceof File && file.size > 0 ? await uploadImage(file, `notes/${me.id}`) : undefined;
+    await createNote(me.id, text, imageUrl);
+  } catch (e) {
+    console.error("createNoteAction failed", e);
+    return { error: e instanceof Error ? e.message : "Upload failed" };
+  }
+  revalidatePath("/dashboard");
+  return {};
+}
