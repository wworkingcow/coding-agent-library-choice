@@ -22,3 +22,38 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export type Note = {
+  id: string;
+  userId: string;
+  text: string;
+  imageUrl?: string;
+  createdAt: string;
+};
+
+// In-memory like `users` above; swap for a real DB together with session handling.
+const notes: Note[] = [];
+
+export async function listNotes(userId: string): Promise<Note[]> {
+  return notes.filter((n) => n.userId === userId);
+}
+
+export async function createNote(userId: string, text: string, imageUrl?: string): Promise<Note> {
+  const note: Note = {
+    id: crypto.randomUUID(),
+    userId,
+    text,
+    imageUrl,
+    createdAt: new Date().toISOString(),
+  };
+  notes.push(note);
+  return note;
+}
+
+/** Saves the uploaded image URL on a note; only the note's owner may do so. */
+export async function setNoteImage(userId: string, noteId: string, imageUrl: string): Promise<Note> {
+  const note = notes.find((n) => n.id === noteId && n.userId === userId);
+  if (!note) throw new Error("Note not found");
+  note.imageUrl = imageUrl;
+  return note;
+}
