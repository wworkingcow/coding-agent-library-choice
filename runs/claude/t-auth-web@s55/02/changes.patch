+
+export const auth = betterAuth({
+  database: db,
+  emailAndPassword: {
+    enabled: true,
+    minPasswordLength: 8,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID as string,
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET as string,
+    },
+  },
+  // Must be last: lets server actions / route handlers set session cookies.
+  plugins: [nextCookies()],
+});
