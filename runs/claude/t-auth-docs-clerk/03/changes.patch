@@ -0,0 +1,24 @@
+import type { NextAuthConfig } from "next-auth";
+import Google from "next-auth/providers/google";
+
+/**
+ * Edge-safe auth config: no Credentials provider here (it needs bcrypt, which
+ * doesn't run in the Edge middleware runtime). This is what middleware.ts
+ * imports; the full config with Credentials lives in src/auth.ts.
+ */
+export default {
+  pages: {
+    signIn: "/signin",
+  },
+  providers: [
+    // Reads AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET from the environment.
+    Google,
+  ],
+  callbacks: {
+    authorized({ auth, request: { nextUrl } }) {
+      const isLoggedIn = !!auth?.user;
+      const isProtected = nextUrl.pathname.startsWith("/dashboard");
+      return isProtected ? isLoggedIn : true;
+    },
+  },
+} satisfies NextAuthConfig;
