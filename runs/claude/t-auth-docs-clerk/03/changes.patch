+/** Creates a new local account with an email + password. Used by the sign-up form. */
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email.toLowerCase() === email)) {
+    throw new Error("An account with that email already exists.");
+  }
+
+  const passwordHash = await bcrypt.hash(input.password, 10);
+  const user: StoredUser = {
+    id: nextId(),
+    email,
+    name: input.name.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return toPublicUser(user);
+}
+
+/** Checks email + password against the store. Used by the credentials sign-in provider. */
+export async function verifyPassword(
+  email: string,
+  password: string,
+): Promise<User | undefined> {
+  const user = users.find((u) => u.email.toLowerCase() === email.trim().toLowerCase());
+  if (!user || !user.passwordHash) return undefined;
+
+  const valid = await bcrypt.compare(password, user.passwordHash);
+  return valid ? toPublicUser(user) : undefined;
+}
+
+/**
+ * Finds or creates a local user record for an OAuth sign-in (Google).
+ * OAuth accounts have no local password — passwordHash stays null.
+ */
+export async function ensureOAuthUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  const existing = users.find((u) => u.email.toLowerCase() === email);
+  if (existing) return toPublicUser(existing);
+
+  const user: StoredUser = {
+    id: nextId(),
+    email,
+    name: input.name.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: null,
+  };
+  users.push(user);
+  return toPublicUser(user);
 }
