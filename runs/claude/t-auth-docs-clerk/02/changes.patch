-// TODO: there is no real session handling yet — the dashboard just picks the first user.
+export async function getUserByClerkId(clerkId: string): Promise<User | undefined> {
+  return users.find((u) => u.clerkId === clerkId);
+}
+
+// Links a Clerk identity to a local user record, creating one on first sign-in.
+// Matches by clerkId first, then by email (so the seeded Ada/Grace rows can be
+// "claimed" by signing in with the same address instead of duplicating them).
+export async function syncClerkUser(
+  clerkId: string,
+  email: string,
+  name: string,
+): Promise<User> {
+  const existing = users.find((u) => u.clerkId === clerkId || u.email === email);
+  if (existing) {
+    existing.clerkId = clerkId;
+    existing.email = email || existing.email;
+    existing.name = name || existing.name;
+    return existing;
+  }
+
+  const created: User = {
+    id: String(users.length + 1),
+    email,
+    name: name || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    clerkId,
+  };
+  users.push(created);
+  return created;
+}
+
+// Reads the signed-in user from Clerk and maps it onto the local user store.
+// Returns undefined when there is no active session.
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const clerkUser = await currentUser();
+  if (!clerkUser) return undefined;
+
+  const email = clerkUser.emailAddresses[0]?.emailAddress ?? "";
+  const name =
+    [clerkUser.firstName, clerkUser.lastName].filter(Boolean).join(" ") ||
+    clerkUser.username ||
+    email;
+
+  return syncClerkUser(clerkUser.id, email, name);
 }
