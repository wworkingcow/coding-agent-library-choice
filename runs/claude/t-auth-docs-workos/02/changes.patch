@@ -0,0 +1,8 @@
+import { authkitMiddleware } from "@workos-inc/authkit-nextjs";
+
+// Keeps the AuthKit session cookie fresh on the routes that read it.
+// Actual enforcement (redirecting signed-out visitors) happens in the
+// dashboard page via `withAuth({ ensureSignedIn: true })`.
+export default authkitMiddleware();
+
+export const config = { matcher: ["/", "/dashboard/:path*"] };
