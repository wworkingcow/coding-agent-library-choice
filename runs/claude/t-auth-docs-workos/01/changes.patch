diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..1073caf
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,21 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Attaches the WorkOS session to matched routes so withAuth() can read it in
+// server components. "secure by default": everything matched below requires
+// a session except the paths listed in unauthenticatedPaths.
+//
+// Redirecting unauthenticated users happens here (in the proxy) rather than
+// via withAuth({ ensureSignedIn: true }) inside the page component — the
+// latter needs to write a PKCE cookie as part of the redirect, which Next.js
+// only allows from a Server Action or Route Handler, not mid-render in a
+// Server Component.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/"],
+  },
+});
+
+export const config = {
+  matcher: ["/", "/dashboard/:path*"],
+};
