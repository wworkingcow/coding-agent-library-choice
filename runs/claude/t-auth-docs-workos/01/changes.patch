+# WorkOS AuthKit — see https://dashboard.workos.com
+# Copy this file to .env.local and fill in real values.
+
+# Client ID, from the WorkOS dashboard.
+WORKOS_CLIENT_ID=client_placeholder
+
+# API key, from the WorkOS dashboard. Keep this secret.
+WORKOS_API_KEY=sk_test_placeholder
+
+# Encrypts the session cookie. Must be at least 32 characters.
+# Generate one with: openssl rand -base64 24
+WORKOS_COOKIE_PASSWORD=placeholder_at_least_32_characters_long
+
+# Must match the callback route below and the redirect URI configured
+# in the WorkOS dashboard under Redirects.
+NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
+
+# Google sign-in is enabled per-connection in the WorkOS dashboard
+# (Authentication > Google OAuth), not via env vars or app code.
