+type WorkOSUser = {
+  id: string;
+  email: string;
+  firstName?: string | null;
+  lastName?: string | null;
+};
+
+/**
+ * Finds the local user record for a WorkOS session user, creating one on
+ * first sign-in. Matches on the stored WorkOS id first, falling back to
+ * email so a WorkOS account can be linked to an existing seed user.
+ */
+export function getOrCreateUser(workosUser: WorkOSUser): User {
+  const existing = users.find(
+    (u) => u.workosUserId === workosUser.id || u.email === workosUser.email
+  );
+
+  if (existing) {
+    if (!existing.workosUserId) existing.workosUserId = workosUser.id;
+    return existing;
+  }
+
+  const name =
+    [workosUser.firstName, workosUser.lastName].filter(Boolean).join(" ") ||
+    workosUser.email;
+
+  const created: User = {
+    id: String(users.length + 1),
+    email: workosUser.email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+    workosUserId: workosUser.id,
+  };
+  users.push(created);
+  return created;
+}
+
+/** Returns the signed-in user (via the WorkOS session), or undefined if signed out. */
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const { user } = await withAuth();
+  if (!user) return undefined;
+  return getOrCreateUser(user);
