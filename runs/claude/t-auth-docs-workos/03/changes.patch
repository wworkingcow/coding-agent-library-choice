diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..c7053ed
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,16 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// "Secure by default": every matched route requires a session except the
+// ones listed in unauthenticatedPaths, so /dashboard is protected here in
+// the proxy rather than relying on a page-level redirect. That matters
+// because Next.js only allows cookies to be written from a Route Handler,
+// Server Action, or proxy/middleware — not from a Server Component render —
+// and the sign-in redirect needs to set a PKCE cookie.
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/"],
+  },
+});
+
+export const config = { matcher: ["/", "/dashboard/:path*"] };
