+import { randomBytes, randomUUID, scryptSync, timingSafeEqual } from "crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -10,6 +13,30 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+// Password hashes, keyed by user id. Kept separate from `User` so we never
+// accidentally serialize a hash out through `listUsers`/`getUser`.
+const passwordHashes = new Map<string, string>();
+
+// Password reset tokens, keyed by the (opaque, unguessable) token string.
+const RESET_TOKEN_TTL_MS = 60 * 60 * 1000; // 1 hour
+type ResetToken = { userId: string; expiresAt: number };
+const resetTokens = new Map<string, ResetToken>();
+
+function hashPassword(password: string): string {
+  const salt = randomBytes(16).toString("hex");
+  const derived = scryptSync(password, salt, 64).toString("hex");
+  return `${salt}:${derived}`;
+}
+
+function verifyPassword(password: string, storedHash: string): boolean {
+  const [salt, derived] = storedHash.split(":");
+  if (!salt || !derived) return false;
+  const candidate = scryptSync(password, salt, 64);
+  const expected = Buffer.from(derived, "hex");
+  if (candidate.length !== expected.length) return false;
+  return timingSafeEqual(candidate, expected);
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +45,82 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  return users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+/**
+ * Creates a new user and sends them a welcome email. Email delivery is
+ * best-effort: if it fails, the user is still created (the failure is
+ * logged inside sendWelcomeEmail, not thrown here).
+ */
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const existing = await getUserByEmail(input.email);
+  if (existing) {
+    throw new Error(`A user with email ${input.email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email: input.email,
+    name: input.name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+
+  users.push(user);
+  passwordHashes.set(user.id, hashPassword(input.password));
+
+  await sendWelcomeEmail(user);
+
+  return user;
+}
+
+/**
+ * Starts a password reset: generates a one-hour token and emails it to the
+ * user. Always resolves (never reveals whether the email was registered),
+ * so callers can return a generic "check your email" response either way.
+ */
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  const token = randomBytes(32).toString("hex");
+  resetTokens.set(token, {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MS,
+  });
+
+  await sendPasswordResetEmail(user, token);
+}
+
+/**
+ * Completes a password reset given a token from a `requestPasswordReset`
+ * email. Throws on an invalid/expired token so the caller can surface an
+ * error to the user.
+ */
+export async function resetPassword(token: string, newPassword: string): Promise<void> {
+  const entry = resetTokens.get(token);
+  if (!entry || entry.expiresAt < Date.now()) {
+    resetTokens.delete(token);
+    throw new Error("This password reset link is invalid or has expired");
+  }
+
+  passwordHashes.set(entry.userId, hashPassword(newPassword));
+  resetTokens.delete(token);
+}
+
+/** Exposed for completeness / future login route; not wired to a route yet. */
+export async function verifyUserPassword(userId: string, password: string): Promise<boolean> {
+  const hash = passwordHashes.get(userId);
+  if (!hash) return false;
+  return verifyPassword(password, hash);
+}
