--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,158 @@
+import { Resend } from "resend";
+
+// --- Provider setup -------------------------------------------------------
+//
+// Resend was chosen for transactional email: first-class TypeScript/Next.js
+// support, a minimal API, a generous free tier for a small app like this,
+// and no need to separately manage SMTP credentials. Swapping providers
+// later just means replacing the client + `send` call below — the rest of
+// the app only depends on `sendWelcomeEmail` / `sendPasswordResetEmail`.
+
+const RESEND_API_KEY = process.env.RESEND_API_KEY;
+const EMAIL_FROM = process.env.EMAIL_FROM ?? "Notely <onboarding@notely.dev>";
+const APP_URL = process.env.APP_URL ?? "http://localhost:3000";
+
+let client: Resend | null = null;
+
+function getClient(): Resend | null {
+  if (!RESEND_API_KEY) return null;
+  if (!client) client = new Resend(RESEND_API_KEY);
+  return client;
+}
+
+type SendResult = { sent: boolean; reason?: string };
+
+async function sendEmail(params: {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+}): Promise<SendResult> {
+  const resend = getClient();
+
+  if (!resend) {
+    // No API key configured (e.g. local dev without credentials). Don't
+    // throw — email delivery should never be what blocks user creation or
+    // password resets. Log so it's obvious nothing was actually sent.
+    console.warn(
+      `[email] RESEND_API_KEY not set — skipping send to ${params.to} ("${params.subject}")`
+    );
+    return { sent: false, reason: "missing_api_key" };
+  }
+
+  try {
+    const { error } = await resend.emails.send({
+      from: EMAIL_FROM,
+      to: params.to,
+      subject: params.subject,
+      html: params.html,
+      text: params.text,
+    });
+
+    if (error) {
+      console.error(`[email] Resend rejected send to ${params.to}:`, error);
+      return { sent: false, reason: error.message };
+    }
+
+    return { sent: true };
+  } catch (err) {
+    console.error(`[email] Failed to send to ${params.to}:`, err);
+    return { sent: false, reason: err instanceof Error ? err.message : "unknown_error" };
+  }
+}
+
+// --- Templates --------------------------------------------------------
+
+function layout(bodyHtml: string): string {
+  return `<!doctype html>
+<html>
+  <body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,Segoe UI,Roboto,sans-serif;">
+    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 0;">
+      <tr>
+        <td align="center">
+          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;padding:32px;">
+            <tr>
+              <td>
+                <div style="font-size:20px;font-weight:600;color:#111827;margin-bottom:24px;">Notely</div>
+                ${bodyHtml}
+              </td>
+            </tr>
+          </table>
+        </td>
+      </tr>
+    </table>
+  </body>
+</html>`;
+}
+
+function welcomeTemplate(name: string) {
+  const html = layout(`
+    <p style="font-size:16px;color:#111827;margin:0 0 16px;">Welcome, ${escapeHtml(name)} 👋</p>
+    <p style="font-size:14px;color:#4b5563;line-height:1.6;margin:0 0 24px;">
+      Your Notely account is ready. Notely helps your team keep shared notes in one place —
+      jump in and take a look at your dashboard.
+    </p>
+    <a href="${APP_URL}/dashboard"
+       style="display:inline-block;background:#111827;color:#ffffff;text-decoration:none;
+              padding:10px 20px;border-radius:6px;font-size:14px;">
+      Go to dashboard
+    </a>
+  `);
+  const text = `Welcome, ${name}!\n\nYour Notely account is ready. Visit your dashboard: ${APP_URL}/dashboard`;
+  return { html, text };
+}
+
+function passwordResetTemplate(name: string, resetUrl: string) {
+  const html = layout(`
+    <p style="font-size:16px;color:#111827;margin:0 0 16px;">Reset your password</p>
+    <p style="font-size:14px;color:#4b5563;line-height:1.6;margin:0 0 24px;">
+      Hi ${escapeHtml(name)}, we received a request to reset your Notely password.
+      This link expires in 1 hour. If you didn't request this, you can ignore this email.
+    </p>
+    <a href="${resetUrl}"
+       style="display:inline-block;background:#111827;color:#ffffff;text-decoration:none;
+              padding:10px 20px;border-radius:6px;font-size:14px;">
+      Reset password
+    </a>
+    <p style="font-size:12px;color:#9ca3af;line-height:1.6;margin:24px 0 0;">
+      Or paste this link into your browser:<br />${resetUrl}
+    </p>
+  `);
+  const text = `Reset your Notely password: ${resetUrl}\n\nThis link expires in 1 hour. If you didn't request this, you can ignore this email.`;
+  return { html, text };
+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+// --- Public API ---------------------------------------------------------
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<SendResult> {
+  const { html, text } = welcomeTemplate(user.name);
+  return sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    html,
+    text,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetToken: string
+): Promise<SendResult> {
+  const resetUrl = `${APP_URL}/reset-password?token=${encodeURIComponent(resetToken)}`;
+  const { html, text } = passwordResetTemplate(user.name, resetUrl);
+  return sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    html,
+    text,
+  });
+}
