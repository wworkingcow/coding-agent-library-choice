+export type EmailTemplate = {
+  subject: string;
+  html: string;
+  text: string;
+};
+
+const APP_NAME = "Notely";
+
+const wrap = (title: string, bodyHtml: string) => `<!doctype html>
+<html>
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>${title}</title>
+  </head>
+  <body style="margin:0;padding:0;background-color:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
+    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f5;padding:32px 0;">
+      <tr>
+        <td align="center">
+          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;padding:32px;">
+            <tr>
+              <td>
+                <div style="font-size:18px;font-weight:600;color:#18181b;margin-bottom:24px;">${APP_NAME}</div>
+                ${bodyHtml}
+                <div style="margin-top:32px;padding-top:16px;border-top:1px solid #e4e4e7;font-size:12px;color:#a1a1aa;">
+                  ${APP_NAME} &middot; you're receiving this because it relates to your account.
+                </div>
+              </td>
+            </tr>
+          </table>
+        </td>
+      </tr>
+    </table>
+  </body>
+</html>`;
+
+export function welcomeEmail(params: { name: string }): EmailTemplate {
+  const { name } = params;
+  return {
+    subject: `Welcome to ${APP_NAME}, ${name}!`,
+    html: wrap(
+      "Welcome",
+      `
+        <p style="font-size:16px;color:#27272a;line-height:1.5;">Hi ${name},</p>
+        <p style="font-size:16px;color:#27272a;line-height:1.5;">
+          Welcome to ${APP_NAME}! Your account has been created and you're ready to go.
+        </p>
+        <p style="font-size:16px;color:#27272a;line-height:1.5;">
+          If you have any questions, just reply to this email — we're happy to help.
+        </p>
+      `,
+    ),
+    text: `Hi ${name},\n\nWelcome to ${APP_NAME}! Your account has been created and you're ready to go.\n\nIf you have any questions, just reply to this email — we're happy to help.`,
+  };
+}
+
+export function passwordResetEmail(params: {
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}): EmailTemplate {
+  const { name, resetUrl, expiresInMinutes } = params;
+  return {
+    subject: `Reset your ${APP_NAME} password`,
+    html: wrap(
+      "Reset your password",
+      `
+        <p style="font-size:16px;color:#27272a;line-height:1.5;">Hi ${name},</p>
+        <p style="font-size:16px;color:#27272a;line-height:1.5;">
+          We received a request to reset your ${APP_NAME} password. Click the button below to choose a new one.
+          This link expires in ${expiresInMinutes} minutes.
+        </p>
+        <p style="text-align:center;margin:32px 0;">
+          <a href="${resetUrl}" style="background-color:#18181b;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:6px;font-size:14px;font-weight:600;display:inline-block;">
+            Reset password
+          </a>
+        </p>
+        <p style="font-size:13px;color:#71717a;line-height:1.5;">
+          If you didn't request this, you can safely ignore this email — your password will not be changed.
+        </p>
+        <p style="font-size:13px;color:#71717a;line-height:1.5;word-break:break-all;">
+          Or paste this link into your browser: ${resetUrl}
+        </p>
+      `,
+    ),
+    text: `Hi ${name},\n\nWe received a request to reset your ${APP_NAME} password. This link expires in ${expiresInMinutes} minutes.\n\n${resetUrl}\n\nIf you didn't request this, you can safely ignore this email — your password will not be changed.`,
+  };
+}
