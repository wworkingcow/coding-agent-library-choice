--- /dev/null
+++ b/src/lib/email/index.ts
@@ -0,0 +1,22 @@
+import { sendRawEmail } from "./client";
+import { passwordResetEmail, welcomeEmail } from "./templates";
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  await sendRawEmail({
+    to: user.email,
+    template: welcomeEmail({ name: user.name }),
+  });
+}
+
+export async function sendPasswordResetEmail(params: {
+  email: string;
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}): Promise<void> {
+  const { email, ...rest } = params;
+  await sendRawEmail({
+    to: email,
+    template: passwordResetEmail(rest),
+  });
+}
