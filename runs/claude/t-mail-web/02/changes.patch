+import { randomBytes, randomUUID, scryptSync, timingSafeEqual } from "crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "./email";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  passwordHash: string;
 };
 
 const users: User[] = [
-  { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
-  { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
+  {
+    id: "1",
+    email: "ada@example.com",
+    name: "Ada",
+    createdAt: "2026-01-04",
+    passwordHash: hashPassword("password123"),
+  },
+  {
+    id: "2",
+    email: "grace@example.com",
+    name: "Grace",
+    createdAt: "2026-02-11",
+    passwordHash: hashPassword("password123"),
+  },
 ];
 
+// Password reset tokens, keyed by token. In-memory like the rest of this
+// module — swap for a real store (with a hashed token column) alongside a
+// real database.
+const RESET_TOKEN_TTL_MINUTES = 30;
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const APP_URL = process.env.APP_URL ?? "http://localhost:3000";
+
+function hashPassword(password: string, salt = randomBytes(16).toString("hex")): string {
+  const derived = scryptSync(password, salt, 64).toString("hex");
+  return `${salt}:${derived}`;
+}
+
+function verifyPassword(password: string, passwordHash: string): boolean {
+  const [salt, storedHash] = passwordHash.split(":");
+  if (!salt || !storedHash) return false;
+  const candidate = scryptSync(password, salt, 64);
+  const stored = Buffer.from(storedHash, "hex");
+  return candidate.length === stored.length && timingSafeEqual(candidate, stored);
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +55,90 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  return users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+/**
+ * Creates a new user and sends them a welcome email. Email delivery failures
+ * are logged but don't block account creation.
+ */
+export async function createUser(params: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const { email, name, password } = params;
+
+  if (await getUserByEmail(email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: hashPassword(password),
+  };
+  users.push(user);
+
+  await sendWelcomeEmail(user);
+
+  return user;
+}
+
+/**
+ * Starts a password reset: issues a single-use, time-limited token and
+ * emails a reset link. Always resolves without error (even for unknown
+ * emails) so callers can't use it to enumerate registered accounts.
+ */
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  const token = randomBytes(32).toString("hex");
+  resetTokens.set(token, {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60 * 1000,
+  });
+
+  const resetUrl = `${APP_URL}/reset-password?token=${token}`;
+  await sendPasswordResetEmail({
+    email: user.email,
+    name: user.name,
+    resetUrl,
+    expiresInMinutes: RESET_TOKEN_TTL_MINUTES,
+  });
+}
+
+/**
+ * Completes a password reset given a token from `requestPasswordReset`.
+ * The token is single-use and expires after RESET_TOKEN_TTL_MINUTES.
+ */
+export async function resetPassword(token: string, newPassword: string): Promise<void> {
+  const entry = resetTokens.get(token);
+  if (!entry || entry.expiresAt < Date.now()) {
+    resetTokens.delete(token);
+    throw new Error("This password reset link is invalid or has expired.");
+  }
+
+  const user = users.find((u) => u.id === entry.userId);
+  resetTokens.delete(token);
+  if (!user) {
+    throw new Error("This password reset link is invalid or has expired.");
+  }
+
+  user.passwordHash = hashPassword(newPassword);
+}
+
+export async function verifyUserPassword(email: string, password: string): Promise<boolean> {
+  const user = await getUserByEmail(email);
+  if (!user) return false;
+  return verifyPassword(password, user.passwordHash);
+}
