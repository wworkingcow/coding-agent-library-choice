index 0000000..d640320
--- /dev/null
+++ b/src/lib/email/client.ts
@@ -0,0 +1,56 @@
+import { Resend } from "resend";
+import type { EmailTemplate } from "./templates";
+
+// Transactional email, sent via Resend (https://resend.com).
+//
+// Resend was chosen over alternatives like SendGrid/Postmark/Mailgun for a
+// TypeScript/Next.js app like this one: a minimal API, a generous free tier,
+// and first-class TypeScript types. Swapping providers later just means
+// rewriting `sendRawEmail` below — the rest of the app calls the
+// `send*Email` helpers in `./index.ts`, not this file.
+
+const FROM_EMAIL = process.env.EMAIL_FROM ?? "Notely <onboarding@notely.dev>";
+
+let client: Resend | null = null;
+
+function getClient(): Resend | null {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) return null;
+  if (!client) client = new Resend(apiKey);
+  return client;
+}
+
+/**
+ * Sends an email via Resend. If RESEND_API_KEY isn't configured (e.g. local
+ * dev without credentials), the email is logged to the console instead of
+ * sent, so the rest of the app keeps working without real credentials.
+ */
+export async function sendRawEmail(params: {
+  to: string;
+  template: EmailTemplate;
+}): Promise<void> {
+  const { to, template } = params;
+  const resend = getClient();
+
+  if (!resend) {
+    console.warn(
+      `[email] RESEND_API_KEY not set — skipping send, logging instead.\n` +
+        `  to: ${to}\n  subject: ${template.subject}\n  text:\n${template.text}\n`,
+    );
+    return;
+  }
+
+  const { error } = await resend.emails.send({
+    from: FROM_EMAIL,
+    to,
+    subject: template.subject,
+    html: template.html,
+    text: template.text,
+  });
+
+  if (error) {
+    // Email failures shouldn't take down the calling flow (e.g. user
+    // creation) — log loudly and let the caller decide what to do.
+    console.error(`[email] failed to send "${template.subject}" to ${to}:`, error);
+  }
+}
diff --git a/src/lib/email/index.ts b/src/lib/email/index.ts
