+ * session. Dynamically imports "@/lib/auth" to avoid a circular import
+ * (auth.ts depends on this module for credential/OAuth user lookups).
+ */
 export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+  const { auth } = await import("@/lib/auth");
