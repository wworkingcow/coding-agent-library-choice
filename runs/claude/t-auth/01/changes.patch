+type UserStore = { users: User[]; nextId: number };
+
+// Next.js bundles Server Components, Server Actions, Route Handlers, and
+// middleware/proxy each into their own module graph, so a plain
+// module-level `let` here would give every one of them its own independent
+// copy of "the" user list. Stashing the store on `globalThis` (the same
