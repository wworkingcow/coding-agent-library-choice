+}
+
+/**
+ * Creates a new email/password user. Throws if the email is already taken.
+ */
+export async function createUser(params: {
+  email: string;
+  password: string;
+  name: string;
+}): Promise<User> {
+  const email = params.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error("An account with that email already exists.");
+  }
+
+  const passwordHash = await bcrypt.hash(params.password, 10);
+  const user: User = {
+    id: String(store.nextId++),
+    email,
+    name: params.name.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return user;
+}
+
+/**
+ * Finds or creates a user for an OAuth sign-in (e.g. Google), which has no password.
+ */
+export async function findOrCreateOAuthUser(params: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const existing = await getUserByEmail(params.email);
+  if (existing) return existing;
+
+  const email = params.email.trim().toLowerCase();
+  const user: User = {
+    id: String(store.nextId++),
+    email,
+    name: params.name?.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return user;
+}
+
+/**
+ * Verifies email/password credentials. Returns the user on success, or
+ * undefined if the email is unknown, has no password set, or the password
+ * doesn't match.
+ */
+export async function verifyPassword(
+  email: string,
+  password: string,
+): Promise<User | undefined> {
+  const user = await getUserByEmail(email);
+  if (!user?.passwordHash) return undefined;
+
+  const valid = await bcrypt.compare(password, user.passwordHash);
+  return valid ? user : undefined;
+}
+
+/**
