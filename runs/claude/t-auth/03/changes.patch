+"use server";
+
+import { AuthError } from "next-auth";
+import { redirect } from "next/navigation";
+import { signIn } from "@/lib/auth";
+import { createUserWithPassword } from "@/lib/users";
+
+export async function signInWithCredentials(formData: FormData) {
+  const email = String(formData.get("email") ?? "").trim();
+  const password = String(formData.get("password") ?? "");
+
+  try {
+    await signIn("credentials", {
+      email,
+      password,
+      redirectTo: "/dashboard",
+    });
+  } catch (error) {
+    if (error instanceof AuthError) {
+      redirect(`/login?error=invalid-credentials`);
+    }
+    // NEXT_REDIRECT (the successful sign-in case) also lands here — rethrow
+    // it so Next.js can actually perform the redirect.
+    throw error;
+  }
+}
+
+export async function signUpWithCredentials(formData: FormData) {
+  const name = String(formData.get("name") ?? "").trim();
+  const email = String(formData.get("email") ?? "").trim();
+  const password = String(formData.get("password") ?? "");
+
+  if (!name || !email || !password) {
+    redirect("/login?mode=signup&error=missing-fields");
+  }
+  if (password.length < 8) {
+    redirect("/login?mode=signup&error=weak-password");
+  }
+
+  try {
+    await createUserWithPassword(email, name, password);
+  } catch {
+    redirect("/login?mode=signup&error=email-taken");
+  }
+
+  try {
+    await signIn("credentials", {
+      email,
+      password,
+      redirectTo: "/dashboard",
+    });
+  } catch (error) {
+    if (error instanceof AuthError) {
+      redirect("/login?error=invalid-credentials");
+    }
+    throw error;
+  }
+}
+
+export async function signInWithGoogle() {
+  await signIn("google", { redirectTo: "/dashboard" });
+}
