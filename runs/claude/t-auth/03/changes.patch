+import Link from "next/link";
+import {
+  signInWithCredentials,
+  signInWithGoogle,
+  signUpWithCredentials,
+} from "./actions";
+
+const ERROR_MESSAGES: Record<string, string> = {
+  "invalid-credentials": "That email or password isn't right.",
+  "missing-fields": "Fill in every field to create an account.",
+  "weak-password": "Password must be at least 8 characters.",
+  "email-taken": "An account with that email already exists.",
+};
+
+type LoginPageProps = {
+  searchParams: Promise<{ mode?: string; error?: string }>;
+};
+
+export default async function LoginPage({ searchParams }: LoginPageProps) {
+  const params = await searchParams;
+  const isSignUp = params.mode === "signup";
+  const errorMessage = params.error ? ERROR_MESSAGES[params.error] : undefined;
+
+  return (
+    <main className="mx-auto flex max-w-sm flex-1 flex-col justify-center p-8">
+      <h1 className="text-2xl font-semibold">
+        {isSignUp ? "Create an account" : "Sign in to Notely"}
+      </h1>
+
+      {errorMessage ? (
+        <p className="mt-4 rounded border border-red-300 bg-red-50 p-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
+          {errorMessage}
+        </p>
+      ) : null}
+
+      <form
+        action={isSignUp ? signUpWithCredentials : signInWithCredentials}
+        className="mt-6 flex flex-col gap-3"
+      >
+        {isSignUp ? (
+          <input
+            name="name"
+            type="text"
+            placeholder="Name"
+            autoComplete="name"
+            required
+            className="rounded border border-black/10 px-3 py-2 text-sm dark:border-white/15"
+          />
+        ) : null}
+        <input
+          name="email"
+          type="email"
+          placeholder="Email"
+          autoComplete="email"
+          required
+          className="rounded border border-black/10 px-3 py-2 text-sm dark:border-white/15"
+        />
+        <input
+          name="password"
+          type="password"
+          placeholder="Password"
+          autoComplete={isSignUp ? "new-password" : "current-password"}
+          required
+          minLength={isSignUp ? 8 : undefined}
+          className="rounded border border-black/10 px-3 py-2 text-sm dark:border-white/15"
+        />
+        <button
+          type="submit"
+          className="mt-1 rounded-full bg-foreground px-5 py-2 text-sm font-medium text-background transition-colors hover:bg-[#383838] dark:hover:bg-[#ccc]"
+        >
+          {isSignUp ? "Sign up" : "Sign in"}
+        </button>
+      </form>
+
+      <div className="mt-4 flex items-center gap-3 text-xs uppercase opacity-50">
+        <span className="h-px flex-1 bg-current" />
+        or
+        <span className="h-px flex-1 bg-current" />
+      </div>
+
+      <form action={signInWithGoogle} className="mt-4">
+        <button
+          type="submit"
+          className="w-full rounded-full border border-black/10 px-5 py-2 text-sm font-medium transition-colors hover:bg-black/[.04] dark:border-white/15 dark:hover:bg-[#1a1a1a]"
+        >
+          Continue with Google
+        </button>
+      </form>
+
+      <p className="mt-6 text-center text-sm opacity-70">
+        {isSignUp ? (
+          <>
+            Already have an account?{" "}
+            <Link href="/login" className="font-medium underline">
+              Sign in
+            </Link>
+          </>
+        ) : (
+          <>
+            Don&apos;t have an account?{" "}
+            <Link href="/login?mode=signup" className="font-medium underline">
+              Sign up
+            </Link>
+          </>
+        )}
+      </p>
+    </main>
+  );
+}
