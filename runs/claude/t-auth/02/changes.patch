 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+// Public shape of a user, safe to send to the client / put in a session.
+export type PublicUser = Omit<User, "passwordHash">;
+
+export function toPublicUser(user: User): PublicUser {
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  const { passwordHash: _passwordHash, ...publicUser } = user;
+  return publicUser;
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === normalized);
+}
+
+/**
+ * Creates a new user with an email/password credential.
+ * Throws if the email is already registered.
+ */
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error("A user with that email already exists.");
+  }
+
+  const user: User = {
+    id: String(nextId++),
+    email,
+    name: input.name.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: await hash(input.password, 10),
+  };
+  users.push(user);
+  return user;
+}
+
+/**
+ * Verifies an email/password combination, returning the user on success.
+ * Returns undefined for unknown emails, wrong passwords, or accounts that
+ * only have an OAuth identity (no password set).
+ */
+export async function verifyPassword(
+  email: string,
+  password: string
+): Promise<User | undefined> {
+  const user = await getUserByEmail(email);
+  if (!user?.passwordHash) return undefined;
+  const valid = await compare(password, user.passwordHash);
+  return valid ? user : undefined;
+}
+
+/**
+ * Finds an existing user by email, or creates one for a first-time OAuth
+ * sign-in (e.g. Google). OAuth users have no password on file.
+ */
+export async function findOrCreateOAuthUser(input: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const existing = await getUserByEmail(input.email);
+  if (existing) return existing;
+
+  const user: User = {
+    id: String(nextId++),
+    email: input.email.trim().toLowerCase(),
+    name: input.name?.trim() || input.email,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return user;
 }
