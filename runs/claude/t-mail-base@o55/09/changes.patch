+++ b/src/lib/email/templates.ts
@@ -0,0 +1,60 @@
+type RenderedEmail = { subject: string; html: string; text: string };
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+function layout(body: string): string {
+  return `<!doctype html>
+<html>
+  <body style="margin:0;padding:24px;background:#f6f6f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#111;">
+    <div style="max-width:480px;margin:0 auto;background:#fff;border-radius:8px;padding:32px;">
+      ${body}
+      <p style="margin-top:32px;font-size:12px;color:#888;">Notely</p>
+    </div>
+  </body>
+</html>`;
+}
+
+function button(href: string, label: string): string {
+  return `<a href="${escapeHtml(href)}" style="display:inline-block;padding:12px 20px;background:#111;color:#fff;text-decoration:none;border-radius:6px;">${escapeHtml(label)}</a>`;
+}
+
+export function welcomeEmail({ name, appUrl }: { name: string; appUrl: string }): RenderedEmail {
+  const dashboardUrl = `${appUrl}/dashboard`;
+  return {
+    subject: "Welcome to Notely",
+    html: layout(`
+      <h1 style="font-size:20px;margin:0 0 16px;">Welcome, ${escapeHtml(name)}!</h1>
+      <p>Your Notely account is ready. Jump in and write your first note.</p>
+      <p style="margin:24px 0;">${button(dashboardUrl, "Open Notely")}</p>
+    `),
+    text: `Welcome, ${name}!\n\nYour Notely account is ready. Jump in and write your first note:\n${dashboardUrl}\n\n— Notely`,
+  };
+}
+
+export function passwordResetEmail({
+  name,
+  resetUrl,
+  expiresInMinutes,
+}: {
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}): RenderedEmail {
+  return {
+    subject: "Reset your Notely password",
+    html: layout(`
+      <h1 style="font-size:20px;margin:0 0 16px;">Reset your password</h1>
+      <p>Hi ${escapeHtml(name)}, we received a request to reset your Notely password.</p>
+      <p style="margin:24px 0;">${button(resetUrl, "Choose a new password")}</p>
+      <p style="font-size:14px;color:#555;">This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, you can ignore this email — your password won't change.</p>
+    `),
+    text: `Hi ${name},\n\nWe received a request to reset your Notely password. Choose a new one here:\n${resetUrl}\n\nThis link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, ignore this email — your password won't change.\n\n— Notely`,
+  };
+}
