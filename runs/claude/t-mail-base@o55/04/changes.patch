diff --git a/src/lib/email/client.ts b/src/lib/email/client.ts
new file mode 100644
index 0000000..70a9bcd
--- /dev/null
+++ b/src/lib/email/client.ts
@@ -0,0 +1,54 @@
+import "server-only";
+import { Resend } from "resend";
+
+export type EmailMessage = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  // Lets Resend dedupe retries of the same logical email.
+  idempotencyKey?: string;
+};
+
+let resend: Resend | null = null;
+
+function getResend(): Resend | null {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) return null;
+  resend ??= new Resend(apiKey);
+  return resend;
+}
+
+export function appUrl(path = ""): string {
+  const base = (process.env.APP_URL ?? "http://localhost:3000").replace(/\/+$/, "");
+  return `${base}${path}`;
+}
+
+export async function sendEmail(message: EmailMessage): Promise<void> {
+  const client = getResend();
+
+  if (!client) {
+    // Without a key, local dev still works: print the email instead of sending it.
+    if (process.env.NODE_ENV === "production") {
+      throw new Error("RESEND_API_KEY is not set");
+    }
+    console.info(`[email] (not sent, RESEND_API_KEY unset) to=${message.to} subject="${message.subject}"\n${message.text}`);
+    return;
+  }
+
+  const { error } = await client.emails.send(
+    {
+      from: process.env.EMAIL_FROM ?? "Notely <onboarding@resend.dev>",
+      replyTo: process.env.EMAIL_REPLY_TO || undefined,
+      to: message.to,
+      subject: message.subject,
+      html: message.html,
+      text: message.text,
+    },
+    message.idempotencyKey ? { idempotencyKey: message.idempotencyKey } : undefined,
+  );
+
+  if (error) {
+    throw new Error(`Failed to send email "${message.subject}": ${error.name}: ${error.message}`);
+  }
+}
diff --git a/src/lib/email/index.ts b/src/lib/email/index.ts
new file mode 100644
index 0000000..14c1767
--- /dev/null
+++ b/src/lib/email/index.ts
@@ -0,0 +1,26 @@
+import "server-only";
+import { appUrl, sendEmail } from "./client";
+import { passwordResetEmail, welcomeEmail } from "./templates";
+
+export async function sendWelcomeEmail(user: { id: string; email: string; name: string }): Promise<void> {
+  await sendEmail({
+    to: user.email,
+    ...welcomeEmail({ name: user.name, dashboardUrl: appUrl("/dashboard") }),
+    idempotencyKey: `welcome/${user.id}`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  await sendEmail({
+    to: user.email,
+    ...passwordResetEmail({
+      name: user.name,
+      resetUrl: appUrl(`/reset-password?token=${encodeURIComponent(token)}`),
+      expiresInMinutes,
+    }),
+  });
+}
diff --git a/src/lib/email/templates.ts b/src/lib/email/templates.ts
new file mode 100644
index 0000000..cb70bde
--- /dev/null
+++ b/src/lib/email/templates.ts
@@ -0,0 +1,51 @@
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+function layout(bodyHtml: string): string {
+  return `<!doctype html>
+<html>
+  <body style="margin:0;padding:24px;background:#f6f6f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#111;">
+    <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:8px;padding:32px;">
+      ${bodyHtml}
+      <p style="margin-top:32px;font-size:12px;color:#888;">Notely</p>
+    </div>
+  </body>
+</html>`;
+}
+
+function button(href: string, label: string): string {
+  return `<a href="${escapeHtml(href)}" style="display:inline-block;background:#111;color:#fff;text-decoration:none;padding:12px 20px;border-radius:6px;font-weight:600;">${escapeHtml(label)}</a>`;
+}
+
+export function welcomeEmail(params: { name: string; dashboardUrl: string }) {
+  const name = escapeHtml(params.name);
+  return {
+    subject: "Welcome to Notely",
+    html: layout(`
+      <h1 style="font-size:20px;margin:0 0 16px;">Welcome to Notely, ${name}!</h1>
+      <p>Your account is ready. Jump in and start writing.</p>
+      <p style="margin:24px 0;">${button(params.dashboardUrl, "Open Notely")}</p>
+    `),
+    text: `Welcome to Notely, ${params.name}!\n\nYour account is ready. Jump in and start writing:\n${params.dashboardUrl}\n`,
+  };
+}
+
+export function passwordResetEmail(params: { name: string; resetUrl: string; expiresInMinutes: number }) {
+  const name = escapeHtml(params.name);
+  return {
+    subject: "Reset your Notely password",
+    html: layout(`
+      <h1 style="font-size:20px;margin:0 0 16px;">Reset your password</h1>
+      <p>Hi ${name}, we received a request to reset your Notely password.</p>
+      <p style="margin:24px 0;">${button(params.resetUrl, "Reset password")}</p>
+      <p style="font-size:14px;color:#555;">This link expires in ${params.expiresInMinutes} minutes and can only be used once. If you didn't request this, you can ignore this email — your password won't change.</p>
+    `),
+    text: `Hi ${params.name},\n\nWe received a request to reset your Notely password. Use this link (expires in ${params.expiresInMinutes} minutes, single use):\n${params.resetUrl}\n\nIf you didn't request this, you can ignore this email.\n`,
+  };
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..eee07fd 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,7 @@
+import "server-only";
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +26,76 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === normalized);
+}
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error("A user with this email already exists");
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // A failed welcome email shouldn't fail signup.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error(`[users] welcome email failed for user ${user.id}`, err);
+  }
+
+  return user;
+}
+
+// Password reset tokens. Only a SHA-256 hash of each token is kept, so a leaked
+// store can't be used to reset passwords. In-memory like the users above.
+const RESET_TOKEN_TTL_MINUTES = 60;
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+// Always resolves without revealing whether the email belongs to an account,
+// so the caller can show the same "check your inbox" message either way.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // One live token per user: a new request invalidates older links.
+  for (const [hash, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  try {
+    await sendPasswordResetEmail(user, token, RESET_TOKEN_TTL_MINUTES);
+  } catch (err) {
+    console.error(`[users] password reset email failed for user ${user.id}`, err);
+  }
+}
+
+// Validates and burns a reset token. Returns the user it belongs to, or
+// undefined if the token is unknown, expired, or already used.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = resetTokens.get(hash);
+  if (!entry) return undefined;
+  resetTokens.delete(hash);
+  if (entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
