+# Transactional email via Resend (https://resend.com/api-keys).
+# If unset outside production, emails are printed to the server console instead of sent.
+RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
+# Must be on a domain verified in Resend. onboarding@resend.dev works for testing (sends only to your own address).
+EMAIL_FROM="Notely <no-reply@notely.example.com>"
+# Optional
+EMAIL_REPLY_TO=support@notely.example.com
+
+# Public base URL, used to build links in emails.
+APP_URL=http://localhost:3000
