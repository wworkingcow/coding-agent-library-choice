+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { sendEmail } from "@/lib/email/send";
+import { passwordResetEmail, welcomeEmail } from "@/lib/email/templates";
+
 export type User = {
   id: string;
   email: string;
@@ -10,6 +14,23 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+const PASSWORD_RESET_TTL_MINUTES = 60;
+
+// Keyed by SHA-256 of the token, so the raw token only ever exists in the email.
+const passwordResetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/+$/, "");
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +39,89 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  const name = input.name.trim();
+  if (!email || !name) throw new Error("Email and name are required");
+  if (await getUserByEmail(email)) throw new Error("A user with this email already exists");
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // The account exists either way; a failed welcome email shouldn't fail sign-up.
+  try {
+    await sendEmail({
+      to: user.email,
+      ...welcomeEmail({ name: user.name, appUrl: appUrl() }),
+      idempotencyKey: `welcome/${user.id}`,
+    });
+  } catch (err) {
+    console.error(`[users] welcome email failed for user ${user.id}`, err);
+  }
+
+  return user;
+}
+
+/**
+ * Emails a single-use reset link if the address belongs to a user. Resolves the
+ * same way whether or not the user exists, so callers can't use it to probe
+ * which emails are registered.
+ */
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // One live link per user: requesting again invalidates the previous one.
+  for (const [hash, entry] of passwordResetTokens) {
+    if (entry.userId === user.id) passwordResetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  passwordResetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + PASSWORD_RESET_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  try {
+    await sendEmail({
+      to: user.email,
+      ...passwordResetEmail({
+        name: user.name,
+        resetUrl,
+        expiresInMinutes: PASSWORD_RESET_TTL_MINUTES,
+      }),
+    });
+  } catch (err) {
+    console.error(`[users] password reset email failed for user ${user.id}`, err);
+  }
+}
+
+/**
+ * Validates and burns a reset token. Returns the user it belongs to, or
+ * undefined if the token is unknown, expired, or already used. The caller then
+ * sets the new password (there is no password storage yet).
+ */
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = passwordResetTokens.get(hash);
+  if (!entry) return undefined;
+  passwordResetTokens.delete(hash);
+  if (entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
