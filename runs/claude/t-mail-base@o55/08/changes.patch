diff --git a/src/lib/email/send.ts b/src/lib/email/send.ts
new file mode 100644
index 0000000..f92617f
--- /dev/null
+++ b/src/lib/email/send.ts
@@ -0,0 +1,52 @@
+import "server-only";
+import { Resend } from "resend";
+
+export type EmailMessage = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  // Lets Resend dedupe retries of the same logical send (e.g. `welcome/<userId>`).
+  idempotencyKey?: string;
+};
+
+let client: Resend | undefined;
+
+function getClient(): Resend | undefined {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) return undefined;
+  client ??= new Resend(apiKey);
+  return client;
+}
+
+export async function sendEmail(message: EmailMessage): Promise<void> {
+  const resend = getClient();
+
+  // Without an API key (local dev, CI) print the email instead of sending it.
+  // In production a missing key is a misconfiguration, so fail loudly.
+  if (!resend) {
+    if (process.env.NODE_ENV === "production") {
+      throw new Error("RESEND_API_KEY is not set");
+    }
+    console.info(
+      `[email] (not sent, RESEND_API_KEY unset)\nTo: ${message.to}\nSubject: ${message.subject}\n\n${message.text}`,
+    );
+    return;
+  }
+
+  const { error } = await resend.emails.send(
+    {
+      from: process.env.EMAIL_FROM ?? "Notely <onboarding@resend.dev>",
+      replyTo: process.env.EMAIL_REPLY_TO || undefined,
+      to: message.to,
+      subject: message.subject,
+      html: message.html,
+      text: message.text,
+    },
+    message.idempotencyKey ? { idempotencyKey: message.idempotencyKey } : undefined,
+  );
+
+  if (error) {
+    throw new Error(`Failed to send email "${message.subject}": ${error.name}: ${error.message}`);
+  }
+}
diff --git a/src/lib/email/templates.ts b/src/lib/email/templates.ts
new file mode 100644
index 0000000..289aca4
--- /dev/null
+++ b/src/lib/email/templates.ts
@@ -0,0 +1,77 @@
+type RenderedEmail = { subject: string; html: string; text: string };
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+function layout(bodyHtml: string): string {
+  return `<!doctype html>
+<html>
+  <body style="margin:0;padding:24px;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#18181b;">
+    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
+      <tr><td align="center">
+        <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:8px;padding:32px;">
+          <tr><td style="font-size:20px;font-weight:600;padding-bottom:16px;">Notely</td></tr>
+          <tr><td style="font-size:15px;line-height:1.6;">${bodyHtml}</td></tr>
+        </table>
+      </td></tr>
+    </table>
+  </body>
+</html>`;
+}
+
+function button(href: string, label: string): string {
+  return `<p style="margin:24px 0;"><a href="${escapeHtml(href)}" style="display:inline-block;background:#18181b;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:500;">${escapeHtml(label)}</a></p>`;
+}
+
+export function welcomeEmail({ name, appUrl }: { name: string; appUrl: string }): RenderedEmail {
+  const dashboardUrl = `${appUrl}/dashboard`;
+  return {
+    subject: "Welcome to Notely",
+    html: layout(
+      `<p>Hi ${escapeHtml(name)},</p>
+       <p>Welcome to Notely! Your account is ready — start writing notes and sharing them with your team.</p>
+       ${button(dashboardUrl, "Open Notely")}
+       <p style="color:#71717a;font-size:13px;">If you didn't create this account, you can ignore this email.</p>`,
+    ),
+    text: `Hi ${name},
+
+Welcome to Notely! Your account is ready — start writing notes and sharing them with your team.
+
+Open Notely: ${dashboardUrl}
+
+If you didn't create this account, you can ignore this email.`,
+  };
+}
+
+export function passwordResetEmail({
+  name,
+  resetUrl,
+  expiresInMinutes,
+}: {
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}): RenderedEmail {
+  return {
+    subject: "Reset your Notely password",
+    html: layout(
+      `<p>Hi ${escapeHtml(name)},</p>
+       <p>We received a request to reset your Notely password. Click the button below to choose a new one. This link expires in ${expiresInMinutes} minutes and can only be used once.</p>
+       ${button(resetUrl, "Reset password")}
+       <p style="color:#71717a;font-size:13px;">If you didn't request a password reset, you can safely ignore this email — your password won't change.</p>`,
+    ),
+    text: `Hi ${name},
+
+We received a request to reset your Notely password. Open the link below to choose a new one. It expires in ${expiresInMinutes} minutes and can only be used once.
+
+${resetUrl}
+
+If you didn't request a password reset, you can safely ignore this email — your password won't change.`,
+  };
+}
