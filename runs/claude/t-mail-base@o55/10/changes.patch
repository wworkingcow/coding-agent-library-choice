+// Server-side only: reads RESEND_API_KEY. Do not import from client components.
+// Transactional email via Resend (https://resend.com/docs/api-reference/emails/send-email).
+// Without RESEND_API_KEY the message is logged to the console instead of sent, so local dev works offline.
+
+type EmailMessage = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+const RESEND_ENDPOINT = "https://api.resend.com/emails";
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+export async function sendEmail(message: EmailMessage): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM ?? "Notely <onboarding@resend.dev>";
+
+  if (!apiKey) {
+    console.info(`[email] RESEND_API_KEY not set, not sending.\nTo: ${message.to}\nSubject: ${message.subject}\n\n${message.text}`);
+    return;
+  }
+
+  const res = await fetch(RESEND_ENDPOINT, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({
+      from,
+      to: [message.to],
+      subject: message.subject,
+      html: message.html,
+      text: message.text,
+    }),
+    signal: AbortSignal.timeout(10_000),
+  });
+
+  if (!res.ok) {
+    const detail = await res.text().catch(() => "");
+    throw new Error(`Resend responded ${res.status}: ${detail}`);
+  }
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const name = escapeHtml(user.name);
+  const dashboardUrl = `${appUrl()}/dashboard`;
+
+  await sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    text: `Hi ${user.name},\n\nWelcome to Notely! Your account is ready.\n\nOpen your dashboard: ${dashboardUrl}\n\n— The Notely team`,
+    html: `<p>Hi ${name},</p>
+<p>Welcome to Notely! Your account is ready.</p>
+<p><a href="${dashboardUrl}">Open your dashboard</a></p>
+<p>— The Notely team</p>`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const name = escapeHtml(user.name);
+  const resetUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+
+  await sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    text: `Hi ${user.name},\n\nSomeone asked to reset the password for your Notely account. Use this link within ${expiresInMinutes} minutes:\n\n${resetUrl}\n\nIf it wasn't you, ignore this email — your password stays the same.\n\n— The Notely team`,
+    html: `<p>Hi ${name},</p>
+<p>Someone asked to reset the password for your Notely account. Use this link within ${expiresInMinutes} minutes:</p>
+<p><a href="${resetUrl}">Reset password</a></p>
+<p>If it wasn't you, ignore this email — your password stays the same.</p>
+<p>— The Notely team</p>`,
+  });
+}
