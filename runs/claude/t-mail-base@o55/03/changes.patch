@@ -0,0 +1,62 @@
+import type { EmailMessage } from "./send";
+
+type Template = Omit<EmailMessage, "to">;
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+function layout(body: string): string {
+  return `<!doctype html>
+<html>
+  <body style="margin:0;padding:24px;background:#f6f6f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#111">
+    <div style="max-width:480px;margin:0 auto;background:#fff;border-radius:8px;padding:32px">
+      ${body}
+      <p style="margin-top:32px;font-size:12px;color:#888">Notely</p>
+    </div>
+  </body>
+</html>`;
+}
+
+function button(href: string, label: string): string {
+  return `<a href="${escapeHtml(href)}" style="display:inline-block;padding:10px 18px;background:#111;color:#fff;border-radius:6px;text-decoration:none">${escapeHtml(label)}</a>`;
+}
+
+export function welcomeEmail({ name, appUrl }: { name: string; appUrl: string }): Template {
+  const dashboardUrl = `${appUrl}/dashboard`;
+  return {
+    subject: "Welcome to Notely",
+    html: layout(`
+      <h1 style="font-size:20px;margin:0 0 16px">Welcome, ${escapeHtml(name)}!</h1>
+      <p>Your Notely account is ready. Jump in and start writing notes with your team.</p>
+      <p style="margin-top:24px">${button(dashboardUrl, "Open Notely")}</p>
+    `),
+    text: `Welcome, ${name}!\n\nYour Notely account is ready. Jump in and start writing notes with your team:\n${dashboardUrl}\n\n— Notely`,
+  };
+}
+
+export function passwordResetEmail({
+  name,
+  resetUrl,
+  expiresInMinutes,
+}: {
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}): Template {
+  return {
+    subject: "Reset your Notely password",
+    html: layout(`
+      <h1 style="font-size:20px;margin:0 0 16px">Reset your password</h1>
+      <p>Hi ${escapeHtml(name)}, we received a request to reset your Notely password.</p>
+      <p style="margin-top:24px">${button(resetUrl, "Reset password")}</p>
+      <p style="margin-top:24px;font-size:14px;color:#555">This link expires in ${expiresInMinutes} minutes. If you didn't ask for this, you can ignore this email — your password won't change.</p>
+    `),
+    text: `Hi ${name},\n\nWe received a request to reset your Notely password. Open this link to choose a new one:\n${resetUrl}\n\nThis link expires in ${expiresInMinutes} minutes. If you didn't ask for this, you can ignore this email.\n\n— Notely`,
+  };
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..4d622a2 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,7 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { sendEmail } from "@/lib/email/send";
+import { passwordResetEmail, welcomeEmail } from "@/lib/email/templates";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +26,79 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/+$/, "");
+}
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  const name = input.name.trim();
+  if (!email || !name) throw new Error("email and name are required");
+  if (users.some((u) => u.email === email)) throw new Error("a user with this email already exists");
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // The account exists either way; a failed welcome email shouldn't undo signup.
+  try {
+    await sendEmail({ to: user.email, ...welcomeEmail({ name: user.name, appUrl: appUrl() }) });
+  } catch (err) {
+    console.error(`[users] welcome email to user ${user.id} failed`, err);
+  }
+
+  return user;
+}
+
+const RESET_TOKEN_TTL_MINUTES = 60;
+
+// Keyed by SHA-256 of the token so a leaked store can't be replayed as links.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+// Always resolves without saying whether the email exists, so callers can
+// show the same "check your inbox" message and not leak who has an account.
+export async function requestPasswordReset(rawEmail: string): Promise<void> {
+  const email = rawEmail.trim().toLowerCase();
+  const user = users.find((u) => u.email === email);
+  if (!user) return;
+
+  for (const [hash, entry] of resetTokens) {
+    if (entry.userId === user.id || entry.expiresAt <= Date.now()) resetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  try {
+    await sendEmail({
+      to: user.email,
+      ...passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes: RESET_TOKEN_TTL_MINUTES }),
+    });
+  } catch (err) {
+    console.error(`[users] password reset email to user ${user.id} failed`, err);
+  }
+}
+
+// Single use: a valid token is consumed and its user returned. The caller
+// then sets the new password (there is no password storage yet).
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = resetTokens.get(hash);
+  if (!entry) return undefined;
+  resetTokens.delete(hash);
+  if (entry.expiresAt <= Date.now()) return undefined;
+  return getUser(entry.userId);
+}
