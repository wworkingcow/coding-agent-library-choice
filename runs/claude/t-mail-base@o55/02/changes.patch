--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,105 @@
+// Transactional email via Resend (https://resend.com/docs/api-reference/emails/send-email).
+// Called over plain fetch so there is no SDK dependency. Without RESEND_API_KEY
+// (local dev), emails are logged to the console instead of sent.
+
+type EmailMessage = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+const RESEND_ENDPOINT = "https://api.resend.com/emails";
+
+export async function sendEmail(message: EmailMessage): Promise<void> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.EMAIL_FROM ?? "Notely <onboarding@resend.dev>";
+
+  if (!apiKey) {
+    console.info(
+      `[email] RESEND_API_KEY not set, not sending.\nTo: ${message.to}\nSubject: ${message.subject}\n\n${message.text}`,
+    );
+    return;
+  }
+
+  const res = await fetch(RESEND_ENDPOINT, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({ from, ...message, to: [message.to] }),
+  });
+
+  if (!res.ok) {
+    const body = await res.text().catch(() => "");
+    throw new Error(`Resend responded ${res.status}: ${body}`);
+  }
+}
+
+function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+function layout(bodyHtml: string): string {
+  return `<!doctype html>
+<html>
+  <body style="margin:0;padding:24px;background:#f6f6f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#111;">
+    <div style="max-width:480px;margin:0 auto;background:#fff;border-radius:8px;padding:32px;">
+      ${bodyHtml}
+      <p style="margin-top:32px;font-size:12px;color:#888;">Notely</p>
+    </div>
+  </body>
+</html>`;
+}
+
+function button(href: string, label: string): string {
+  return `<a href="${escapeHtml(href)}" style="display:inline-block;padding:12px 20px;background:#111;color:#fff;border-radius:6px;text-decoration:none;">${escapeHtml(label)}</a>`;
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }): Promise<void> {
+  const dashboardUrl = appUrl("/dashboard");
+  const name = escapeHtml(user.name);
+
+  await sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    html: layout(`
+      <h1 style="font-size:20px;margin:0 0 16px;">Welcome, ${name}!</h1>
+      <p>Your Notely account is ready. Jump in and start writing.</p>
+      <p style="margin-top:24px;">${button(dashboardUrl, "Open Notely")}</p>
+    `),
+    text: `Welcome, ${user.name}!\n\nYour Notely account is ready. Jump in and start writing:\n${dashboardUrl}\n\nNotely`,
+  });
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<void> {
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+  const name = escapeHtml(user.name);
+
+  await sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    html: layout(`
+      <h1 style="font-size:20px;margin:0 0 16px;">Reset your password</h1>
+      <p>Hi ${name}, we received a request to reset your Notely password.</p>
+      <p style="margin-top:24px;">${button(resetUrl, "Choose a new password")}</p>
+      <p style="margin-top:24px;font-size:14px;color:#555;">This link expires in ${expiresInMinutes} minutes. If you didn't request a reset, you can ignore this email.</p>
+    `),
+    text: `Hi ${user.name},\n\nWe received a request to reset your Notely password. Choose a new one here:\n${resetUrl}\n\nThis link expires in ${expiresInMinutes} minutes. If you didn't request a reset, you can ignore this email.\n\nNotely`,
+  });
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..feef971 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,75 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === normalized);
+}
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // The account exists either way; a failed welcome email shouldn't undo signup.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error(`[users] welcome email to ${user.email} failed`, err);
+  }
+
+  return user;
+}
+
+const RESET_TOKEN_TTL_MINUTES = 30;
+
+// Keyed by SHA-256 of the token so a leaked store can't be used to reset passwords.
+const passwordResetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+// Always resolves the same way whether or not the email is registered,
+// so callers can't use it to discover which addresses have accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // Only the most recent link should work.
+  for (const [hash, entry] of passwordResetTokens) {
+    if (entry.userId === user.id) passwordResetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  passwordResetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  await sendPasswordResetEmail(user, token, RESET_TOKEN_TTL_MINUTES);
+}
+
+// Validates and invalidates a reset token. Returns the user it belongs to, or
+// undefined if the token is unknown, expired or already used. The caller is
+// responsible for setting the new password once there is credential storage.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = passwordResetTokens.get(hash);
+  if (!entry) return undefined;
+
+  passwordResetTokens.delete(hash);
+  if (entry.expiresAt < Date.now()) return undefined;
+
+  return getUser(entry.userId);
+}
