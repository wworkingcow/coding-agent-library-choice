+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (await getUserByEmail(email)) {
+    throw new Error("A user with this email already exists");
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // The account exists regardless of whether the welcome email goes out — don't fail signup over it.
+  try {
+    await sendEmail(welcomeEmail({ to: user.email, name: user.name, appUrl: appUrl() }));
+  } catch (err) {
+    console.error(`Failed to send welcome email to user ${user.id}`, err);
+  }
+
+  return user;
+}
+
+// Always resolves without revealing whether the email belongs to an account.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  for (const [hash, entry] of passwordResetTokens) {
+    if (entry.userId === user.id) passwordResetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  passwordResetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await sendEmail(
+    passwordResetEmail({
+      to: user.email,
+      name: user.name,
+      resetUrl,
+      expiresInMinutes: RESET_TOKEN_TTL_MINUTES,
+    }),
+  );
+}
+
+// Single-use: returns the user the token was issued for and invalidates it, or undefined if invalid/expired.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = passwordResetTokens.get(hash);
+  if (!entry) return undefined;
+  passwordResetTokens.delete(hash);
+  if (entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
