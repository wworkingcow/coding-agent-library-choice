@@ -10,6 +14,43 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+// Kept apart from User so hashes never leak through listUsers()/getUser().
+const passwordHashes = new Map<string, string>();
+
+type ResetToken = { userId: string; expiresAt: number };
+// Keyed by sha256(token): the raw token only ever exists in the emailed link.
+const resetTokens = new Map<string, ResetToken>();
+const RESET_TOKEN_TTL_MINUTES = 60;
+
+const scryptAsync = promisify(scrypt) as (password: string, salt: Buffer, keylen: number) => Promise<Buffer>;
+
+function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/+$/, "");
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+async function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(16);
+  const key = await scryptAsync(password, salt, 64);
+  return `${salt.toString("hex")}:${key.toString("hex")}`;
+}
+
+export async function verifyPassword(userId: string, password: string): Promise<boolean> {
+  const stored = passwordHashes.get(userId);
+  if (!stored) return false;
+  const [saltHex, keyHex] = stored.split(":");
+  const expected = Buffer.from(keyHex, "hex");
+  const actual = await scryptAsync(password, Buffer.from(saltHex, "hex"), expected.length);
+  return timingSafeEqual(expected, actual);
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +59,78 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string; password?: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (await getUserByEmail(email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  if (input.password) {
+    passwordHashes.set(user.id, await hashPassword(input.password));
+  }
+
+  // The account exists either way; a mail outage shouldn't fail sign-up.
+  try {
+    await sendEmail(welcomeEmail({ to: user.email, name: user.name, appUrl: appUrl() }));
+  } catch (err) {
+    console.error(`Failed to send welcome email to user ${user.id}`, err);
+  }
+
+  return user;
+}
+
+// Always resolves without revealing whether the email belongs to an account.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // One live link per user: a new request invalidates older ones.
+  for (const [key, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(key);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  try {
+    await sendEmail(
+      passwordResetEmail({ to: user.email, name: user.name, resetUrl, expiresInMinutes: RESET_TOKEN_TTL_MINUTES }),
+    );
+  } catch (err) {
+    console.error(`Failed to send password reset email to user ${user.id}`, err);
+  }
+}
+
+// Consumes the token; returns false if it is unknown, expired, or already used.
+export async function resetPassword(token: string, newPassword: string): Promise<boolean> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  if (!entry) return false;
+  resetTokens.delete(key);
+  if (entry.expiresAt < Date.now()) return false;
+  if (!(await getUser(entry.userId))) return false;
+
+  passwordHashes.set(entry.userId, await hashPassword(newPassword));
+  return true;
+}
