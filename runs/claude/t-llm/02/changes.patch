 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+// --- AI summary usage tracking -------------------------------------------
+//
+// Keeps a simple per-user counter + daily cap for the /api/summarize
+// endpoint. In-memory only, same as the rest of this file — fine for the
+// scaffold, would move to real storage alongside real auth later.
+
+const MAX_SUMMARIES_PER_DAY = 20;
+
+type SummaryUsage = { date: string; count: number };
+
+const summaryUsageByUser = new Map<string, SummaryUsage>();
+
+function todayKey(): string {
+  return new Date().toISOString().slice(0, 10);
+}
+
+/** Whether this user still has summary quota left for today. */
+export async function canRequestSummary(userId: string): Promise<boolean> {
+  const usage = summaryUsageByUser.get(userId);
+  if (!usage || usage.date !== todayKey()) return true;
+  return usage.count < MAX_SUMMARIES_PER_DAY;
+}
+
+/** Records a summary request for this user, resetting the counter daily. */
+export async function recordSummaryUsage(userId: string): Promise<number> {
+  const date = todayKey();
+  const usage = summaryUsageByUser.get(userId);
+  const count = usage && usage.date === date ? usage.count + 1 : 1;
+  summaryUsageByUser.set(userId, { date, count });
+  return count;
+}
