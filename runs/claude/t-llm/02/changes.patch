@@ -0,0 +1,106 @@
+import { NextRequest, NextResponse } from "next/server";
+import Anthropic from "@anthropic-ai/sdk";
+import {
+  canRequestSummary,
+  getCurrentUser,
+  recordSummaryUsage,
+} from "@/lib/users";
+
+export const runtime = "nodejs";
+
+const MODEL = "claude-sonnet-5";
+const MAX_NOTE_LENGTH = 20_000;
+
+let client: Anthropic | null = null;
+
+function getClient(): Anthropic {
+  if (!client) {
+    const apiKey = process.env.ANTHROPIC_API_KEY;
+    if (!apiKey) {
+      throw new Error("ANTHROPIC_API_KEY is not configured");
+    }
+    client = new Anthropic({ apiKey });
+  }
+  return client;
+}
+
+export async function POST(req: NextRequest) {
+  // There's no real session handling yet (see src/lib/users.ts), so we
+  // attribute the request to whichever user getCurrentUser() resolves to.
+  const user = await getCurrentUser();
+  if (!user) {
+    return NextResponse.json({ error: "Not authenticated" }, { status: 401 });
+  }
+
+  let body: unknown;
+  try {
+    body = await req.json();
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body" }, { status: 400 });
+  }
+
+  const text = (body as { text?: unknown } | null)?.text;
+  if (typeof text !== "string" || text.trim().length === 0) {
+    return NextResponse.json(
+      { error: "Request body must include a non-empty 'text' string" },
+      { status: 400 }
+    );
+  }
+  if (text.length > MAX_NOTE_LENGTH) {
+    return NextResponse.json(
+      { error: `'text' must be ${MAX_NOTE_LENGTH} characters or fewer` },
+      { status: 400 }
+    );
+  }
+
+  if (!(await canRequestSummary(user.id))) {
+    return NextResponse.json(
+      { error: "Daily summary limit reached. Try again tomorrow." },
+      { status: 429 }
+    );
+  }
+
+  if (!process.env.ANTHROPIC_API_KEY) {
+    return NextResponse.json(
+      { error: "Summarization is not configured on this server" },
+      { status: 503 }
+    );
+  }
+
+  try {
+    const anthropic = getClient();
+    const message = await anthropic.messages.create({
+      model: MODEL,
+      max_tokens: 200,
+      system:
+        "You summarize personal notes. Reply with exactly two sentences " +
+        "and nothing else — no preamble, no bullet points, no quotes.",
+      messages: [
+        {
+          role: "user",
+          content: `Summarize the following note in exactly two sentences:\n\n${text}`,
+        },
+      ],
+    });
+
+    const summary = message.content
+      .filter((block) => block.type === "text")
+      .map((block) => block.text)
+      .join(" ")
+      .trim();
+
+    const usageCount = await recordSummaryUsage(user.id);
+
+    return NextResponse.json({
+      summary,
+      requestedBy: { id: user.id, name: user.name },
+      usage: { count: usageCount, limit: 20 },
+    });
+  } catch (err) {
+    console.error("summarize: Anthropic request failed", err);
+    return NextResponse.json(
+      { error: "Failed to generate summary" },
+      { status: 502 }
+    );
+  }
+}
