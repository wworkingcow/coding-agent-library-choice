+++ b/src/lib/summarize.ts
@@ -0,0 +1,64 @@
+import Anthropic from "@anthropic-ai/sdk";
+
+// Fast/cheap model — good fit for a short summarization task like this one.
+// Override via ANTHROPIC_SUMMARY_MODEL if you want a more capable model.
+const MODEL = process.env.ANTHROPIC_SUMMARY_MODEL ?? "claude-haiku-4-5-20251001";
+
+const MAX_INPUT_LENGTH = 20_000;
+
+let client: Anthropic | null = null;
+
+function getClient(): Anthropic {
+  const apiKey = process.env.ANTHROPIC_API_KEY;
+  if (!apiKey) {
+    throw new Error(
+      "ANTHROPIC_API_KEY is not set. Copy .env.example to .env.local and add your key."
+    );
+  }
+  if (!client) {
+    client = new Anthropic({ apiKey });
+  }
+  return client;
+}
+
+/**
+ * Summarizes a note's text into exactly two sentences using an LLM.
+ * Throws on empty input, oversized input, or upstream/API errors.
+ */
+export async function summarizeNote(text: string): Promise<string> {
+  const trimmed = text.trim();
+  if (!trimmed) {
+    throw new Error("Note text is empty.");
+  }
+  if (trimmed.length > MAX_INPUT_LENGTH) {
+    throw new Error(`Note text is too long (max ${MAX_INPUT_LENGTH} characters).`);
+  }
+
+  const anthropic = getClient();
+  const message = await anthropic.messages.create({
+    model: MODEL,
+    max_tokens: 200,
+    system:
+      "You summarize notes for a note-taking app called Notely. " +
+      "Reply with exactly two sentences of plain text summarizing the note. " +
+      "No preamble, no markdown, no bullet points, no quotes around the summary.",
+    messages: [
+      {
+        role: "user",
+        content: `Summarize the following note in exactly two sentences:\n\n${trimmed}`,
+      },
+    ],
+  });
+
+  const summary = message.content
+    .filter((block): block is Anthropic.TextBlock => block.type === "text")
+    .map((block) => block.text)
+    .join(" ")
+    .trim();
+
+  if (!summary) {
+    throw new Error("The model returned an empty summary.");
+  }
+
+  return summary;
+}
