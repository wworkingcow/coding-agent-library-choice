+import { createHash, randomBytes } from "node:crypto";
+import { sendEmail } from "@/lib/resend";
+import { WelcomeEmail } from "@/emails/welcome";
+import { PasswordResetEmail } from "@/emails/password-reset";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +27,57 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+const appUrl = () => process.env.APP_URL ?? "http://localhost:3000";
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) throw new Error("Email already in use");
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  await sendEmail({
+    to: user.email,
+    subject: "Welcome to Notely",
+    react: WelcomeEmail({ name: user.name, appUrl: appUrl() }),
+    text: `Welcome to Notely, ${user.name}! Open your dashboard: ${appUrl()}/dashboard`,
+  });
+  return user;
+}
+
+// Reset tokens are stored hashed; in-memory like the user list until there is a real store.
+const RESET_TTL_MS = 60 * 60 * 1000;
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+// Resolves the same way whether or not the email exists, so it cannot be used to probe accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const normalized = email.trim().toLowerCase();
+  const user = users.find((u) => u.email === normalized);
+  if (!user) return;
+
+  const token = randomBytes(32).toString("hex");
+  resetTokens.set(hashToken(token), { userId: user.id, expiresAt: Date.now() + RESET_TTL_MS });
+
+  const actionUrl = `${appUrl()}/reset-password?token=${token}`;
+  await sendEmail({
+    to: user.email,
+    subject: "Reset your Notely password",
+    react: PasswordResetEmail({ name: user.name, actionUrl }),
+    text: `Reset your Notely password (valid for 1 hour): ${actionUrl}`,
+  });
+}
+
+// Single-use: returns the user the token belongs to, or undefined if invalid/expired.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
