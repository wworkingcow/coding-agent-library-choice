diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..69740cb
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,31 @@
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+function getClient(): Resend {
+  const key = process.env.RESEND_API_KEY;
+  if (!key) throw new Error("RESEND_API_KEY is not set");
+  return (client ??= new Resend(key));
+}
+
+type Email = { to: string; subject: string; react: React.ReactElement; text: string };
+
+// Never throws: a failed email must not break the request that triggered it.
+export async function sendEmail({ to, subject, react, text }: Email): Promise<boolean> {
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!from || !process.env.RESEND_API_KEY) {
+    console.warn(`[email] RESEND_API_KEY/RESEND_FROM_EMAIL not set, skipping "${subject}"`);
+    return false;
+  }
+  try {
+    const { error } = await getClient().emails.send({ from, to, subject, react, text });
+    if (error) {
+      console.error(`[email] Resend refused "${subject}": ${error.name}: ${error.message}`);
+      return false;
+    }
+    return true;
+  } catch (err) {
+    console.error(`[email] failed to send "${subject}"`, err);
+    return false;
+  }
+}
