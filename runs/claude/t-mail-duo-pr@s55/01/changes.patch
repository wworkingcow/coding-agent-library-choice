diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..48f2bde
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,39 @@
+import { PasswordResetEmail } from "@/emails/password-reset";
+import { WelcomeEmail } from "@/emails/welcome";
+import { getResend } from "@/lib/resend";
+import type { User } from "@/lib/users";
+
+const appUrl = () => process.env.APP_URL ?? "http://localhost:3000";
+
+// Resend resolves to { error } instead of throwing on refusal. Email failures are logged,
+// never thrown, so they can't break the request that triggered them.
+async function send(to: string, subject: string, react: React.ReactElement, text: string) {
+  try {
+    const from = process.env.RESEND_FROM_EMAIL;
+    if (!from) throw new Error("RESEND_FROM_EMAIL is not set");
+    const { error } = await getResend().emails.send({ from, to, subject, react, text });
+    if (error) console.error(`[email] "${subject}" to ${to} failed: ${error.name}: ${error.message}`);
+  } catch (e) {
+    console.error(`[email] "${subject}" to ${to} failed:`, e);
+  }
+}
+
+export function sendWelcomeEmail(user: User) {
+  const url = appUrl();
+  return send(
+    user.email,
+    "Welcome to Notely",
+    WelcomeEmail({ name: user.name, appUrl: url }),
+    `Welcome to Notely, ${user.name}! Your account is ready: ${url}`,
+  );
+}
+
+export function sendPasswordResetEmail(user: User, token: string) {
+  const actionUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  return send(
+    user.email,
+    "Reset your Notely password",
+    PasswordResetEmail({ name: user.name, actionUrl }),
+    `Hi ${user.name}, reset your Notely password (link valid for one hour): ${actionUrl}`,
+  );
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..8807872
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,10 @@
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+// Lazy so importing this module never throws when the key is unset (e.g. during build).
+export function getResend(): Resend {
+  const key = process.env.RESEND_API_KEY;
+  if (!key) throw new Error("RESEND_API_KEY is not set");
+  return (client ??= new Resend(key));
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..f5b351c 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes } from "node:crypto";
+import { sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,41 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) throw new Error("A user with this email already exists");
+  const user: User = {
+    id: String(users.length + 1),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  await sendWelcomeEmail(user);
+  return user;
+}
+
+const RESET_TTL_MS = 60 * 60 * 1000;
+// Only the SHA-256 of each token is stored. In-memory like the user list; move to the DB with it.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+const hashToken = (token: string) => createHash("sha256").update(token).digest("hex");
+
+// Always resolves the same way whether or not the email exists, so callers can't enumerate users.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === email.trim().toLowerCase());
+  if (!user) return;
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), { userId: user.id, expiresAt: Date.now() + RESET_TTL_MS });
+  await sendPasswordResetEmail(user, token);
+}
+
+// Single-use: returns the user for a valid token and invalidates it.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  resetTokens.delete(key);
+  if (!entry || entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
