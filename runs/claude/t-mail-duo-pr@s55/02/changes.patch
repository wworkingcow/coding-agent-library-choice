diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..a863ef5
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,45 @@
+import { getResend } from "@/lib/resend";
+
+const escapeHtml = (s: string) =>
+  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+const appUrl = () => process.env.APP_URL ?? "http://localhost:3000";
+
+// Never throws: a failed email must not break the request that triggered it.
+async function send(to: string, subject: string, text: string, html: string) {
+  const resend = getResend();
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!resend || !from) {
+    console.warn(`[email] RESEND_API_KEY/RESEND_FROM_EMAIL not set; skipping "${subject}"`);
+    return;
+  }
+  try {
+    const { error } = await resend.emails.send({ from, to, subject, text, html });
+    if (error) console.error(`[email] "${subject}" failed: ${error.name}: ${error.message}`);
+  } catch (err) {
+    console.error(`[email] "${subject}" failed`, err);
+  }
+}
+
+export async function sendWelcomeEmail(user: { email: string; name: string }) {
+  const url = `${appUrl()}/dashboard`;
+  await send(
+    user.email,
+    "Welcome to Notely",
+    `Hi ${user.name},\n\nWelcome to Notely! Get started: ${url}`,
+    `<p>Hi ${escapeHtml(user.name)},</p><p>Welcome to Notely! <a href="${url}">Open your dashboard</a>.</p>`,
+  );
+}
+
+export async function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+) {
+  const url = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await send(
+    user.email,
+    "Reset your Notely password",
+    `Hi ${user.name},\n\nReset your password: ${url}\n\nThis link expires in 1 hour. If you didn't ask for it, ignore this email.`,
+    `<p>Hi ${escapeHtml(user.name)},</p><p><a href="${url}">Reset your password</a>. This link expires in 1 hour.</p><p>If you didn't ask for it, ignore this email.</p>`,
+  );
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..d16c75f
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,11 @@
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+// Lazy so the app still builds and runs without credentials.
+export function getResend(): Resend | undefined {
+  const key = process.env.RESEND_API_KEY;
+  if (!key) return undefined;
+  client ??= new Resend(key);
+  return client;
+}
