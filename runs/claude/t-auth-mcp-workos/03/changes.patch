@@ -0,0 +1,18 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// Secure-by-default: every path in `matcher` requires a signed-in user
+// except the ones listed in `unauthenticatedPaths`. This is what actually
+// keeps /dashboard unreachable without signing in first (in addition to the
+// `requireCurrentUser()` check on the page itself).
+export default authkitProxy({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/", "/sign-in", "/sign-up", "/sign-out", "/auth/callback"],
+  },
+});
+
+export const config = {
+  // Exclude static assets so Tailwind/image/font requests aren't routed
+  // through the auth proxy.
+  matcher: ["/((?!_next/static|_next/image|favicon.ico).*)"],
+};
