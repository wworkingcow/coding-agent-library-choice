+# WorkOS AuthKit — get real values from https://dashboard.workos.com
+# (Redirects tab for the client ID/redirect URI, API Keys tab for the secret key).
+# Copy this file to .env.local and fill in real values for local development.
+
+WORKOS_CLIENT_ID=client_placeholder
+WORKOS_API_KEY=sk_test_placeholder
+# Must be at least 32 characters. Generate with: openssl rand -base64 24
+WORKOS_COOKIE_PASSWORD=placeholder_at_least_32_characters_long
+# Must match the Redirect URI configured in the WorkOS dashboard.
+NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
