@@ -0,0 +1,13 @@
+# WorkOS AuthKit — https://dashboard.workos.com
+# Get these from your WorkOS dashboard (Configuration -> API keys / Redirects).
+# Email+password and Google sign-in are both toggled on in the WorkOS dashboard,
+# not in app code — see "Authentication" in the dashboard for the Google OAuth setup.
+WORKOS_CLIENT_ID=client_placeholder
+WORKOS_API_KEY=sk_test_placeholder
+
+# Encrypts the session cookie. Must be at least 32 characters. Generate with:
+#   openssl rand -base64 32
+WORKOS_COOKIE_PASSWORD=placeholder_at_least_32_characters_long
+
+# Must match the redirect URI configured in the WorkOS dashboard for this environment.
+NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
