diff --git a/src/app/sign-in/route.ts b/src/app/sign-in/route.ts
new file mode 100644
index 0000000..bbac111
--- /dev/null
+++ b/src/app/sign-in/route.ts
@@ -0,0 +1,10 @@
+import { getSignInUrl } from "@workos-inc/authkit-nextjs";
+import { redirect } from "next/navigation";
+import type { NextRequest } from "next/server";
+
+// AuthKit hosts the sign-in form (email + password and Google), so this route
+// just forwards into the hosted flow.
+export async function GET(request: NextRequest) {
+  const returnTo = request.nextUrl.searchParams.get("returnTo") ?? undefined;
+  redirect(await getSignInUrl({ returnTo }));
+}
