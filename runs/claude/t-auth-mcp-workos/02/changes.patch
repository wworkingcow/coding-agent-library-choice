diff --git a/src/proxy.ts b/src/proxy.ts
new file mode 100644
index 0000000..b1ce4a0
--- /dev/null
+++ b/src/proxy.ts
@@ -0,0 +1,16 @@
+import { authkitProxy } from "@workos-inc/authkit-nextjs";
+
+// `middlewareAuth.enabled: true` requires a signed-in session on every path
+// hit by the matcher below, redirecting straight into the WorkOS hosted
+// sign-in flow otherwise — except paths listed in `unauthenticatedPaths`.
+// "/" is listed there (not gated) but still needs to be in the matcher: the
+// proxy is what attaches session data to the request, and `withAuth()` throws
+// on any route the proxy doesn't cover, even to ask "is anyone signed in?"
+// (which the homepage does, to show a Dashboard vs. Sign in/Sign up link).
+// (Bare `authkitProxy()` with no `middlewareAuth` option would just manage the
+// session cookie without enforcing anything.)
+export default authkitProxy({
+  middlewareAuth: { enabled: true, unauthenticatedPaths: ["/"] },
+});
+
+export const config = { matcher: ["/", "/dashboard/:path*"] };
