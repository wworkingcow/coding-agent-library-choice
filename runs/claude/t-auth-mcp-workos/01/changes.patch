@@ -0,0 +1,17 @@
+import { authkitMiddleware } from "@workos-inc/authkit-nextjs";
+
+// Attaches/refreshes the AuthKit session cookie on every matched request,
+// and — with middlewareAuth enabled — redirects signed-out visitors straight
+// to sign-in for any matched path not listed as public. `/` stays public
+// (the landing page renders differently for signed-in vs signed-out
+// visitors); everything under /dashboard requires a session.
+export default authkitMiddleware({
+  middlewareAuth: {
+    enabled: true,
+    unauthenticatedPaths: ["/"],
+  },
+});
+
+export const config = {
+  matcher: ["/", "/dashboard/:path*"],
+};
