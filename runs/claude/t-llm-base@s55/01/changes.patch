+// Summarizes a note on behalf of a user. Returns undefined if the user doesn't exist.
+export async function summarizeNoteForUser(
+  userId: string,
+  noteText: string,
+): Promise<string | undefined> {
+  const user = await getUser(userId);
+  if (!user) return undefined;
+  return summarizeText(noteText);
+}
