+
+// Summarizes a note on behalf of the signed-in user. Throws SummarizeError(401) if nobody is signed in.
+export async function summarizeNoteForCurrentUser(
+  text: string,
+): Promise<{ userId: string; summary: string }> {
+  const user = await getCurrentUser();
+  if (!user) throw new SummarizeError("Not signed in.", 401);
+  return { userId: user.id, summary: await summarizeText(text) };
+}
