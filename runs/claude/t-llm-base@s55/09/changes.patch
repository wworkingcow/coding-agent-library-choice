+// Summarizes a note on behalf of a user. Throws if the user doesn't exist.
+export async function summarizeNoteForUser(
+  userId: string,
+  text: string,
+): Promise<string> {
+  const user = await getUser(userId);
+  if (!user) throw new Error(`Unknown user: ${userId}`);
+  return summarizeNote(text);
+}
