@@ -0,0 +1,34 @@
+import { DatabaseSync } from "node:sqlite";
+import type { BetterAuthOptions } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+
+// Reuse one connection across dev hot reloads.
+const globalForDb = globalThis as unknown as { notelyDb?: DatabaseSync };
+const db = (globalForDb.notelyDb ??= new DatabaseSync(
+  process.env.DATABASE_PATH ?? "notely.db",
+));
+
+const googleClientId = process.env.GOOGLE_CLIENT_ID;
+const googleClientSecret = process.env.GOOGLE_CLIENT_SECRET;
+
+// Kept apart from the auth instance so instrumentation.ts can migrate the
+// schema before betterAuth() runs its own schema check.
+export const authOptions = {
+  database: db,
+  emailAndPassword: {
+    enabled: true,
+    minPasswordLength: 8,
+  },
+  socialProviders:
+    googleClientId && googleClientSecret
+      ? { google: { clientId: googleClientId, clientSecret: googleClientSecret } }
+      : {},
+  advanced: {
+    database: {
+      // `next build` loads this module before any migration has run.
+      validateSchema: process.env.NEXT_PHASE !== "phase-production-build",
+    },
+  },
+  // Must stay last so it can set cookies from server actions.
+  plugins: [nextCookies()],
+} satisfies BetterAuthOptions;
