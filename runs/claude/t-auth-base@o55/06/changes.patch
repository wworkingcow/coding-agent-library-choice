index 0000000..2a7c70a
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,59 @@
+import "server-only";
+import { DatabaseSync } from "node:sqlite";
+import { betterAuth, type BetterAuthOptions } from "better-auth";
+import { getMigrations } from "better-auth/db/migration";
+import { nextCookies } from "better-auth/next-js";
+
+export const db = new DatabaseSync(process.env.DATABASE_PATH ?? "./notely.db");
+
+const options = {
+  database: db,
+  emailAndPassword: {
+    enabled: true,
+    minPasswordLength: 8,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID as string,
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET as string,
+    },
+  },
+  account: {
+    // Let someone who signed up with a password later use Google with the same
+    // (Google-verified) email and land on the same user.
+    accountLinking: { enabled: true, trustedProviders: ["google"] },
+  },
+  // Must stay last so it can set cookies from server actions / server components.
+  plugins: [nextCookies()],
+} satisfies BetterAuthOptions;
+
+export const auth = betterAuth(options);
+
+// Seed members that existed before auth was added. They have no credentials,
+// so they can only get in via Google with a matching email (account linking).
+const seedUsers = [
+  { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
+  { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
+];
+
+let ready: Promise<void> | undefined;
+
+/** Creates/updates the auth tables and seeds the original team, once per process. */
+export function ensureDatabase(): Promise<void> {
+  ready ??= (async () => {
+    const { runMigrations } = await getMigrations(options);
+    await runMigrations();
+    const insert = db.prepare(
+      `INSERT OR IGNORE INTO "user" (id, email, name, emailVerified, createdAt, updatedAt)
+       VALUES (?, ?, ?, 0, ?, ?)`,
+    );
+    for (const u of seedUsers) {
+      const ts = new Date(u.createdAt).toISOString();
+      insert.run(u.id, u.email, u.name, ts, ts);
+    }
+  })().catch((err) => {
+    ready = undefined;
+    throw err;
+  });
+  return ready;
+}
