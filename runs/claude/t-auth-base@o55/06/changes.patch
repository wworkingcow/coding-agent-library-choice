+"use client";
+
+import Link from "next/link";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import { authClient } from "@/lib/auth-client";
+
+type Mode = "sign-in" | "sign-up";
+
+export function AuthForm({ mode }: { mode: Mode }) {
+  const router = useRouter();
+  const [error, setError] = useState<string | null>(null);
+  const [pending, setPending] = useState(false);
+
+  async function onSubmit(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const form = new FormData(event.currentTarget);
+    const email = String(form.get("email"));
+    const password = String(form.get("password"));
+
+    setPending(true);
+    setError(null);
+    const { error } =
+      mode === "sign-up"
+        ? await authClient.signUp.email({ email, password, name: String(form.get("name")) })
+        : await authClient.signIn.email({ email, password });
+    setPending(false);
+
+    if (error) {
+      setError(error.message ?? "Something went wrong");
+      return;
+    }
+    router.push("/dashboard");
+    router.refresh();
+  }
+
+  async function onGoogle() {
+    setPending(true);
+    setError(null);
+    const { error } = await authClient.signIn.social({
+      provider: "google",
+      callbackURL: "/dashboard",
+      errorCallbackURL: "/sign-in",
+    });
+    if (error) {
+      setPending(false);
+      setError(error.message ?? "Google sign-in failed");
+    }
+  }
+
+  const input = "w-full rounded border border-black/15 bg-transparent px-3 py-2 text-sm dark:border-white/20";
+
+  return (
+    <main className="mx-auto w-full max-w-sm p-8">
+      <h1 className="text-2xl font-semibold">
+        {mode === "sign-up" ? "Create your Notely account" : "Sign in to Notely"}
+      </h1>
+
+      <button
+        type="button"
+        onClick={onGoogle}
+        disabled={pending}
+        className="mt-6 w-full rounded border border-black/15 px-3 py-2 text-sm font-medium hover:bg-black/5 disabled:opacity-50 dark:border-white/20 dark:hover:bg-white/10"
+      >
+        Continue with Google
+      </button>
+
+      <p className="my-4 text-center text-xs opacity-60">or</p>
+
+      <form onSubmit={onSubmit} className="space-y-3">
+        {mode === "sign-up" && (
+          <input name="name" placeholder="Name" required autoComplete="name" className={input} />
+        )}
+        <input name="email" type="email" placeholder="Email" required autoComplete="email" className={input} />
+        <input
+          name="password"
+          type="password"
+          placeholder="Password"
+          required
+          minLength={8}
+          autoComplete={mode === "sign-up" ? "new-password" : "current-password"}
+          className={input}
+        />
+        {error && <p className="text-sm text-red-600">{error}</p>}
+        <button
+          type="submit"
+          disabled={pending}
+          className="w-full rounded bg-foreground px-3 py-2 text-sm font-medium text-background disabled:opacity-50"
+        >
+          {mode === "sign-up" ? "Sign up" : "Sign in"}
+        </button>
+      </form>
+
+      <p className="mt-6 text-sm opacity-70">
+        {mode === "sign-up" ? (
+          <>Already have an account? <Link href="/sign-in" className="underline">Sign in</Link></>
+        ) : (
+          <>New to Notely? <Link href="/sign-up" className="underline">Create an account</Link></>
+        )}
+      </p>
+    </main>
+  );
+}
