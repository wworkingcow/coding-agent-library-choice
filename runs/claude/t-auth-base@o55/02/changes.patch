+import { DatabaseSync } from "node:sqlite";
+import type { BetterAuthOptions } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+
+const googleClientId = process.env.GOOGLE_CLIENT_ID;
+const googleClientSecret = process.env.GOOGLE_CLIENT_SECRET;
+
+export const googleEnabled = Boolean(googleClientId && googleClientSecret);
+
+// Kept separate from auth.ts so instrumentation can migrate the database
+// before betterAuth() runs its startup schema check.
+export const authOptions = {
+  database: new DatabaseSync(process.env.DATABASE_PATH ?? "notely.db"),
+  emailAndPassword: {
+    enabled: true,
+    minPasswordLength: 8,
+  },
+  socialProviders: googleEnabled
+    ? {
+        google: {
+          clientId: googleClientId!,
+          clientSecret: googleClientSecret!,
+        },
+      }
+    : {},
+  // nextCookies must stay last so cookies set by server actions reach the browser.
+  plugins: [nextCookies()],
+} satisfies BetterAuthOptions;
