+import "server-only";
+import { DatabaseSync } from "node:sqlite";
+import type { BetterAuthOptions } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+
+// Kept apart from auth.ts so instrumentation can migrate the database
+// without constructing the auth instance (which checks the schema eagerly).
+
+export const db = new DatabaseSync(process.env.DATABASE_PATH ?? "notely.db");
+
+const googleClientId = process.env.GOOGLE_CLIENT_ID;
+const googleClientSecret = process.env.GOOGLE_CLIENT_SECRET;
+
+export const googleEnabled = Boolean(googleClientId && googleClientSecret);
+
+export const authOptions = {
+  appName: "Notely",
+  database: db,
+  emailAndPassword: {
+    enabled: true,
+    minPasswordLength: 8,
+  },
+  socialProviders: googleEnabled
+    ? {
+        google: {
+          clientId: googleClientId!,
+          clientSecret: googleClientSecret!,
+        },
+      }
+    : {},
+  // nextCookies must stay last so Set-Cookie works from server actions.
+  plugins: [nextCookies()],
+} satisfies BetterAuthOptions;
