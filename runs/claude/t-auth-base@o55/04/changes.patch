@@ -0,0 +1,13 @@
+// Creates/updates Better Auth's tables. Run with `npm run db:migrate`.
+import { getMigrations } from "better-auth/db/migration";
+import { auth } from "../src/lib/auth.ts";
+
+const { toBeCreated, toBeAdded, toBeAddedIndexes, runMigrations } = await getMigrations(
+  auth.options,
+);
+if (toBeCreated.length + toBeAdded.length + toBeAddedIndexes.length === 0) {
+  console.log("Database is up to date.");
+} else {
+  await runMigrations();
+  console.log(`Created tables: ${toBeCreated.map((t) => t.table).join(", ") || "none"}`);
+}
