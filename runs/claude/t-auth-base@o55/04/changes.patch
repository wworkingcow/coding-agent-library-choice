@@ -0,0 +1,23 @@
+import { DatabaseSync } from "node:sqlite";
+import { betterAuth } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+
+// One SQLite file holds Better Auth's tables (user, session, account, verification).
+// Run `npm run db:migrate` once to create them.
+export const db = new DatabaseSync(process.env.DATABASE_PATH ?? "notely.db");
+
+export const auth = betterAuth({
+  database: db,
+  emailAndPassword: {
+    enabled: true,
+    minPasswordLength: 8,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID as string,
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET as string,
+    },
+  },
+  // Lets server actions / server components set auth cookies. Must stay last.
+  plugins: [nextCookies()],
+});
