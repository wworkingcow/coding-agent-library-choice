+import { DatabaseSync } from "node:sqlite";
+import { betterAuth } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+
+const googleClientId = process.env.GOOGLE_CLIENT_ID;
+const googleClientSecret = process.env.GOOGLE_CLIENT_SECRET;
+
+// Google sign-in is only offered once real OAuth credentials are configured.
+export const googleEnabled = Boolean(googleClientId && googleClientSecret);
+
+export const auth = betterAuth({
+  database: new DatabaseSync(process.env.DATABASE_PATH ?? "notely.db"),
+  emailAndPassword: {
+    enabled: true,
+    minPasswordLength: 8,
+  },
+  socialProviders: googleEnabled
+    ? {
+        google: {
+          clientId: googleClientId!,
+          clientSecret: googleClientSecret!,
+        },
+      }
+    : {},
+  // Must stay last: lets server actions set auth cookies via next/headers.
+  plugins: [nextCookies()],
+});
