+# Copy to .env.local and fill in real values.
+
+# Secret used to sign/encrypt sessions. Generate with: openssl rand -base64 32
+BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
+
+# Public base URL of the app (used for OAuth redirects and cookie origin checks).
+BETTER_AUTH_URL=http://localhost:3000
+
+# Google OAuth client (https://console.cloud.google.com/apis/credentials).
+# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
+GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
+GOOGLE_CLIENT_SECRET=your-google-client-secret
+
+# SQLite file for users/sessions (node:sqlite, no native deps).
+DATABASE_PATH=./data/notely.db
