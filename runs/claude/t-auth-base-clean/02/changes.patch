@@ -1,24 +1,106 @@
+import bcrypt from "bcryptjs";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  // Present for accounts created via email/password. Absent for OAuth-only accounts.
+  passwordHash?: string;
 };
 
+// In-memory store. Swap this for a real database when Notely grows up.
 const users: User[] = [
-  { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
-  { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
+  {
+    id: "1",
+    email: "ada@example.com",
+    name: "Ada",
+    createdAt: "2026-01-04",
+  },
+  {
+    id: "2",
+    email: "grace@example.com",
+    name: "Grace",
+    createdAt: "2026-02-11",
+  },
 ];
 
+let nextId = users.length + 1;
+
+function toPublicUser(user: User): User {
+  // Never let a password hash leak out to callers/session/UI.
+  const publicUser = { ...user };
+  delete publicUser.passwordHash;
+  return publicUser;
+}
+
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toPublicUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const user = users.find((u) => u.id === id);
+  return user ? toPublicUser(user) : undefined;
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const user = users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+  return user ? toPublicUser(user) : undefined;
+}
+
+// Creates a new email/password account. Throws if the email is already taken.
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email.toLowerCase() === email)) {
+    throw new Error("An account with that email already exists.");
+  }
+
+  const passwordHash = await bcrypt.hash(input.password, 10);
+  const user: User = {
+    id: String(nextId++),
+    email,
+    name: input.name.trim() || email.split("@")[0],
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(user);
+  return toPublicUser(user);
+}
+
+// Verifies email/password credentials. Returns the user (without the hash) on
+// success, or undefined if the email is unknown, has no password set (e.g. a
+// Google-only account), or the password doesn't match.
+export async function verifyUserCredentials(
+  email: string,
+  password: string,
+): Promise<User | undefined> {
+  const user = users.find((u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!user?.passwordHash) return undefined;
+
+  const valid = await bcrypt.compare(password, user.passwordHash);
+  return valid ? toPublicUser(user) : undefined;
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+// Finds an existing user by email, or creates one (no password set) for
+// sign-in via an OAuth provider like Google.
+export async function findOrCreateOAuthUser(input: {
+  email: string;
+  name?: string | null;
+}): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  const existing = users.find((u) => u.email.toLowerCase() === email);
+  if (existing) return toPublicUser(existing);
+
+  const user: User = {
+    id: String(nextId++),
+    email,
+    name: input.name?.trim() || email.split("@")[0],
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return toPublicUser(user);
 }
