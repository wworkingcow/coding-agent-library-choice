+++ b/src/lib/auth.ts
@@ -0,0 +1,68 @@
+import NextAuth from "next-auth";
+import Credentials from "next-auth/providers/credentials";
+import Google from "next-auth/providers/google";
+import { findOrCreateOAuthUser, getUserByEmail, verifyUserCredentials } from "@/lib/users";
+
+export const { handlers, signIn, signOut, auth } = NextAuth({
+  providers: [
+    Google({
+      clientId: process.env.GOOGLE_CLIENT_ID,
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET,
+    }),
+    Credentials({
+      credentials: {
+        email: { label: "Email", type: "email" },
+        password: { label: "Password", type: "password" },
+      },
+      authorize: async (credentials) => {
+        const email = credentials?.email;
+        const password = credentials?.password;
+        if (typeof email !== "string" || typeof password !== "string") {
+          return null;
+        }
+
+        const user = await verifyUserCredentials(email, password);
+        return user ?? null;
+      },
+    }),
+  ],
+  pages: {
+    signIn: "/signin",
+  },
+  session: {
+    strategy: "jwt",
+  },
+  callbacks: {
+    async signIn({ user, account }) {
+      // Credentials sign-in already went through verifyUserCredentials above.
+      // For Google, mirror the account into our user store on first sign-in.
+      if (account?.provider === "google") {
+        if (!user.email) return false;
+        await findOrCreateOAuthUser({ email: user.email, name: user.name });
+      }
+      return true;
+    },
+    async jwt({ token, user }) {
+      // On sign-in, `user` comes straight from `authorize()` (credentials) or
+      // the provider profile (Google) — resolve it to our own users.ts record
+      // so the token id is always our internal id, never the Google `sub`.
+      if (user?.email) {
+        const appUser = await getUserByEmail(user.email);
+        if (appUser) {
+          token.sub = appUser.id;
+          token.email = appUser.email;
+          token.name = appUser.name;
+        }
+      }
+      return token;
+    },
+    async session({ session, token }) {
+      if (session.user && token.sub) {
+        session.user.id = token.sub;
+        session.user.email = token.email ?? session.user.email;
+        session.user.name = token.name ?? session.user.name;
+      }
+      return session;
+    },
+  },
+});
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..98ef97c 100644
--- a/src/lib/users.ts
