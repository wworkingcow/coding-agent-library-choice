@@ -1,8 +1,12 @@
+import bcrypt from "bcryptjs";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  // Absent for accounts that only ever signed in via an OAuth provider (e.g. Google).
+  passwordHash?: string;
 };
 
 const users: User[] = [
@@ -18,7 +22,58 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === normalized);
+}
+
+export async function hashPassword(password: string): Promise<string> {
+  return bcrypt.hash(password, 10);
+}
+
+export async function verifyPassword(
+  password: string,
+  hash: string,
+): Promise<boolean> {
+  return bcrypt.compare(password, hash);
+}
+
+/** Creates a new email+password user. Throws if the email is already taken. */
+export async function createUser(params: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = params.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error("A user with this email already exists.");
+  }
+
+  const user: User = {
+    id: crypto.randomUUID(),
+    email,
+    name: params.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: await hashPassword(params.password),
+  };
+  users.push(user);
+  return user;
+}
+
+/** Finds an existing user by email, or creates one for a fresh OAuth sign-in. */
+export async function findOrCreateOAuthUser(params: {
+  email: string;
+  name: string;
+}): Promise<User> {
+  const existing = await getUserByEmail(params.email);
+  if (existing) return existing;
+
+  const user: User = {
+    id: crypto.randomUUID(),
+    email: params.email.trim().toLowerCase(),
+    name: params.name.trim() || params.email,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+  return user;
 }
