+          Continue with Google
+        </button>
+
+        <div className="flex items-center gap-3 text-xs uppercase text-zinc-400">
+          <div className="h-px flex-1 bg-black/[.08] dark:bg-white/[.145]" />
+          or
+          <div className="h-px flex-1 bg-black/[.08] dark:bg-white/[.145]" />
+        </div>
+
+        <form onSubmit={handleSignUp} className="space-y-4">
+          <div className="space-y-1">
+            <label htmlFor="name" className="text-sm font-medium">
+              Name
+            </label>
+            <input
+              id="name"
+              type="text"
+              value={name}
+              onChange={(e) => setName(e.target.value)}
+              className="w-full rounded-md border border-black/[.08] bg-transparent px-3 py-2 text-sm outline-none focus:border-black/40 dark:border-white/[.145] dark:focus:border-white/40"
+            />
+          </div>
+          <div className="space-y-1">
+            <label htmlFor="email" className="text-sm font-medium">
+              Email
+            </label>
+            <input
+              id="email"
+              type="email"
+              required
+              value={email}
+              onChange={(e) => setEmail(e.target.value)}
+              className="w-full rounded-md border border-black/[.08] bg-transparent px-3 py-2 text-sm outline-none focus:border-black/40 dark:border-white/[.145] dark:focus:border-white/40"
