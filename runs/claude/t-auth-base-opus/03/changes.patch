@@ -0,0 +1,19 @@
+/**
+ * Creates/updates the auth tables (user, session, account, verification) in the
+ * SQLite file before the server takes its first request. Next.js awaits
+ * register(), so no page can query a table that doesn't exist yet.
+ */
+export async function register() {
+  if (process.env.NEXT_RUNTIME !== "nodejs") return;
+
+  const [{ getMigrations }, { authOptions }] = await Promise.all([
+    import("better-auth/db/migration"),
+    import("@/lib/auth"),
+  ]);
+
+  const { toBeCreated, toBeAdded, runMigrations } = await getMigrations(authOptions);
+  if (toBeCreated.length === 0 && toBeAdded.length === 0) return;
+
+  await runMigrations();
+  console.log("[notely] auth schema migrated");
+}
