@@ -0,0 +1,46 @@
+import { betterAuth } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+import { db } from "./db";
+
+function secret() {
+  const fromEnv = process.env.BETTER_AUTH_SECRET;
+  if (fromEnv) return fromEnv;
+  // `next build` evaluates this module without a runtime env; only a real
+  // production server is required to carry a secret.
+  const building = process.env.NEXT_PHASE === "phase-production-build";
+  if (process.env.NODE_ENV === "production" && !building) {
+    throw new Error("BETTER_AUTH_SECRET must be set in production — see .env.example");
+  }
+  return "notely-dev-secret-do-not-use-in-production";
+}
+
+// Exported separately so the migration runner in instrumentation.ts can build
+// the schema from the exact same config the server runs on.
+export const authOptions = {
+  appName: "Notely",
+  database: db,
+  baseURL: process.env.BETTER_AUTH_URL ?? "http://localhost:3000",
+  secret: secret(),
+  emailAndPassword: {
+    enabled: true,
+    minPasswordLength: 8,
+    autoSignIn: true,
+  },
+  socialProviders: {
+    google: {
+      clientId: process.env.GOOGLE_CLIENT_ID ?? "",
+      clientSecret: process.env.GOOGLE_CLIENT_SECRET ?? "",
+    },
+  },
+  session: {
+    expiresIn: 60 * 60 * 24 * 30, // 30 days
+    updateAge: 60 * 60 * 24, // refresh the expiry at most once a day
+  },
+  // nextCookies() has to stay last: it wraps responses so cookies set inside
+  // server actions actually reach the browser.
+  plugins: [nextCookies()],
+};
+
+export const auth = betterAuth(authOptions);
+
+export type Session = typeof auth.$Infer.Session;
