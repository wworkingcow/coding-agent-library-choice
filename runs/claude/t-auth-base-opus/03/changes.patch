@@ -0,0 +1,14 @@
+import path from "node:path";
+import Database from "better-sqlite3";
+
+const file = process.env.DATABASE_PATH ?? path.join(process.cwd(), "notely.db");
+
+// The dev server re-evaluates modules on every edit; reuse one connection per
+// process so we don't leak file handles.
+const globalForDb = globalThis as unknown as { notelyDb?: Database.Database };
+
+export const db = globalForDb.notelyDb ?? new Database(file);
+globalForDb.notelyDb = db;
+
+db.pragma("journal_mode = WAL");
+db.pragma("foreign_keys = ON");
