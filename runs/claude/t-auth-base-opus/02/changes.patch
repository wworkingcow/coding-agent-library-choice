+import { googleSignInAction } from "@/lib/auth-actions";
+
+type Props = {
+  mode: "signin" | "signup";
+  action: (state: AuthFormState, formData: FormData) => Promise<AuthFormState>;
+  callbackUrl: string;
+};
+
+const COPY = {
+  signin: {
+    title: "Sign in to Notely",
+    submit: "Sign in",
+    altPrompt: "New here?",
+    altHref: "/signup",
+    altLabel: "Create an account",
+  },
+  signup: {
+    title: "Create your Notely account",
+    submit: "Create account",
+    altPrompt: "Already have an account?",
+    altHref: "/signin",
+    altLabel: "Sign in",
+  },
+} as const;
+
+export function AuthForm({ mode, action, callbackUrl }: Props) {
+  const [state, formAction] = useActionState(action, {});
+  const copy = COPY[mode];
+  const fieldErrors = state.fieldErrors ?? {};
+
+  return (
+    <main className="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center p-8">
+      <h1 className="text-2xl font-semibold tracking-tight">{copy.title}</h1>
+
+      <form action={googleSignInAction} className="mt-8">
+        <input type="hidden" name="callbackUrl" value={callbackUrl} />
+        <GoogleButton />
+      </form>
+
+      <div className="my-6 flex items-center gap-3 text-xs uppercase tracking-wide opacity-50">
+        <span className="h-px flex-1 bg-current" />
+        or
+        <span className="h-px flex-1 bg-current" />
+      </div>
+
+      <form action={formAction} className="flex flex-col gap-4" noValidate>
+        <input type="hidden" name="callbackUrl" value={callbackUrl} />
+
+        {mode === "signup" && (
+          <Field
+            label="Name"
+            name="name"
+            type="text"
+            autoComplete="name"
+            errors={fieldErrors.name}
+          />
+        )}
+
+        <Field
+          label="Email"
+          name="email"
+          type="email"
+          autoComplete="email"
+          errors={fieldErrors.email}
+        />
+
+        <Field
+          label="Password"
+          name="password"
+          type="password"
+          autoComplete={mode === "signup" ? "new-password" : "current-password"}
+          errors={fieldErrors.password}
+        />
+
+        {state.error && (
+          <p role="alert" className="text-sm text-red-600 dark:text-red-400">
+            {state.error}
+          </p>
+        )}
+
+        <SubmitButton label={copy.submit} />
+      </form>
+
+      <p className="mt-6 text-sm opacity-70">
+        {copy.altPrompt}{" "}
+        <Link href={copy.altHref} className="font-medium underline">
+          {copy.altLabel}
+        </Link>
+      </p>
+    </main>
+  );
+}
+
+function Field({
+  label,
+  name,
+  type,
+  autoComplete,
+  errors,
+}: {
+  label: string;
+  name: string;
+  type: string;
+  autoComplete: string;
+  errors?: string[];
+}) {
+  const errorId = `${name}-error`;
+  return (
+    <label className="flex flex-col gap-1.5 text-sm">
+      <span className="font-medium">{label}</span>
+      <input
+        name={name}
+        type={type}
+        autoComplete={autoComplete}
+        required
+        aria-invalid={errors ? true : undefined}
+        aria-describedby={errors ? errorId : undefined}
+        className="rounded-md border border-black/[.12] bg-transparent px-3 py-2 outline-none focus:border-current dark:border-white/[.18]"
+      />
+      {errors?.map((message) => (
+        <span key={message} id={errorId} className="text-red-600 dark:text-red-400">
+          {message}
+        </span>
+      ))}
+    </label>
+  );
+}
+
+function SubmitButton({ label }: { label: string }) {
+  const { pending } = useFormStatus();
+  return (
+    <button
+      type="submit"
+      disabled={pending}
+      className="mt-2 h-11 rounded-full bg-foreground text-sm font-medium text-background transition-opacity hover:opacity-90 disabled:opacity-50"
+    >
+      {pending ? "Please wait…" : label}
+    </button>
+  );
+}
+
+function GoogleButton() {
+  const { pending } = useFormStatus();
+  return (
+    <button
+      type="submit"
+      disabled={pending}
+      className="flex h-11 w-full items-center justify-center gap-2.5 rounded-full border border-solid border-black/[.12] text-sm font-medium transition-colors hover:bg-black/[.04] disabled:opacity-50 dark:border-white/[.18] dark:hover:bg-white/[.06]"
+    >
+      <GoogleMark />
+      Continue with Google
+    </button>
+  );
+}
+
+function GoogleMark() {
