@@ -0,0 +1,76 @@
+import NextAuth from "next-auth";
+import Credentials from "next-auth/providers/credentials";
+import { z } from "zod";
+
+import { authConfig } from "@/auth.config";
+import { upsertOAuthUser, verifyCredentials } from "@/lib/users";
+
+const credentialsSchema = z.object({
+  email: z.string().email(),
+  password: z.string().min(1),
+});
+
+export const { handlers, auth, signIn, signOut } = NextAuth({
+  ...authConfig,
+  providers: [
+    ...authConfig.providers,
+    Credentials({
+      credentials: {
+        email: { label: "Email", type: "email" },
+        password: { label: "Password", type: "password" },
+      },
+      // Returning null (rather than throwing) makes Auth.js surface a generic
+      // CredentialsSignin error, so we never leak whether the email exists.
+      async authorize(credentials) {
+        const parsed = credentialsSchema.safeParse(credentials);
+        if (!parsed.success) return null;
+
+        const user = await verifyCredentials(
+          parsed.data.email,
+          parsed.data.password,
+        );
+        if (!user) return null;
+
+        return {
+          id: user.id,
+          email: user.email,
+          name: user.name,
+          image: user.image,
+        };
+      },
+    }),
+  ],
+  callbacks: {
+    ...authConfig.callbacks,
+
+    signIn({ account, profile }) {
+      // Only trust a Google identity once Google says the address is verified;
+      // otherwise it could be used to take over a matching local account.
+      if (account?.provider === "google") return profile?.email_verified === true;
+      return true;
+    },
+
+    /**
+     * Runs with `account`/`user` set only on the initial sign in — every later
+     * call just re-reads the token, which is what keeps the proxy's Edge
+     * runtime away from the user store.
+     */
+    async jwt({ token, user, account }) {
+      if (account?.provider === "google" && token.email) {
+        const linked = await upsertOAuthUser({
+          email: token.email,
+          name: token.name,
+          image: token.picture,
+          provider: "google",
+        });
+        // Replace Google's subject with our own id so the rest of the app has
+        // a single notion of "who is this".
+        token.sub = linked.id;
+        token.name = linked.name;
+      } else if (user?.id) {
+        token.sub = user.id;
+      }
+      return token;
+    },
+  },
+});
