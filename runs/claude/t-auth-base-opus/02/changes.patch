+import NextAuth from "next-auth";
+import { authConfig } from "@/auth.config";
+
+const PROTECTED = ["/dashboard"];
+const AUTH_PAGES = ["/signin", "/signup"];
+
+/**
+ * Optimistic routing only: it reads the session cookie to keep signed-out users
+ * from ever seeing the dashboard shell, and to bounce signed-in users off the
+ * auth pages.
+ *
+ * This is NOT the authorization gate. The proxy runs before rendering and can
+ * be bypassed, so every protected page re-checks the session server-side (see
+ * `getCurrentUser()` in src/lib/users.ts).
+ */
+const { auth } = NextAuth(authConfig);
+
+export default auth((req) => {
+  const { nextUrl } = req;
+  const isLoggedIn = Boolean(req.auth?.user);
+  const { pathname } = nextUrl;
+
+  if (!isLoggedIn && PROTECTED.some((p) => pathname.startsWith(p))) {
+    const signInUrl = new URL("/signin", nextUrl);
+    // Remember where they were headed so sign-in can send them back.
+    signInUrl.searchParams.set("callbackUrl", pathname + nextUrl.search);
+    return Response.redirect(signInUrl);
+  }
+
+  if (isLoggedIn && AUTH_PAGES.includes(pathname)) {
+    return Response.redirect(new URL("/dashboard", nextUrl));
+  }
+});
+
+export const config = {
+  // Skip Next internals, the Auth.js routes themselves, and static files.
+  matcher: ["/((?!api/auth|_next/static|_next/image|favicon.ico|.*\\.svg$).*)"],
+};
