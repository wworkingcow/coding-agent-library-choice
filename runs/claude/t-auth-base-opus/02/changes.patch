+import bcrypt from "bcryptjs";
+
 export type User = {
   id: string;
   email: string;
   name: string;
   createdAt: string;
+  image?: string;
+};
+
+// Everything the store knows about a user. `passwordHash` and `providers` never
+// leave this module — callers only ever see the public `User` shape above.
+type UserRecord = User & {
+  passwordHash: string | null;
+  providers: string[];
 };
 
-const users: User[] = [
-  { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04" },
-  { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
+const BCRYPT_ROUNDS = 12;
+
+// A valid bcrypt hash of a random throwaway string, so nothing a caller can
+// send will match it. Used to keep the timing of a failed lookup close to the
+// timing of a wrong password.
+const DUMMY_HASH = "$2b$12$D73JJnD0WXpgp61FkWoHZuxGEb0Vhcps8HAltpjXjTADDAWT9IRPC";
+
+// Seeded users share the dev password "password123" (see .env.example).
+const users: UserRecord[] = [
+  {
+    id: "1",
+    email: "ada@example.com",
+    name: "Ada",
+    createdAt: "2026-01-04",
+    passwordHash: "$2b$12$Bh0ByTjHL8AvDvzHrBaKU.PFZ1Eb6jsJ52xJT1DsvKW.i2nLTiwBG",
+    providers: ["credentials"],
+  },
+  {
+    id: "2",
+    email: "grace@example.com",
+    name: "Grace",
+    createdAt: "2026-02-11",
+    passwordHash: "$2b$12$5YkEYqcu56VDrhoBV.RaYOCdLGvQK6TZPgTVQ5YUX46jtmfCAOlum",
+    providers: ["credentials"],
+  },
 ];
 
+let nextId = users.length + 1;
+
+const normalizeEmail = (email: string) => email.trim().toLowerCase();
+
+// Builds the public shape field by field rather than stripping secrets off the
+// record, so a field added to UserRecord later cannot leak by omission.
+function toUser(record: UserRecord): User {
+  const { id, email, name, createdAt, image } = record;
+  return { id, email, name, createdAt, image };
+}
+
+function today(): string {
+  return new Date().toISOString().slice(0, 10);
+}
+
 export async function listUsers(): Promise<User[]> {
-  return users;
+  return users.map(toUser);
 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const found = users.find((u) => u.id === id);
+  return found && toUser(found);
+}
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const target = normalizeEmail(email);
+  const found = users.find((u) => u.email === target);
+  return found && toUser(found);
+}
+
+/**
+ * Create an email + password user. Returns `null` when the email is taken so
+ * the caller can render a field error instead of handling a throw.
+ */
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User | null> {
+  const email = normalizeEmail(input.email);
+  if (users.some((u) => u.email === email)) return null;
+
+  const record: UserRecord = {
+    id: String(nextId++),
+    email,
+    name: input.name.trim(),
+    createdAt: today(),
+    passwordHash: await bcrypt.hash(input.password, BCRYPT_ROUNDS),
+    providers: ["credentials"],
+  };
+  users.push(record);
+  return toUser(record);
+}
+
+/**
+ * Check an email + password pair. Always runs a bcrypt comparison — even for
+ * unknown emails and for accounts that only have a Google login — so the
+ * response time does not reveal which emails exist.
+ */
+export async function verifyCredentials(
+  email: string,
+  password: string,
+): Promise<User | null> {
+  const target = normalizeEmail(email);
+  const found = users.find((u) => u.email === target);
+  const hash = found?.passwordHash ?? DUMMY_HASH;
+
+  const ok = await bcrypt.compare(password, hash);
+  if (!ok || !found || !found.passwordHash) return null;
+  return toUser(found);
+}
+
+/**
