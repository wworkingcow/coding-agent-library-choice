+import type { NextAuthConfig } from "next-auth";
+import Google from "next-auth/providers/google";
+
+/**
+ * The half of the Auth.js config that is safe to run in the proxy (Edge)
+ * runtime: no bcrypt, no user store, no Node built-ins.
+ *
+ * `src/auth.ts` spreads this and adds the Credentials provider and the `jwt`
+ * callback, both of which need the user store and therefore Node.
+ */
+export const authConfig = {
+  providers: [Google],
+  session: { strategy: "jwt" },
+  pages: {
+    signIn: "/signin",
+  },
+  callbacks: {
+    // Copy our internal user id off the token and onto the session, so
+    // `getCurrentUser()` can resolve the real record from the store.
+    session({ session, token }) {
+      if (token.sub) session.user.id = token.sub;
+      if (typeof token.name === "string") session.user.name = token.name;
+      if (typeof token.picture === "string") session.user.image = token.picture;
+      return session;
+    },
+  },
+} satisfies NextAuthConfig;
