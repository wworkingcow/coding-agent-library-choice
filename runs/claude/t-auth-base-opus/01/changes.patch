@@ -0,0 +1,12 @@
+const DEFAULT_PATH = "/dashboard";
+
+/**
+ * Narrows a user-supplied `?next=` value to a same-origin path so it cannot be
+ * used to bounce someone off to another host after sign-in.
+ */
+export function safePath(value: string | string[] | undefined): string {
+  if (typeof value !== "string") return DEFAULT_PATH;
+  // Reject protocol-relative ("//evil.com") and absolute URLs; require a path.
+  if (!value.startsWith("/") || value.startsWith("//")) return DEFAULT_PATH;
+  return value;
+}
