+import { betterAuth } from "better-auth";
+import { nextCookies } from "better-auth/next-js";
+
+import { db } from "./db";
+
+// Google is only registered when credentials are present, so the app still
+// boots with the placeholder .env.example values (the button is disabled then).
+export const googleEnabled = Boolean(
+  process.env.GOOGLE_CLIENT_ID && process.env.GOOGLE_CLIENT_SECRET,
+);
+
+export const auth = betterAuth({
+  database: db,
+  emailAndPassword: {
+    enabled: true,
+  },
+  socialProviders: googleEnabled
+    ? {
+        google: {
+          clientId: process.env.GOOGLE_CLIENT_ID as string,
+          clientSecret: process.env.GOOGLE_CLIENT_SECRET as string,
+        },
+      }
+    : {},
+  // nextCookies() must stay last: it flushes Set-Cookie for server actions.
+  plugins: [nextCookies()],
+});
