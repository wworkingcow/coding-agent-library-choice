+"use client";
+
+import { useState } from "react";
+import type { FormEvent } from "react";
+import Link from "next/link";
+import { useRouter } from "next/navigation";
+
+import { authClient } from "@/lib/auth-client";
+
+type Mode = "sign-in" | "sign-up";
+
+const COPY = {
+  "sign-in": {
+    title: "Sign in to Notely",
+    submit: "Sign in",
+    altPrompt: "Don't have an account?",
+    altLabel: "Sign up",
+    altHref: "/sign-up",
+  },
+  "sign-up": {
+    title: "Create your Notely account",
+    submit: "Create account",
+    altPrompt: "Already have an account?",
+    altLabel: "Sign in",
+    altHref: "/sign-in",
+  },
+} as const;
+
+const fieldClass =
+  "w-full rounded-lg border border-black/[.12] bg-white px-3 py-2 text-sm text-black outline-none transition-colors placeholder:text-zinc-400 focus:border-black/40 disabled:opacity-50 dark:border-white/[.16] dark:bg-black dark:text-zinc-50 dark:focus:border-white/40";
+
+export function AuthForm({
+  mode,
+  googleEnabled,
+  redirectTo,
+}: {
+  mode: Mode;
+  googleEnabled: boolean;
+  redirectTo: string;
+}) {
+  const router = useRouter();
+  const copy = COPY[mode];
+  const [pending, setPending] = useState<"email" | "google" | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  async function onSubmit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setError(null);
+    setPending("email");
+
+    const form = new FormData(event.currentTarget);
+    const email = String(form.get("email") ?? "");
+    const password = String(form.get("password") ?? "");
+    const name = String(form.get("name") ?? "");
+
+    const { error: authError } =
+      mode === "sign-up"
+        ? await authClient.signUp.email({ email, password, name })
+        : await authClient.signIn.email({ email, password });
+
+    if (authError) {
+      setError(authError.message ?? "Something went wrong. Please try again.");
+      setPending(null);
+      return;
+    }
+
+    // refresh() drops the cached RSC payload so the dashboard re-renders with
+    // the new session instead of the signed-out version.
+    router.replace(redirectTo);
+    router.refresh();
+  }
+
+  async function onGoogle() {
+    setError(null);
+    setPending("google");
+
+    const { error: authError } = await authClient.signIn.social({
+      provider: "google",
+      callbackURL: redirectTo,
+    });
+
+    if (authError) {
+      setError(authError.message ?? "Could not start Google sign-in.");
+      setPending(null);
+    }
+    // On success the browser is redirected to Google, so leave pending set.
+  }
+
+  const busy = pending !== null;
+
+  return (
+    <div className="w-full max-w-sm">
+      <h1 className="text-2xl font-semibold tracking-tight text-black dark:text-zinc-50">
+        {copy.title}
+      </h1>
+
+      <form onSubmit={onSubmit} className="mt-8 flex flex-col gap-4">
+        {mode === "sign-up" && (
+          <label className="flex flex-col gap-1.5">
+            <span className="text-sm font-medium">Name</span>
+            <input
+              name="name"
+              type="text"
+              autoComplete="name"
+              required
+              disabled={busy}
+              placeholder="Ada Lovelace"
+              className={fieldClass}
+            />
+          </label>
+        )}
+
+        <label className="flex flex-col gap-1.5">
+          <span className="text-sm font-medium">Email</span>
+          <input
+            name="email"
+            type="email"
+            autoComplete="email"
+            required
+            disabled={busy}
+            placeholder="you@example.com"
+            className={fieldClass}
+          />
+        </label>
+
+        <label className="flex flex-col gap-1.5">
+          <span className="text-sm font-medium">Password</span>
+          <input
+            name="password"
+            type="password"
+            autoComplete={
+              mode === "sign-up" ? "new-password" : "current-password"
+            }
+            required
+            minLength={8}
+            disabled={busy}
+            placeholder="At least 8 characters"
+            className={fieldClass}
+          />
+        </label>
+
+        {error && (
+          <p
+            role="alert"
+            className="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950/40 dark:text-red-300"
+          >
+            {error}
+          </p>
+        )}
+
+        <button
+          type="submit"
+          disabled={busy}
+          className="mt-2 flex h-11 items-center justify-center rounded-full bg-black px-5 text-sm font-medium text-white transition-colors hover:bg-[#383838] disabled:opacity-50 dark:bg-zinc-50 dark:text-black dark:hover:bg-[#ccc]"
+        >
+          {pending === "email" ? "Working…" : copy.submit}
+        </button>
+      </form>
+
+      <div className="my-6 flex items-center gap-3 text-xs uppercase tracking-wide text-zinc-500">
+        <span className="h-px flex-1 bg-black/[.08] dark:bg-white/[.145]" />
+        or
+        <span className="h-px flex-1 bg-black/[.08] dark:bg-white/[.145]" />
+      </div>
+
+      <button
+        type="button"
+        onClick={onGoogle}
+        disabled={busy || !googleEnabled}
+        title={
+          googleEnabled
+            ? undefined
+            : "Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in .env.local to enable this"
+        }
+        className="flex h-11 w-full items-center justify-center gap-2.5 rounded-full border border-solid border-black/[.08] px-5 text-sm font-medium transition-colors hover:border-transparent hover:bg-black/[.04] disabled:opacity-50 disabled:hover:bg-transparent dark:border-white/[.145] dark:hover:bg-[#1a1a1a]"
+      >
+        <GoogleMark />
+        {pending === "google" ? "Redirecting…" : "Continue with Google"}
+      </button>
+
+      {!googleEnabled && (
+        <p className="mt-2 text-center text-xs text-zinc-500">
+          Google sign-in is off until you set{" "}
+          <code className="font-mono">GOOGLE_CLIENT_ID</code> and{" "}
+          <code className="font-mono">GOOGLE_CLIENT_SECRET</code>.
+        </p>
+      )}
+
+      <p className="mt-8 text-center text-sm text-zinc-600 dark:text-zinc-400">
+        {copy.altPrompt}{" "}
+        <Link
+          href={copy.altHref}
+          className="font-medium text-zinc-950 underline-offset-4 hover:underline dark:text-zinc-50"
+        >
+          {copy.altLabel}
+        </Link>
+      </p>
+    </div>
+  );
+}
+
+function GoogleMark() {
+  return (
+    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 18 18">
+      <path
+        fill="#4285F4"
+        d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.88 2.69-6.62Z"
+      />
+      <path
+        fill="#34A853"
+        d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.34A9 9 0 0 0 9 18Z"
+      />
+      <path
+        fill="#FBBC05"
+        d="M3.97 10.72a5.41 5.41 0 0 1 0-3.44V4.94H.96a9 9 0 0 0 0 8.12l3.01-2.34Z"
+      />
+      <path
+        fill="#EA4335"
+        d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.94l3.01 2.34C4.68 5.16 6.66 3.58 9 3.58Z"
+      />
+    </svg>
+  );
+}
