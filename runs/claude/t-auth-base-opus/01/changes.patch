+// Shape of Better Auth's `user` table. It stores timestamps as an ISO string on
+// some drivers and as epoch milliseconds on others, so accept both.
+type UserRow = {
+  id: string;
+  email: string;
+  name: string | null;
+  createdAt: string | number | Date | null;
+};
+
+function toDay(value: UserRow["createdAt"]): string {
+  if (value == null) return "unknown";
+  const date =
+    typeof value === "string" && /^\d+$/.test(value)
+      ? new Date(Number(value))
+      : new Date(value);
+  return Number.isNaN(date.getTime()) ? "unknown" : date.toISOString().slice(0, 10);
