@@ -0,0 +1,19 @@
+import { NextResponse } from "next/server";
+import type { NextRequest } from "next/server";
+import { getSessionCookie } from "better-auth/cookies";
+
+// Cheap first gate: is there a session cookie at all? No database round-trip,
+// so this stays fast and edge-safe. It is deliberately optimistic — a forged or
+// expired cookie gets past it, which is why /dashboard also calls
+// getCurrentUser() and redirects. That server-side check is the real guard.
+export function proxy(request: NextRequest) {
+  if (getSessionCookie(request)) return NextResponse.next();
+
+  const signIn = new URL("/sign-in", request.url);
+  signIn.searchParams.set("next", request.nextUrl.pathname);
+  return NextResponse.redirect(signIn);
+}
+
+export const config = {
+  matcher: ["/dashboard/:path*"],
+};
