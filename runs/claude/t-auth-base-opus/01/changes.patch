--- /dev/null
+++ b/src/lib/db.ts
@@ -0,0 +1,14 @@
+import Database from "better-sqlite3";
+
+// One SQLite handle, shared by Better Auth (src/lib/auth.ts) and the user
+// queries in src/lib/users.ts. Cached on globalThis so the dev server's hot
+// reload reuses the handle instead of leaking a new one on every edit.
+const globalForDb = globalThis as unknown as { notelyDb?: Database.Database };
+
+function open(): Database.Database {
+  const db = new Database(process.env.DATABASE_PATH ?? "notely.sqlite");
+  db.pragma("journal_mode = WAL");
+  return db;
+}
+
+export const db = (globalForDb.notelyDb ??= open());
