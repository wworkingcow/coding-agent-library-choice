+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { appUrl, sendEmail } from "@/lib/email";
+import { welcomeEmail } from "@/emails/welcome";
+import { passwordResetEmail } from "@/emails/password-reset";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +27,81 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists");
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Failures are logged inside sendEmail; signup succeeds regardless.
+  await sendEmail({
+    to: user.email,
+    ...welcomeEmail({ name: user.name, dashboardUrl: appUrl("/dashboard") }),
+  });
+
+  return user;
+}
+
+// --- Password reset ---------------------------------------------------------
+
+const RESET_TOKEN_TTL_MINUTES = 30;
+
+// Only the SHA-256 of each token is kept, so a leaked store can't be used to reset passwords.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+/**
+ * Emails a single-use reset link if the address belongs to a user.
+ * Resolves the same way whether or not the user exists, so callers can't
+ * use it to discover which emails are registered.
+ */
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = users.find((u) => u.email === email.trim().toLowerCase());
+  if (!user) return;
+
+  // One live link per user: a new request invalidates the previous one.
+  for (const [hash, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  await sendEmail({
+    to: user.email,
+    ...passwordResetEmail({
+      name: user.name,
+      resetUrl: appUrl(`/reset-password?token=${encodeURIComponent(token)}`),
+      expiresInMinutes: RESET_TOKEN_TTL_MINUTES,
+    }),
+  });
+}
+
+/**
+ * Validates and burns a reset token. Returns the user it was issued for, or
+ * undefined if the token is unknown, already used, or expired. The caller then
+ * sets the new password (there is no password storage in this module yet).
+ */
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = resetTokens.get(hash);
+  if (!entry) return undefined;
+  resetTokens.delete(hash);
+  if (entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
