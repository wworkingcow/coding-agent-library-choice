+import { button, escapeHtml, layout } from "./layout";
+
+export function welcomeEmail({ name, dashboardUrl }: { name: string; dashboardUrl: string }) {
+  const subject = "Welcome to Notely";
+  const html = layout({
+    preview: "Your Notely account is ready.",
+    body: `
+      <p>Hi ${escapeHtml(name)},</p>
+      <p>Your Notely account is ready. Jump in and write your first note.</p>
+      ${button(dashboardUrl, "Open Notely")}
+      <p style="color:#71717a;font-size:13px;">If you didn't create this account, you can ignore this email.</p>`,
+  });
+  const text = `Hi ${name},
+
+Your Notely account is ready. Jump in and write your first note:
+${dashboardUrl}
+
+If you didn't create this account, you can ignore this email.`;
+  return { subject, html, text };
+}
diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..6b731f2
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,53 @@
+import "server-only";
+import { Resend } from "resend";
+
+export type EmailMessage = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+export type SendResult = { ok: true; id: string } | { ok: false; error: string };
+
+let client: Resend | null = null;
+
+// Created lazily so a missing key fails at send time with a logged error,
+// not at import time for every page that touches user code.
+function getClient(): Resend | null {
+  if (client) return client;
+  const key = process.env.RESEND_API_KEY;
+  if (!key) return null;
+  client = new Resend(key);
+  return client;
+}
+
+// Never throws: a failed email must not break the request that triggered it.
+export async function sendEmail(message: EmailMessage): Promise<SendResult> {
+  const resend = getClient();
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!resend || !from) {
+    const error = "RESEND_API_KEY or RESEND_FROM_EMAIL is not set";
+    console.error(`[email] not sent to ${message.to}: ${error}`);
+    return { ok: false, error };
+  }
+
+  try {
+    const { data, error } = await resend.emails.send({ from, ...message });
+    if (error || !data) {
+      const msg = error ? `${error.name}: ${error.message}` : "empty response";
+      console.error(`[email] "${message.subject}" to ${message.to} failed: ${msg}`);
+      return { ok: false, error: msg };
+    }
+    return { ok: true, id: data.id };
+  } catch (err) {
+    const msg = err instanceof Error ? err.message : String(err);
+    console.error(`[email] "${message.subject}" to ${message.to} threw: ${msg}`);
+    return { ok: false, error: msg };
+  }
+}
+
+export function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
