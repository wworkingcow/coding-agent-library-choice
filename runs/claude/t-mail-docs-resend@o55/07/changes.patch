+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
+export async function createUser(input: { email: string; name: string; password?: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  const name = input.name.trim();
+  if (!email.includes("@")) throw new Error("Invalid email address");
+  if (!name) throw new Error("Name is required");
+  if (await getUserByEmail(email)) throw new Error("A user with this email already exists");
+  if (input.password !== undefined && input.password.length < MIN_PASSWORD_LENGTH) {
+    throw new Error(`Password must be at least ${MIN_PASSWORD_LENGTH} characters`);
+  }
+
+  const user: User = { id: randomUUID(), email, name, createdAt: new Date().toISOString().slice(0, 10) };
+  users.push(user);
+  if (input.password !== undefined) passwordHashes.set(user.id, await hashPassword(input.password));
+
+  // Failures are logged inside sendWelcomeEmail; signup succeeds regardless.
+  await sendWelcomeEmail(user);
+  return user;
+}
+
+// Always resolves the same way whether or not the email exists, so callers can't
+// use it to discover which addresses have accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // One live token per user: a new request invalidates older links.
+  for (const [key, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(key);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  await sendPasswordResetEmail(user, token, RESET_TOKEN_TTL_MINUTES);
+}
+
+export async function resetPassword(token: string, newPassword: string): Promise<{ ok: true } | { ok: false; error: string }> {
+  if (newPassword.length < MIN_PASSWORD_LENGTH) {
+    return { ok: false, error: `Password must be at least ${MIN_PASSWORD_LENGTH} characters` };
+  }
+
+  const key = hashToken(token);
+  const entry = resetTokens.get(key);
+  if (!entry || entry.expiresAt < Date.now()) {
+    resetTokens.delete(key);
+    return { ok: false, error: "This reset link is invalid or has expired" };
+  }
+
+  resetTokens.delete(key); // single use
+  passwordHashes.set(entry.userId, await hashPassword(newPassword));
+  return { ok: true };
+}
