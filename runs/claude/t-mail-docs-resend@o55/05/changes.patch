@@ -0,0 +1,33 @@
+import "server-only";
+import { getResend } from "@/lib/resend";
+import { welcomeEmail } from "@/emails/welcome";
+import { passwordResetEmail } from "@/emails/password-reset";
+
+type SendResult = { ok: true; id: string } | { ok: false; error: string };
+
+async function send(to: string, email: { subject: string; html: string; text: string }): Promise<SendResult> {
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!from) return { ok: false, error: "RESEND_FROM_EMAIL is not set" };
+
+  try {
+    // `emails.send` resolves with `{ error }` instead of throwing when Resend refuses a message.
+    const { data, error } = await getResend().emails.send({ from, to, ...email });
+    if (error || !data) return { ok: false, error: error?.message ?? "Unknown Resend error" };
+    return { ok: true, id: data.id };
+  } catch (err) {
+    return { ok: false, error: err instanceof Error ? err.message : String(err) };
+  }
+}
+
+export function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  return send(user.email, welcomeEmail({ name: user.name, dashboardUrl: appUrl("/dashboard") }));
+}
+
+export function sendPasswordResetEmail(user: { email: string; name: string }, resetUrl: string, expiresInMinutes: number) {
+  return send(user.email, passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes }));
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..1d24027
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,13 @@
+import { Resend } from "resend";
+
+// Created lazily: `new Resend()` throws without an API key, and we don't want
+// importing this module (e.g. during `next build`) to fail when it isn't set.
+let client: Resend | undefined;
+
+export function getResend(): Resend {
+  if (!process.env.RESEND_API_KEY) {
+    throw new Error("RESEND_API_KEY is not set");
+  }
+  client ??= new Resend(process.env.RESEND_API_KEY);
+  return client;
+}
