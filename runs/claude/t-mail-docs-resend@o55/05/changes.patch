 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (await getUserByEmail(email)) {
+    throw new Error("A user with this email already exists");
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // A failed welcome email shouldn't fail signup — log it and move on.
+  const result = await sendWelcomeEmail(user);
+  if (!result.ok) console.error(`Welcome email to ${user.email} failed: ${result.error}`);
+
+  return user;
+}
+
+// Always resolves the same way whether or not the email exists, so callers
+// can't use it to discover which addresses have accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // Only the latest link should work.
+  for (let i = passwordResetTokens.length - 1; i >= 0; i--) {
+    if (passwordResetTokens[i].userId === user.id) passwordResetTokens.splice(i, 1);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  passwordResetTokens.push({
+    userId: user.id,
+    tokenHash: hashToken(token),
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+  const result = await sendPasswordResetEmail(user, resetUrl, RESET_TOKEN_TTL_MINUTES);
+  if (!result.ok) console.error(`Password reset email to ${user.email} failed: ${result.error}`);
+}
+
+// Validates and consumes a reset token. Returns the user it belongs to, or
+// undefined if the token is unknown, expired or already used. The caller sets
+// the new password once there is password storage.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const tokenHash = hashToken(token);
+  const index = passwordResetTokens.findIndex((t) => t.tokenHash === tokenHash);
+  if (index === -1) return undefined;
+
+  const [entry] = passwordResetTokens.splice(index, 1);
+  if (entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
