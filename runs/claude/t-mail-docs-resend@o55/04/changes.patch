+import { button, escapeHtml, layout } from "./layout";
+
+export function welcomeEmail({ name, dashboardUrl }: { name: string; dashboardUrl: string }) {
+  const subject = "Welcome to Notely";
+  const html = layout(`
+    <p>Hi ${escapeHtml(name)},</p>
+    <p>Thanks for signing up for Notely. Your account is ready — jump in and write your first note.</p>
+    ${button(dashboardUrl, "Open Notely")}
+    <p style="color:#71717a;font-size:13px;">If you didn't create this account, you can ignore this email.</p>
+  `);
+  const text = `Hi ${name},
+
+Thanks for signing up for Notely. Your account is ready — jump in and write your first note:
+${dashboardUrl}
+
+If you didn't create this account, you can ignore this email.`;
+  return { subject, html, text };
+}
diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..01c2b20
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,53 @@
+import "server-only";
+import { Resend } from "resend";
+
+import { passwordResetEmail } from "@/emails/password-reset";
+import { welcomeEmail } from "@/emails/welcome";
+
+type EmailContent = { subject: string; html: string; text: string };
+
+let client: Resend | undefined;
+
+// Created lazily so a missing key doesn't break builds or pages that never send email.
+function getClient(): Resend {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) throw new Error("RESEND_API_KEY is not set");
+  client ??= new Resend(apiKey);
+  return client;
+}
+
+function getFrom(): string {
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!from) throw new Error("RESEND_FROM_EMAIL is not set");
+  return from;
+}
+
+export function appUrl(path = ""): string {
+  const base = (process.env.APP_URL ?? "http://localhost:3000").replace(/\/+$/, "");
+  return `${base}${path}`;
+}
+
+// Resend resolves to { error } instead of throwing; we normalise both cases to a throw
+// so callers have a single failure path.
+async function send(to: string, content: EmailContent, idempotencyKey?: string): Promise<string> {
+  const { data, error } = await getClient().emails.send(
+    { from: getFrom(), to, ...content },
+    idempotencyKey ? { idempotencyKey } : undefined,
+  );
+  if (error || !data) {
+    throw new Error(`Resend failed to send "${content.subject}": ${error?.name ?? "unknown"} — ${error?.message ?? "no data"}`);
+  }
+  return data.id;
+}
+
+export function sendWelcomeEmail(user: { id: string; email: string; name: string }) {
+  return send(user.email, welcomeEmail({ name: user.name, dashboardUrl: appUrl("/dashboard") }), `welcome/${user.id}`);
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+  expiresInMinutes: number,
+) {
+  return send(user.email, passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes }));
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..6d23c93 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,8 @@
+import "server-only";
+import { createHash, randomBytes, randomUUID, timingSafeEqual } from "node:crypto";
+
+import { appUrl, sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -18,7 +23,104 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  const name = input.name.trim();
+  if (!email.includes("@")) throw new Error("Invalid email address");
+  if (!name) throw new Error("Name is required");
+  if (await getUserByEmail(email)) throw new Error("A user with this email already exists");
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name,
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // The account exists either way; a failed welcome email must not fail sign-up.
+  try {
+    await sendWelcomeEmail(user);
+  } catch (err) {
+    console.error(`Welcome email to user ${user.id} failed`, err);
+  }
+
+  return user;
+}
+
+// --- Password reset ---
+
+const RESET_TOKEN_TTL_MINUTES = 30;
+
+type PasswordResetToken = { userId: string; tokenHash: Buffer; expiresAt: number };
+
+// Only a hash of each token is kept, so a leak of this store can't be used to reset passwords.
+const resetTokens: PasswordResetToken[] = [];
+
+function hashToken(token: string): Buffer {
+  return createHash("sha256").update(token).digest();
+}
+
+function pruneExpiredTokens(now = Date.now()) {
+  for (let i = resetTokens.length - 1; i >= 0; i--) {
+    if (resetTokens[i].expiresAt <= now) resetTokens.splice(i, 1);
+  }
+}
+
+/**
+ * Starts a password reset. Always resolves the same way whether or not the email belongs
+ * to an account, so callers can't be used to discover which emails are registered.
+ */
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  pruneExpiredTokens();
+  // A new request invalidates any earlier links for this user.
+  for (let i = resetTokens.length - 1; i >= 0; i--) {
+    if (resetTokens[i].userId === user.id) resetTokens.splice(i, 1);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.push({
+    userId: user.id,
+    tokenHash: hashToken(token),
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+  try {
+    await sendPasswordResetEmail(user, resetUrl, RESET_TOKEN_TTL_MINUTES);
+  } catch (err) {
+    console.error(`Password reset email to user ${user.id} failed`, err);
+  }
+}
+
+/**
+ * Validates a reset token from the emailed link and consumes it (single use).
+ * Returns the user the token belongs to, or undefined if it's invalid or expired.
+ * There is no password storage yet — the caller sets the new password for the returned user.
+ */
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  pruneExpiredTokens();
+  const hash = hashToken(token);
+  const index = resetTokens.findIndex((t) => timingSafeEqual(t.tokenHash, hash));
+  if (index === -1) return undefined;
+
+  const [entry] = resetTokens.splice(index, 1);
+  return getUser(entry.userId);
+}
