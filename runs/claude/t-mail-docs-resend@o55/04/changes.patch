+import { button, escapeHtml, layout } from "./layout";
+
+export function passwordResetEmail({
+  name,
+  resetUrl,
+  expiresInMinutes,
+}: {
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}) {
+  const subject = "Reset your Notely password";
+  const html = layout(`
+    <p>Hi ${escapeHtml(name)},</p>
+    <p>We received a request to reset your Notely password. Click the button below to choose a new one.</p>
+    ${button(resetUrl, "Reset password")}
+    <p>This link expires in ${expiresInMinutes} minutes and can only be used once.</p>
+    <p style="color:#71717a;font-size:13px;">If you didn't request a password reset, you can safely ignore this email — your password won't change.</p>
+  `);
+  const text = `Hi ${name},
+
+We received a request to reset your Notely password. Open this link to choose a new one:
+${resetUrl}
+
+This link expires in ${expiresInMinutes} minutes and can only be used once.
+
+If you didn't request a password reset, you can safely ignore this email — your password won't change.`;
+  return { subject, html, text };
+}
