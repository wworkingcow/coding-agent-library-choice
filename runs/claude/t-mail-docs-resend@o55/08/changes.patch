+import type { EmailContent } from "@/lib/email";
+import { button, escapeHtml, layout } from "@/emails/layout";
+
+export function welcomeEmail({ name, dashboardUrl }: { name: string; dashboardUrl: string }): EmailContent {
+  return {
+    subject: "Welcome to Notely",
+    html: layout(`
+      <p>Hi ${escapeHtml(name)},</p>
+      <p>Thanks for joining Notely. Your account is ready — jump in and write your first note.</p>
+      <p style="margin:24px 0">${button("Open Notely", dashboardUrl)}</p>
+      <p style="color:#6b7280;font-size:13px">If you didn't create this account, you can ignore this email.</p>
+    `),
+    text: `Hi ${name},
+
+Thanks for joining Notely. Your account is ready — jump in and write your first note.
+
+Open Notely: ${dashboardUrl}
+
+If you didn't create this account, you can ignore this email.`,
+  };
+}
diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..e0ad9a0
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,45 @@
+import "server-only";
+import { getResend } from "@/lib/resend";
+import { welcomeEmail } from "@/emails/welcome";
+import { passwordResetEmail } from "@/emails/password-reset";
+
+export type EmailContent = { subject: string; html: string; text: string };
+
+export type SendResult = { ok: true; id: string } | { ok: false; error: string };
+
+export function appUrl(path = ""): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
+
+// Never throws: a failed email must not break the request that triggered it.
+async function sendEmail(to: string, content: EmailContent): Promise<SendResult> {
+  try {
+    const from = process.env.RESEND_FROM_EMAIL;
+    if (!from) throw new Error("RESEND_FROM_EMAIL is not set");
+
+    const { data, error } = await getResend().emails.send({ from, to, ...content });
+    if (error) {
+      console.error(`[email] "${content.subject}" to ${to} failed: ${error.name}: ${error.message}`);
+      return { ok: false, error: error.message };
+    }
+    return { ok: true, id: data.id };
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    console.error(`[email] "${content.subject}" to ${to} failed: ${message}`);
+    return { ok: false, error: message };
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }): Promise<SendResult> {
+  return sendEmail(user.email, welcomeEmail({ name: user.name, dashboardUrl: appUrl("/dashboard") }));
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  token: string,
+  expiresInMinutes: number,
+): Promise<SendResult> {
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+  return sendEmail(user.email, passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes }));
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..e85a179
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,14 @@
+import "server-only";
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+// Created lazily so a missing key fails the email send, not every import of this module.
+export function getResend(): Resend {
+  if (!client) {
+    const apiKey = process.env.RESEND_API_KEY;
+    if (!apiKey) throw new Error("RESEND_API_KEY is not set");
+    client = new Resend(apiKey);
+  }
+  return client;
+}
