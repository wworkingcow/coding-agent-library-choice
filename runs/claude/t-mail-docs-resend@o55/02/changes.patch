+}
diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..8ce3388
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,46 @@
+import { getResend } from "@/lib/resend";
+import { passwordResetEmail } from "@/emails/password-reset";
+import { welcomeEmail } from "@/emails/welcome";
+
+export type SendResult = { ok: true; id: string } | { ok: false; error: string };
+
+export function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
+}
+
+// Never throws: a failed email must not break the request that triggered it.
+async function send(
+  to: string,
+  message: { subject: string; html: string; text: string },
+): Promise<SendResult> {
+  const resend = getResend();
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!resend || !from) {
+    console.warn(`[email] RESEND_API_KEY / RESEND_FROM_EMAIL not set; skipped "${message.subject}" to ${to}`);
+    return { ok: false, error: "email not configured" };
+  }
+
+  try {
+    const { data, error } = await resend.emails.send({ from, to, ...message });
+    if (error || !data) {
+      console.error(`[email] "${message.subject}" to ${to} failed:`, error);
+      return { ok: false, error: error?.message ?? "unknown error" };
+    }
+    return { ok: true, id: data.id };
+  } catch (err) {
+    console.error(`[email] "${message.subject}" to ${to} threw:`, err);
+    return { ok: false, error: err instanceof Error ? err.message : String(err) };
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  return send(user.email, welcomeEmail({ name: user.name, appUrl: appUrl() }));
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+  expiresInMinutes: number,
+) {
+  return send(user.email, passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes }));
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..8d020a1
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,10 @@
+import { Resend } from "resend";
+
+// Server-only. Created lazily so a missing key doesn't crash the app at import time.
+let client: Resend | undefined;
+
+export function getResend(): Resend | undefined {
+  if (!process.env.RESEND_API_KEY) return undefined;
+  client ??= new Resend(process.env.RESEND_API_KEY);
+  return client;
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..6188d4e 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,6 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { appUrl, sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +25,66 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email.toLowerCase() === normalized);
+}
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // Awaited so serverless runtimes don't drop it; send() never throws.
+  await sendWelcomeEmail(user);
+
+  return user;
+}
+
+// Password reset tokens. Only the SHA-256 of a token is stored; the raw token lives in the email link.
+const RESET_TOKEN_TTL_MINUTES = 60;
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+// Always resolves the same way whether or not the email exists, so callers can't leak which accounts exist.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // One live token per user: a new request invalidates older links.
+  for (const [hash, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = `${appUrl()}/reset-password?token=${encodeURIComponent(token)}`;
+  await sendPasswordResetEmail(user, resetUrl, RESET_TOKEN_TTL_MINUTES);
+}
+
+// Single use: returns the user the token belongs to and invalidates it. Call this when the new password is submitted.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = resetTokens.get(hash);
+  if (!entry) return undefined;
+  resetTokens.delete(hash);
+  if (entry.expiresAt < Date.now()) return undefined;
+  return getUser(entry.userId);
+}
