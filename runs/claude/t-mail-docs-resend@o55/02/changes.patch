+import { button, emailLayout, escapeHtml } from "./layout";
+
+export function passwordResetEmail({
+  name,
+  resetUrl,
+  expiresInMinutes,
+}: {
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}) {
+  return {
+    subject: "Reset your Notely password",
+    html: emailLayout(
+      `<h1 style="font-size:20px;margin:0 0 16px">Reset your password</h1>
+       <p>Hi ${escapeHtml(name)}, we got a request to reset your Notely password.</p>
+       ${button(resetUrl, "Choose a new password")}
+       <p style="font-size:13px;color:#555">This link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, ignore this email — your password won't change.</p>`,
+    ),
+    text: `Hi ${name}, we got a request to reset your Notely password.\n\nChoose a new password: ${resetUrl}\n\nThis link expires in ${expiresInMinutes} minutes. If you didn't ask for a reset, ignore this email — your password won't change.\n`,
+  };
+}
