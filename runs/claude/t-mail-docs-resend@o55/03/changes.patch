+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { appUrl, sendPasswordResetEmail, sendWelcomeEmail } from "@/lib/email";
+
 export type User = {
   id: string;
   email: string;
@@ -10,6 +13,20 @@ const users: User[] = [
   { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11" },
 ];
 
+const RESET_TOKEN_TTL_MINUTES = 60;
+
+// Only the SHA-256 of a reset token is stored; the raw token exists only in the emailed link.
+type PasswordResetToken = { userId: string; tokenHash: string; expiresAt: number };
+const passwordResetTokens: PasswordResetToken[] = [];
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
 export async function listUsers(): Promise<User[]> {
   return users;
 }
@@ -18,7 +35,68 @@ export async function getUser(id: string): Promise<User | undefined> {
   return users.find((u) => u.id === id);
 }
 
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = normalizeEmail(email);
+  return users.find((u) => u.email === normalized);
+}
+
 // TODO: there is no real session handling yet — the dashboard just picks the first user.
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (await getUserByEmail(email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // The account exists either way; a failed welcome email is logged inside sendWelcomeEmail.
+  await sendWelcomeEmail(user);
+
+  return user;
+}
+
+// Always resolves the same way whether or not the email is registered, so callers
+// can't use it to find out which addresses have accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // A new request invalidates any earlier links for this user.
+  for (let i = passwordResetTokens.length - 1; i >= 0; i--) {
+    if (passwordResetTokens[i].userId === user.id) passwordResetTokens.splice(i, 1);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  passwordResetTokens.push({
+    userId: user.id,
+    tokenHash: hashToken(token),
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+  await sendPasswordResetEmail(user, resetUrl, RESET_TOKEN_TTL_MINUTES);
+}
+
+// Validates a reset token from the emailed link and burns it (single use).
+// Returns the user the token belongs to, or undefined if it is unknown or expired.
+// The caller is responsible for setting the new password — there is no password storage yet.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const tokenHash = hashToken(token);
+  const index = passwordResetTokens.findIndex((t) => t.tokenHash === tokenHash);
+  if (index === -1) return undefined;
+
+  const [record] = passwordResetTokens.splice(index, 1);
+  if (record.expiresAt < Date.now()) return undefined;
+
+  return getUser(record.userId);
+}
