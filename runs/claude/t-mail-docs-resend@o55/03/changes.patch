@@ -0,0 +1,48 @@
+import "server-only";
+import { getResend } from "@/lib/resend";
+import { welcomeEmail } from "@/emails/welcome";
+import { passwordResetEmail } from "@/emails/password-reset";
+
+type EmailContent = { subject: string; html: string; text: string };
+
+export type SendResult = { ok: true; id: string } | { ok: false; error: string };
+
+// Resend resolves to { data: null, error } instead of throwing on a refused message.
+// Both paths are turned into a result so a failed email never breaks the request that triggered it.
+async function send(to: string, content: EmailContent): Promise<SendResult> {
+  const from = process.env.RESEND_FROM_EMAIL;
+  if (!from) {
+    console.error("[email] RESEND_FROM_EMAIL is not set");
+    return { ok: false, error: "RESEND_FROM_EMAIL is not set" };
+  }
+  try {
+    const { data, error } = await getResend().emails.send({ from, to, ...content });
+    if (error || !data) {
+      const message = error ? `${error.name}: ${error.message}` : "no data returned";
+      console.error(`[email] send to ${to} failed: ${message}`);
+      return { ok: false, error: message };
+    }
+    return { ok: true, id: data.id };
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    console.error(`[email] send to ${to} failed: ${message}`);
+    return { ok: false, error: message };
+  }
+}
+
+export function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }) {
+  return send(user.email, welcomeEmail({ name: user.name, dashboardUrl: appUrl("/dashboard") }));
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+  expiresInMinutes: number,
+) {
+  return send(user.email, passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes }));
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..9948681
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,14 @@
+import "server-only";
+import { Resend } from "resend";
+
+let client: Resend | undefined;
+
+// Created lazily so a missing key fails when an email is sent, not when the module is imported.
+export function getResend(): Resend {
+  if (!client) {
+    const apiKey = process.env.RESEND_API_KEY;
+    if (!apiKey) throw new Error("RESEND_API_KEY is not set");
+    client = new Resend(apiKey);
+  }
+  return client;
+}
