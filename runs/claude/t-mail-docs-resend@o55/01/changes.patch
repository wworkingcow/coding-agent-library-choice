diff --git a/src/lib/email/client.ts b/src/lib/email/client.ts
new file mode 100644
index 0000000..2b77f8c
--- /dev/null
+++ b/src/lib/email/client.ts
@@ -0,0 +1,54 @@
+import "server-only";
+import { Resend } from "resend";
+
+let client: Resend | null = null;
+
+// Created lazily: `new Resend()` throws without an API key, which would break
+// builds and local dev for anyone who hasn't configured email yet.
+function getClient(): Resend | null {
+  if (client) return client;
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) return null;
+  client = new Resend(apiKey);
+  return client;
+}
+
+export type EmailMessage = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+export type SendResult = { ok: true; id: string | null } | { ok: false; error: string };
+
+// Never throws: a failed email must not break the request that triggered it.
+export async function sendEmail(message: EmailMessage): Promise<SendResult> {
+  const resend = getClient();
+  const from = process.env.EMAIL_FROM;
+
+  if (!resend || !from) {
+    if (process.env.NODE_ENV === "production") {
+      console.error("[email] RESEND_API_KEY or EMAIL_FROM is not set; email not sent", {
+        to: message.to,
+        subject: message.subject,
+      });
+      return { ok: false, error: "Email is not configured" };
+    }
+    // In development, print the email instead of sending it.
+    console.info(`[email] (not sent, no RESEND_API_KEY) to=${message.to} subject="${message.subject}"\n${message.text}`);
+    return { ok: true, id: null };
+  }
+
+  try {
+    const { data, error } = await resend.emails.send({ from, ...message });
+    if (error) {
+      console.error("[email] Resend refused message", { to: message.to, subject: message.subject, error });
+      return { ok: false, error: error.message };
+    }
+    return { ok: true, id: data?.id ?? null };
+  } catch (err) {
+    console.error("[email] Failed to reach Resend", { to: message.to, subject: message.subject, err });
+    return { ok: false, error: err instanceof Error ? err.message : String(err) };
+  }
+}
diff --git a/src/lib/email/templates.ts b/src/lib/email/templates.ts
