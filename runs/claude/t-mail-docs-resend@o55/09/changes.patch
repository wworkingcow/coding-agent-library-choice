new file mode 100644
index 0000000..06de94f
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,65 @@
+import "server-only";
+import { getResend } from "@/lib/resend";
+import { welcomeEmail } from "@/emails/welcome";
+import { passwordResetEmail } from "@/emails/password-reset";
+
+export type SendResult = { ok: true; id: string } | { ok: false; error: string };
+
+export function appUrl(): string {
+  return (process.env.APP_URL ?? "http://localhost:3000").replace(/\/+$/, "");
+}
+
+// Never throws: a failed email must not break the request that triggered it.
+// Resend resolves refused messages to `{ error }`; we also catch config/network errors.
+async function send(message: {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  tag: string;
+}): Promise<SendResult> {
+  try {
+    const from = process.env.RESEND_FROM_EMAIL;
+    if (!from) throw new Error("RESEND_FROM_EMAIL is not set");
+
+    const { data, error } = await getResend().emails.send({
+      from,
+      to: message.to,
+      subject: message.subject,
+      html: message.html,
+      text: message.text,
+      replyTo: process.env.RESEND_REPLY_TO_EMAIL || undefined,
+      tags: [{ name: "type", value: message.tag }],
+    });
+
+    if (error) {
+      console.error(`[email] ${message.tag} to ${message.to} failed: ${error.name}: ${error.message}`);
+      return { ok: false, error: error.message };
+    }
+    return { ok: true, id: data.id };
+  } catch (err) {
+    const msg = err instanceof Error ? err.message : String(err);
+    console.error(`[email] ${message.tag} to ${message.to} failed: ${msg}`);
+    return { ok: false, error: msg };
+  }
+}
+
+export function sendWelcomeEmail(user: { email: string; name: string }): Promise<SendResult> {
+  return send({
+    to: user.email,
+    tag: "welcome",
+    ...welcomeEmail({ name: user.name, appUrl: appUrl() }),
+  });
+}
+
+export function sendPasswordResetEmail(
+  user: { email: string; name: string },
+  resetUrl: string,
+  expiresInMinutes: number,
+): Promise<SendResult> {
+  return send({
+    to: user.email,
+    tag: "password_reset",
+    ...passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes }),
+  });
+}
diff --git a/src/lib/resend.ts b/src/lib/resend.ts
new file mode 100644
index 0000000..16ab745
--- /dev/null
+++ b/src/lib/resend.ts
@@ -0,0 +1,15 @@
+import "server-only";
+import { Resend } from "resend";
+
+// Created lazily: the Resend constructor throws without an API key, which would
+// break `next build` and any page that imports user code in an unconfigured env.
+let client: Resend | undefined;
+
+export function getResend(): Resend {
+  if (!client) {
+    const apiKey = process.env.RESEND_API_KEY;
+    if (!apiKey) throw new Error("RESEND_API_KEY is not set");
+    client = new Resend(apiKey);
+  }
+  return client;
+}
