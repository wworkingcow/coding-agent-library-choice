+import { buttonHtml, emailLayout, escapeHtml } from "./layout";
+
+export function welcomeEmail({ name, dashboardUrl }: { name: string; dashboardUrl: string }) {
+  const subject = "Welcome to Notely";
+
+  const html = emailLayout(`
+    <p>Hi ${escapeHtml(name)},</p>
+    <p>Thanks for signing up for Notely. Your account is ready.</p>
+    <p style="padding:8px 0;">${buttonHtml(dashboardUrl, "Open your dashboard")}</p>
+    <p style="color:#71717a;font-size:13px;">If you didn't create this account, you can ignore this email.</p>
+  `);
+
+  const text = `Hi ${name},
+
+Thanks for signing up for Notely. Your account is ready.
+
+Open your dashboard: ${dashboardUrl}
+
+If you didn't create this account, you can ignore this email.`;
+
+  return { subject, html, text };
+}
diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..6b1d5fe
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,58 @@
+import { Resend } from "resend";
+
+export type EmailMessage = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+export type SendResult = { ok: true; id: string } | { ok: false; error: string };
+
+let client: Resend | undefined;
+
+function getClient(): Resend | undefined {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) return undefined;
+  client ??= new Resend(apiKey);
+  return client;
+}
+
+// Server-only. Never throws: a failed email must not break the request that triggered it.
+export async function sendEmail(message: EmailMessage): Promise<SendResult> {
+  const resend = getClient();
+
+  if (!resend) {
+    // No API key (local dev): log instead of sending so flows stay testable.
+    console.info(`[email] RESEND_API_KEY not set, skipping send to ${message.to}: ${message.subject}\n${message.text}`);
+    return { ok: false, error: "RESEND_API_KEY not set" };
+  }
+
+  try {
+    const { data, error } = await resend.emails.send({
+      from: process.env.RESEND_FROM_EMAIL ?? "Notely <onboarding@resend.dev>",
+      to: message.to,
+      subject: message.subject,
+      html: message.html,
+      text: message.text,
+    });
+
+    if (error || !data) {
+      const reason = error ? `${error.name}: ${error.message}` : "empty response";
+      console.error(`[email] send to ${message.to} failed — ${reason}`);
+      return { ok: false, error: reason };
+    }
+
+    return { ok: true, id: data.id };
+  } catch (err) {
+    // Network failures and the like can still reject.
+    const reason = err instanceof Error ? err.message : String(err);
+    console.error(`[email] send to ${message.to} failed — ${reason}`);
+    return { ok: false, error: reason };
+  }
+}
+
+export function appUrl(path: string): string {
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(path, base).toString();
+}
diff --git a/src/lib/users.ts b/src/lib/users.ts
index 1b4b6c1..2d68dc3 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -1,3 +1,8 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { appUrl, sendEmail } from "@/lib/email";
+import { welcomeEmail } from "@/emails/welcome";
+import { passwordResetEmail } from "@/emails/password-reset";
+
 export type User = {
   id: string;
   email: string;
@@ -22,3 +27,73 @@ export async function getUser(id: string): Promise<User | undefined> {
 export async function getCurrentUser(): Promise<User | undefined> {
   return users[0];
 }
+
+export async function getUserByEmail(email: string): Promise<User | undefined> {
+  const normalized = email.trim().toLowerCase();
+  return users.find((u) => u.email === normalized);
+}
+
+export async function createUser(input: { email: string; name: string }): Promise<User> {
+  const email = input.email.trim().toLowerCase();
+  if (await getUserByEmail(email)) {
+    throw new Error(`A user with email ${email} already exists`);
+  }
+
+  const user: User = {
+    id: randomUUID(),
+    email,
+    name: input.name.trim(),
+    createdAt: new Date().toISOString().slice(0, 10),
+  };
+  users.push(user);
+
+  // sendEmail never throws, so a failed welcome email doesn't fail signup.
+  await sendEmail({ to: user.email, ...welcomeEmail({ name: user.name, dashboardUrl: appUrl("/dashboard") }) });
+
+  return user;
+}
+
+const RESET_TOKEN_TTL_MINUTES = 60;
+
+// Only the SHA-256 of each token is stored, so a leaked store can't be used to reset passwords.
+const resetTokens = new Map<string, { userId: string; expiresAt: number }>();
+
+function hashToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+// Resolves the same way whether or not the email exists, so callers can't use it to probe for accounts.
+export async function requestPasswordReset(email: string): Promise<void> {
+  const user = await getUserByEmail(email);
+  if (!user) return;
+
+  // One live link per user: a new request invalidates older ones.
+  for (const [hash, entry] of resetTokens) {
+    if (entry.userId === user.id) resetTokens.delete(hash);
+  }
+
+  const token = randomBytes(32).toString("base64url");
+  resetTokens.set(hashToken(token), {
+    userId: user.id,
+    expiresAt: Date.now() + RESET_TOKEN_TTL_MINUTES * 60_000,
+  });
+
+  const resetUrl = appUrl(`/reset-password?token=${encodeURIComponent(token)}`);
+  await sendEmail({
+    to: user.email,
+    ...passwordResetEmail({ name: user.name, resetUrl, expiresInMinutes: RESET_TOKEN_TTL_MINUTES }),
+  });
+}
+
+// Validates and burns a reset token. Returns the user it belongs to, or undefined if invalid/expired.
+// TODO: once passwords are stored, set the new password here.
+export async function consumePasswordResetToken(token: string): Promise<User | undefined> {
+  const hash = hashToken(token);
+  const entry = resetTokens.get(hash);
+  if (!entry) return undefined;
+
+  resetTokens.delete(hash);
+  if (entry.expiresAt < Date.now()) return undefined;
+
+  return getUser(entry.userId);
+}
