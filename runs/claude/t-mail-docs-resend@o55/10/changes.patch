+import { buttonHtml, emailLayout, escapeHtml } from "./layout";
+
+export function passwordResetEmail({
+  name,
+  resetUrl,
+  expiresInMinutes,
+}: {
+  name: string;
+  resetUrl: string;
+  expiresInMinutes: number;
+}) {
+  const subject = "Reset your Notely password";
+
+  const html = emailLayout(`
+    <p>Hi ${escapeHtml(name)},</p>
+    <p>We received a request to reset your Notely password. Click below to choose a new one.</p>
+    <p style="padding:8px 0;">${buttonHtml(resetUrl, "Reset password")}</p>
+    <p style="color:#71717a;font-size:13px;">This link expires in ${expiresInMinutes} minutes and can be used once. If you didn't request a reset, you can ignore this email — your password won't change.</p>
+  `);
+
+  const text = `Hi ${name},
+
+We received a request to reset your Notely password. Use the link below to choose a new one:
+
+${resetUrl}
+
+This link expires in ${expiresInMinutes} minutes and can be used once. If you didn't request a reset, you can ignore this email — your password won't change.`;
+
+  return { subject, html, text };
+}
