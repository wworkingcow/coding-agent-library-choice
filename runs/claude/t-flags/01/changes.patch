--- /dev/null
+++ b/src/lib/flags.ts
@@ -0,0 +1,101 @@
+import { createClient } from "@vercel/edge-config";
+import type { User } from "./users";
+
+/**
+ * Feature flags, backed by Vercel Edge Config.
+ *
+ * Edge Config is a globally-replicated key/value store built for exactly
+ * this: reading small bits of config (like flags) on every request with very
+ * low latency, and updating them from the Vercel dashboard/API in place —
+ * no redeploy, and changes propagate within seconds.
+ *
+ * Add new flags by extending `FlagKey` and `DEFAULTS` below.
+ *
+ * Edge Config is expected to contain a single item named "flags", shaped like:
+ *
+ * {
+ *   "new-dashboard": {
+ *     "enabled": false,
+ *     "users": { "1": true, "grace@example.com": true }
+ *   }
+ * }
+ *
+ * - "enabled" is the flag's default for everyone.
+ * - "users" holds per-user overrides keyed by user id OR email, so a flag
+ *   can be flipped on/off for a specific person regardless of the default.
+ *
+ * If EDGE_CONFIG isn't set (e.g. local dev without a real Edge Config
+ * provisioned yet), flags fall back to an optional `FLAG_<KEY>` env var and
+ * then to their hardcoded default, so the app keeps working out of the box.
+ */
+
+export type FlagKey = "new-dashboard";
+
+type FlagConfig = {
+  enabled?: boolean;
+  users?: Record<string, boolean>;
+};
+
+type FlagsDocument = Partial<Record<FlagKey, FlagConfig>>;
+
+// Hardcoded fallback used when a flag has no Edge Config entry, no env
+// override, and no per-user override — i.e. the safe "off by default" state.
+const DEFAULTS: Record<FlagKey, boolean> = {
+  "new-dashboard": false,
+};
+
+const edgeConfig = process.env.EDGE_CONFIG
+  ? createClient(process.env.EDGE_CONFIG)
+  : null;
+
+const CACHE_TTL_MS = 5_000; // keep per-request reads snappy without going stale for long
+let cache: { doc: FlagsDocument; expiresAt: number } | null = null;
+
+async function loadFlagsDocument(): Promise<FlagsDocument> {
+  if (!edgeConfig) return {};
+
+  if (cache && cache.expiresAt > Date.now()) {
+    return cache.doc;
+  }
+
+  try {
+    const doc = (await edgeConfig.get<FlagsDocument>("flags")) ?? {};
+    cache = { doc, expiresAt: Date.now() + CACHE_TTL_MS };
+    return doc;
+  } catch (error) {
+    console.error("[flags] failed to read Edge Config, falling back to cached/default values", error);
+    return cache?.doc ?? {};
+  }
+}
+
+function envOverride(key: FlagKey): boolean | undefined {
+  const envKey = `FLAG_${key.toUpperCase().replace(/-/g, "_")}`;
+  const raw = process.env[envKey];
+  if (raw === undefined) return undefined;
+  return raw === "1" || raw.toLowerCase() === "true";
+}
+
+/**
+ * Evaluate a feature flag for a given user (or anonymously, if no user is
+ * signed in). Per-user overrides always win, so a flag can be turned on/off
+ * for a specific person without touching the global default.
+ */
+export async function isFeatureEnabled(
+  key: FlagKey,
+  user?: Pick<User, "id" | "email"> | null
+): Promise<boolean> {
+  const doc = await loadFlagsDocument();
+  const config = doc[key];
+
+  if (user && config?.users) {
+    if (user.id in config.users) return config.users[user.id];
+    if (user.email in config.users) return config.users[user.email];
+  }
+
+  if (config?.enabled !== undefined) return config.enabled;
+
+  const override = envOverride(key);
+  if (override !== undefined) return override;
+
+  return DEFAULTS[key];
+}
