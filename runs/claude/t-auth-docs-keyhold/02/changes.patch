@@ -0,0 +1,45 @@
+"use server";
+
+import { AuthError } from "next-auth";
+import { signIn } from "@/auth";
+import { createUserWithPassword } from "@/lib/users";
+
+export type SignUpState = { error?: string };
+
+export async function signUpAction(
+  _prevState: SignUpState,
+  formData: FormData
+): Promise<SignUpState> {
+  const name = String(formData.get("name") ?? "").trim();
+  const email = String(formData.get("email") ?? "").trim();
+  const password = String(formData.get("password") ?? "");
+
+  if (!name || !email || !password) {
+    return { error: "Fill in name, email and password." };
+  }
+  if (password.length < 8) {
+    return { error: "Password must be at least 8 characters." };
+  }
+
+  try {
+    await createUserWithPassword(email, name, password);
+  } catch (err) {
+    return { error: err instanceof Error ? err.message : "Could not create account." };
+  }
+
+  try {
+    await signIn("credentials", { email, password, redirectTo: "/dashboard" });
+  } catch (err) {
+    // signIn throws a redirect internally on success — rethrow anything that isn't that.
+    if (err instanceof AuthError) {
+      return { error: "Account created, but sign-in failed. Try signing in." };
+    }
+    throw err;
+  }
+
+  return {};
+}
+
+export async function signUpWithGoogleAction() {
+  await signIn("google", { redirectTo: "/dashboard" });
+}
