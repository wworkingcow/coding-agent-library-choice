+const users: UserRecord[] = [
+  { id: "1", email: "ada@example.com", name: "Ada", createdAt: "2026-01-04", passwordHash: null },
+  { id: "2", email: "grace@example.com", name: "Grace", createdAt: "2026-02-11", passwordHash: null },
 ];
 
+let nextId = users.length + 1;
+
+function toPublicUser(record: UserRecord): User {
+  return { id: record.id, email: record.email, name: record.name, createdAt: record.createdAt };
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
