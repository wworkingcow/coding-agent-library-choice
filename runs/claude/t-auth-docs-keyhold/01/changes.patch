 }
 
 export async function getUser(id: string): Promise<User | undefined> {
-  return users.find((u) => u.id === id);
+  const record = users.find((u) => u.id === id);
+  return record ? toPublicUser(record) : undefined;
+}
+
+export async function findUserByEmail(email: string): Promise<User | undefined> {
+  const target = normalizeEmail(email);
+  const record = users.find((u) => u.email === target);
+  return record ? toPublicUser(record) : undefined;
 }
 
-// TODO: there is no real session handling yet — the dashboard just picks the first user.
-export async function getCurrentUser(): Promise<User | undefined> {
-  return users[0];
+// Email + password sign up. Throws if the email is already taken.
+export async function createUser(input: {
+  email: string;
+  name: string;
+  password: string;
+}): Promise<User> {
+  const email = normalizeEmail(input.email);
+  if (users.some((u) => u.email === email)) {
+    throw new Error("A user with this email already exists.");
+  }
+
+  const passwordHash = await bcrypt.hash(input.password, 10);
+  const record: UserRecord = {
+    id: String(nextId++),
+    email,
+    name: input.name.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash,
+  };
+  users.push(record);
+  return toPublicUser(record);
+}
+
+// Email + password sign in. Returns the user on success, null otherwise.
+// Also null for accounts that were only ever created via Google sign-in.
+export async function verifyPassword(email: string, password: string): Promise<User | null> {
+  const record = users.find((u) => u.email === normalizeEmail(email));
+  if (!record || !record.passwordHash) return null;
+
+  const ok = await bcrypt.compare(password, record.passwordHash);
+  return ok ? toPublicUser(record) : null;
+}
+
+// Google sign-in. Links to an existing account with the same email, or
+// provisions a new password-less account.
+export async function findOrCreateOAuthUser(input: { email: string; name: string }): Promise<User> {
+  const email = normalizeEmail(input.email);
+  const existing = users.find((u) => u.email === email);
+  if (existing) return toPublicUser(existing);
+
+  const record: UserRecord = {
+    id: String(nextId++),
+    email,
+    name: input.name.trim() || email,
+    createdAt: new Date().toISOString().slice(0, 10),
+    passwordHash: null,
+  };
+  users.push(record);
+  return toPublicUser(record);
 }
