+"use client";
+
+import Link from "next/link";
+import { useRouter, useSearchParams } from "next/navigation";
+import { signIn } from "next-auth/react";
+import { Suspense, useState, type FormEvent } from "react";
+
+function SignInForm() {
+  const router = useRouter();
+  const searchParams = useSearchParams();
+  const callbackUrl = searchParams.get("callbackUrl") || "/dashboard";
+
+  const [email, setEmail] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  async function onSubmit(e: FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+
+    const result = await signIn("credentials", { email, password, redirect: false });
+
+    setLoading(false);
+    if (result?.error) {
+      setError("Invalid email or password.");
+      return;
+    }
+    router.push(callbackUrl);
+  }
+
+  return (
+    <main className="mx-auto flex max-w-sm flex-col p-8">
+      <h1 className="text-2xl font-semibold">Sign in</h1>
+
+      <form onSubmit={onSubmit} className="mt-6 flex flex-col gap-3">
+        <input
+          type="email"
+          required
+          autoComplete="email"
+          placeholder="Email"
+          value={email}
+          onChange={(e) => setEmail(e.target.value)}
+          className="rounded border border-black/10 bg-transparent px-3 py-2 text-sm dark:border-white/20"
+        />
+        <input
+          type="password"
+          required
+          autoComplete="current-password"
+          placeholder="Password"
+          value={password}
+          onChange={(e) => setPassword(e.target.value)}
+          className="rounded border border-black/10 bg-transparent px-3 py-2 text-sm dark:border-white/20"
+        />
+        {error && <p className="text-sm text-red-600">{error}</p>}
+        <button
+          type="submit"
+          disabled={loading}
+          className="rounded-full bg-foreground px-5 py-2 text-sm font-medium text-background disabled:opacity-50"
+        >
+          {loading ? "Signing in…" : "Sign in"}
+        </button>
+      </form>
+
+      <div className="my-5 flex items-center gap-3 text-xs uppercase opacity-50">
+        <span className="h-px flex-1 bg-black/10 dark:bg-white/20" />
+        or
+        <span className="h-px flex-1 bg-black/10 dark:bg-white/20" />
+      </div>
+
+      <button
+        type="button"
+        onClick={() => signIn("google", { callbackUrl })}
+        className="rounded-full border border-black/10 px-5 py-2 text-sm font-medium dark:border-white/20"
+      >
+        Continue with Google
+      </button>
+
+      <p className="mt-6 text-sm opacity-70">
+        No account?{" "}
+        <Link href="/sign-up" className="underline">
+          Sign up
+        </Link>
+      </p>
+    </main>
+  );
+}
+
+export default function SignInPage() {
+  return (
+    <Suspense>
+      <SignInForm />
+    </Suspense>
+  );
+}
